(module rewrite.testmacrohead)
(import "rewrite.macrohead" :as head)
(import "rewrite.sourceroutes" :as routes)
(import "rewrite.observedresolution" :as observed)
(import "rewrite.headprotocol" :as protocol)
(import "rewrite.code" :as code)
(import "rewrite.codeforms" :as syntax)
(import "rewrite.namespace" :as namespace)
(import "rewrite.nameforms" :as names)
(import "rewrite.routingfacts" :as facts)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.str" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.debug-allocator" :use [DebugAllocator])

(defn expect [(a (dyn Allocator))
              (table (ptr routes/Table))
              (view (ptr namespace/View))
              (world (ptr facts/World))
              (input (ptr code/Syntax))
              (id syntax/N0Id)
              (scope i64)
              (module (slice u8))
              (expected (slice u8))
              (owner (slice u8))] (-> void)
  (set! (.f0 (elem (field input contexts) 0)) scope)
  (set! (.f1 (elem (field input contexts) 0)) module)
  (let [(mut output)
          (observed/macro-head! a table view world input id (Some "caller"))]
    (defer (head/release! (mut output)))
    (match (.result output)
      (Err [_] (panic "head failure"))
      (Ok [answer]
          (unless (= (match (.target answer) (Some [x] x) (None [] ""))
                     expected)
            (panic "wrong macro head"))
          (match (.route answer)
            (None [] (unless (= owner "") (panic "missing route")))
            (Some [route]
                  (unless (and (= (.f0 route) owner)
                               (= (.f1 route) (str (.lexical output)))
                               (= (.f2 route) expected))
                    (panic "generated spelling lifetime or route"))))))))

(defn check [(a (dyn Allocator)) (table (ptr routes/Table))] (-> void)
  (let [(mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        (mut store) (names/store-new a)
        (mut input) (code/create a)
        id
          (syntax/append-0 (mut (.rows0 (.store input)))
                           (syntax/N0V2 (syntax/store-text! (mut (.store input))
                                                            "m")))
        forms
          (match (read-all sa
                           "(Namespace [(Declaration \"caller.m\") (Declaration \"def.m\") (Declaration \"m\")
             (Declaration \"def.$scope7@def$m\") (Declaration \"lib.$scope9@def$m\")] [] [])
           (Routing [(ModuleImports \"def\" [] (Imports [(Reexport \"lib\" (Refer true [] [] []))]) (Refer true [] [] []))] [] [] [] \"core\")"
                           0)
            (Ok [forms] forms)
            (Err [_] (panic "read")))
        root
          (match (names/parse-7 (mut store) (elem forms 0))
            (Ok [id] id)
            (Err [_] (panic "namespace parse")))
        routes
          (match (names/parse-13 (mut store) (elem forms 1))
            (Ok [id] id)
            (Err [_] (panic "routing parse")))]
    (defer (close! (mut scratch)))
    (defer (names/store-free! (mut store)))
    (defer (code/release! (mut input)))
    (push! (mut (.contexts input))
           (syntax/N1Row
             :f0 0
             :f1 ""
             :f2 99
             :f3 77
             :f4 55
             :f5 33))
    (let [(mut view)
            (match (namespace/compile a (mut store) root)
              (Ok [v] v)
              (Err [_] (panic "view")))
          (mut world)
            (match (facts/compile a (mut store) routes)
              (Ok [v] v)
              (Err [_] (panic "world")))]
      (defer (namespace/release! (mut view)))
      (defer (facts/release! (mut world)))
      (expect a
              table
              (mut view)
              (mut world)
              (mut input)
              id
              0
              "def"
              "caller.m"
              "")
      (expect a
              table
              (mut view)
              (mut world)
              (mut input)
              id
              7
              "def"
              "def.$scope7@def$m"
              "")
      (expect a table (mut view) (mut world) (mut input) id 8 "def" "def.m" "")
      (expect a
              table
              (mut view)
              (mut world)
              (mut input)
              id
              9
              "def"
              "lib.$scope9@def$m"
              "lib")
      (expect a table (mut view) (mut world) (mut input) id 7 "" "m" "")
      (expect a
              table
              (mut view)
              (mut world)
              (mut input)
              id
              -1
              "def"
              "caller.m"
              "")
      (let [(mut first)
              (observed/macro-head! a
                                    table
                                    (mut view)
                                    (mut world)
                                    (mut input)
                                    id
                                    (Some "caller"))
            (mut second)
              (observed/macro-head! a
                                    table
                                    (mut view)
                                    (mut world)
                                    (mut input)
                                    id
                                    (Some "caller"))]
        (defer (head/release! (mut first)))
        (defer (head/release! (mut second)))
        (when (= (str (.lexical first)) (str (.lexical second)))
          (panic "constructed occurrence reused lexical identity")))
      (let [(mut invalid)
              (observed/macro-head! a
                                    table
                                    (mut view)
                                    (mut world)
                                    (mut input)
                                    (syntax/N0Id :index 999)
                                    (None))]
        (defer (head/release! (mut invalid)))
        (match (.result invalid)
          (Ok [_] (panic "invalid head accepted"))
          (Err [e]
               (match e
                 (protocol/HandlerError [_ error]
                                        (match error
                                          (head/InvalidHead [_])
                                          (_ (panic "wrong head error"))))
                 (_ (panic "wrong protocol error"))))))
      (let [missing
              (syntax/append-0 (mut (.rows0 (.store input)))
                               (syntax/N0V2 "missing"))
            (mut output)
              (observed/macro-head! a
                                    table
                                    (mut view)
                                    (mut world)
                                    (mut input)
                                    missing
                                    (None))]
        (defer (head/release! (mut output)))
        (match (.result output)
          (Ok [_] (panic "missing context accepted"))
          (Err [e]
               (match e
                 (protocol/HandlerError [_ error]
                                        (match error
                                          (head/MissingContext [_])
                                          (_ (panic "wrong context error"))))
                 (_ (panic "wrong context protocol error"))))))
      (let [integer
              (syntax/append-0 (mut (.rows0 (.store input))) (syntax/N0V0 7))
            (mut output)
              (observed/macro-head! a
                                    table
                                    (mut view)
                                    (mut world)
                                    (mut input)
                                    integer
                                    (None))]
        (defer (head/release! (mut output)))
        (match (.result output)
          (Ok [_] (panic "integer head accepted"))
          (Err [e]
               (match e
                 (protocol/HandlerError [_ error]
                                        (match error
                                          (head/ExpectedSymbol [_])
                                          (_ (panic "wrong symbol error"))))
                 (_ (panic "wrong symbol protocol error")))))))))

(defn main [] (-> i64)
  (let [debug (DebugAllocator::new (malloc-allocator))]
    (let [(mut table) (routes/create (DebugAllocator::view debug))]
      (routes/start! (mut table))
      (check (DebugAllocator::view debug) (mut table))
      ; Every input store and head outcome has been released before this lookup.
      (match (routes/lookup (mut table) "def" "$scope9@def$m" 6)
        (Some [route]
              (unless (and (= (.f0 route) "lib")
                           (= (.f1 route) "$scope9@def$m")
                           (= (.f2 route) "lib.$scope9@def$m"))
                (panic "published route lost ownership")))
        (None [] (panic "scoped route not published")))
      (routes/release! (mut table)))
    (unless (= (DebugAllocator::deinit! debug) 0) (panic "macro-head leak")))
  (println "macro heads: scoped preference, definition/caller context, raw fallback, fresh constructed occurrences, owned route spelling and invalid syntax passed")
  0)
