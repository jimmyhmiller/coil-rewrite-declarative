(module fixture.main)
(import "rewrite.generated" :use *)
(import "rewrite.native" :as native)
(import "rewrite.invocation" :as inv)
(import "rewrite.code" :as code)
(import "rewrite.codeforms" :as forms)
(import "coil.alloc" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "declarative.rt.jit" :as jit)
(defn value [(r (Result i64 inv/InvocationError))] (-> i64)
  (match r (Ok [n] n) (Err [_] (panic "native syntax operation"))))
(defn identity-entry :cc (cc/C) [(n i64)] (-> i64) n)
(defn reenter :cc (cc/C) [(ctx (ptr inv/Invocation)) (n i64)] (-> i64)
  (match (inv/close! ctx)
    (Err [e] (match e (inv/InvocationBusy []) (_ (panic "wrong close error"))))
    (Ok [_] (panic "closed running invocation")))
  (match (inv/read-one! ctx 99 "running" "0")
    (Err [e] (match e (inv/InvocationBusy []) (_ (panic "wrong read error"))))
    (Ok [_] (panic "read while running")))
  (inv/callback-result! ctx (inv/invoke-code! ctx (fnptr-of identity-entry) n)))
(defn main [] (-> i64)
  (let [(mut arena) (zeroed ScratchArena) started (init (mut arena) (malloc-allocator))
        a (allocator (mut arena)) (mut store) (store-new a)
        (mut ids) (ArrayList::new [N1Id] a)
        (mut imports) (ArrayList::new [(native/ContextFunction inv/Invocation)] a)
        (mut ctx) (inv/create a) (mut other) (inv/create a)
        (mut ok) true
        root (value (inv/read-one! (mut ctx) 1 "source" "((1 2) [40 42])"))
        foreign (value (inv/read-one! (mut other) 1 "other" "((1 2) [40 42])"))
        forms (match (read-all a "(Function \"select\" \"n\" (Call (Variable \"first\") (Call (Variable \"last\") (Variable \"n\")))) (Function \"inspect\" \"n\" (Call (Variable \"integer\") (Call (Variable \"select\") (Variable \"n\")))) (Function \"nested\" \"n\" (Call (Variable \"reenter\") (Variable \"n\")))" 0)
          (Ok [forms] forms) (Err [_] (panic "fixture source")))]
    (for [i 0 (len (load forms))]
      (match (parse-1 (mut store) (elem forms i))
        (Ok [id] (push! (mut ids) id)) (Err [_] (panic "fixture parse"))))
    (push! (mut imports) (native/ContextFunction [inv/Invocation] :name "integer" :context (primitive/cast (ptr inv/Invocation) (mut ctx)) :function (fnptr-of inv/integer-callback)))
    (push! (mut imports) (native/ContextFunction [inv/Invocation] :name "last" :context (primitive/cast (ptr inv/Invocation) (mut ctx)) :function (fnptr-of inv/last-callback)))
    (push! (mut imports) (native/ContextFunction [inv/Invocation] :name "first" :context (primitive/cast (ptr inv/Invocation) (mut ctx)) :function (fnptr-of inv/first-callback)))
    (push! (mut imports) (native/ContextFunction [inv/Invocation] :name "reenter" :context (primitive/cast (ptr inv/Invocation) (mut ctx)) :function (fnptr-of reenter)))
    (let [im (match (compile-program a (mut store) (mut ids)) (Ok [im] im) (Err [_] (panic "compile phase fixture")))
          loaded (match (native/load-image-with-contexts a im (mut imports)) (Ok [im] im) (Err [_] (panic "link phase fixture")))
          select (primitive/cast (fnptr (cc/C) [i64] i64) (jit/address-of (.program loaded) 0))
          inspect (primitive/cast (fnptr (cc/C) [i64] i64) (jit/address-of (.program loaded) 1))
          nested (primitive/cast (fnptr (cc/C) [i64] i64) (jit/address-of (.program loaded) 2))
          selected (value (inv/invoke-code! (mut ctx) select root))]
      (unless (and (= 40 (value (inv/integer (mut ctx) selected)))
                   (= 40 (value (inv/invoke-value! (mut ctx) inspect root)))) (set! ok false))
      (match (inv/invoke-code! (mut ctx) select selected)
        (Err [e] (match e (inv/ExpectedContainer [h] (unless (= h selected) (set! ok false))) (_ (set! ok false))))
        (Ok [_] (set! ok false)))
      (match (inv/invoke-code! (mut ctx) select foreign)
        (Err [e] (match e (inv/InvalidHandle [_]) (_ (set! ok false)))) (Ok [_] (set! ok false)))
      (match (inv/invoke-code! (mut ctx) nested root)
        (Err [e] (match e (inv/InvocationBusy []) (_ (set! ok false)))) (Ok [_] (set! ok false)))
      (unless (and (not (.running ctx)) (= 40 (value (inv/invoke-value! (mut ctx) inspect root)))) (set! ok false))
      (let [(mut promoted) (code/create (malloc-allocator))
            result (match (inv/promote! (mut promoted) (mut ctx) selected)
                     (Ok [id] id) (Err [_] (panic "promote native result")))]
        (native/unload-context-image! loaded)
        (inv/close! (mut ctx))
        (match (get (.rows0 (.store promoted)) (.index result))
          (forms/N0V0 [n] (unless (= n 40) (set! ok false))) (_ (set! ok false)))
        (code/release! (mut promoted))))
    (inv/close! (mut ctx)) (inv/close! (mut other)) (close! (mut arena))
    (println "native syntax handles: selection, scalar projection, sticky errors and reentry: {}" ok)
    (if ok 0 1)))
