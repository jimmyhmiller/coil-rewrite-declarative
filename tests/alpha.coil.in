(module fixture.main)
(import "rewrite.generated" :use *)
(import "rewrite.resolution" :as resolution)
(import "rewrite.source" :as source)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)

(defn reference-id [(occurrence resolution/Occurrence)] (-> i64)
  (match (.target occurrence) (Some [id] (.index id)) (None [] (- 0 1))))
(defn main [] (-> i64)
  (let [a (malloc-allocator) (mut input) (store-new a) (mut target) (store-new a)
        (mut globals) (ArrayList::new [(slice u8)] a) (mut ok) true
        origin (source/Origin :source 10 :lo 0 :hi 1)
        name (store-text! (mut input) "x")
        shared (append-0 (mut (.rows0 input)) (N0V1 name))
        inner (append-0 (mut (.rows0 input)) (N0V2 name shared shared))
        global (append-0 (mut (.rows0 input)) (N0V1 "__coil_local_0"))
        (mut items) (ArrayList::new [N0Id] a)]
    (match (store-source! (mut input) 10 "alpha.coil" "x") (Ok [_]) (Err [_] (set! ok false)))
    (push! (mut globals) "__coil_local_0") (push! (mut globals) "__coil_local_1")
    (push! (mut items) inner) (push! (mut items) shared) (push! (mut items) global)
    (let [group (append-0 (mut (.rows0 input)) (N0V4 (sequence-0 (mut input) (mut items))))
          root (append-1 (mut (.rows1 input)) (N1Row :f0 name :f1 group))]
      (for [i 0 (len (.rows0 input))] (push! (mut (.origins0 input)) origin))
      (push! (mut (.origins1 input)) origin)
      (match (alpha-1 a (mut input) (mut input) root (mut globals))
        (Err [e] (match e (AlphaAliasedStores []) (_ (set! ok false))))
        (Ok [out] (let [(mut rows) (.rows out)] (free! (mut rows)) (set! ok false))))
      (let [(mut conflict) (store-new a)]
        (match (store-source! (mut conflict) 10 "other.coil" "y") (Ok [_]) (Err [_] (set! ok false)))
        (match (alpha-1 a (mut input) (mut conflict) root (mut globals))
          (Err [e] (match e (AlphaSource [_]) (_ (set! ok false))))
          (Ok [out] (let [(mut rows) (.rows out)] (free! (mut rows)) (set! ok false))))
        (store-free! (mut conflict)))
      (match (alpha-0 a (mut input) (mut target) shared (mut globals))
        (Err [e] (match e (AlphaResolve [_]) (_ (set! ok false))))
        (Ok [out] (let [(mut rows) (.rows out)] (free! (mut rows)) (set! ok false))))
      (let [missing-origin (append-1 (mut (.rows1 input)) (N1Row :f0 name :f1 group))]
        (match (alpha-1 a (mut input) (mut target) missing-origin (mut globals))
          (Err [e] (match e (AlphaOriginMissing [schema row]
            (unless (and (= schema 1) (= row (.index missing-origin))) (set! ok false))) (_ (set! ok false))))
          (Ok [out] (let [(mut rows) (.rows out)] (free! (mut rows)) (set! ok false)))))
      (let [(mut outer) (ArrayList::new [(slice u8)] a)
            dual (append-5 (mut (.rows5 input)) (N5Row :f0 name :f1 shared))]
        (push! (mut (.origins5 input)) origin) (push! (mut outer) "x")
        (match (alpha-5 a (mut input) (mut target) dual (mut outer))
          (Err [e] (match e (AlphaOverlappingRole [schema field]
            (unless (and (= schema 5) (= field 0)) (set! ok false))) (_ (set! ok false))))
          (Ok [out] (let [(mut rows) (.rows out)] (free! (mut rows)) (set! ok false))))
        (free! (mut outer)))
      (let [(mut before) (match (resolve-1 a (mut input) root (mut globals))
                            (Ok [r] r) (Err [_] (panic "source resolution")))
            copied (match (alpha-1 a (mut input) (mut target) root (mut globals))
                     (Ok [r] r) (Err [_] (panic "alpha copy")))
            (mut rows) (.rows copied)
            (mut after) (match (resolve-1 a (mut target) (.root copied) (mut globals))
                           (Ok [r] r) (Err [_] (panic "target resolution")))]
        (unless (and (= (len (.occurrences before)) (len (.occurrences after)))
                     (= (len (.declarations before)) (len (.declarations after)))
                     (= (len rows) (len (.occurrences before)))) (set! ok false))
        (for [i 0 (len (.occurrences before))]
          (let [before (get (.occurrences before) i) after (get (.occurrences after) i)]
            (unless (and (= (reference-id before) (reference-id after))
                         (= (.schema before) (.schema after)) (= (.parent before) (.parent after))
                         (= (.field before) (.field after)) (= (.item before) (.item after))
                         (= (get rows i) (.row after))) (set! ok false))))
        (for [i 0 (len (.declarations before))]
          (let [before (get (.declarations before) i) after (get (.declarations after) i)]
            (unless (and (= (.owner before) (.owner after)) (= (.field before) (.field after))) (set! ok false))))
        (unless (and (= (.name (get (.declarations after) 2)) "__coil_local_2")
                     (= (.name (get (.declarations after) 3)) "__coil_local_3")
                     (= (.name (get (.declarations after) 0)) "__coil_local_0")) (set! ok false))
        ; Three occurrences of the shared reference must become distinct rows.
        (unless (and (not (= (get rows 3) (get rows 4))) (not (= (get rows 4) (get rows 5)))) (set! ok false))
        (resolution/release! (mut before)) (resolution/release! (mut after)) (free! (mut rows))
        (for text (.strings (.source-data input))
          (for [i 0 (len text)] (set! text i 88)))
        (store-free! (mut input))
        (match (resolve-1 a (mut target) (.root copied) (mut globals))
          (Err [_] (set! ok false))
          (Ok [r] (let [(mut r) r]
            (unless (= (.name (get (.declarations r) 2)) "__coil_local_2") (set! ok false))
            (resolution/release! (mut r)))))
        (match (get (.documents (.source-data target)) 10)
          (Some [doc] (unless (and (= (.text doc) "x") (= (.name doc) "alpha.coil")) (set! ok false)))
          (None [] (set! ok false)))))
    (store-free! (mut target)) (free! (mut globals)) (free! (mut items))
    (println "alpha copying: declaration identity, shared occurrences, reserved globals and independent storage: {}" ok)
    (if ok 0 1)))
