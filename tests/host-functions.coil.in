(module fixture.main)
(import "rewrite.generated" :use *)
(import "rewrite.native" :as native)
(import "coil.alloc" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "declarative.rt.jit" :as jit)

(defn host-inc :cc (cc/C) [(x i64)] (-> i64) (+ x 1))
(defn host-double :cc (cc/C) [(x i64)] (-> i64) (+ x x))
(defn wrong-signature :cc (cc/C) [(x bool)] (-> i64) (if x 1 0))
(defn main [] (-> i64)
  (let [(mut arena) (zeroed ScratchArena) started (init (mut arena) (malloc-allocator))
        a (allocator (mut arena)) (mut store) (store-new a)
        (mut ids) (ArrayList::new [N1Id] a) (mut imports) (ArrayList::new [native/HostFunction] a)
        (mut ok) true
        forms (match (read-all a "(Function \"entry\" \"n\" (Add (Call (Variable \"helper\") (Variable \"n\")) (Let \"f\" (AddressOf (Variable \"double\")) (Call (Variable \"f\") (Integer 1))))) (Function \"helper\" \"n\" (Call (Variable \"increment\") (Variable \"n\")))" 0)
                (Ok [forms] forms) (Err [_] (panic "fixture source")))]
    (for [i 0 (len (load forms))]
      (match (parse-1 (mut store) (elem forms i))
        (Ok [id] (push! (mut ids) id)) (Err [_] (panic "fixture parse"))))
    (let [im (match (compile-program a (mut store) (mut ids))
               (Ok [im] im) (Err [_] (panic "host declarations")))]
      (unless (and (= (len (.names im)) 4) (= (get (.defined im) 2) (- 0 1)) (= (get (.defined im) 3) (- 0 1))) (set! ok false))
      (match (native/load-image-with a im (mut imports))
        (Err [e] (match e (native/MissingImport [name] (unless (= name "increment") (set! ok false))) (_ (set! ok false))))
        (Ok [loaded] (jit/unload! loaded) (set! ok false)))
      (push! (mut imports) (native/HostFunction :name "increment" :function (fnptr-of host-inc)))
      (push! (mut imports) (native/HostFunction :name "double" :function (fnptr-of host-double)))
      (match (native/load-image-with a im (mut imports))
        (Err [_] (set! ok false))
        (Ok [loaded]
          (let [run (primitive/cast (fnptr (cc/C) [i64] i64) (jit/address-of loaded 0))]
            (unless (= (run 39) 42) (set! ok false))
            (set! (mut imports) 0 (native/HostFunction :name "increment" :function (fnptr-of host-double)))
            (match (native/load-image-with a im (mut imports))
              (Err [_] (set! ok false))
              (Ok [second]
                (let [other (primitive/cast (fnptr (cc/C) [i64] i64) (jit/address-of second 0))]
                  (unless (and (= (other 20) 42) (= (run 39) 42)) (set! ok false)))
                (jit/unload! second))))
          (jit/unload! loaded)))
      ; Rebinding an import when loading a fresh image must use that image's bindings.
      (set! (mut imports) 0 (native/HostFunction :name "increment" :function (fnptr-of host-double)))
      (match (native/load-image-with a im (mut imports))
        (Err [_] (set! ok false))
        (Ok [loaded]
          (let [run (primitive/cast (fnptr (cc/C) [i64] i64) (jit/address-of loaded 0))]
            (unless (= (run 20) 42) (set! ok false)))
          (jit/unload! loaded)))
      (set! (mut imports) 1 (native/HostFunction :name "increment" :function (fnptr-of host-inc)))
      (match (native/load-image-with a im (mut imports))
        (Err [e] (match e (native/DuplicateImport [_]) (_ (set! ok false))))
        (Ok [loaded] (jit/unload! loaded) (set! ok false)))
      (set! (mut imports) 1 (native/HostFunction :name "entry" :function (fnptr-of host-inc)))
      (match (native/load-image-with a im (mut imports))
        (Err [e] (match e (native/DefinedImport [_]) (_ (set! ok false))))
        (Ok [loaded] (jit/unload! loaded) (set! ok false)))
      (set! (mut imports) 1 (native/HostFunction :name "unlisted" :function (fnptr-of host-inc)))
      (match (native/load-image-with a im (mut imports))
        (Err [e] (match e (native/UnknownImport [_]) (_ (set! ok false))))
        (Ok [loaded] (jit/unload! loaded) (set! ok false)))
      (set! (mut imports) 1 (native/HostFunction :name "double" :function (zeroed (fnptr (cc/C) [i64] i64))))
      (match (native/load-image-with a im (mut imports))
        (Err [e] (match e (native/NullImport [_]) (_ (set! ok false))))
        (Ok [loaded] (jit/unload! loaded) (set! ok false))))
    ; A source declaration cannot replace an explicitly declared host function.
    (let [collision (append-1 (mut (.rows1 store))
                      (N1Row :f0 "increment" :f1 "n" :f2 (append-0 (mut (.rows0 store)) (N0V0 0))))]
      (push! (mut ids) collision)
      (match (compile-program a (mut store) (mut ids))
        (Err [e] (match e (DuplicateFunction [name] (unless (= name "increment") (set! ok false))) (_ (set! ok false))))
        (Ok [_] (set! ok false))))
    (store-free! (mut store)) (free! (mut imports)) (free! (mut ids)) (close! (mut arena))
    (println "host functions: typed direct/indirect calls, fresh-image linkage and rejected imports: {}" ok)
    (if ok 0 1)))
