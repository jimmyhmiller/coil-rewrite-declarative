(module rewrite.testrequestexecution)
(import "rewrite.requestexecution" :as execution)
(import "rewrite.requestprotocol" :as protocol)
(import "rewrite.requests" :as requests)
(import "rewrite.code" :as code)
(import "rewrite.codeforms" :as forms)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use [HashMap])
(import "coil.str" :use [keyops-borrowed])
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(defn read-root [(s (mut code/Syntax)) (source i64) (text (slice u8))]
  (-> forms/N0Id)
  (let [roots
          (match (code/read! (mut s) source "execution.coil" text)
            (Ok [roots] roots)
            (Err [_] (panic "read")))]
    (match (forms/sequence-item-0 (field s store) roots 0)
      (Some [id] id)
      (None [] (panic "root")))))

(defstruct Script
  [(session (ptr execution/Session))
   (markers (ptr (HashMap (slice u8) bool)))
   (entries (ptr (HashMap (slice u8) bool)))
   (remaining i64)
   (loop-root (Option forms/N0Id))
   (done-root (Option forms/N0Id))
   (log (ArrayList i64))
   (probe? bool)
   (unknown? bool)])

(defn callback :cc (cc/C) [(script (ptr Script))
                           (call (ptr requests/Call))
                           (output (ptr code/Syntax))]
  (-> (Result forms/N0Id i64))
  (when (.probe? script)
    (set! (.probe? script) false)
    (when (execution/close! (.session script))
      (panic "closed active execution"))
    (match (execution/run! (.session script)
                           output
                           (forms/N0Id :index 0)
                           (None)
                           (.markers script)
                           (.entries script)
                           script
                           (primitive/fnptr-of callback))
      (Err [e] (match e (execution/Busy []) (_ (panic "reentry error"))))
      (_ (panic "reentry accepted"))))
  (cond (= (.entry call) "fail") (Err 77)
        (= (.entry call) "bad") (Ok (forms/N0Id :index 999999))
        (= (.entry call) "md.relay")
          (let [id (read-root output 101 "(request constant)")]
            (set! (.f1 (elem (field output contexts) (.index id)))
                  (forms/store-text! (mut (.store output)) "foreign.module"))
            (Ok id))
        (= (.entry call) "first")
          (let [arg
                  (sexp-nth (.source (.arguments call))
                            (.start (.arguments call)))]
            (push! (mut (.log script)) 1)
            (unless (and (sexp-list? arg)
                         (sexp-sym-is (sexp-nth arg 0) "request"))
              (panic "argument expanded early"))
            (match (code/import-form! output arg)
              (Ok [id] (Ok id))
              (Err [_] (Err 88))))
        :else
          (do
            (when (= (.entry call) "repeat")
              (set! (.remaining script) (- (.remaining script) 1)))
            (if (and (= (.entry call) "repeat") (> (.remaining script) 0))
                (do
                  (match (.loop-root script)
                    (None []
                          (set! (.loop-root script)
                                (Some (read-root output 100 "(request repeat)"))))
                    (Some [_]))
                  (match (.loop-root script)
                    (Some [id] (Ok id))
                    (None [] (panic "loop root"))))
                (do
                  (push! (mut (.log script)) 2)
                  (match (.done-root script)
                    (None []
                          (set! (.done-root script)
                                (Some (read-root output
                                                 99
                                                 (if (.unknown? script)
                                                     "(request absent)"
                                                     "42")))))
                    (Some [_]))
                  (match (.done-root script)
                    (Some [id] (Ok id))
                    (None [] (panic "done root"))))))))

(defn reset-script! [(script (mut Script)) (remaining i64)] (-> void)
  (set! (.remaining script) remaining)
  (set! (.loop-root script) (None))
  (set! (.done-root script) (None))
  (set! (.probe? script) true)
  (set! (.unknown? script) false)
  (while (> (len (.log script)) 0) (pop! (mut (.log script)))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut input) (code/create a)
        (mut expected) (code/create a)
        (mut durable) (code/create a)
        (mut durable-root) (None [forms/N0Id])
        (mut session) (execution/create a)
        (mut markers) (HashMap::new [(slice u8) bool] a (keyops-borrowed))
        (mut entries) (HashMap::new [(slice u8) bool] a (keyops-borrowed))
        (mut script)
          (Script
            :session (primitive/cast (ptr execution/Session) (mut session))
            :markers
              (primitive/cast (ptr (HashMap (slice u8) bool)) (mut markers))
            :entries
              (primitive/cast (ptr (HashMap (slice u8) bool)) (mut entries))
            :remaining 0
            :loop-root (None)
            :done-root (None)
            :log (ArrayList::new [i64] a)
            :probe? true
            :unknown? false)
        root
          (read-root (mut input)
                     1
                     "(box (request first (request constant)) [1 (request constant)] (quote (request fail)) (defn f [(request fail)] (-> x) (request constant)))")
        expected-root
          (read-root (mut expected)
                     2
                     "(box 42 [1 42] (quote (request fail)) (defn f [(request fail)] (-> x) 42))")]
    (defer (code/release! (mut input)))
    (defer (code/release! (mut expected)))
    (defer (code/release! (mut durable)))
    (defer (free! (mut markers)))
    (defer (free! (mut entries)))
    (defer (free! (mut (.log script))))
    (set! (mut markers) "request" true)
    (set! (mut entries) "first" true)
    (set! (mut entries) "constant" true)
    (set! (mut entries) "md.relay" true)
    (set! (mut entries) "md.constant" true)
    (set! (mut entries) "repeat" true)
    (set! (mut entries) "fail" true)
    (set! (mut entries) "bad" true)
    (let [context (elem (field (mut input) contexts) (.index root))]
      (set! (.f0 context) 17)
      (set! (.f1 context)
            (forms/store-text! (mut (.store input)) "owner.module"))
      (set! (.f2 context) 29)
      (set! (.f3 context) 71)
      (set! (.f4 context) 3))
    (let [original (get (.contexts input) (.index root))
          output
            (match (execution/run! (mut session)
                                   (mut input)
                                   root
                                   (None)
                                   (mut markers)
                                   (mut entries)
                                   (mut script)
                                   (primitive/fnptr-of callback))
              (Ok [id] id)
              (Err [_] (panic "execution")))
          context (get (.contexts (.syntax session)) (.index output))
          saved
            (match (code/promote! (mut durable)
                                  (field (mut session) syntax)
                                  output)
              (Ok [id] id)
              (Err [_] (panic "durable promotion")))]
      (set! durable-root (Some saved))
      (unless (and (= (.f1 context) "owner.module")
                   (= (.f2 context) 29)
                   (= (.f3 context) 71)
                   (= (.f4 context) 3)
                   (= (.calls session) 4)
                   (= (len (.log script)) 4)
                   (= (get (.log script) 0) 1)
                   (= (.f5 original) (.f5 context))
                   (= (.f0 original) (.f0 context)))
        (panic "order or enclosing identity"))
      (match (code/equal? a (mut durable) saved (mut expected) expected-root)
        (Ok [same] (unless same (panic "replacement shape")))
        (Err [_] (panic "equality")))
      (match (execution/run! (mut session)
                             (field (mut session) syntax)
                             output
                             (None)
                             (mut markers)
                             (mut entries)
                             (mut script)
                             (primitive/fnptr-of callback))
        (Err [e]
             (match e (execution/AliasedInput []) (_ (panic "alias error"))))
        (_ (panic "aliased input accepted"))))
    (let [repeat-root (read-root (mut input) 3 "(request repeat)")]
      (for [attempt 0 2]
        (reset-script! (mut script) 100000)
        (match (execution/run! (mut session)
                               (mut input)
                               repeat-root
                               (None)
                               (mut markers)
                               (mut entries)
                               (mut script)
                               (primitive/fnptr-of callback))
          (Ok [_])
          (Err [_] (panic "exact call ceiling")))
        (unless (= (.calls session) 100000) (panic "fresh top-level budget")))
      (reset-script! (mut script) 100001)
      (match (execution/run! (mut session)
                             (mut input)
                             repeat-root
                             (None)
                             (mut markers)
                             (mut entries)
                             (mut script)
                             (primitive/fnptr-of callback))
        (Err [e]
             (match e
               (execution/Protocol [failure]
                                   (match failure
                                     (protocol/Exhausted [budget limit]
                                                         (unless (and (= limit
                                                                         100000)
                                                                      (= (protocol/budget-name budget)
                                                                         "calls"))
                                                           (panic "limit")))
                                     (_ (panic "protocol error"))))
               (_ (panic "runner error"))))
        (_ (panic "unbounded requests")))
      (unless (and (= (.calls session) 100000) (= (.remaining script) 1))
        (panic "exhausted callback ran")))
    (let [repeat-root (read-root (mut input) 8 "(request repeat)")]
      (reset-script! (mut script) 100000)
      (set! (.unknown? script) true)
      (match (execution/run! (mut session)
                             (mut input)
                             repeat-root
                             (None)
                             (mut markers)
                             (mut entries)
                             (mut script)
                             (primitive/fnptr-of callback))
        (Err [e]
             (match e
               (execution/Protocol [failure]
                                   (match failure
                                     (protocol/HandlerError [_ cause]
                                                            (match cause
                                                              (execution/Selection [selection]
                                                                                   (match selection
                                                                                     (requests/Unavailable [_
                                                                                                            raw
                                                                                                            name]
                                                                                                           (unless (and (= raw
                                                                                                                           "absent")
                                                                                                                        (= name
                                                                                                                           "absent"))
                                                                                                             (panic "retained diagnostic")))
                                                                                     (_ (panic "lookup precedence"))))
                                                              (_ (panic "lookup before limit"))))
                                     (_ (panic "limit replaced lookup error"))))
               (_ (panic "setup"))))
        (_ (panic "unavailable returned request accepted")))
      (unless (= (.calls session) 100000) (panic "lookup callback count")))
    (let [relay (read-root (mut input) 7 "(request relay)")]
      (reset-script! (mut script) 0)
      (match (execution/run! (mut session)
                             (mut input)
                             relay
                             (Some "md")
                             (mut markers)
                             (mut entries)
                             (mut script)
                             (primitive/fnptr-of callback))
        (Ok [_])
        (Err [_] (panic "returned request module")))
      (unless (= (.calls session) 2) (panic "returned request not revisited")))
    (for [mode 0 2]
      (let [bad-root
              (read-root (mut input)
                         (+ 4 mode)
                         (if (= mode 0) "(request fail)" "(request bad)"))]
        (reset-script! (mut script) 0)
        (match (execution/run! (mut session)
                               (mut input)
                               bad-root
                               (None)
                               (mut markers)
                               (mut entries)
                               (mut script)
                               (primitive/fnptr-of callback))
          (Err [e]
               (match e
                 (execution/Protocol [failure]
                                     (match failure
                                       (protocol/HandlerError [_ cause]
                                                              (match cause
                                                                (execution/Callback [value]
                                                                                    (unless (and (= mode
                                                                                                    0)
                                                                                                 (= value
                                                                                                    77))
                                                                                      (panic "callback error")))
                                                                (execution/Projection [_]
                                                                                      (unless (= mode
                                                                                                 1)
                                                                                        (panic "projection error")))
                                                                (_ (panic "wrong handler failure"))))
                                       (_ (panic "wrong failure"))))
                 (_ (panic "setup failure"))))
          (_ (panic "failed callback accepted")))))
    (reset-script! (mut script) 0)
    (match (execution/run! (mut session)
                           (mut input)
                           root
                           (None)
                           (mut markers)
                           (mut entries)
                           (mut script)
                           (primitive/fnptr-of callback))
      (Ok [_])
      (Err [_] (panic "retry after failures")))
    (let [quoted (read-root (mut input) 6 "(quote (request fail))")]
      (reset-script! (mut script) 0)
      (match (execution/run! (mut session)
                             (mut input)
                             quoted
                             (None)
                             (mut markers)
                             (mut entries)
                             (mut script)
                             (primitive/fnptr-of callback))
        (Ok [_])
        (Err [_] (panic "opaque result")))
      (unless (= (.calls session) 0) (panic "quote invoked callback")))
    (unless (and (execution/close! (mut session))
                 (execution/close! (mut session)))
      (panic "close"))
    (match (execution/run! (mut session)
                           (mut input)
                           root
                           (None)
                           (mut markers)
                           (mut entries)
                           (mut script)
                           (primitive/fnptr-of callback))
      (Err [e] (match e (execution/Closed []) (_ (panic "closed error"))))
      (_ (panic "closed runner accepted")))
    (let [saved
            (match durable-root (Some [id] id) (None [] (panic "saved root")))]
      (match (code/equal? a (mut durable) saved (mut expected) expected-root)
        (Ok [same] (unless same (panic "result depended on closed session")))
        (Err [_] (panic "durable equality"))))
    (println "request execution: outermost replacement, returned calls, metadata, ownership, failures and per-root 100000-call boundary passed")
    0))
