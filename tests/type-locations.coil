(module rewrite.testtypelocations)
(import "rewrite.typesyntax" :as forms)
(import "rewrite.source" :as source)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.str" :use [StrBuf])
(import "coil.primitive" :as primitive)
(import "coil.scratch" :use [ScratchArena])
(import "coil.debug-allocator" :use [DebugAllocator])

(defn captured [(store (ptr forms/Store)) (schema i64) (row i64) (field i64)]
  (-> source/Occurrence)
  (match (source/captured (field store source-data) schema row field)
    (Some [value] value)
    (_ (panic "missing location"))))

(defn span [(site source/Occurrence) (lo i64) (hi i64)] (-> void)
  (unless (and (= (.source (.origin site)) 17)
               (= (.lo (.origin site)) lo)
               (= (.hi (.origin site)) hi))
    (panic "wrong span")))

(defn check [(a (dyn Allocator))] (-> void)
  (let [(mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        (mut store) (forms/store-new a)
        (mut structural) (forms/store-new a)
        (mut canonical) (forms/store-new a)
        (mut text) (StrBuf::new a)
        (mut module-name) (StrBuf::new a)]
    (defer (forms/store-free! (mut store)))
    (defer (forms/store-free! (mut structural)))
    (defer (forms/store-free! (mut canonical)))
    (push-str! (mut text) "(array (dyn Show) N) T")
    (push-str! (mut module-name) "definition")
    (let [roots
            (match (read-all sa (str text) 17) (Ok [v] v) (_ (panic "reader")))
          root (elem roots 0)
          dyn (sexp-nth root 1)
          name (sexp-nth dyn 1)
          extent (sexp-nth root 2)
          (mut module) (HygModule :name (str module-name))
          (mut empty-module) (HygModule :name "")
          name-lo (.lo name)
          name-hi (.hi name)
          name-id (.node-id name)
          extent-lo (.lo extent)
          extent-hi (.hi extent)
          head-lo (.lo (sexp-nth root 0))
          head-hi (.hi (sexp-nth root 0))
          dyn-lo (.lo dyn)
          dyn-hi (.hi dyn)]
      (set! (.ctxt root) 88)
      (set! (.hyg name) 7)
      (set! (.horigin name) 13)
      (set! (.ctxt name) 92)
      (set! (.hmod name) (primitive/cast (ptr HygModule) (mut module)))
      (set! (.hyg extent) -2)
      (set! (.horigin extent) 14)
      (set! (.ctxt extent) 93)
      (set! (.hmod extent) (primitive/cast (ptr HygModule) (mut empty-module)))
      (match (forms/store-source! (mut store) 17 "locations.coil" (str text))
        (Ok [_])
        (_ (panic "document")))
      (let [before (next-node-id)
            first
              (match (forms/surface-3 (mut store) root)
                (Ok [v] v)
                (_ (panic "array")))
            second
              (match (forms/surface-3 (mut store) (elem roots 1))
                (Ok [v] v)
                (_ (panic "name")))]
        (unless (= (next-node-id) (+ before 1))
          (panic "capture allocated identities"))
        (let [(mut first-state)
                (forms/transform-state-new a (mut store) (mut structural) 64)
              middle
                (match (forms/transform-3-9 (mut first-state) first)
                  (Ok [v] v)
                  (_ (panic "structural map")))
              (mut second-state)
                (forms/transform-state-new a
                                           (mut structural)
                                           (mut canonical)
                                           64)
              result
                (match (forms/transform-9-15 (mut second-state) middle)
                  (Ok [v] v)
                  (_ (panic "canonical map")))]
          (forms/transform-state-free! (mut second-state))
          (forms/transform-state-free! (mut first-state))
          (match (source/captured (mut (.source-data canonical))
                                  15
                                  (.index result)
                                  -1)
            (None [])
            (_ (panic "canonical row conflates occurrences"))))
        (for value (.strings (.source-data structural))
          (for [i 0 (len value)] (set! value i 88)))
        (let [(mut found?) false]
          (for trace (.traces canonical)
            (when (= (.target-schema trace) 10)
              (match (.occurrence trace)
                (Some [site]
                      (set! found? true)
                      (span site extent-lo extent-hi)
                      (unless (and (= (.spelling site) "N")
                                   (= (.context site) 93)
                                   (= (.scope site) -2))
                        (panic "canonical occurrence metadata ownership")))
                (_ (panic "missing canonical occurrence")))))
          (unless found? (panic "no lexical trace")))
        (for [i 0 (len (.bytes text))] (set! (mut (.bytes text)) i 88))
        (for [i 0 (len (.bytes module-name))]
          (set! (mut (.bytes module-name)) i 88))
        (free! (mut text))
        (free! (mut module-name))
        (close! (mut scratch))
        (let [whole (captured store 3 (.index first) -1)
              head (captured store 3 (.index first) -2)]
          (unless (and (= (.context whole) 88)
                       (not (.symbol? whole))
                       (= (.spelling head) "array")
                       (.symbol? head))
            (panic "root/head metadata"))
          (span head head-lo head-hi))
        (match (get (.rows3 store) (.index first))
          (forms/N3V9 [element length]
                      (let [child (captured store 3 (.index first) 0)
                            identifier (captured store 3 (.index element) 0)
                            parameter (captured store 1 (.index length) 0)]
                        (span child dyn-lo dyn-hi)
                        (span identifier name-lo name-hi)
                        (span parameter extent-lo extent-hi)
                        (unless (and (= (.spelling identifier) "Show")
                                     (= (.scope identifier) 7)
                                     (= (.context identifier) 92)
                                     (= (.hygiene-origin identifier) 13)
                                     (= (.node-id identifier) name-id))
                          (panic "owned identifier metadata"))
                        (match (.module identifier)
                          (Some [m]
                                (unless (= m "definition")
                                  (panic "module ownership")))
                          (_ (panic "module presence")))
                        (unless (and (= (.spelling parameter) "N")
                                     (= (.scope parameter) -2)
                                     (= (.context parameter) 93)
                                     (= (.hygiene-origin parameter) 14))
                          (panic "extent metadata"))
                        (match (.module parameter)
                          (Some [m] (unless (= m "") (panic "empty module")))
                          (_ (panic "lost empty module presence")))))
          (_ (panic "array shape")))
        (let [raw (captured store 3 (.index second) 0)]
          (unless (= (.spelling raw) "T") (panic "raw spelling"))
          (match (.module raw) (None []) (_ (panic "invented module"))))
        (match (source/captured (mut (.source-data store)) 3 (.index second) -2)
          (None [])
          (_ (panic "invented list head")))))))

(defn main [] (-> i64)
  (let [debug (DebugAllocator::new (malloc-allocator))]
    (check (DebugAllocator::view debug))
    (unless (= (DebugAllocator::deinit! debug) 0) (panic "location leak")))
  (println "type locations: precise root/head/field spans, owned spelling/module, hygiene/context/node identity, absent/empty modules and no early freshness passed")
  0)
