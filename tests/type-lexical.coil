(module rewrite.testtypelexical)
(import "rewrite.typesyntax" :as forms)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.debug-allocator" :use [DebugAllocator])

(defn check [(a (dyn Allocator))] (-> void)
  (let [(mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        (mut input) (forms/store-new a)
        (mut target) (forms/store-new a)
        text
          "(Reference (Identifier \"N\" -1 \"def\")) (Parameter (Identifier \"W\" 7 \"def\")) (Named (Identifier \"cc\" 0 \"ignored\")) (Value (Identifier \"cc/C\" 8 \"def\")) (Integer 3)"
        roots (match (read-all sa text 1) (Ok [v] v) (_ (panic "source")))
        constant
          (match (forms/parse-6 (mut input) (elem roots 0))
            (Ok [v] v)
            (_ (panic "constant")))
        extent
          (match (forms/parse-7 (mut input) (elem roots 1))
            (Ok [v] v)
            (_ (panic "extent")))
        named
          (match (forms/parse-8 (mut input) (elem roots 2))
            (Ok [v] v)
            (_ (panic "named convention")))
        value
          (match (forms/parse-8 (mut input) (elem roots 3))
            (Ok [v] v)
            (_ (panic "value convention")))
        literal
          (match (forms/parse-6 (mut input) (elem roots 4))
            (Ok [v] v)
            (_ (panic "literal")))]
    (defer (forms/store-free! (mut target)))
    (match (forms/store-source! (mut input) 1 "type-names.coil" text)
      (Ok [_])
      (_ (panic "source registration")))
    (let [(mut state) (forms/transform-state-new a (mut input) (mut target))
          before (next-node-id)]
      (for [i 0 2]
        (match (forms/transform-6-11 (mut state) constant)
          (Ok [_])
          (_ (panic "constant lexical map"))))
      (match (forms/transform-7-12 (mut state) extent)
        (Ok [_])
        (_ (panic "extent lexical map")))
      (match (forms/transform-8-13 (mut state) named)
        (Ok [_])
        (_ (panic "named convention map")))
      (match (forms/transform-8-13 (mut state) value)
        (Ok [_])
        (_ (panic "value convention map")))
      (match (forms/transform-6-11 (mut state) literal)
        (Ok [_])
        (_ (panic "literal map")))
      (unless (= (next-node-id) (+ before 3))
        (panic "wrong lexical allocation count"))
      (forms/transform-state-free! (mut state)))
    (for value (.strings (.source-data input))
      (for [i 0 (len value)] (set! value i 88)))
    (forms/store-free! (mut input))
    (close! (mut scratch))
    (unless (and (= (len (.rows10 target)) 5)
                 (!= (.f0 (get (.rows10 target) 0))
                     (.f0 (get (.rows10 target) 1)))
                 (= (.f0 (get (.rows10 target) 2)) "$scope7@def$W")
                 (= (.f0 (get (.rows10 target) 3)) "cc")
                 (= (.f0 (get (.rows10 target) 4)) "$scope8@def$cc/C"))
      (panic "lexical names or ownership"))
    (match (get (.rows11 target) 2)
      (forms/N11V0 [value] (unless (= value 3) (panic "constant value")))
      (_ (panic "constant kind")))))

(defn main [] (-> i64)
  (let [debug (DebugAllocator::new (malloc-allocator))]
    (check (DebugAllocator::view debug))
    (unless (= (DebugAllocator::deinit! debug) 0) (panic "type lexical leak")))
  (println "type lexical components: constant/extent/convention names, fresh occurrences, stable scopes, literals and ownership passed")
  0)
