(module fixture.main)
(import "rewrite.generated" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut literals) (ArrayList::new [N0Row] a)
        (mut additions) (ArrayList::new [N1Row] a)
        left (append-0 (mut literals) (N0Row :f0 19))
        right (append-0 (mut literals) (N0Row :f0 23))
        add (append-1 (mut additions) (N1Row :f0 left :f1 right))
        (mut answer) 0]
    (for [i 0 4096] (append-0 (mut literals) (N0Row :f0 i)))
    (match (lookup-1 (mut additions) add)
      (None [] (set! answer 1))
      (Some [row]
        (match (lookup-0 (mut literals) (.f0 row))
          (None [] (set! answer 2))
          (Some [l]
            (match (lookup-0 (mut literals) (.f1 row))
              (None [] (set! answer 3))
              (Some [r] (unless (= (+ (.f0 l) (.f0 r)) 42) (set! answer 4))))))))
    (match (lookup-0 (mut literals) (N0Id :index 99999))
      (Some [_] (set! answer 5)) (None [] 0))
    (match (lookup-0 (mut literals) (N0Id :index (- 0 1)))
      (Some [_] (set! answer 6)) (None [] 0))
    (free! (mut additions)) (free! (mut literals))
    answer))
