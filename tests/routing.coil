(module rewrite.testrouting)
(import "rewrite.routing" :as routing)
(import "rewrite.routingfacts" :as facts)
(import "rewrite.namespace" :as namespace)
(import "rewrite.nameforms" :as forms)
(import "rewrite.resolveprotocol" :as protocol)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.debug-allocator" :use [DebugAllocator])

(defn expect [(a (dyn Allocator))
              (view (ptr namespace/View))
              (world (ptr facts/World))
              (head (slice u8))
              (module (Option (slice u8)))
              (macro? bool)
              (target (slice u8))
              (owner (slice u8))] (-> void)
  (match (routing/resolve a view world head module macro?)
    (Err [_] (panic "unexpected route error"))
    (Ok [answer]
        (unless (= (match (.target answer) (Some [name] name) (None [] ""))
                   target)
          (println "wrong route for {}: expected {}" head target)
          (panic "target"))
        (unless (= (match (.route answer)
                     (Some [route] (.f0 route))
                     (None [] ""))
                   owner)
          (panic "route owner"))
        (match (.route answer)
          (Some [route]
                (unless (= (.f2 route) target) (panic "route declaration")))
          (None [])))))

(defn check [(a (dyn Allocator))] (-> void)
  (let [(mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        (mut store) (forms/store-new a)
        input
          (match (read-all sa
                           "(Namespace
            [(Declaration \"app.own\") (Declaration \"app.private\") (Declaration \"app.part.name\")
             (Declaration \"part.name\") (Declaration \"app..field\") (Declaration \"raw\")
             (Declaration \"libs.foo\") (Declaration \"libs.private\") (Declaration \"other.foo\")
             (Declaration \"core.cond\") (Declaration \"core.hidden\") (Declaration \"core.missing\")
             (Declaration \"project.cond\") (Declaration \"library.cond\") (Declaration \"project.only\")]
            [(Alias \"app.alias\" \"libs.foo\") (Alias \"app.chain\" \"app.alias\")]
            [(ExportModule \"app\" true [] []) (ExportModule \"libs\" true [(Name \"foo\")] [])])
          (Routing
            [(ModuleImports \"app\" [(ImportAlias \"l\" \"libs\") (ImportAlias \"dup\" \"libs\") (ImportAlias \"dup\" \"other\")]
              (Imports [(Reexport \"libs\" (Refer true [] [] []))])
              (Refer true [] [(Name \"hidden\")] [(Rename \"cond\" \"choose\")]))
             (ModuleImports \"amb\" [] (Imports [(Reexport \"libs\" (Refer true [] [] [])) (Reexport \"other\" (Refer true [] [] []))]) (Refer true [] [] []))
             (ModuleImports \"core\" [] (Imports []) (Refer true [] [] []))]
            [(Provider \"cond\" \"library\" false) (Provider \"cond\" \"project\" true)
             (Provider \"missing\" \"project\" true) (Provider \"only\" \"project\" true)]
            [(Name \"app.foo\") (Name \"app.own\")] [(Name \"stdlib.user\")] \"core\")"
                           0)
            (Ok [forms] forms)
            (Err [_] (panic "read")))
        root
          (match (forms/parse-7 (mut store) (elem input 0))
            (Ok [root] root)
            (Err [_] (panic "namespace parse")))
        routing-root
          (match (forms/parse-13 (mut store) (elem input 1))
            (Ok [root] root)
            (Err [_] (panic "routing parse")))]
    (defer (close! (mut scratch)))
    (defer (forms/store-free! (mut store)))
    (let [(mut view)
            (match (namespace/compile a (mut store) root)
              (Ok [view] view)
              (Err [_] (panic "view")))
          (mut world)
            (match (facts/compile a (mut store) routing-root)
              (Ok [world] world)
              (Err [_] (panic "world")))]
      (defer (namespace/release! (mut view)))
      (defer (facts/release! (mut world)))
      (expect a (mut view) (mut world) "own" (Some "app") true "app.own" "")
      (expect a (mut view) (mut world) "foo" (Some "app") true "" "")
      (expect a (mut view) (mut world) "foo" (Some "app") false "libs.foo" "")
      (expect a (mut view) (mut world) "alias" (Some "app") true "libs.foo" "")
      (expect a (mut view) (mut world) "chain" (Some "app") true "" "")
      (expect a
              (mut view)
              (mut world)
              "part.name"
              (Some "app")
              true
              "app.part.name"
              "")
      (expect a (mut view) (mut world) "part.name" (None) true "part.name" "")
      (expect a
              (mut view)
              (mut world)
              ".field"
              (Some "app")
              true
              "app..field"
              "")
      (expect a
              (mut view)
              (mut world)
              "libs.private"
              (Some "app")
              true
              "libs.private"
              "")
      (expect a (mut view) (mut world) "l/private" (Some "app") false "" "")
      (expect a
              (mut view)
              (mut world)
              "l/foo"
              (Some "app")
              true
              "libs.foo"
              "libs")
      (expect a
              (mut view)
              (mut world)
              "dup/foo"
              (Some "app")
              true
              "libs.foo"
              "libs")
      (expect a (mut view) (mut world) "libs/foo" (Some "app") true "" "")
      (expect a
              (mut view)
              (mut world)
              "libs/foo"
              (Some "app")
              false
              "libs.foo"
              "")
      (expect a
              (mut view)
              (mut world)
              "other/foo"
              (Some "app")
              false
              "other.foo"
              "")
      (expect a
              (mut view)
              (mut world)
              "app/private"
              (Some "app")
              false
              "app.private"
              "")
      (expect a (mut view) (mut world) "app/private" (Some "app") true "" "")
      (expect a (mut view) (mut world) "l/foo" (None) true "" "")
      (expect a
              (mut view)
              (mut world)
              "choose"
              (Some "app")
              true
              "project.cond"
              "")
      (expect a (mut view) (mut world) "cond" (Some "app") true "" "")
      (expect a (mut view) (mut world) "hidden" (Some "app") true "" "")
      (expect a
              (mut view)
              (mut world)
              "cond"
              (Some "stdlib.user")
              true
              "library.cond"
              "")
      (expect a (mut view) (mut world) "hidden" (None) true "core.hidden" "")
      (expect a (mut view) (mut world) "missing" (None) true "" "")
      (expect a (mut view) (mut world) "only" (None) true "project.only" "")
      (expect a (mut view) (mut world) "only" (Some "core") true "" "")
      (expect a (mut view) (mut world) "raw" (None) true "raw" "")
      (expect a (mut view) (mut world) "raw" (Some "") true "" "")
      (expect a
              (mut view)
              (mut world)
              "foo"
              (Some "amb")
              true
              "libs.foo"
              "libs")
      (match (routing/resolve a (mut view) (mut world) "foo" (Some "amb") false)
        (Ok [_] (panic "ambiguity fell through"))
        (Err [e]
             (match e
               (protocol/HandlerError [_ error]
                                      (match error
                                        (routing/Use [error]
                                                     (match error
                                                       (namespace/Ambiguous [_ _])
                                                       (_ (panic "wrong use error"))))
                                        (_ (panic "wrong handler error"))))
               (_ (panic "wrong protocol error"))))))))

(defn failure-check [(a (dyn Allocator)) (duplicate? bool)] (-> void)
  (let [(mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        (mut store) (forms/store-new a)
        input
          (match (read-all sa
                           "(Routing [(ModuleImports \"first\" [(ImportAlias \"l\" \"lib\")] (Imports [(Reexport \"lib\" (Refer true [] [] []))]) (Refer true [] [] [])) (ModuleImports \"second\" [(ImportAlias \"l\" \"lib\")] (Imports [(Reexport \"lib\" (Refer true [] [] []))]) (Refer true [] [] []))] [] [] [] \"core\")"
                           0)
            (Ok [forms] forms)
            (Err [_] (panic "failure read")))
        root
          (match (forms/parse-13 (mut store) (elem input 0))
            (Ok [id] id)
            (Err [_] (panic "failure parse")))]
    (defer (close! (mut scratch)))
    (defer (forms/store-free! (mut store)))
    (if duplicate?
        (set! (.f0 (elem (mut (.rows11 store)) 1)) "first")
        (set! (.f3 (elem (mut (.rows11 store)) 1)) (forms/N2Id :index 999)))
    (match (facts/compile a (mut store) root)
      (Ok [world]
          (let [(mut owned) world] (facts/release! (mut owned)))
          (panic "invalid world accepted"))
      (Err [error]
           (if duplicate?
               (match error
                 (namespace/Index [_])
                 (_ (panic "wrong duplicate error")))
               (match error
                 (namespace/CoreRefer [module _]
                                      (unless (= module "second")
                                        (panic "wrong module witness")))
                 (_ (panic "wrong core error"))))))))

(defn main [] (-> i64)
  (let [debug (DebugAllocator::new (malloc-allocator))]
    (check (DebugAllocator::view debug))
    (failure-check (DebugAllocator::view debug) true)
    (failure-check (DebugAllocator::view debug) false)
    (unless (= (DebugAllocator::deinit! debug) 0) (panic "routing leak")))
  (println "routing: own/slash/dotted/bare precedence, shadowing, aliases, ambiguity, core refers, provider ownership and lifetimes passed")
  0)
