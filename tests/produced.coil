(module rewrite.testproduced)
(import "rewrite.produced" :as produced)
(import "rewrite.code" :as code)
(import "rewrite.codeforms" :as forms)
(import "rewrite.stage" :as stage)
(import "rewrite.syntaxreader" :as projection)
(import "rewrite.source" :as source)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.scratch" :use [ScratchArena])

(defn read-root [(syntax (mut code/Syntax)) (source i64) (text (slice u8))]
  (-> forms/N0Id)
  (let [roots
          (match (code/read! (mut syntax) source "produced.coil" text)
            (Ok [roots] roots)
            (Err [_] (panic "read")))]
    (match (forms/sequence-item-0 (field syntax store) roots 0)
      (Some [id] id)
      (None [] (panic "root")))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut input) (code/create a)
        (mut output) (code/create a)
        (mut expected-syntax) (code/create a)
        (mut identities) (ArrayList::new [i64] a)
        (mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        root
          (read-root (mut input)
                     1
                     "(do (do) 1 (do 2 (do (quote (do hidden)) [do 3] (body (do local)))) (do))")
        name (forms/store-text! (mut (.store input)) "own.module")]
    (defer (code/release! (mut output)))
    (defer (code/release! (mut expected-syntax)))
    (defer (free! (mut identities)))
    (defer (close! (mut scratch)))
    (for [i 0 (len (.contexts input))]
      (let [context (elem (field (mut input) contexts) i)]
        (set! (.f0 context) 17)
        (set! (.f1 context) name)
        (set! (.f2 context) 23)
        (set! (.f3 context) 5)
        (set! (.f4 context) 9)))
    (let [(mut original)
            (match (projection/project sa (mut input) root)
              (Ok [form] form)
              (Err [_] (panic "original")))
          leaves (forms/leaves-produced-forms sa (mut original))]
      (for leaf leaves (push! (mut identities) (.node-id leaf))))
    (match (produced/normalize! a (mut input) (mut input) root (None))
      (Err [e] (match e (produced/AliasedStores []) (_ (panic "alias error"))))
      (Ok [_] (panic "alias accepted")))
    (let [(mut entries)
            (match (produced/normalize! a
                                        (mut output)
                                        (mut input)
                                        root
                                        (Some name))
              (Ok [entries] entries)
              (Err [_] (panic "normalize")))
          expected
            (match (code/read! (mut expected-syntax)
                               0
                               "expected.coil"
                               "1 2 (quote (do hidden)) [do 3] (body (do local))")
              (Ok [forms] forms)
              (Err [_] (panic "expected")))]
      (defer (free! (mut entries)))
      (unless (= (len entries) 5) (panic "flatten arity"))
      (code/release! (mut input))
      (for [i 0 5]
        (let [entry (get entries i)
              (mut form)
                (match (projection/project sa (mut output) (.form entry))
                  (Ok [form] form)
                  (Err [_] (panic "output")))
              context (get (.contexts output) (.index (.form entry)))]
          (let [want
                  (match (forms/sequence-item-0 (field (mut expected-syntax)
                                                       store)
                                                expected
                                                i)
                    (Some [id] id)
                    (None [] (panic "expected root")))]
            (match (code/equal? a
                                (mut output)
                                (.form entry)
                                (mut expected-syntax)
                                want)
              (Ok [same] (unless same (panic "boundary or order")))
              (Err [_] (panic "equality"))))
          (match (.module entry)
            (Some [name]
                  (unless (= name "own.module") (panic "module lifetime")))
            (None [] (panic "module lost")))
          (unless (and (= (.f0 context) 17)
                       (= (.f1 context) "own.module")
                       (= (.f2 context) 23)
                       (= (.f3 context) 5)
                       (= (.f4 context) 9)
                       (= (.f5 context) (get identities i)))
            (panic "context changed")))))
    (let [(mut source) (code/create a)
          empty (read-root (mut source) 2 "(do (do) (do (do)))")
          one (read-root (mut source) 3 "(do 42)")]
      (defer (code/release! (mut source)))
      (for [i 0 3]
        (let [(mut entries)
                (match (produced/normalize! a
                                            (mut output)
                                            (mut source)
                                            (if (= i 0) empty one)
                                            (if (= i 2) (Some "") (None)))
                  (Ok [entries] entries)
                  (Err [_] (panic "empty/singleton")))]
          (defer (free! (mut entries)))
          (unless (= (len entries) (if (= i 0) 0 1)) (panic "empty count"))
          (when (> i 0)
            (match (.module (get entries 0))
              (None [] (unless (= i 1) (panic "lost empty module")))
              (Some [name]
                    (unless (and (= i 2) (= name ""))
                      (panic "anonymous module"))))))))
    ; A later document conflict returns no partial list. Earlier roots and source
    ; remain usable; unreachable target rows are allowed by the import contract.
    (let [(mut source) (code/create a)
          first (read-root (mut source) 4 "(do 10 20)")
          conflict (read-root (mut output) 4 "different")]
      (defer (code/release! (mut source)))
      (match (forms/store-source! (mut (.store source)) 5 "ten.coil" "10")
        (Ok [_])
        (Err [_] (panic "extra document")))
      (for [i 0 (len (.rows0 (.store source)))]
        (match (get (.rows0 (.store source)) i)
          (forms/N0V0 [value]
                      (when (= value 10)
                        (set! (mut (.origins0 (.store source)))
                              i
                              (source/Origin
                                :source 5
                                :lo 0
                                :hi 2))))
          (_)))
      (match (produced/normalize! a (mut output) (mut source) first (None))
        (Err [e]
             (match e
               (produced/Import [e]
                                (match e
                                  (code/DocumentError [e]
                                                      (match e
                                                        (source/SourceConflict [id]
                                                                               (unless (= id
                                                                                          4)
                                                                                 (panic "conflict id")))
                                                        (_ (panic "document error"))))
                                  (_ (panic "import error"))))
               (_ (panic "normalization error"))))
        (Ok [_] (panic "conflict accepted")))
      (match (get (.documents (.source-data (.store output))) 5)
        (Some [doc] (unless (= (.text doc) "10") (panic "first leaf document")))
        (None [] (panic "failure was not after first leaf"))))
    (println "produced forms: recursive bundles, boundaries, order, empty/singleton tags, metadata, ownership and conflicts passed")
    0))
