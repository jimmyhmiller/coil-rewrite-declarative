(module rewrite.tests.types)
(import "rewrite.types" :as types)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.arraylist" :use *)

(defn intern [(store (mut types/Types)) (argument i64) (result i64)] (-> i64)
  (match (types/function (mut store) argument result)
    (Ok [id] id)
    (Err [_] 0)))

(defn main [] (-> i64)
  (let [(mut store) (types/create (malloc-allocator))
        int-to-bool (intern (mut store) 1 2)
        bool-to-int (intern (mut store) 2 1)
        higher (intern (mut store) int-to-bool bool-to-int)
        (mut failed) 0
        (mut chain) higher]
    (unless (and (!= int-to-bool bool-to-int)
                 (= int-to-bool (intern (mut store) 1 2))
                 (= higher (intern (mut store) int-to-bool bool-to-int)))
      (set! failed (+ failed 1)))
    (for [i 0 10000]
      (let [next (intern (mut store) chain 3)]
        (unless (and (> next 0) (= next (intern (mut store) chain 3)))
          (set! failed (+ failed 1)))
        (match (types/as-function (mut store) next)
          (Some [f]
                (unless (and (= (.argument f) chain) (= (.result f) 3))
                  (set! failed (+ failed 1))))
          (None [] (set! failed (+ failed 1))))
        (set! chain next)))
    (unless (= (len (.functions store)) 10003) (set! failed (+ failed 1)))
    (for invalid [0 (- 0 1) 9999999999]
      (match (types/function (mut store) invalid 1)
        (Err [e]
             (unless (match e (types/InvalidType [id] (= id invalid)) (_ false))
               (set! failed (+ failed 1))))
        (Ok [_] (set! failed (+ failed 1))))
      (match (types/function (mut store) 1 invalid)
        (Err [_] 0)
        (Ok [_] (set! failed (+ failed 1)))))
    (for id [1 2 3 0 9999999999]
      (match (types/as-function (mut store) id)
        (None [] 0)
        (Some [_] (set! failed (+ failed 1)))))
    (unless (= int-to-bool (intern (mut store) 1 2)) (set! failed (+ failed 1)))
    (let [(mut args) (ArrayList::new [i64] (malloc-allocator))
          empty
            (match (types/signature (mut store) (slice args) 1)
              (Ok [id] id)
              (Err [_] (panic "empty signature rejected")))]
      (defer (free! (mut args)))
      (push! (mut args) 1)
      (unless (= int-to-bool
                 (match (types/signature (mut store) (slice args) 2)
                   (Ok [id] id)
                   (Err [_] 0)))
        (set! failed (+ failed 1)))
      (push! (mut args) 2)
      (let [pair
              (match (types/signature (mut store) (slice args) 1)
                (Ok [id] id)
                (Err [_] (panic "pair signature rejected")))]
        (set! (mut args) 0 2)
        (set! (mut args) 1 1)
        (let [reversed
                (match (types/signature (mut store) (slice args) 1)
                  (Ok [id] id)
                  (Err [_] 0))]
          (unless (and (!= pair reversed) (!= pair empty) (> reversed 0))
            (set! failed (+ failed 1))))
        (clear! (mut args))
        (for [i 0 40] (push! (mut args) (if (= (% i 2) 0) pair empty)))
        (let [wide
                (match (types/signature (mut store) (slice args) pair)
                  (Ok [id] id)
                  (Err [_] 0))]
          (unless (> wide 0) (set! failed (+ failed 1)))
          (match (types/as-signature (mut store) wide)
            (Some [signature]
                  (unless (and (= (len (.arguments signature)) 40)
                               (= (.result signature) pair))
                    (set! failed (+ failed 1))))
            (None [] (set! failed (+ failed 1)))))
        (clear! (mut args))
        (push! (mut args) 1)
        (push! (mut args) 2)
        (unless (= pair
                   (match (types/signature (mut store) (slice args) 1)
                     (Ok [id] id)
                     (Err [_] 0)))
          (set! failed (+ failed 1)))
        (match (types/as-signature (mut store) pair)
          (Some [signature]
                (unless (and (= (len (.arguments signature)) 2)
                             (= (get (.arguments signature) 0) 1)
                             (= (get (.arguments signature) 1) 2))
                  (set! failed (+ failed 1))))
          (None [] (set! failed (+ failed 1))))
        (for id [empty pair]
          (match (types/as-function (mut store) id)
            (None [])
            (Some [_] (set! failed (+ failed 1)))))
        (let [before (len (.functions store))]
          (set! (mut args) 1 0)
          (match (types/signature (mut store) (slice args) 1)
            (Err [error]
                 (unless (match error
                           (types/InvalidType [id] (= id 0))
                           (_ false))
                   (set! failed (+ failed 1))))
            (Ok [_] (set! failed (+ failed 1))))
          (unless (= before (len (.functions store)))
            (set! failed (+ failed 1))))))
    (types/release! (mut store))
    (println "type-store failures: {}" failed)
    failed))
