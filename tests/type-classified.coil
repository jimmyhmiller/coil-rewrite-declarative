(module rewrite.testtypeclassified)
(import "rewrite.typesyntax" :as forms)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.debug-allocator" :use [DebugAllocator])
(import "coil.primitive" :as primitive)

(defn context! [(form (ptr Sexp)) (scope i64) (module (ptr HygModule))]
  (-> void)
  (when (sexp-sym? form) (set! (.hyg form) scope) (set! (.hmod form) module))
  (when (or (sexp-list? form) (sexp-vec? form))
    (for [i 0 (sexp-count form)] (context! (sexp-nth form i) scope module))))

(defn elaborate [(a (dyn Allocator))
                 (target (ptr forms/Store))
                 (text (slice u8))
                 (scope i64)
                 (bits i64)
                 (fresh i64)] (-> forms/N15Id)
  (let [(mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        (mut input) (forms/store-new a)
        (mut structural) (forms/store-new a)
        roots (match (read-all sa text 1) (Ok [v] v) (_ (panic "reader")))
        (mut module) (HygModule :name "definition")]
    (defer (close! (mut scratch)))
    (defer (forms/store-free! (mut input)))
    (defer (forms/store-free! (mut structural)))
    (context! (elem roots 0)
              scope
              (primitive/cast (ptr HygModule) (mut module)))
    (match (forms/store-source! (mut input) 1 "type.coil" text)
      (Ok [_])
      (_ (panic "source registration")))
    (let [root
            (match (forms/surface-3 (mut input) (elem roots 0))
              (Ok [v] v)
              (_ (panic "written type")))
          (mut state)
            (forms/transform-state-new a (mut input) (mut structural) bits)
          before (next-node-id)
          intermediate
            (match (forms/transform-3-9 (mut state) root)
              (Ok [v] v)
              (_ (panic "elaboration")))
          (mut classified)
            (forms/transform-state-new a (mut structural) target bits)
          result
            (match (forms/transform-9-15 (mut classified) intermediate)
              (Ok [v] v)
              (_ (panic "classification")))]
      (defer (forms/transform-state-free! (mut classified)))
      (defer (forms/transform-state-free! (mut state)))
      (unless (= (next-node-id) (+ before (+ fresh 1)))
        (panic "incorrect lexical allocation count"))
      (for value (.strings (.source-data input))
        (for [i 0 (len value)] (set! value i 88)))
      (for value (.strings (.source-data structural))
        (for [i 0 (len value)] (set! value i 88)))
      result)))

(defn expect [(a (dyn Allocator))
              (source (slice u8))
              (expected (slice u8))
              (scope i64)
              (bits i64)]
  (-> void)
  (let [(mut target) (forms/store-new a)
        (mut reference) (forms/store-new a)
        (mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        actual (elaborate a (mut target) source scope bits 0)
        roots
          (match (read-all sa expected 2)
            (Ok [v] v)
            (_ (panic "expected source")))
        wanted
          (match (forms/parse-15 (mut reference) (elem roots 0))
            (Ok [v] v)
            (_ (panic "expected type")))]
    (defer (close! (mut scratch)))
    (defer (forms/store-free! (mut target)))
    (defer (forms/store-free! (mut reference)))
    (match (forms/equal-15 a (mut target) actual (mut reference) wanted)
      (Ok [same]
          (unless same
            (println "wrong elaboration: {}" source)
            (panic "type shape")))
      (_ (panic "type comparison")))))

(defn main [] (-> i64)
  (let [debug (DebugAllocator::new (malloc-allocator))
        a (DebugAllocator::view debug)]
    (expect a "i32" "(Integer 32 true)" -7 32)
    (expect a "u008" "(Integer 8 false)" -7 32)
    (expect a "usize" "(Integer 32 false)" -7 32)
    (expect a "isize" "(Integer 32 true)" -7 32)
    (expect a "f32" "(Float 32)" -7 32)
    (expect a "f64" "(Float 64)" -7 32)
    (expect a "bool" "(Boolean)" -7 32)
    (expect a "void" "(Void)" -7 32)
    (expect a "never" "(Never)" -7 32)
    (expect a "Code" "(Code)" -7 32)
    (expect a "CodeBuilder" "(CodeBuilder)" -7 32)
    (expect a "externref" "(ExternRef)" -7 32)
    (expect a "T..." "(Pack \"T...\")" -7 32)
    (expect a "(ptr)" "(Pointer (Integer 64 true))" -7 32)
    (expect a "(dyn Show)" "(Nominal \"Show-dyn\")" -7 32)
    (expect a "(struct Raw)" "(Nominal \"Raw\")" -7 32)
    (expect a
            "(array (slice u8) 3)"
            "(Array (Slice (Integer 8 false)) (Fixed 3))"
            -7
            32)
    (expect a "(mask 4)" "(Vector (Boolean) (Fixed 4))" -7 32)
    (expect a
            "(mut (ref i32))"
            "(Reference true (Reference false (Integer 32 true)))"
            -7
            32)
    (expect a "(const :unit)" "(Constant (Keyword \"unit\"))" -7 32)
    (expect a "42" "(Constant (Integer 42))" -7 32)
    (expect a "true" "(Constant (Boolean true))" -7 32)
    (expect a "T" "(Nominal \"$scope7@definition$T\")" 7 64)
    (expect a "i0" "(Nominal \"$scope7@definition$i0\")" 7 64)
    (expect a
            "(Box T (const N))"
            "(Application (LexicalName \"$scope7@definition$Box\") [(Nominal \"$scope7@definition$T\") (Constant (Reference (LexicalName \"$scope7@definition$N\")))])"
            7
            64)
    (expect a
            "(array u8 N)"
            "(Array (Integer 8 false) (Parameter (LexicalName \"$scope7@definition$N\")))"
            7
            64)
    (expect a
            "(vec f32 W)"
            "(Vector (Float 32) (Parameter (LexicalName \"$scope7@definition$W\")))"
            7
            64)
    (expect a
            "(fnptr cc [usize T] (ptr))"
            "(Function (Named (LexicalName \"$scope7@definition$cc\")) [(Integer 64 false) (Nominal \"$scope7@definition$T\")] (Pointer (Integer 64 true)))"
            7
            64)
    (expect a
            "(fnptr (cc/C) [] never)"
            "(Function (Value (LexicalName \"$scope7@definition$cc/C\")) [] (Never))"
            7
            64)
    (expect a "T" "(Nominal \"T\")" 0 64)
    (let [(mut target) (forms/store-new a)
          root
            (elaborate a
                       (mut target)
                       "(Pair T T (const N) (array u8 W))"
                       -1
                       64
                       5)]
      (defer (forms/store-free! (mut target)))
      (unless (and (= (len (.rows10 target)) 3)
                   (= (len (.rows15 target)) 6))
        (panic "negative type shape"))
      (match (get (.rows15 target) 0)
        (forms/N15V8 [first]
                     (match (get (.rows15 target) 1)
                       (forms/N15V8 [second]
                                    (when (= first second)
                                      (panic "reused negative type identity")))
                       (_ (panic "second nominal"))))
        (_ (panic "first nominal"))))
    (unless (= (DebugAllocator::deinit! debug) 0)
      (panic "classified type leak")))
  (println "classified types: primitive/pack precedence, target widths, full traversal, selective lexical freshness, dynamic names and owned output passed")
  0)
