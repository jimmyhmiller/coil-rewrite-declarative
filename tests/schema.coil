(module rewrite.tests.schema)
(import "rewrite.schema" :as schema)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.arraylist" :use *)

(defn main [] (-> i64)
  (let [arena (arena-new 1048576)
        a (arena-view arena)
        (mut failures) 0]
    (match (schema/parse a
                         "(node Add (left Expr) (right Expr)) (node Expr (value Int))"
                         7)
      (Ok [s] (unless (= (len (.nodes s)) 2) (set! failures (+ failures 1))))
      (Err [_] (set! failures (+ failures 1))))
    (for text ["(node X (a Missing))"
               "(node X) (node X)"
               "(node X (a Int) (a Bool))"
               "(node Int)"
               "(wrong X)"
               "(node X (a))"
               "(node X (a Int :key :key))"
               "(node X (a Int :unknown))"
               "(node X (a Int key))"
               "(node X (a (many Int)))"
               "(node X (a (many X extra)))"
               "(node X (a (many (many X))))"
               "(sum X (Case (a Int :key)))"
               "(node X"]
      (match (schema/parse a text 7)
        (Ok [_]
            (do
              (println "accepted invalid schema: {}" text)
              (set! failures (+ failures 1))))
        (Err [d] (unless (= (.source d) 7) (set! failures (+ failures 1))))))
    (match (schema/parse a "(node X (a Missing))" 9)
      (Ok [_] (set! failures (+ failures 1)))
      (Err [d]
           (unless (and (= (.lo d) 11) (= (.hi d) 18))
             (set! failures (+ failures 1)))))
    (match (schema/parse a
                         "(node Entry (name Text :key) (children (many Expr))) (sum Expr (Leaf (value Int)) (Branch (child Expr)))"
                         17)
      (Err [_] (set! failures (+ failures 1)))
      (Ok [s]
          (let [record (get (.nodes s) 0)
                sum (get (.nodes s) 1)
                fields (.fields (get (.variants record) 0))
                key (get fields 0)
                repeated (get fields 1)]
            (unless (and (= (len (.nodes s)) 2)
                         (= (.name record) "Entry")
                         (not (.sum? record))
                         (= (.name sum) "Expr")
                         (.sum? sum)
                         (= (len (.variants sum)) 2)
                         (.key? key)
                         (= (.type-name key) "Text")
                         (not (.many? key))
                         (.many? repeated)
                         (= (.type-name repeated) "Expr")
                         (not (.key? repeated)))
              (set! failures (+ failures 1))))))
    (arena-release! arena)
    (println "schema failures: {}" failures)
    failures))
