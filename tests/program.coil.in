(module fixture.main)
(import "rewrite.generated" :use *)
(import "rewrite.native" :as native)
(import "rewrite.scope" :use *)
(import "rewrite.types" :as types)
(import "coil.hashmap" :use [HashMap])
(import "coil.str" :as keystr :use [StrBuf])
(import "native.cir" :as cir)
(import "native.cir-ops" :as cop)
(import "coil.scratch" :use [ScratchArena])
(import "coil.alloc" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "declarative.rt.jit" :as jit)
(import "declarative.rt.image" :as image)
(defn check [(text (slice u8)) (expected i64)] (-> bool)
  (let [(mut arena) (zeroed ScratchArena) initialized (init (mut arena) (malloc-allocator))
        a (allocator (mut arena)) (mut store) (store-new a) (mut ids) (ArrayList::new [N1Id] a)
        ok (block :done
          (match (read-all a text 0)
            (Err [_] (break :done false))
            (Ok [forms] (for [i 0 (len (load forms))]
              (match (parse-1 (mut store) (elem forms i))
                (Err [_] (break :done false)) (Ok [id] (push! (mut ids) id))))))
          (match (compile-program a (mut store) (mut ids))
                (Err [e] (match e
                  (DuplicateFunction [_] (= expected 1))
                  (InvalidBody [_ _] (= expected 2))
                  (WrongReturn [_ _] (= expected 3)) (_ false)))
                (Ok [im]
                  (let [loaded (native/load-image a im)
                        run (primitive/cast (fnptr (cc/C) [i64] i64) (jit/address-of loaded 0))
                        value (run 41)]
                    (jit/unload! loaded)
                    (= value expected)))))]
    (store-free! (mut store)) (free! (mut ids)) (close! (mut arena)) ok))
; A large global environment must not become a large per-function CIR prelude.
(defn sparse-symbols [(text (slice u8)) (parameter (slice u8)) (expected i64)] (-> bool)
  (let [(mut arena) (zeroed ScratchArena) initialized (init (mut arena) (malloc-allocator))
        a (allocator (mut arena)) (mut store) (store-new a)
        (mut type-store) (types/create a)
        signature (match (types/function (mut type-store) 1 1) (Ok [id] id) (Err [_] (panic "signature")))
        (mut type-index) (HashMap::new [(slice u8) i64] a (keystr/keyops))
        (mut value-index) (HashMap::new [(slice u8) ValueBinding] a (keystr/keyops))
        (mut function) (cir/Func::new)]
    (for [i 0 2000]
      (let [(mut name) (StrBuf::new a)]
        (push-str! (mut name) "f") (push-i64! (mut name) i)
        (set! (mut type-index) (str (load name)) signature)
        (set! (mut value-index) (str (load name)) (GlobalSymbol (cast u32 i)))))
    (let [body (match (read-all a text 0)
                (Err [_] (panic "source"))
                (Ok [forms] (match (parse-0 (mut store) (elem forms 0))
                  (Err [_] (panic "expression")) (Ok [id] id))))
          declaration (ProgramFunction :name "test" :parameter parameter :body body)
          (mut type-scope) (scope-global (mut type-index))
          (mut value-scope) (scope-global (mut value-index))
          checked (match (program-check (mut type-store) (mut store) declaration (mut type-scope))
                    (Typed [ty] (= ty 1)) (_ false))
          (mut count) 0 (mut correct) checked]
      (when checked
        (cir/set-block! (mut function) (cir/new-block! (mut function)))
        (cir/ret1! (mut function) (program-lower (mut store) declaration (mut function) (mut value-scope)))
        (cir/finish! (mut function))
        (for [i 0 (len (.values function))]
          (let [value (elem (mut (.values function)) i)]
            (when (= (cast i64 (.op value)) cop/OP-SYM)
              (set! count (+ count 1))
              (unless (= (.imm value) 1999) (set! correct false))))))
      (cir/func-free! (mut function)) (store-free! (mut store))
      (free! (mut type-index)) (free! (mut value-index)) (types/release! (mut type-store))
      (close! (mut arena))
      (and correct (= count expected)))))
(defn main [] (-> i64)
  (if (and
    (sparse-symbols "(Add (Variable \"x\") (Integer 1))" "x" 0)
    (sparse-symbols "(Add (Variable \"f1999\") (Integer 1))" "f1999" 0)
    (sparse-symbols "(Choose (Boolean true) (Call (Variable \"f1999\") (Variable \"x\")) (Call (Variable \"f1999\") (Variable \"x\")))" "x" 2)
    (check "(Function \"main\" \"n\" (Call (Variable \"inc\") (Variable \"n\"))) (Function \"inc\" \"x\" (Add (Variable \"x\") (Integer 1)))" 42)
    (check "(Function \"main\" \"n\" (Add (Let \"inc\" (Integer 1) (Variable \"inc\")) (Call (Variable \"inc\") (Integer 40)))) (Function \"inc\" \"x\" (Add (Variable \"x\") (Integer 1)))" 42)
    (check "(Function \"main\" \"n\" (Let \"inc\" (Variable \"inc\") (Call (Variable \"inc\") (Variable \"n\")))) (Function \"inc\" \"x\" (Add (Variable \"x\") (Integer 1)))" 42)
    (check "(Function \"main\" \"n\" (Integer 42)) (Function \"main\" \"x\" (Integer 1))" 1)
    (check "(Function \"main\" \"n\" (Integer 42)) (Function \"bad\" \"x\" (Variable \"missing\"))" 2)
    (check "(Function \"main\" \"n\" (Boolean true))" 3)
    (check "(Function \"main\" \"main\" (Add (Variable \"main\") (Integer 1)))" 42)) 0 1))
