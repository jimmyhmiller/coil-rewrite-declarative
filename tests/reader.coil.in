(module fixture.main)
(import "rewrite.generated" :use *)
(import "rewrite.types" :as types)
(import "coil.reader" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(defn check [(text (slice u8)) (expected i64)] (-> bool)
  (let [arena (arena-new 1048576) a (arena-view arena)
        (mut type-store) (types/create a)
        (mut store) (store-new a)
        ok (match (read-all a text 27)
          (Err [_] false)
          (Ok [forms]
            (match (parse-0 (mut store) (elem forms 0))
              (Err [d] (and (= expected 0) (= (.source d) 27) (< (.lo d) (.hi d))))
              (Ok [id]
                (and (= (len (.rows0 store)) (len (.origins0 store)))
                     (= (.source (elem (mut (.origins0 store)) (.index id))) 27)
                     (match (judge-0 (mut type-store) (mut (.rows0 store)) id)
                       (Typed [ty]
                         (if (< expected 6) (= ty expected)
                           (match (types/as-function (mut type-store) ty)
                             (None [] false)
                             (Some [f]
                               (and (= (.argument f) 1)
                                 (if (= expected 6) (= (.result f) 1)
                                   (match (types/as-function (mut type-store) (.result f))
                                     (None [] false)
                                     (Some [inner] (and (= (.argument inner) 2) (= (.result inner) 1))))))))))
                       (UnboundName [_ _] (= expected 4))
                       (Mismatch [_ _ _ _ _ _] (= expected 5))
                       (ExpectedFunction [_ _] (= expected 8))
                       (FunctionArity [_ expected-count actual-count] (and (= expected 11) (!= expected-count actual-count)))
                       (Classified [ty category] (and (= expected 9) (= ty 1) (= category "address")))
                       (CategoryMismatch [node category lo hi]
                         (and (= expected 10) (>= node 0) (> hi lo) (or (= category "address") (= category "value"))))
                       (_ false)))))))]
    (store-free! (mut store))
    (types/release! (mut type-store))
    (arena-release! arena)
    ok))
(defn main [] (-> i64)
  (if (and
    (check "(UseNullary (Nullary))" 1)
    (check "(UseBinary (Binary))" 2)
    (check "(UseNullary (Binary))" 11)
    (check "(UseBinary (Nullary))" 11)
    (check "(Call (Nullary) (Integer 1))" 11)
    (check "(SameBinary (BuildBinary (Integer 1) (Integer 2)))" 2)
    (check "(SameBinary (BuildBinary (Integer 1) (Boolean true)))" 5)
    (check "(UseBinary (BuildBinary (Integer 1) (Boolean true)))" 5)
    (check "(UseNested (NestedSignature))" 2)
    (check "(Place (Integer 7))" 9)
    (check "(Read (Place (Integer 7)))" 1)
    (check "(Read (Integer 7))" 10)
    (check "(Let \"x\" (Place (Integer 7)) (Variable \"x\"))" 10)
    (check "(Add (Place (Integer 7)) (Integer 3))" 10)
    (check "(Let \"x\" (Integer 42) (Add (Variable \"x\") (Integer 1)))" 1)
    (check "(Let \"x\" (Integer 42) (Let \"x\" (Boolean true) (Variable \"x\")))" 2)
    (check "(Variable \"missing\")" 4)
    (check "(Choose (Boolean false) (Integer 1) (Boolean true))" 5)
    (check "(LambdaInt \"x\" (Variable \"x\"))" 6)
    (check "(Let \"id\" (LambdaInt \"x\" (Variable \"x\")) (Variable \"id\"))" 6)
    (check "(LambdaInt \"x\" (LambdaBool \"y\" (Variable \"x\")))" 7)
    (check "(Call (LambdaInt \"x\" (Variable \"x\")) (Integer 7))" 1)
    (check "(Call (LambdaInt \"x\" (Variable \"x\")) (Boolean true))" 5)
    (check "(Call (Integer 7) (Integer 2))" 8)
    (check "(Call (Call (LambdaInt \"x\" (LambdaBool \"y\" (Variable \"x\"))) (Integer 7)) (Boolean true))" 1)
    (check "(Endomorphism (LambdaInt \"x\" (Variable \"x\")))" 2)
    (check "(Endomorphism (LambdaInt \"x\" (Boolean true)))" 5)
    (check "(Higher (LambdaInt \"x\" (LambdaBool \"y\" (Variable \"x\"))))" 2)
    (check "(Higher (LambdaInt \"x\" (LambdaBool \"y\" (Variable \"y\"))))" 5)
    (check "(Higher (LambdaInt \"x\" (Variable \"x\")))" 8)
    (check "(Integer false)" 0)
    (check "(Integer 1 2)" 0)
    (check "(Unknown)" 0)
    (check "(Add (Integer 1) (Boolean 99))" 0)) 0 1))
