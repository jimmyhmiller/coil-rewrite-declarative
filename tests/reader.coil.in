(module fixture.main)
(import "rewrite.generated" :use *)
(import "rewrite.types" :as types)
(import "coil.reader" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(defn check [(text (slice u8)) (expected i64)] (-> bool)
  (let [arena (arena-new 1048576) a (arena-view arena)
        (mut type-store) (types/create a)
        (mut store) (store-new a)
        ok (match (read-all a text 27)
          (Err [_] false)
          (Ok [forms]
            (match (parse-0 (mut store) (elem forms 0))
              (Err [d] (and (= expected 0) (= (.source d) 27) (< (.lo d) (.hi d))))
              (Ok [id]
                (and (= (len (.rows0 store)) (len (.origins0 store)))
                     (= (.source (elem (mut (.origins0 store)) (.index id))) 27)
                     (match (judge-0 (mut type-store) (mut (.rows0 store)) id)
                       (Typed [ty]
                         (if (< expected 6) (= ty expected)
                           (match (types/as-function (mut type-store) ty)
                             (None [] false)
                             (Some [f]
                               (and (= (.argument f) 1)
                                 (if (= expected 6) (= (.result f) 1)
                                   (match (types/as-function (mut type-store) (.result f))
                                     (None [] false)
                                     (Some [inner] (and (= (.argument inner) 2) (= (.result inner) 1))))))))))
                       (UnboundName [_ _] (= expected 4))
                       (Mismatch [_ _ _ _ _ _] (= expected 5))
                       (_ false)))))))]
    (store-free! (mut store))
    (types/release! (mut type-store))
    (arena-release! arena)
    ok))
(defn main [] (-> i64)
  (if (and
    (check "(Let \"x\" (Integer 42) (Add (Variable \"x\") (Integer 1)))" 1)
    (check "(Let \"x\" (Integer 42) (Let \"x\" (Boolean true) (Variable \"x\")))" 2)
    (check "(Variable \"missing\")" 4)
    (check "(Choose (Boolean false) (Integer 1) (Boolean true))" 5)
    (check "(LambdaInt \"x\" (Variable \"x\"))" 6)
    (check "(Let \"id\" (LambdaInt \"x\" (Variable \"x\")) (Variable \"id\"))" 6)
    (check "(LambdaInt \"x\" (LambdaBool \"y\" (Variable \"x\")))" 7)
    (check "(Integer false)" 0)
    (check "(Integer 1 2)" 0)
    (check "(Unknown)" 0)
    (check "(Add (Integer 1) (Boolean 99))" 0)) 0 1))
