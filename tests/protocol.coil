(module rewrite.testprotocol)
(import "rewrite.stageprotocol" :as p)
(import "coil.result" :use *)
(import "coil.primitive" :use [fnptr-of])
(import "coil.cc" :as cc)

(defstruct State [(remaining i64) (installed i64) (resumed i64) (mode i64)])

(defn route :cc (cc/C) [(state (ptr State))] (-> (Result p/Event i64))
  (Ok (if (= (.remaining state) 0) (p/Event-Done) (p/Event-Request))))

(defn install :cc (cc/C) [(state (ptr State))] (-> (Result p/Event i64))
  (set! (.installed state) (+ (.installed state) 1))
  (cond (= (.mode state) 1) (Err 42)
        (= (.mode state) 2) (Ok (p/Event-Done))
        :else (Ok (p/Event-Ready))))

(defn invoke :cc (cc/C) [(state (ptr State))] (-> (Result p/Event i64))
  (Ok (p/Event-Returned)))

(defn resume :cc (cc/C) [(state (ptr State))] (-> (Result p/Event i64))
  (set! (.remaining state) (- (.remaining state) 1))
  (set! (.resumed state) (+ (.resumed state) 1))
  (Ok (p/Event-Again)))

(defn run-case [(count i64) (mode i64)] (-> bool)
  (let [(mut state)
          (State
            :remaining count
            :installed 0
            :resumed 0
            :mode mode)
        (mut handlers)
          (p/Handlers [State i64]
                      :step-route
                      (fnptr-of route)
                      :step-install
                      (fnptr-of install)
                      :step-invoke
                      (fnptr-of invoke)
                      :step-resume
                      (fnptr-of resume))]
    (match (p/run (mut state) (mut handlers))
      (Ok [_]
          (and (= mode 0)
               (<= count 64)
               (= (.remaining state) 0)
               (= (.installed state) count)
               (= (.resumed state) count)))
      (Err [error]
           (match error
             (p/Exhausted [budget limit]
                          (and (= mode 0)
                               (= count 65)
                               (= limit 64)
                               (= (p/budget-name budget) "requests")
                               (= (.installed state) 64)
                               (= (.resumed state) 64)
                               (= (.remaining state) 1)))
             (p/HandlerError [state-id error]
                             (and (= mode 1)
                                  (= error 42)
                                  (= (p/state-name state-id) "install")
                                  (= (.installed state) 1)
                                  (= (.resumed state) 0)))
             (p/UnexpectedEvent [state-id event]
                                (and (= mode 2)
                                     (= (p/state-name state-id) "install")
                                     (= (p/event-name event) "Done")
                                     (= (.installed state) 1)
                                     (= (.resumed state) 0)
                                     (match event
                                       (p/Event-Done [] true)
                                       (_ false)))))))))

(defn main [] (-> i64)
  (let [ok
          (and (run-case 0 0)
               (run-case 2 0)
               (run-case 64 0)
               (run-case 65 0)
               (run-case 1 1)
               (run-case 1 2)
               (run-case 2 0))]
    (println "protocol: completion, exact fuel boundary, effect failure, illegal event, fresh runs: {}"
             ok)
    (if ok 0 1)))
