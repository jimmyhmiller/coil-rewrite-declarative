(module fixture.main)
(import "rewrite.generated" :use *)
(import "rewrite.types" :as types)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "native.cir" :as cir)
(import "rewrite.native" :as native)
(import "declarative.rt.image" :as image)
(import "coil.scratch" :use [ScratchArena])
(import "declarative.rt.jit" :as jit)
(defn check [(source (slice u8)) (expected i64)] (-> bool)
  (let [(mut arena) (zeroed ScratchArena)
        initialized (init (mut arena) (malloc-allocator)) a (allocator (mut arena))
        (mut store) (store-new a) (mut types) (types/create a)
        ok (match (read-all a source 0)
          (Err [_] false)
          (Ok [forms]
            (match (surface-0 (mut store) (elem forms 0))
              (Err [_] false)
              (Ok [id]
                (match (judge-0 (mut types) (mut (.rows0 store)) id)
                  (Typed [ty]
                    (let [(mut function) (cir/Func::new)
                          fp (primitive/cast (ptr cir/Func) (mut function))
                          entry (cir/new-block! fp)]
                      (cir/set-block! fp entry)
                      (cir/ret1! fp (lower-0 (mut (.rows0 store)) id fp))
                      (cir/finish! fp)
                      (let [(mut im) (image/create a) symbol (image/symbol! (mut im) "entry")
                            loaded (do (native/emit! a (mut im) fp symbol) (native/load-image a im))
                            run (primitive/cast (fnptr (cc/C) [] i64) (jit/address-of loaded symbol))
                            result (= (run) expected)]
                        (jit/unload! loaded)
                        (cir/func-free! fp)
                        result)))
                  (_ (= expected (- 0 999))))))))]
    (store-free! (mut store)) (types/release! (mut types)) (close! (mut arena))
    ok))

(defn typed [(text (slice u8)) (expected i64)] (-> bool)
  (let [arena (arena-new 1048576) a (arena-view arena)
        (mut store) (store-new a) (mut types) (types/create a)
        ok (match (read-all a text 0)
          (Err [_] false)
          (Ok [forms] (match (surface-0 (mut store) (elem forms 0))
            (Err [_] false)
            (Ok [id] (match (judge-0 (mut types) (mut (.rows0 store)) id)
              (Typed [ty] (= ty expected)) (_ false))))))]
    (store-free! (mut store)) (types/release! (mut types)) (arena-release! arena) ok))

(defn main [] (-> i64)
  (let [ok (and
    (check "(parallel [x 1 y 2] (plus x y))" 3)
    (check "(outer x 5 (parallel [x 10 y x] (plus x y)))" 15)
    (check "(outer x 7 (plus (parallel [x 1 y 2] (plus x y)) x))" 10)
    (check "(parallel [x 1 y x] (plus x y))" (- 0 999))
    (check "(parallel [x 1 x 2] x)" 2)
    (check "(parallel [x true y 2] x)" 1)
    (typed "(parallel [x true y 2] x)" 2)
    (check "(parallel [x true y 2] (plus x y))" (- 0 999)))]
    (println "shared binding declarations: parallel payloads, shadowing, isolation, types: {}" ok)
    (if ok 0 1)))
