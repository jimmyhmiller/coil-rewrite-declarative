(module fixture.main)
(import "rewrite.generated" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(import "coil.str" :use *)
(import "coil.hashmap" :use [HashMap])

(defn main [] (-> i64)
  (let [arena (arena-new 16777216) a (arena-view arena)
        (mut rows) (ArrayList::new [N0Row] a)
        (mut ids) (ArrayList::new [N0Id] a)
        (mut failures) 0]
    (for [i 0 10000]
      (let [(mut name) (StrBuf::new a)]
        (push-i64! (mut name) i)
        (push! (mut ids) (append-0 (mut rows) (N0Row :f0 (str (load name)) :f1 i :f2 (= i 0))))))
    (match (index-0-0 a (mut rows) (mut ids))
      (Err [_] (set! failures (+ failures 1)))
      (Ok [map]
        (let [(mut names) map]
          (for [i 0 10000]
            (let [(mut name) (StrBuf::new a)]
              (push-i64! (mut name) i)
              (match (get names (str (load name)))
                (Some [id] (unless (= (.index id) i) (set! failures (+ failures 1))))
                (None [] (set! failures (+ failures 1))))))
          (match (get names "absent")
            (Some [_] (set! failures (+ failures 1))) (None []))
          (free! (mut names)))))
    (match (index-0-1 a (mut rows) (mut ids))
      (Err [_] (set! failures (+ failures 1)))
      (Ok [map] (let [(mut serials) map]
        (for [i 0 10000]
          (match (get serials i)
            (Some [id] (unless (= (.index id) i) (set! failures (+ failures 1))))
            (None [] (set! failures (+ failures 1)))))
        (free! (mut serials)))))
    ; Duplicate provenance uses row IDs, not positions in the selected sequence.
    (let [(mut subset) (ArrayList::new [N0Id] a)]
      (push! (mut subset) (N0Id :index 8))
      (push! (mut subset) (N0Id :index 4))
      (match (index-0-2 a (mut rows) (mut subset))
        (Err [e] (match e
          (DuplicateKey [node field first second]
            (unless (and (= node 0) (= field 2) (= first 8) (= second 4)) (set! failures (+ failures 1))))
          (_ (set! failures (+ failures 1)))))
        (Ok [map] (let [(mut unexpected) map] (free! (mut unexpected)) (set! failures (+ failures 1)))))
      (set! (mut subset) 1 (N0Id :index 10000))
      (match (index-0-0 a (mut rows) (mut subset))
        (Err [e] (match e
          (InvalidIndexReference [node id] (unless (and (= node 0) (= id 10000)) (set! failures (+ failures 1))))
          (_ (set! failures (+ failures 1)))))
        (Ok [map] (let [(mut unexpected) map] (free! (mut unexpected)) (set! failures (+ failures 1)))))
      (set! (mut subset) 1 (N0Id :index 8))
      (match (index-0-1 a (mut rows) (mut subset))
        (Err [e] (match e
          (DuplicateKey [_ _ first second] (unless (and (= first 8) (= second 8)) (set! failures (+ failures 1))))
          (_ (set! failures (+ failures 1)))))
        (Ok [map] (let [(mut unexpected) map] (free! (mut unexpected)) (set! failures (+ failures 1)))))
      (free! (mut subset)))
    (free! (mut ids)) (free! (mut rows)) (arena-release! arena)
    (println "index failures: {}" failures)
    failures))
