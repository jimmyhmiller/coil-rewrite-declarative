(module fixture.main)
(import "rewrite.generated" :use *)
(import "rewrite.source" :as source)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use [HashMap])
(import "coil.reader" :use *)
(import "coil.result" :use *)

(defn main [] (-> i64)
  (let [a (malloc-allocator) (mut input) (store-new a) (mut output) (store-new a)
        arena (arena-new 1048576) reader-a (arena-view arena)
        forms (match (read-all reader-a "(Pair (Leaf \"owned\") (Leaf \"owned\"))" 7)
                (Ok [forms] forms) (Err [_] (panic "reader")))
        root (match (parse-0 (mut input) (elem forms 0)) (Ok [id] id) (Err [_] (panic "parse")))
        (mut ok) true]
    (match (store-source! (mut input) 7 "identity.coil" "(Pair (Leaf \"owned\") (Leaf \"owned\"))") (Ok [_]) (Err [_] (set! ok false)))
    (unless (= (len (.strings (.source-data input))) 3) (set! ok false))
    (match (store-source! (mut input) 7 "identity.coil" "(Pair (Leaf \"owned\") (Leaf \"owned\"))")
      (Ok [added] (when added (set! ok false))) (Err [_] (set! ok false)))
    ; Pre-existing target rows force different numeric IDs; recursive fields must be mapped.
    (append-0 (mut (.rows0 output)) (N0V0 (store-text! (mut output) "sentinel")))
    (push! (mut (.origins0 output)) (source/Origin :source 0 :lo 0 :hi 0))
    (let [(mut alias) (transform-state-new a (mut input) (mut input))]
      (match (transform-0-0 (mut alias) root)
        (Err [e] (match e (TransformAliasedStores []) (_ (set! ok false))))
        (Ok [_] (set! ok false)))
      (transform-state-free! (mut alias)))
    (let [(mut state) (transform-state-new a (mut input) (mut output))]
      (match (transform-0-0 (mut state) root)
        (Err [_] (set! ok false))
        (Ok [id]
          (unless (= (.index id) 3) (set! ok false))
          (match (lookup-0 (mut (.rows0 output)) id)
            (Some [row] (match row
              (N0V1 [left right] (unless (and (= (.index left) 1) (= (.index right) 2)) (set! ok false)))
              (_ (set! ok false))))
            (None [] (set! ok false)))))
      (transform-state-free! (mut state)))
    (for text (.strings (.source-data input)) (for [i 0 (len text)] (set! text i 88)))
    (store-free! (mut input)) (arena-release! arena)
    (match (lookup-0 (mut (.rows0 output)) (N0Id :index 1))
      (Some [row] (match row (N0V0 [text] (unless (= text "owned") (set! ok false))) (_ (set! ok false))))
      (None [] (set! ok false)))
    (match (get (.documents (.source-data output)) 7)
      (Some [doc] (unless (= (.name doc) "identity.coil") (set! ok false)))
      (None [] (set! ok false)))
    (unless (= (len (.traces output)) 3) (set! ok false))
    ; A second input exercises missing sources, conflicting identities, and span validation.
    (let [(mut bad) (store-new a)
          id (append-0 (mut (.rows0 bad)) (N0V0 (store-text! (mut bad) "")))
          (mut state) (transform-state-new a (mut bad) (mut output))]
      (push! (mut (.origins0 bad)) (source/Origin :source 7 :lo 0 :hi 1))
      (match (transform-0-0 (mut state) id)
        (Err [e] (match e (TransformSource [error] (match error (source/SourceMissing [id]) (_ (set! ok false)))) (_ (set! ok false))))
        (Ok [_] (set! ok false)))
      (match (store-source! (mut bad) 7 "other.coil" "x") (Ok [_]) (Err [_] (set! ok false)))
      (match (transform-0-0 (mut state) id)
        (Err [e] (match e (TransformSource [error] (match error (source/SourceConflict [id]) (_ (set! ok false)))) (_ (set! ok false))))
        (Ok [_] (set! ok false)))
      (set! (mut (.origins0 bad)) 0 (source/Origin :source 7 :lo 0 :hi 2))
      (match (transform-0-0 (mut state) id)
        (Err [e] (match e (TransformSource [error] (match error (source/SourceSpan [id lo hi]) (_ (set! ok false)))) (_ (set! ok false))))
        (Ok [_] (set! ok false)))
      (unless (= (len (.rows0 output)) 4) (set! ok false))
      (transform-state-free! (mut state)) (store-free! (mut bad)))
    (store-free! (mut output))
    (println "owned identity transform and source errors: {}" ok)
    (if ok 0 1)))
