(module fixture.main)
(import "rewrite.beforeprotocol" :as p)
(import "coil.result" :use *)
(import "coil.cc" :as cc)
(import "coil.primitive" :use [fnptr-of])
(defstruct Run [(target i64) (mode i64) (current i64) (pending i64) (calls i64) (accepted i64) (limit i64)])
(defn round :cc (cc/C) [(run (ptr Run))] (-> (Result p/Event i64))
  (set! (.calls run) (+ (.calls run) 1))
  (if (>= (.current run) (.target run)) (Ok (p/Event-Equal))
    (do
      (set! (.pending run) (+ (.current run) 1))
      (Ok (if (or (= (.mode run) 1)
                   (and (= (.mode run) 2) (< (.current run) 16))
                   (and (= (.mode run) 3) (= (.current run) 16)))
        (p/Event-ChangedStage) (p/Event-ChangedPlain))))))
(defn accept :cc (cc/C) [(run (ptr Run))] (-> (Result p/Event i64))
  (set! (.current run) (.pending run))
  (set! (.accepted run) (+ (.accepted run) 1))
  (Ok (p/Event-Accepted)))
(defn check [(target i64) (mode i64) (calls i64) (current i64) (limit i64)] (-> bool)
  (let [(mut run) (Run :target target :mode mode :current 0 :pending 0 :calls 0 :accepted 0 :limit 0)
        (mut handlers) (p/Handlers [Run i64] :step-round (fnptr-of round) :step-accept (fnptr-of accept))
        outcome (match (p/run (mut run) (mut handlers))
          (Ok [_] (= limit 0))
          (Err [e] (match e
            (p/Exhausted [budget actual]
              (set! (.limit run) actual)
              (and (> limit 0) (= actual limit) (= (p/budget-name budget) "rounds")))
            (_ false))))
        ok (and outcome (= (.calls run) calls) (= (.current run) current) (= (.accepted run) current))]
    (unless ok (println "guard mismatch target={} mode={} calls={} current={} limit={}"
                 target mode (.calls run) (.current run) (.limit run)))
    ok))
