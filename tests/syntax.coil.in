(module fixture.main)
(import "rewrite.generated" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(defn main [] (-> i64)
  (let [arena (arena-new 1048576) a (arena-view arena) (mut store) (store-new a)
        ok (match (read-all a "[7 \"payload\"]" 91)
          (Err [_] false)
          (Ok [forms] (match (surface-0 (mut store) (elem forms 0))
            (Err [_] false)
            (Ok [id] (match (lookup-0 (mut (.rows0 store)) id)
              (None [] false)
              (Some [row] (and (= (.f0 row) "payload") (= (.f1 row) 7)
                (= (.source (elem (mut (.origins0 store)) (.index id))) 91))))))))]
    (store-free! (mut store)) (arena-release! arena)
    (if ok 0 1)))
