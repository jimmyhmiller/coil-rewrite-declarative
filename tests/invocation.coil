(module rewrite.testinvocation)
(import "rewrite.invocation" :as inv)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(defn identity-entry :cc (cc/C) [(value i64)] (-> i64)
  value)

(defn zero-entry :cc (cc/C) [(value i64)] (-> i64)
  0)

(defn value [(result (Result i64 inv/InvocationError))] (-> i64)
  (match result
    (Ok [n] n)
    (Err [_] (panic "expected successful invocation operation"))))

(defn invalid? [(result (Result i64 inv/InvocationError))] (-> bool)
  (match result
    (Err [e] (match e (inv/InvalidHandle [_] true) (_ false)))
    (Ok [_] false)))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut left) (inv/create a)
        (mut right) (inv/create a)
        (mut ok) true
        root (value (inv/read-one! (mut left) 1 "left" "((1 2) [40 42])"))
        foreign (value (inv/read-one! (mut right) 1 "right" "((1 2) [40 42])"))
        vector (value (inv/child! (mut left) root true))
        forty (value (inv/child! (mut left) vector false))]
    (unless (and (> root 0)
                 (> foreign 0)
                 (not (= root foreign))
                 (= forty (value (inv/child! (mut left) vector false)))
                 (= 40 (value (inv/integer (mut left) forty)))
                 (= 42
                    (value (inv/integer (mut left)
                                        (value (inv/child! (mut left)
                                                           vector
                                                           true))))))
      (set! ok false))
    (unless (and (invalid? (inv/integer (mut left) foreign))
                 (invalid? (inv/integer (mut left) 0))
                 (invalid? (inv/integer (mut left) (- 0 1)))
                 (invalid? (inv/invoke-code! (mut left)
                                             (primitive/fnptr-of identity-entry)
                                             foreign)))
      (set! ok false))
    (unless (= root
               (value (inv/invoke-code! (mut left)
                                        (primitive/fnptr-of identity-entry)
                                        root)))
      (set! ok false))
    (unless (= 0
               (value (inv/invoke-value! (mut left)
                                         (primitive/fnptr-of zero-entry)
                                         root)))
      (set! ok false))
    (unless (invalid? (inv/invoke-code! (mut left)
                                        (primitive/fnptr-of zero-entry)
                                        root))
      (set! ok false))
    (match (inv/invoke-code! (mut left) (zeroed (fnptr (cc/C) [i64] i64)) root)
      (Err [e] (match e (inv/NullEntry []) (_ (set! ok false))))
      (Ok [_] (set! ok false)))
    (unless (= 0 (inv/first-callback (mut left) root)) (set! ok false))
    (match (.error left)
      (Some [e] (match e (inv/OutsideInvocation []) (_ (set! ok false))))
      (None [] (set! ok false)))
    (unless (= root
               (value (inv/invoke-code! (mut left)
                                        (primitive/fnptr-of identity-entry)
                                        root)))
      (set! ok false))
    (match (.error left) (None []) (Some [_] (set! ok false)))
    (match (inv/child! (mut left) forty false)
      (Err [e]
           (match e
             (inv/ExpectedContainer [h] (unless (= h forty) (set! ok false)))
             (_ (set! ok false))))
      (Ok [_] (set! ok false)))
    (let [empty (value (inv/read-one! (mut left) 2 "empty" "[]"))]
      (match (inv/child! (mut left) empty true)
        (Err [e] (match e (inv/EmptyContainer [_]) (_ (set! ok false))))
        (Ok [_] (set! ok false))))
    (match (inv/read-one! (mut left) 3 "many" "1 2")
      (Err [e]
           (match e
             (inv/RootArity [n] (unless (= n 2) (set! ok false)))
             (_ (set! ok false))))
      (Ok [_] (set! ok false)))
    (match (inv/read-one! (mut left) 4 "bad" "(")
      (Err [e] (match e (inv/SyntaxFailure [_]) (_ (set! ok false))))
      (Ok [_] (set! ok false)))
    (let [(mut counter) 9223372036854775806]
      (unless (= 9223372036854775807 (value (inv/mint-counter! (mut counter))))
        (set! ok false))
      (match (inv/mint-counter! (mut counter))
        (Err [e] (match e (inv/HandleCapacity []) (_ (set! ok false))))
        (Ok [_] (set! ok false)))
      (unless (= counter 9223372036854775807) (set! ok false)))
    (for [i 0 2000]
      (let [h (value (inv/read-one! (mut left) (+ i 10) "growth" "42"))]
        (unless (= 42 (value (inv/integer (mut left) h))) (set! ok false))))
    (unless (and (= 40 (value (inv/integer (mut left) forty)))
                 (= forty (value (inv/child! (mut left) vector false))))
      (set! ok false))
    (match (inv/close! (mut left))
      (Ok [closed] (unless closed (set! ok false)))
      (Err [_] (set! ok false)))
    (match (inv/close! (mut left))
      (Ok [closed] (when closed (set! ok false)))
      (Err [_] (set! ok false)))
    (match (inv/integer (mut left) forty)
      (Err [e] (match e (inv/ClosedInvocation []) (_ (set! ok false))))
      (Ok [_] (set! ok false)))
    (set! left (inv/create a))
    (let [fresh (value (inv/read-one! (mut left) 1 "fresh" "42"))]
      (unless (and (not (= fresh root))
                   (invalid? (inv/integer (mut left) root))
                   (= 42 (value (inv/integer (mut left) fresh))))
        (set! ok false)))
    (inv/close! (mut left))
    (inv/close! (mut right))
    (println "invocation handles: ownership, lifetime, exhaustion and entry validation: {}"
             ok)
    (if ok 0 1)))
