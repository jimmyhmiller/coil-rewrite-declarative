(module fixture.main)
(import "rewrite.generated" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(defn typed? [(result Judgment) (expected i64)] (-> bool)
  (match result (Typed [actual] (= actual expected)) (_ false)))
(defn main [] (-> i64)
  (let [(mut rows) (ArrayList::new [N0Row] (malloc-allocator))
        integer (append-0 (mut rows) (N0V0 42))
        boolean (append-0 (mut rows) (N0V1 true))
        good (append-0 (mut rows) (N0V2 integer integer))
        bad (append-0 (mut rows) (N0V2 integer boolean))
        cycle (append-0 (mut rows) (N0V2 (N0Id :index 4) integer))
        nested (append-0 (mut rows) (N0V2 good bad))
        both-bad (append-0 (mut rows) (N0V2 boolean boolean))
        missing (append-0 (mut rows) (N0V2 (N0Id :index 999) integer))
        (mut ok) (and (typed? (judge-0 (mut rows) integer) 1)
                      (typed? (judge-0 (mut rows) boolean) 2)
                      (typed? (judge-0 (mut rows) good) 1))]
    (for id [bad nested]
      (unless (match (judge-0 (mut rows) id)
                (Mismatch [node field expected actual lo hi]
                  (and (= node (.index boolean)) (= field 1) (= expected 1) (= actual 2) (= lo RULE_LO) (= hi RULE_HI)))
                (_ false))
        (set! ok false)))
    (unless (match (judge-0 (mut rows) both-bad)
              (Mismatch [node field expected actual lo hi] (= field 0)) (_ false))
      (set! ok false))
    (unless (match (judge-0 (mut rows) cycle)
              (CyclicInput [node] (= node (.index cycle))) (_ false))
      (set! ok false))
    (for id [(N0Id :index 999) missing]
      (unless (match (judge-0 (mut rows) id)
                (InvalidReference [node] (= node 999)) (_ false))
        (set! ok false)))
    (free! (mut rows))
    (if ok 0 1)))
