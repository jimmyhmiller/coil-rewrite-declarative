(module fixture.main)
(import "rewrite.generated" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(defn main [] (-> i64)
  (let [(mut rows) (ArrayList::new [N0Row] (malloc-allocator))
        integer (append-0 (mut rows) (N0V0 42))
        boolean (append-0 (mut rows) (N0V1 true))
        good (append-0 (mut rows) (N0V2 integer integer))
        bad (append-0 (mut rows) (N0V2 integer boolean))
        cycle (append-0 (mut rows) (N0V2 (N0Id :index 4) integer))
        ok (and (= (judge-0 (mut rows) integer) 1)
                (= (judge-0 (mut rows) boolean) 2)
                (= (judge-0 (mut rows) good) 1)
                (= (judge-0 (mut rows) bad) 0)
                (= (judge-0 (mut rows) cycle) 0)
                (= (judge-0 (mut rows) (N0Id :index 999)) 0))]
    (free! (mut rows))
    (if ok 0 1)))
