(module fixture.main)
(import "fixture.protocol" :as p)
(import "coil.result" :use *)
(import "coil.cc" :as cc)
(import "coil.primitive" :use [fnptr-of])
(defstruct Job [(retries i64) (polls i64) (fetches i64) (checks i64)])
(defn fetch :cc (cc/C) [(job (ptr Job))] (-> (Result p/Event i64))
  (set! (.fetches job) (+ (.fetches job) 1))
  (if (= (.retries job) 0) (Ok (p/Event-Ready))
    (do (set! (.retries job) (- (.retries job) 1)) (Ok (p/Event-Retry)))))
(defn poll :cc (cc/C) [(job (ptr Job))] (-> (Result p/Event i64))
  (set! (.checks job) (+ (.checks job) 1))
  (if (= (.polls job) 0) (Ok (p/Event-Loaded))
    (do (set! (.polls job) (- (.polls job) 1)) (Ok (p/Event-Wait)))))
(defn wrong :cc (cc/C) [(job (ptr Job))] (-> bool) false)
(defn main [] (-> i64)
  (let [(mut job) (Job :retries 2 :polls 3 :fetches 0 :checks 0)
        (mut handlers) (p/Handlers [Job i64] :step-fetch (fnptr-of fetch) :step-poll (fnptr-of poll))
        ok (match (p/run (mut job) (mut handlers))
             (Ok [_] (and (= (.fetches job) 3) (= (.checks job) 4))) (Err [_] false))]
    (println "independent protocol: retry and polling budgets: {}" ok)
    (if ok 0 1)))
