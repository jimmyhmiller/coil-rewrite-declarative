(module rewrite.teststagedatum)
(import "rewrite.code" :as code)
(import "rewrite.codeforms" :as forms)
(import "rewrite.sequence" :as sequence)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)

(defn child [(s (ptr code/Syntax)) (root forms/N0Id) (i i64)] (-> forms/N0Id)
  (let [items
          (match (get (.rows0 (.store s)) (.index root))
            (forms/N0V6 [items] items)
            (_ (panic "list")))]
    (match (forms/sequence-item-0 (field s store) items i)
      (Some [id] id)
      (None [] (panic "child")))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut input) (code/create a)
        (mut output) (code/create a)
        (mut parts) (ArrayList::new [i64] a)
        roots
          (match (code/read! (mut input)
                             1
                             "stage.coil"
                             "(alpha [beta] 7 :kw \"text\" c\"raw\" -0.0 (quote gamma))")
            (Ok [ids] ids)
            (Err [_] (panic "read")))
        root
          (match (forms/sequence-item-0 (field (mut input) store) roots 0)
            (Some [id] id)
            (None [] (panic "root")))
        singleton (sequence/singleton! (mut (.sequences0 (.store input))) root)]
    (defer (code/release! (mut output)))
    (defer (free! (mut parts)))
    (push! (mut parts) singleton)
    (push! (mut parts) singleton)
    (let [joined
            (match (sequence/join! (mut (.sequences0 (.store input)))
                                   (mut parts))
              (Ok [id] (forms/N0Seq :index id))
              (Err [_] (panic "join")))
          outer
            (forms/append-0 (mut (.rows0 (.store input))) (forms/N0V6 joined))]
      (push! (mut (.origins0 (.store input)))
             (get (.origins0 (.store input)) (.index root)))
      (push! (mut (.contexts input)) (get (.contexts input) (.index root)))
      (for [i 0 (len (.contexts input))]
        (let [context (elem (field (mut input) contexts) i)]
          (set! (.f0 context) 17)
          (set! (.f1 context)
                (forms/store-text! (mut (.store input)) "owner.module"))
          (set! (.f2 context) 29)
          (set! (.f3 context) 71)
          (set! (.f4 context) 3)))
      (let [copy
              (match (code/stage-datum! (mut output) (mut input) outer)
                (Ok [id] id)
                (Err [_] (panic "stage datum")))
            left (child (mut output) copy 0)
            right (child (mut output) copy 1)]
        (when (= (.index left) (.index right)) (panic "occurrences shared"))
        (when (= (.f5 (get (.contexts output) (.index left)))
                 (.f5 (get (.contexts output) (.index right))))
          (panic "container identities shared"))
        (when (= (.f5 (get (.contexts output)
                           (.index (child (mut output) left 0))))
                 (.f5 (get (.contexts output)
                           (.index (child (mut output) right 0)))))
          (panic "symbol identities shared"))
        (match (code/equal? a (mut input) outer (mut output) copy)
          (Ok [same] (unless same (panic "datum shape changed")))
          (Err [_] (panic "equality")))
        (for trace (.traces (.store output))
          (let [source (get (.contexts input) (.source-node trace))
                result (get (.contexts output) (.target-node trace))
                kind (get (.rows0 (.store input)) (.source-node trace))
                fresh? (forms/context-stage-datum-fresh? kind)]
            (unless (and (= (.f2 result) 29) (= (.f4 result) 3))
              (panic "transport metadata changed"))
            (if fresh?
                (unless (and (> (.f5 result) 0) (!= (.f5 result) (.f5 source)))
                  (panic "identity not refreshed"))
                (unless (= (.f5 result) (.f5 source))
                  (panic "leaf identity changed")))
            (match kind
              (forms/N0V2 [_]
                          (unless (and (= (.f0 result) 0)
                                       (= (.f1 result) "")
                                       (= (.f3 result) 5))
                            (panic "symbol context retained")))
              (_ (unless (and (= (.f0 result) 17)
                              (= (.f1 result) "owner.module")
                              (= (.f3 result) 71))
                   (panic "non-symbol context changed"))))))
        (let [saved (get (.rows0 (.store input)) (.index outer))
              loop-sequence
                (sequence/singleton! (mut (.sequences0 (.store input))) outer)]
          (set! (mut (.rows0 (.store input)))
                (.index outer)
                (forms/N0V6 (forms/N0Seq :index loop-sequence)))
          (match (code/stage-datum! (mut output) (mut input) outer)
            (Err [e]
                 (match e
                   (code/PromotionShape [shape]
                                        (match shape
                                          (forms/TransformCycle [_ _])
                                          (_ (panic "cycle shape"))))
                   (_ (panic "cycle error"))))
            (Ok [_] (panic "occurrence cycle accepted")))
          (set! (mut (.rows0 (.store input))) (.index outer) saved)
          (match (code/stage-datum! (mut output) (mut input) outer)
            (Ok [_])
            (Err [_] (panic "occurrence retry"))))
        (code/release! (mut input))
        (unless (= (.f1 (get (.contexts output) (.index copy))) "owner.module")
          (panic "borrowed module text"))
        (match (get (.rows0 (.store output))
                    (.index (child (mut output) right 0)))
          (forms/N0V2 [name]
                      (unless (= name "alpha") (panic "borrowed symbol text")))
          (_ (panic "symbol")))))
    (println "declared stage datum: isolated symbols, preserved other metadata, occurrence identities, joins and independent storage passed")
    0))
