(module rewrite.testuselookup)
(import "rewrite.namespace" :as namespace)
(import "rewrite.nameforms" :as forms)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.debug-allocator" :use [DebugAllocator])

(defn check-case [(a (dyn Allocator))
                  (source (slice u8))
                  (name (slice u8))
                  (expected (slice u8))
                  (ambiguous? bool)
                  (next-owner (slice u8))] (-> void)
  (let [(mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        (mut store) (forms/store-new a)
        graph
          (match (read-all sa
                           "(Namespace [(Declaration \"base.a\") (Declaration \"base.b\") (Declaration \"other.a\")] [] [(ExportModule \"facade\" false [] [(Reexport \"base\" (Refer true [] [] []))])])"
                           0)
            (Ok [forms] forms)
            (Err [_] (panic "graph read")))
        input
          (match (read-all sa source 0)
            (Ok [forms] forms)
            (Err [_] (panic "uses read")))
        root
          (match (forms/parse-7 (mut store) (elem graph 0))
            (Ok [root] root)
            (Err [_] (panic "graph parse")))
        use-root
          (match (forms/parse-9 (mut store) (elem input 0))
            (Ok [root] root)
            (Err [_] (panic "uses parse")))]
    (defer (close! (mut scratch)))
    (defer (forms/store-free! (mut store)))
    (let [(mut view)
            (match (namespace/compile a (mut store) root)
              (Ok [view] view)
              (Err [_] (panic "view")))
          (mut uses)
            (match (namespace/compile-uses a (mut store) use-root)
              (Ok [uses] uses)
              (Err [_] (panic "uses")))]
      (defer (namespace/release! (mut view)))
      (defer (namespace/release-edges! (mut uses)))
      (for [mode 0 2]
        (let [macro? (= mode 0)]
          (match (namespace/used a (mut view) (mut uses) name macro?)
            (Err [error]
                 (unless (and (not macro?) ambiguous?)
                   (panic "unexpected ambiguity"))
                 (match error
                   (namespace/Ambiguous [first next]
                                        (unless (and (= (.f0 first) "base")
                                                     (= (.f2 first) expected)
                                                     (= (.f0 next) next-owner))
                                          (panic "wrong ambiguity witness")))
                   (_ (panic "query error"))))
            (Ok [value]
                (when (and (not macro?) ambiguous?) (panic "ambiguity lost"))
                (match value
                  (None [] (unless (= expected "") (panic "missing candidate")))
                  (Some [candidate]
                        (unless (and (= (.f2 candidate) expected)
                                     (> (len (.f1 candidate)) 0))
                          (panic "wrong candidate")))))))))))

(defn check [(a (dyn Allocator))] (-> void)
  (check-case a "(Imports [])" "a" "" false "")
  (check-case a
              "(Imports [(Reexport \"base\" (Refer true [] [] [])) (Reexport \"other\" (Refer true [] [] []))])"
              "a"
              "base.a"
              true
              "other")
  (check-case a
              "(Imports [(Reexport \"facade\" (Refer true [] [] [])) (Reexport \"base\" (Refer true [] [] []))])"
              "a"
              "base.a"
              false
              "")
  (check-case a
              "(Imports [(Reexport \"base\" (Refer false [] [] [(Rename \"a\" \"x\")])) (Reexport \"base\" (Refer false [] [] [(Rename \"b\" \"x\")]))])"
              "x"
              "base.a"
              false
              "")
  (check-case a
              "(Imports [(Reexport \"base\" (Refer false [] [] [(Rename \"a\" \"x\")])) (Reexport \"base\" (Refer false [] [] [(Rename \"b\" \"x\")])) (Reexport \"other\" (Refer false [] [] [(Rename \"a\" \"x\")]))])"
              "x"
              "base.a"
              true
              "other")
  (check-case a
              "(Imports [(Reexport \"base\" (Refer false [] [] [(Rename \"a\" \"x\")])) (Reexport \"facade\" (Refer false [] [] [(Rename \"a\" \"x\")])) (Reexport \"facade\" (Refer false [] [] [(Rename \"b\" \"x\")]))])"
              "x"
              "base.a"
              true
              "facade")
  (check-case a
              "(Imports [(Reexport \"base\" (Refer false [] [] [])) (Reexport \"other\" (Refer true [] [] []))])"
              "a"
              "other.a"
              false
              "")
  (check-case a
              "(Imports [(Reexport \"base\" (Refer true [] [(Name \"a\")] [])) (Reexport \"other\" (Refer true [] [] []))])"
              "a"
              "other.a"
              false
              ""))

(defn main [] (-> i64)
  (let [debug (DebugAllocator::new (malloc-allocator))]
    (check (DebugAllocator::view debug))
    (unless (= (DebugAllocator::deinit! debug) 0) (panic "use lookup leaked")))
  (println "use selection: first hit, same declaration, same owner, first witness, ambiguity and misses passed")
  0)
