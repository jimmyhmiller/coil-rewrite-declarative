(module fixture.main)
(import "rewrite.generated" :use *)
(import "rewrite.native" :as native)
(import "coil.scratch" :use [ScratchArena])
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "declarative.rt.jit" :as jit)

(defn expansion-program [] (-> i64)
  (let [(mut arena) (zeroed ScratchArena) initialized (init (mut arena) (malloc-allocator))
        a (allocator (mut arena)) (mut input) (store-new a) (mut output) (store-new a)
        (mut roots) (ArrayList::new [N1Id] a)
        text "(group (ignore) (group (define-alias inc entry x (bump x)) (define extra x (+ x 9))))"
        (mut ok) true
        result (block :done
          (match (store-source! (mut input) 91 "declarations.coil" text) (Err [_] (break :done false)) (Ok [_]))
          (let [forms (match (read-all a text 91) (Ok [forms] forms) (Err [_] (break :done false)))
                root (match (surface-4 (mut input) (elem forms 0)) (Ok [id] id) (Err [_] (break :done false)))
                (mut state) (transform-state-new a (mut input) (mut output))]
            (defer (transform-state-free! (mut state)))
            (let [ids (match (transform-many-4-1 (mut state) root) (Ok [ids] ids) (Err [_] (break :done false)))
                  count (match (sequence-size-1 (mut output) ids) (Some [n] n) (None [] (break :done false)))
                  rows (len (.rows1 output)) traces (len (.traces output))]
              (unless (= count 3) (break :done false))
              (match (sequence-materialize-1 a (mut output) ids (mut roots))
                (Ok [n] (unless (= n 3) (break :done false))) (Err [_] (break :done false)))
              (match (sequence-item-1 (mut output) ids count) (None []) (Some [_] (break :done false)))
              (match (sequence-item-1 (mut output) ids (- 0 1)) (None []) (Some [_] (break :done false)))
              (match (sequence-size-1 (mut output) (N1Seq :index 9999)) (None []) (Some [_] (break :done false)))
              (match (transform-many-4-1 (mut state) root)
                (Ok [again] (unless (and (= (.index ids) (.index again))
                                         (= rows (len (.rows1 output))) (= traces (len (.traces output))))
                              (break :done false)))
                (Err [_] (break :done false)))
              (unless (and (= (.f0 (get (.rows1 output) (.index (get roots 0)))) "entry")
                           (= (.f0 (get (.rows1 output) (.index (get roots 1)))) "inc")
                           (= (.f0 (get (.rows1 output) (.index (get roots 2)))) "extra"))
                (break :done false))
              true)))]
    (store-free! (mut input))
    (unless result (set! ok false))
    (when result
      (match (compile-program a (mut output) (mut roots))
        (Err [_] (set! ok false))
        (Ok [im] (let [loaded (native/load-image a im)
                       run (primitive/cast (fnptr (cc/C) [i64] i64) (jit/address-of loaded 0))
                       extra (primitive/cast (fnptr (cc/C) [i64] i64) (jit/address-of loaded 2))]
                   (unless (and (= (run 41) 42) (= (extra 1) 10)) (set! ok false))
                   (jit/unload! loaded)))))
    (store-free! (mut output)) (free! (mut roots)) (close! (mut arena))
    (println "declaration sequence expansion and native alias: {}" ok)
    (if ok 0 1)))

(defn collision [] (-> bool)
  (let [arena (arena-new 1048576) a (arena-view arena)
        (mut input) (store-new a) (mut output) (store-new a)
        (mut roots) (ArrayList::new [N1Id] a)
        text "(define-alias same same x x)"
        ok (block :done
          (match (store-source! (mut input) 92 "collision.coil" text)
            (Ok [_]) (Err [_] (break :done false)))
          (let [forms (match (read-all a text 92) (Ok [forms] forms) (Err [_] (break :done false)))
                root (match (surface-4 (mut input) (elem forms 0)) (Ok [id] id) (Err [_] (break :done false)))
                (mut state) (transform-state-new a (mut input) (mut output))]
            (defer (transform-state-free! (mut state)))
            (let [ids (match (transform-many-4-1 (mut state) root)
                        (Ok [ids] ids) (Err [_] (break :done false)))]
              (match (sequence-materialize-1 a (mut output) ids (mut roots))
                (Ok [_]) (Err [_] (break :done false)))
              (match (compile-program a (mut output) (mut roots))
                (Err [e] (match e (DuplicateFunction [name] (= name "same")) (_ false)))
                (Ok [_] false)))))]
    (store-free! (mut input)) (store-free! (mut output)) (free! (mut roots))
    (arena-release! arena) ok))

(defn main [] (-> i64)
  (let [program (expansion-program) duplicate (collision)]
    (println "introduced declaration collision rejected: {}" duplicate)
    (if (and (= program 0) duplicate) 0 1)))
