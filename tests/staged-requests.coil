(module rewrite.teststagedrequests)
(import "rewrite.stagedrequests" :as batch)
(import "rewrite.requestexecution" :as execution)
(import "rewrite.requests" :as requests)
(import "rewrite.code" :as code)
(import "rewrite.codeforms" :as forms)
(import "rewrite.stage" :as stage)
(import "rewrite.revision" :as revision)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use [HashMap])
(import "coil.str" :use [keyops-borrowed])
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.primitive" :use [fnptr-of])
(import "coil.cc" :as cc)

(defstruct Script
  [(calls i64)
   (fail-at i64)
   (allocator (dyn Allocator))
   (supply revision/Supply)
   (versions (ArrayList revision/Version))
   (tracked (ArrayList revision/Tagged))
   (admitted i64)
   (fail-admit i64)
   (checking? bool)])

(defn admit :cc (cc/C) [(script (ptr Script))
                        (index i64)
                        (original (ptr stage/Tagged))
                        (input (ptr code/Syntax))
                        (output (ptr code/Syntax))
                        (normalized (ptr (ArrayList stage/Tagged)))]
  (-> (Result batch/Admitted i64))
  (unless (= index (.admitted script)) (panic "admission order"))
  (set! (.admitted script) (+ (.admitted script) 1))
  (if (= index (.fail-admit script))
      (Err 74)
      (let [(mut tracked)
              (match (revision/track! (.allocator script)
                                      (mut (.supply script))
                                      (Some (revision/Tagged
                                              :entry (load original)
                                              :version
                                                (get (.versions script) index)))
                                      input
                                      output
                                      normalized)
                (Ok [forms] forms)
                (Err [_] (panic "admission tracking")))]
        (defer (free! (mut tracked)))
        (for form tracked (push! (mut (.tracked script)) form))
        (Ok (batch/Accepted)))))

(defn execute :cc (cc/C) [(script (ptr Script))
                          (call (ptr requests/Call))
                          (syntax (ptr code/Syntax))]
  (-> (Result forms/N0Id i64))
  (set! (.calls script) (+ (.calls script) 1))
  (when (and (.checking? script) (= (.calls script) 3))
    (unless (= (.admitted script) 1) (panic "next request preceded admission")))
  (if (= (.calls script) (.fail-at script))
      (Err 73)
      (let [args (.arguments call)]
        (unless (= (- (sexp-count (.source args)) (.start args)) 1)
          (panic "arity"))
        (match (code/import-form! syntax
                                  (sexp-nth (.source args) (.start args)))
          (Ok [id] (Ok id))
          (Err [_] (panic "callback import"))))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut input) (code/create a)
        (mut output) (code/create a)
        (mut expected) (code/create a)
        (mut session) (execution/create a)
        (mut roots) (ArrayList::new [stage/Tagged] a)
        (mut markers) (HashMap::new [(slice u8) bool] a (keyops-borrowed))
        (mut entries) (HashMap::new [(slice u8) bool] a (keyops-borrowed))
        (mut script)
          (Script
            :calls 0
            :fail-at -1
            :allocator a
            :supply (revision/Supply :last 0)
            :versions (ArrayList::new [revision/Version] a)
            :tracked (ArrayList::new [revision/Tagged] a)
            :admitted 0
            :fail-admit -1
            :checking? false)
        source
          (match (code/read! (mut input)
                             1
                             "batch.coil"
                             "(request emit (do 1 (do (request emit 2)))) (request emit (do (do) 3)) (do) (quote (do hidden))")
            (Ok [roots] roots)
            (Err [_] (panic "source")))
        want
          (match (code/read! (mut expected)
                             2
                             "expected.coil"
                             "1 2 3 (quote (do hidden))")
            (Ok [roots] roots)
            (Err [_] (panic "expected")))
        left (forms/store-text! (mut (.store input)) "left")
        right (forms/store-text! (mut (.store input)) "right")]
    (defer (code/release! (mut output)))
    (defer (code/release! (mut expected)))
    (defer (free! (mut roots)))
    (defer (free! (mut markers)))
    (defer (free! (mut entries)))
    (defer (free! (mut (.versions script))))
    (defer (free! (mut (.tracked script))))
    (set! (mut markers) "request" true)
    (set! (mut entries) "left.emit" true)
    (set! (mut entries) "right.emit" true)
    (for [i 0 4]
      (let [id
              (match (forms/sequence-item-0 (field (mut input) store) source i)
                (Some [id] id)
                (None [] (panic "root")))]
        (push! (mut roots)
               (stage/Tagged
                 :form id
                 :module (if (= i 0) (Some left) (Some right))))))
    (for [i 0 4]
      (let [(mut v)
              (match (revision/fresh! (mut (.supply script)))
                (Ok [v] v)
                (Err [_] (panic "initial version")))]
        (set! (.revision v) 7)
        (set! (.cached-shape v) 91)
        (push! (mut (.versions script)) v)))
    ; The second original form fails after the first was fully normalized.
    (set! (.fail-at script) 3)
    (match (batch/run! a
                       (mut session)
                       (mut output)
                       (mut input)
                       (mut roots)
                       (mut markers)
                       (mut entries)
                       (mut script)
                       (fnptr-of execute))
      (Err [e]
           (match e
             (batch/Request [index _]
                            (unless (= index 1)
                              (panic "original root error index")))
             (_ (panic "batch error"))))
      (Ok [_] (panic "callback failure accepted")))
    (set! (.calls script) 0)
    (set! (.fail-at script) -1)
    (set! (.checking? script) true)
    (set! (.fail-admit script) 1)
    (match (batch/run-with! a
                            (mut session)
                            (mut output)
                            (mut input)
                            (mut roots)
                            (mut markers)
                            (mut entries)
                            (mut script)
                            (fnptr-of execute)
                            (fnptr-of admit))
      (Err [e]
           (match e
             (batch/Admission [index error]
                              (unless (and (= index 1) (= error 74))
                                (panic "admission error")))
             (_ (panic "wrong batch error"))))
      (Ok [_] (panic "admission failure accepted")))
    (unless (and (= (.last (.supply script)) 6) (= (len (.tracked script)) 2))
      (panic "prior admission effects lost"))
    (while (> (len (.tracked script)) 0) (pop! (mut (.tracked script))))
    (set! (.calls script) 0)
    (set! (.admitted script) 0)
    (set! (.fail-admit script) -1)
    (let [(mut returned)
            (match (batch/run-with! a
                                    (mut session)
                                    (mut output)
                                    (mut input)
                                    (mut roots)
                                    (mut markers)
                                    (mut entries)
                                    (mut script)
                                    (fnptr-of execute)
                                    (fnptr-of admit))
              (Ok [forms] forms)
              (Err [_] (panic "batch")))]
      (defer (free! (mut returned)))
      (code/release! (mut input))
      (execution/close! (mut session))
      (unless (and (= (len returned) 4) (= (.calls script) 3))
        (panic "batch counts"))
      (unless (= (len (.tracked script)) 4) (panic "tracked count"))
      (for [i 0 4]
        (let [v (.version (get (.tracked script) i))]
          (unless (and (= (.identity v)
                          (cond (= i 0) 7 (= i 1) 8 (= i 2) 2 :else 4))
                       (= (.revision v) (cond (< i 2) 0 (= i 2) 8 :else 7))
                       (= (.cached-shape v) (if (= i 3) 91 0)))
            (panic "batch revisions"))))
      (for [i 0 4]
        (let [entry (get returned i)
              expected-id
                (match (forms/sequence-item-0 (field (mut expected) store)
                                              want
                                              i)
                  (Some [id] id)
                  (None [] (panic "expected id")))]
          (match (code/equal? a
                              (mut output)
                              (.form entry)
                              (mut expected)
                              expected-id)
            (Ok [same] (unless same (panic "batch order")))
            (Err [_] (panic "equality")))
          (match (.module entry)
            (Some [name]
                  (unless (= name (if (< i 2) "left" "right")) (panic "module")))
            (None [] (panic "missing module"))))))
    (println "staged request batches: returned bundles, multiple modules, root-indexed failures, admission ordering, revision tracking, retry and independent output lifetime passed")
    0))
