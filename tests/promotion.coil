(module rewrite.testpromotion)
(import "rewrite.code" :as code)
(import "rewrite.codeforms" :as forms)
(import "rewrite.syntaxreader" :as projection)
(import "coil.reader" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)

(defn read-root [(s (mut code/Syntax))] (-> forms/N0Id)
  (let [roots
          (match (code/read! (mut s)
                             1
                             "owned.coil"
                             "(7 -0.0 alpha :kw \"text\" c\"raw\" [9])")
            (Ok [r] r)
            (Err [_] (panic "read")))]
    (match (forms/sequence-item-0 (field s store) roots 0)
      (Some [r] r)
      (None [] (panic "root")))))

(defn child [(s (ptr code/Syntax)) (r forms/N0Id) (i i64)] (-> forms/N0Id)
  (let [items
          (match (get (.rows0 (.store s)) (.index r))
            (forms/N0V6 [xs] xs)
            (forms/N0V7 [xs] xs)
            (_ (panic "container")))]
    (match (forms/sequence-item-0 (field s store) items i)
      (Some [r] r)
      (None [] (panic "child")))))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut views) (zeroed ScratchArena)
        initialized (init (mut views) a)
        va (allocator (mut views))
        (mut input) (code/create a)
        (mut output) (code/create a)
        (mut conflict) (code/create a)
        (mut ok) true
        root (read-root (mut input))
        (mut shared) (ArrayList::new [forms/N0Id] a)]
    (push! (mut shared) root)
    (push! (mut shared) root)
    (let [origin (get (.origins0 (.store input)) (.index root))
          outer
            (forms/append-0 (mut (.rows0 (.store input)))
                            (forms/N0V6 (forms/sequence-0 (mut (.store input))
                                                          (mut shared))))]
      (push! (mut (.origins0 (.store input))) origin)
      (push! (mut (.contexts input))
             (forms/N1Row
               :f0 17
               :f1 (forms/store-text! (mut (.store input)) "owner.module")
               :f2 29
               :f3 71
               :f4 3
               :f5 901))
      (match (code/promote! (mut input) (mut input) outer)
        (Err [e]
             (match e
               (code/PromotionShape [shape]
                                    (match shape
                                      (forms/TransformAliasedStores [])
                                      (_ (set! ok false))))
               (_ (set! ok false))))
        (Ok [_] (set! ok false)))
      (forms/store-source! (mut (.store conflict)) 1 "conflict" "different")
      (match (code/promote! (mut conflict) (mut input) outer)
        (Err [e]
             (match e
               (code/PromotionShape [shape]
                                    (match shape
                                      (forms/TransformSource [_])
                                      (_ (set! ok false))))
               (_ (set! ok false))))
        (Ok [_] (set! ok false)))
      (let [(mut rejected) (code/create a)
            context
              (match (pop! (mut (.contexts input)))
                (Some [c] c)
                (None [] (panic "metadata")))]
        (match (code/promote! (mut rejected) (mut input) outer)
          (Err [e]
               (match e
                 (code/PromotionContextMissing [row]
                                               (unless (= row (.index outer))
                                                 (set! ok false)))
                 (_ (set! ok false))))
          (Ok [_] (set! ok false)))
        (unless (= (len (.contexts rejected)) (len (.rows0 (.store rejected))))
          (set! ok false))
        (push! (mut (.contexts input)) context)
        (match (code/promote! (mut rejected) (mut input) outer)
          (Ok [_])
          (Err [_] (set! ok false)))
        (let [original (get (.rows0 (.store input)) (.index root))]
          (set! (mut (.rows0 (.store input)))
                (.index root)
                (get (.rows0 (.store input)) (.index outer)))
          (match (code/promote! (mut rejected) (mut input) root)
            (Err [e]
                 (match e
                   (code/PromotionShape [shape]
                                        (match shape
                                          (forms/TransformCycle [_ _])
                                          (_ (set! ok false))))
                   (_ (set! ok false))))
            (Ok [_] (set! ok false)))
          (match (projection/project va (mut input) root)
            (Err [e]
                 (match e (projection/ProjectionCycle [_]) (_ (set! ok false))))
            (Ok [_] (set! ok false)))
          (set! (mut (.rows0 (.store input))) (.index root) original))
        (code/release! (mut rejected)))
      (let [promoted
              (match (code/promote! (mut output) (mut input) outer)
                (Ok [id] id)
                (Err [_] (panic "promotion")))
            first (child (mut output) promoted 0)
            second (child (mut output) promoted 1)]
        (unless (= (.index first) (.index second)) (set! ok false))
        (unless (= (len (.rows0 (.store output))) (len (.rows0 (.store input))))
          (set! ok false))
        (for text (.strings (.source-data (.store input)))
          (for [i 0 (len text)] (set! text i 88)))
        (code/release! (mut input))
        (let [context (get (.contexts output) (.index promoted))]
          (unless (and (= (.f0 context) 17)
                       (= (.f1 context) "owner.module")
                       (= (.f2 context) 29)
                       (= (.f3 context) 71)
                       (= (.f4 context) 3)
                       (= (.f5 context) 901))
            (set! ok false)))
        (match (get (.documents (.source-data (.store output))) 1)
          (Some [d] (unless (= (.name d) "owned.coil") (set! ok false)))
          (None [] (set! ok false)))
        (let [(mut view)
                (match (projection/project va (mut output) promoted)
                  (Ok [f] f)
                  (Err [_] (panic "projection")))]
          (unless (and (= (.hyg view) 17)
                       (= (.ctxt view) 29)
                       (= (.horigin view) 71)
                       (= (.hflags view) 3)
                       (= (.node-id view) 901)
                       (= (hmod-name (.hmod view)) "owner.module")
                       (= (sexp-count (mut view)) 2)
                       (= (.node-id (sexp-nth (mut view) 0))
                          (.node-id (sexp-nth (mut view) 1))))
            (set! ok false))
          (let [inner (sexp-nth (mut view) 0)]
            (unless (and (sexp-int? (sexp-nth inner 0))
                         (= (sexp-int (sexp-nth inner 0)) 7)
                         (sexp-sym-is (sexp-nth inner 2) "alpha")
                         (sexp-vec? (sexp-nth inner 6)))
              (set! ok false))))
        (for [i 0 6]
          (let [r
                  (get (.rows0 (.store output))
                       (.index (child (mut output) first i)))]
            (unless (match r
                      (forms/N0V0 [n] (and (= i 0) (= n 7)))
                      (forms/N0V1 [bits]
                                  (and (= i 1)
                                       (= bits (- (- 0 9223372036854775807) 1))))
                      (forms/N0V2 [text] (and (= i 2) (= text "alpha")))
                      (forms/N0V3 [text] (and (= i 3) (= text "kw")))
                      (forms/N0V4 [text] (and (= i 4) (= text "text")))
                      (forms/N0V5 [text] (and (= i 5) (= text "raw")))
                      (_ false))
              (set! ok false))))
        (let [nine (child (mut output) (child (mut output) first 6) 0)]
          (match (get (.rows0 (.store output)) (.index nine))
            (forms/N0V0 [n] (unless (= n 9) (set! ok false)))
            (_ (set! ok false))))))
    (close! (mut views))
    (free! (mut shared))
    (code/release! (mut output))
    (code/release! (mut conflict))
    (println "syntax promotion: independent ownership, sharing, metadata, kinds and conflicts: {}"
             ok)
    (if ok 0 1)))
