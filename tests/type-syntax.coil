(module rewrite.testtypesyntax)
(import "rewrite.typesyntax" :as forms)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.debug-allocator" :use [DebugAllocator])
(import "coil.str" :use [StrBuf])
(import "coil.primitive" :as primitive)

(defn input! [(a (dyn Allocator)) (store (ptr forms/Store))] (-> forms/N3Id)
  (let [(mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        input
          (match (read-all sa
                           "(fnptr (cc/C) [(ptr T ignored) (array i64 0)] (Box (const :meters)))"
                           17)
            (Ok [v] v)
            (Err [_] (panic "source")))
        form (elem input 0)
        pointer (sexp-nth (sexp-nth form 2) 0)
        (mut module-text) (StrBuf::new sa)]
    (defer (close! (mut scratch)))
    (push-str! (mut module-text) "definition.module")
    (let [(mut module) (HygModule :name (str module-text))]
      (set! (.hmod (sexp-nth pointer 1))
            (primitive/cast (ptr HygModule) (mut module)))
      (set! (.hmod (sexp-nth (sexp-nth form 1) 0))
            (primitive/cast (ptr HygModule) (mut module)))
      (set! (.hyg (sexp-nth (sexp-nth form 1) 0)) (- 0 1))
      (set! (.hyg (sexp-nth pointer 1)) 31)
      (let [view
              (match (forms/view-3 sa pointer)
                (Ok [v]
                    (match v (Some [v] v) (_ (panic "pointer view absent"))))
                (_ (panic "pointer view")))
            capture (get (.captures view) 0)]
        (unless (and (= (.variant view) 8)
                     (.rest? capture)
                     (= (.count capture) 1)
                     (= (.hyg (sexp-nth (.source capture) (.start capture))) 31))
          (panic "bounded view lost original occurrence")))
      (let [before (next-node-id)
            result
              (match (forms/surface-3 store form)
                (Ok [id] id)
                (Err [_] (panic "type parse")))]
        (unless (= (next-node-id) (+ before 1))
          (panic "capture allocated lexical identity"))
        result))))

(defn check [(a (dyn Allocator))] (-> void)
  (let [(mut store) (forms/store-new a)
        root (input! a (mut store))]
    (defer (forms/store-free! (mut store)))
    ; Reader scratch has been freed. Owned written rows retain their spelling.
    (match (get (.rows3 store) (.index root))
      (forms/N3V14 [convention parameters result]
                   (match (get (.rows2 store) (.index convention))
                     (forms/N2V1 [name scope module]
                                 (unless (and (= name "cc/C")
                                              (= scope (- 0 1))
                                              (= module "definition.module"))
                                   (panic "convention name")))
                     (_ (panic "convention kind")))
                   (unless (= (match (forms/sequence-size-3 (mut store)
                                                            parameters)
                                (Some [n] n)
                                (_ (- 0 1)))
                              2)
                     (panic "parameter count"))
                   (let [first
                           (match (forms/sequence-item-3 (mut store)
                                                         parameters
                                                         0)
                             (Some [id] id)
                             (_ (panic "parameter")))]
                     (match (get (.rows3 store) (.index first))
                       (forms/N3V8 [elements]
                                   (unless (= (match (forms/sequence-size-3 (mut store)
                                                                            elements)
                                                (Some [n] n)
                                                (_ (- 0 1)))
                                              1)
                                     (panic "pointer selected ignored tail"))
                                   (let [element
                                           (match (forms/sequence-item-3 (mut store)
                                                                         elements
                                                                         0)
                                             (Some [id] id)
                                             (_ (panic "pointee")))]
                                     (match (get (.rows3 store)
                                                 (.index element))
                                       (forms/N3V3 [name scope module]
                                                   (unless (and (= name "T")
                                                                (= scope 31)
                                                                (= module
                                                                   "definition.module"))
                                                     (panic "owned type name")))
                                       (_ (panic "named pointee")))))
                       (_ (panic "pointer kind"))))
                   (match (get (.rows3 store) (.index result))
                     (forms/N3V15 [name scope module arguments]
                                  (unless (and (= name "Box")
                                               (= scope 0)
                                               (= module ""))
                                    (panic "application name"))
                                  (let [argument
                                          (match (forms/sequence-item-3 (mut store)
                                                                        arguments
                                                                        0)
                                            (Some [id] id)
                                            (_ (panic "application argument")))]
                                    (match (get (.rows3 store)
                                                (.index argument))
                                      (forms/N3V4 [constant]
                                                  (match (get (.rows0 store)
                                                              (.index constant))
                                                    (forms/N0V1 [keyword]
                                                                (unless (= keyword
                                                                           "meters")
                                                                  (panic "keyword")))
                                                    (_ (panic "constant kind"))))
                                      (_ (panic "constant wrapper")))))
                     (_ (panic "result kind"))))
      (_ (panic "function kind")))))

(defn main [] (-> i64)
  (let [debug (DebugAllocator::new (malloc-allocator))]
    (check (DebugAllocator::view debug))
    (unless (= (DebugAllocator::deinit! debug) 0)
      (panic "written type ownership leak")))
  (println "written types: recursive structure, bounded pointer view, borrowed hygiene, owned context and deferred identity allocation passed")
  0)
