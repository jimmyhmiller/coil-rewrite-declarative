(module fixture.main)
(import "rewrite.generated" :use *)
(import "rewrite.native" :as native)
(import "coil.scratch" :use [ScratchArena])
(import "coil.alloc" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.hashmap" :use [HashMap])
(import "coil.cc" :as cc)
(import "declarative.rt.jit" :as jit)

(defn native-program [] (-> bool)
  (let [(mut input-arena) (zeroed ScratchArena) initialized-input (init (mut input-arena) (malloc-allocator))
        (mut target-arena) (zeroed ScratchArena) initialized-target (init (mut target-arena) (malloc-allocator))
        sa (allocator (mut input-arena)) a (allocator (mut target-arena))
        (mut input) (store-new sa) (mut store) (store-new a)
        (mut source-ids) (ArrayList::new [N3Id] sa) (mut target-ids) (ArrayList::new [N1Id] a)
        text "(defn entry [(n i64)] (-> i64) (let [f (fnptr-of inc)] (unless-else false (f n) 0))) (defn inc [(x i64)] (-> i64) (bump x))"
        transformed (block :done
          (match (store-source! (mut input) 81 "surface.coil" text)
            (Err [_] (break :done false)) (Ok [_]))
          (let [doc (match (get (.documents (.source-data input)) 81)
                       (Some [doc] doc) (None [] (panic "source registration")))]
            (match (read-all sa (.text doc) 81)
              (Err [_] (break :done false))
              (Ok [forms] (for [i 0 (len (load forms))]
                (match (surface-3 (mut input) (elem forms i))
                  (Err [_] (break :done false)) (Ok [id] (push! (mut source-ids) id)))))))
          (let [(mut state) (transform-state-new a (mut input) (mut store))]
            (defer (transform-state-free! (mut state)))
            (for [i 0 (len source-ids)]
              (match (transform-3-1 (mut state) (get source-ids i))
                (Err [_] (break :done false)) (Ok [id] (push! (mut target-ids) id))))
            (> (len (.traces store)) (len target-ids))))]
    ; Poison the source pool before releasing it so accidental aliases fail deterministically.
    (for text (.strings (.source-data input))
      (for [i 0 (len text)] (set! text i 88)))
    (store-free! (mut input)) (free! (mut source-ids)) (close! (mut input-arena))
    (let [ok (and transformed
                  (match (get (.documents (.source-data store)) 81)
                    (Some [doc] (and (= (.name doc) "surface.coil") (= (.text doc) text)))
                    (None [] false))
                  (match (compile-program a (mut store) (mut target-ids))
                    (Err [_] false)
                    (Ok [im] (let [loaded (native/load-image a im)
                                   run (primitive/cast (fnptr (cc/C) [i64] i64) (jit/address-of loaded 0))
                                   result (= (run 41) 42)]
                               (jit/unload! loaded) result))))]
      (store-free! (mut store)) (free! (mut target-ids)) (close! (mut target-arena)) ok)))

(defn sharing-and-errors [] (-> bool)
  (let [arena (arena-new 1048576) a (arena-view arena) (mut store) (store-new a) (mut target) (store-new a)
        forms (match (read-all a "(bump 1)" 83) (Ok [forms] forms) (Err [_] (panic "fixture syntax")))
        original (origin-of (elem forms 0))
        bump (match (surface-2 (mut store) (elem forms 0)) (Ok [id] id) (Err [_] (panic "fixture pattern")))
        root (append-2 (mut (.rows2 store)) (N2V2 bump bump))
        (mut ok) true]
    (match (store-source! (mut store) 83 "graph.coil" "(bump 1)") (Ok [_]) (Err [_] (set! ok false)))
    (push! (mut (.origins2 store)) original)
    (let [(mut state) (transform-state-new a (mut store) (mut target))]
      (match (transform-2-0 (mut state) root)
        (Err [_] (set! ok false))
        (Ok [id]
          (unless (and (= (len (.rows0 target)) 4) (= (len (.rows2 store)) 3)
                       (= (len (.traces target)) 4) (= (len (.origins0 target)) 4)) (set! ok false))
          (match (lookup-0 (mut (.rows0 target)) id)
            (Some [row] (match row (N0V2 [left right] (unless (= (.index left) (.index right)) (set! ok false))) (_ (set! ok false))))
            (None [] (set! ok false)))
          (for [i 0 (len (.traces target))]
            (let [trace (elem (mut (.traces target)) i)
                  origin (elem (mut (.origins0 target)) (.target-node trace))
                  source (elem (mut (.origins2 store)) (.source-node trace))]
              (unless (and (= (.target-schema trace) 0) (= (.source-schema trace) 2)
                           (= (.source origin) 83) (= (.lo origin) (.lo source)) (= (.hi origin) (.hi source))
                           (> (.rule-hi trace) (.rule-lo trace))) (set! ok false))))
          (match (transform-2-0 (mut state) root)
            (Ok [again] (unless (and (= (.index again) (.index id)) (= (len (.rows0 target)) 4) (= (len (.traces target)) 4)) (set! ok false)))
            (Err [_] (set! ok false)))))
      (match (transform-2-0 (mut state) (N2Id :index 999))
        (Err [e] (match e (TransformReference [schema node] (unless (and (= schema 2) (= node 999)) (set! ok false))) (_ (set! ok false))))
        (Ok [_] (set! ok false)))
      (let [cycle-id (N2Id :index (len (.rows2 store)))
            cycle (append-2 (mut (.rows2 store)) (N2V2 cycle-id cycle-id))]
        (push! (mut (.origins2 store)) original)
        (match (transform-2-0 (mut state) root)
          (Err [e] (match e (TransformSourceChanged [schema] (unless (= schema 2) (set! ok false))) (_ (set! ok false))))
          (Ok [_] (set! ok false)))
        (let [(mut fresh) (transform-state-new a (mut store) (mut target))]
          (for [attempt 0 2]
            (match (transform-2-0 (mut fresh) cycle)
              (Err [e] (match e (TransformCycle [schema node] (unless (and (= schema 2) (= node (.index cycle))) (set! ok false))) (_ (set! ok false))))
              (Ok [_] (set! ok false))))
          (match (transform-2-0 (mut fresh) root) (Err [_] (set! ok false)) (Ok [_]))
          (transform-state-free! (mut fresh))))
      (transform-state-free! (mut state)))
    (let [without-origin (append-2 (mut (.rows2 store)) (N2V0 7))
          (mut state) (transform-state-new a (mut store) (mut target))]
      (match (transform-2-0 (mut state) without-origin)
        (Err [e] (match e (TransformOriginMissing [schema node] (unless (and (= schema 2) (= node (.index without-origin))) (set! ok false))) (_ (set! ok false))))
        (Ok [_] (set! ok false)))
      (transform-state-free! (mut state)))
    (store-free! (mut store)) (store-free! (mut target)) (arena-release! arena) ok))

(defn main [] (-> i64)
  (let [sharing (sharing-and-errors) native (native-program)]
    (println "transform sharing/errors: {}; native: {}" sharing native)
    (if (and sharing native) 0 1)))
