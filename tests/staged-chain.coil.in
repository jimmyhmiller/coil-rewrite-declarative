(module fixture.main)
(import "fixture.phase" :as p)
(import "fixture.runtime" :as r)
(import "rewrite.native" :as native)
(import "rewrite.code" :as code)
(import "rewrite.codeforms" :as forms)
(import "rewrite.syntaxreader" :as projection)
(import "rewrite.invocation" :as inv)
(import "coil.alloc" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "declarative.rt.jit" :as jit)
(import "declarative.rt.image" :as image)

(defn declarations [(a (dyn Allocator)) (store (mut p/Store)) (text (slice u8))]
  (-> (ArrayList p/N1Id))
  (let [fs (match (read-all a text 2) (Ok [fs] fs) (Err [_] (panic "phase source")))
        (mut ids) (ArrayList::new [p/N1Id] a)]
    (for [i 0 (len (load fs))]
      (push! (mut ids) (match (p/parse-1 (mut store) (elem fs i)) (Ok [id] id) (Err [_] (panic "phase parse")))))
    ids))
(defn execute [(a (dyn Allocator)) (im image/Image) (entry i64)
               (input (ptr code/Syntax)) (root forms/N0Id) (output (mut code/Syntax))]
  (-> forms/N0Id)
  (let [(mut invocation) (inv/create a)
        handle (match (inv/import! (mut invocation) input root) (Ok [h] h) (Err [_] (panic "invocation import")))
        (mut hosts) (ArrayList::new [(native/ContextFunction inv/Invocation)] a)]
    (push! (mut hosts) (native/ContextFunction [inv/Invocation] :name "last"
      :context (primitive/cast (ptr inv/Invocation) (mut invocation)) :function (fnptr-of inv/last-callback)))
    (let [loaded (match (native/load-image-with-contexts a im (mut hosts)) (Ok [im] im) (Err [_] (panic "phase linkage")))
          entrypoint (primitive/cast (fnptr (cc/C) [i64] i64) (jit/address-of (.program loaded) entry))
          returned (match (inv/invoke-code! (mut invocation) entrypoint handle) (Ok [h] h) (Err [_] (panic "phase execution")))
          promoted (match (inv/promote! (mut output) (mut invocation) returned) (Ok [id] id) (Err [_] (panic "phase promotion")))]
      (native/unload-context-image! loaded)
      (inv/close! (mut invocation)) (free! (mut hosts))
      promoted)))
(defn main [] (-> i64)
  (let [(mut scratch) (zeroed ScratchArena) started (init (mut scratch) (malloc-allocator))
        a (allocator (mut scratch)) (mut phase-store) (p/store-new a)
        (mut history) (p/program-history-new a (mut phase-store))
        (mut authored) (code/create a) (mut resumed) (code/create a) (mut final) (code/create a)
        (mut ok) true
        roots (match (code/read! (mut authored) 1 "chain.guest" "(chain-a (chain-b (defn entry [(n i64)] (-> i64) (+ n 1))))") (Ok [roots] roots) (Err [_] (panic "guest input")))
        root (match (forms/sequence-item-0 (field (mut authored) store) roots 0) (Some [id] id) (None [] (panic "guest root")))
        (mut first) (declarations a (mut phase-store) "(Function \"earlier-helper\" \"n\" (Call (Variable \"last\") (Variable \"n\"))) (Function \"phase-a\" \"n\" (Call (Variable \"earlier-helper\") (Variable \"n\")))")
        image-a (match (p/extend-program a (mut history) (mut first)) (Ok [im] im) (Err [_] (panic "first increment")))
        next (execute a image-a 1 (mut authored) root (mut resumed))]
    (code/release! (mut authored))
    (match (p/extend-program a (mut history) (mut first))
      (Err [e] (match e (p/DuplicateFunction [_]) (_ (set! ok false)))) (Ok [_] (set! ok false)))
    (unless (= (len (.ids history)) 2) (set! ok false))
    (let [(mut view) (match (projection/project a (mut resumed) next) (Ok [f] f) (Err [_] (panic "guest projection")))]
      (unless (and (sexp-list? (mut view)) (= (sexp-count (mut view)) 2) (sexp-sym-is (sexp-nth (mut view) 0) "chain-b"))
        (panic "guest language was not resumed")))
    (let [(mut second) (declarations a (mut phase-store) "(Function \"phase-b\" \"n\" (Call (Variable \"earlier-helper\") (Variable \"n\")))")
          (mut empty-history) (p/program-history-new a (mut phase-store))]
      (match (p/extend-program a (mut empty-history) (mut second))
        (Err [e] (match e (p/InvalidBody [_ _]) (_ (set! ok false)))) (Ok [_] (set! ok false)))
      (unless (= (len (.ids empty-history)) 0) (set! ok false))
      (p/program-history-free! (mut empty-history))
      (let [image-b (match (p/extend-program a (mut history) (mut second)) (Ok [im] im) (Err [_] (panic "cumulative helper missing")))
            result (execute a image-b 2 (mut resumed) next (mut final))]
        (code/release! (mut resumed))
        (unless (= (len (.ids history)) 3) (set! ok false))
        (let [(mut form) (match (projection/project a (mut final) result) (Ok [f] f) (Err [_] (panic "runtime projection")))
              (mut store) (r/store-new a)
              (mut ids) (ArrayList::new [r/N1Id] a)]
          (match (get (.documents (.source-data (.store final))) 1)
            (Some [doc] (match (r/store-source! (mut store) 1 (.name doc) (.text doc))
                          (Ok [_]) (Err [_] (panic "runtime source document"))))
            (None [] (panic "promoted source missing")))
          (push! (mut ids) (match (r/surface-1 (mut store) (mut form)) (Ok [id] id) (Err [_] (panic "resume runtime grammar"))))
          (let [runtime (match (r/compile-program a (mut store) (mut ids)) (Ok [im] im) (Err [_] (panic "runtime compile")))
                loaded (native/load-image a runtime)
                run (primitive/cast (fnptr (cc/C) [i64] i64) (jit/address-of loaded 0))]
            (unless (and (= (len (.names runtime)) 1) (= (get (.names runtime) 0) "entry") (= (get (.defined runtime) 0) 0) (= (run 41) 42)) (set! ok false))
            (jit/unload! loaded)))))
    (p/program-history-free! (mut history)) (code/release! (mut final)) (close! (mut scratch))
    (println "cumulative phases: retained helper, guest resumption, teardown, runtime-only image: {}" ok)
    (if ok 0 1)))
