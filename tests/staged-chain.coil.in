(module fixture.main)
(import "fixture.phase" :as p)
(import "fixture.runtime" :as r)
(import "rewrite.native" :as native)
(import "rewrite.stageprotocol" :as protocol)
(import "rewrite.rounds" :as rounds)
(import "rewrite.stage" :as stage)
(import "rewrite.requests" :as requests)
(import "rewrite.requestexecution" :as execution)
(import "coil.hashmap" :use [HashMap])
(import "coil.str" :use [StrBuf keyops-borrowed])
(import "rewrite.code" :as code)
(import "rewrite.codeforms" :as forms)
(import "rewrite.syntaxreader" :as projection)
(import "rewrite.invocation" :as inv)
(import "coil.alloc" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "declarative.rt.jit" :as jit)
(import "declarative.rt.image" :as image)

(defn execute [(a (dyn Allocator))
               (im image/Image)
               (entry i64)
               (input (ptr code/Syntax))
               (root forms/N0Id)
               (output (mut code/Syntax))]
  (-> forms/N0Id)
  (let [(mut invocation) (inv/create a)
        handle
          (match (inv/import! (mut invocation) input root)
            (Ok [h] h)
            (Err [_] (panic "invocation import")))
        (mut hosts) (ArrayList::new [(native/ContextFunction inv/Invocation)] a)]
    (push! (mut hosts)
           (native/ContextFunction [inv/Invocation]
                                   :name
                                   "last"
                                   :context
                                   (primitive/cast (ptr inv/Invocation)
                                                   (mut invocation))
                                   :function
                                   (fnptr-of inv/last-callback)))
    (let [loaded
            (match (native/load-image-with-contexts a im (mut hosts))
              (Ok [im] im)
              (Err [_] (panic "phase linkage")))
          entrypoint
            (primitive/cast (fnptr (cc/C) [i64] i64)
                            (jit/address-of (.program loaded) entry))
          returned
            (match (inv/invoke-code! (mut invocation) entrypoint handle)
              (Ok [h] h)
              (Err [_] (panic "phase execution")))
          promoted
            (match (inv/promote! (mut output) (mut invocation) returned)
              (Ok [id] id)
              (Err [_] (panic "phase promotion")))]
      (native/unload-context-image! loaded)
      (inv/close! (mut invocation))
      (free! (mut hosts))
      promoted)))

(defsum StageFailure (UnexpectedGuest) (PhaseRejected))

(defstruct Expansion
  [(allocator (dyn Allocator))
   (store (ptr p/Store))
   (history (ptr p/ProgramHistory))
   (current (ptr code/Syntax))
   (root forms/N0Id)
   (pending (ptr code/Syntax))
   (pending-root forms/N0Id)
   (output (ptr rounds/Generation))
   (markers (ArrayList (slice u8)))
   (image (Option image/Image))
   (stage i64)
   (rounds i64)
   (ok bool)])

(defn declarations [(context (ptr Expansion)) (source (slice u8))]
  (-> (ArrayList p/N1Id))
  (let [a (.allocator context)
        (mut input) (code/create a)
        (mut text) (StrBuf::new a)
        (mut tagged) (ArrayList::new [stage/Tagged] a)
        (mut ids) (ArrayList::new [p/N1Id] a)
        (mut body) (ArrayList::new [forms/N0Id] a)
        source-id (+ 2 (.stage context))]
    (defer (code/release! (mut input)))
    (defer (free! (mut text)))
    (defer (free! (mut tagged)))
    (defer (free! (mut body)))
    (push-str! (mut text) "(stage phase-request ")
    (push-str! (mut text) source)
    (push-str! (mut text) ")")
    (let [roots
            (match (code/read! (mut input)
                               source-id
                               "phase.coil"
                               (str (load text)))
              (Ok [ids] ids)
              (Err [_] (panic "stage source")))
          root
            (match (forms/sequence-item-0 (field (mut input) store) roots 0)
              (Some [id] id)
              (None [] (panic "stage root")))]
      (push! (mut tagged) (stage/Tagged :form root :module (None))))
    (let [(mut split)
            (match (stage/split a
                                (mut input)
                                (mut tagged)
                                (field context markers))
              (Ok [split] split)
              (Err [_] (panic "stage partition")))]
      (defer (stage/release! (mut split)))
      (unless (= (len (.runtime split)) 0) (panic "stage leaked into runtime"))
      (free! (mut (.markers context)))
      (set! (.markers context) (ArrayList::new [(slice u8)] a))
      (for marker (.markers split)
        (push! (mut (.markers context)) (p/store-text! (.store context) marker)))
      (match (p/store-source! (.store context)
                              source-id
                              "phase.coil"
                              (str (load text)))
        (Ok [_])
        (Err [_] (panic "phase document")))
      (for entry (.staged split)
        (let [(mut form)
                (match (projection/project a
                                           (field (mut split) syntax)
                                           (.form entry))
                  (Ok [form] form)
                  (Err [_] (panic "isolated phase projection")))
              id
                (match (p/parse-1 (.store context) (mut form))
                  (Ok [id] id)
                  (Err [_] (panic "phase parse")))
              owned
                (match (code/promote! (field (.output context) syntax)
                                      (field (mut split) syntax)
                                      (.form entry))
                  (Ok [id] id)
                  (Err [_] (panic "owned stage declaration")))]
          (push! (mut ids) id)
          (push! (mut body) owned)))
      (let [output (.output context)
            roots (forms/sequence-0 (mut (.store (.syntax output))) (mut body))]
        (set! (mut (.rows2 (.store (.syntax output))))
              (.index (.introduced output))
              (forms/N2Row :f0 roots))))
    ids))

(defn route :cc (cc/C) [(context (ptr Expansion))]
  (-> (Result protocol/Event StageFailure))
  (let [(mut view)
          (match (projection/project (.allocator context)
                                     (.current context)
                                     (.root context))
            (Ok [form] form)
            (Err [_] (panic "projection")))]
    (if (and (sexp-list? (mut view)) (> (sexp-count (mut view)) 0))
        (let [tag (sexp-nth (mut view) 0)]
          (cond (sexp-sym-is tag "defn") (Ok (protocol/Event-Done))
                (sexp-sym-is tag "chain-a")
                  (do (set! (.stage context) 0) (Ok (protocol/Event-Request)))
                (sexp-sym-is tag "chain-b")
                  (do (set! (.stage context) 1) (Ok (protocol/Event-Request)))
                :else (Err (UnexpectedGuest))))
        (Err (UnexpectedGuest)))))

(defn install :cc (cc/C) [(context (ptr Expansion))]
  (-> (Result protocol/Event StageFailure))
  (let [a (.allocator context)
        source
          (if (= (.stage context) 0)
              "(Function \"earlier-helper\" \"n\" (Call (Variable \"last\") (Variable \"n\"))) (Function \"phase-a\" \"n\" (Call (Variable \"earlier-helper\") (Variable \"n\")))"
              "(Function \"phase-b\" \"n\" (Call (Variable \"earlier-helper\") (Variable \"n\")))")
        (mut added) (declarations context source)]
    (when (= (.stage context) 1)
      (let [(mut empty) (p/program-history-new a (.store context))]
        (match (p/extend-program a (mut empty) (mut added))
          (Err [e]
               (match e (p/InvalidBody [_ _]) (_ (set! (.ok context) false))))
          (Ok [_] (set! (.ok context) false)))
        (unless (= (len (.ids empty)) 0) (set! (.ok context) false))
        (p/program-history-free! (mut empty))))
    (match (p/extend-program a (.history context) (mut added))
      (Err [_] (Err (PhaseRejected)))
      (Ok [im]
          (set! (.image context) (Some im))
          (when (= (.stage context) 0)
            (match (p/extend-program a (.history context) (mut added))
              (Err [e]
                   (match e
                     (p/DuplicateFunction [_])
                     (_ (set! (.ok context) false))))
              (Ok [_] (set! (.ok context) false)))
            (unless (= (len (.ids (.history context))) 2)
              (set! (.ok context) false)))
          (Ok (protocol/Event-Ready))))))

(defstruct NativeCall [(allocator (dyn Allocator)) (image image/Image)])

(defn native-request :cc (cc/C) [(context (ptr NativeCall))
                                 (call (ptr requests/Call))
                                 (syntax (ptr code/Syntax))]
  (-> (Result forms/N0Id StageFailure))
  (block :done
    (unless (= (- (sexp-count (.source (.arguments call)))
                  (.start (.arguments call)))
               1)
      (break :done (Err (UnexpectedGuest))))
    (let [argument
            (sexp-nth (.source (.arguments call)) (.start (.arguments call)))
          root
            (match (code/import-form! syntax argument)
              (Ok [id] id)
              (Err [_] (break :done (Err (UnexpectedGuest)))))
          (mut entry) (- 0 1)]
      (for [i 0 (len (.names (.image context)))]
        (when (= (get (.names (.image context)) i) (.entry call))
          (set! entry i)))
      (when (< entry 0) (break :done (Err (PhaseRejected))))
      (Ok (execute (.allocator context)
                   (.image context)
                   entry
                   syntax
                   root
                   syntax)))))

(defn invoke :cc (cc/C) [(context (ptr Expansion))]
  (-> (Result protocol/Event StageFailure))
  (let [a (.allocator context)
        im
          (match (.image context)
            (Some [im] im)
            (None [] (panic "installed image")))
        (mut markers) (HashMap::new [(slice u8) bool] a (keyops-borrowed))
        (mut entries) (HashMap::new [(slice u8) bool] a (keyops-borrowed))
        (mut items) (ArrayList::new [Sexp] a)
        (mut input) (code/create a)
        (mut session) (execution/create a)
        (mut callback) (NativeCall :allocator a :image im)
        owned
          (match (code/promote! (mut input) (.current context) (.root context))
            (Ok [id] id)
            (Err [_] (panic "request argument ownership")))
        argument
          (match (projection/project a (mut input) owned)
            (Ok [form] form)
            (Err [_] (panic "request argument")))]
    (defer (free! (mut markers)))
    (defer (free! (mut entries)))
    (defer (free! (mut items)))
    (defer (code/release! (mut input)))
    (defer (execution/close! (mut session)))
    (for marker (.markers context) (set! (mut markers) marker true))
    (for name (.names im) (set! (mut entries) name true))
    (match (forms/store-source! (mut (.store input)) 0 "request" "")
      (Ok [_])
      (Err [_] (panic "synthetic request origin")))
    (push! (mut items) (mk-sexp (KSym "phase-request") 0 0))
    (push! (mut items)
           (mk-sexp (KSym (if (= (.stage context) 0) "phase-a" "phase-b")) 0 0))
    (push! (mut items) argument)
    (let [(mut request) (mk-sexp (KList (box! a (ArrayList Sexp) items)) 0 0)
          root
            (match (code/import-form! (mut input) (mut request))
              (Ok [id] id)
              (Err [_] (panic "owned request")))
          returned
            (match (execution/run! (mut session)
                                   (mut input)
                                   root
                                   (None)
                                   (mut markers)
                                   (mut entries)
                                   (mut callback)
                                   (fnptr-of native-request))
              (Ok [id] id)
              (Err [_] (panic "native request execution")))]
      (unless (= (.calls session) 1) (panic "unexpected native call count"))
      (set! (.pending-root context)
            (match (code/promote! (.pending context)
                                  (field (mut session) syntax)
                                  returned)
              (Ok [id] id)
              (Err [_] (panic "request result ownership")))))
    (Ok (protocol/Event-Returned))))

(defn round-effect :cc (cc/C) [(context (ptr Expansion))
                               (input (ptr rounds/Generation))
                               (output (ptr rounds/Generation))]
  (-> (Result bool StageFailure))
  (set! (.current context)
        (primitive/cast (ptr code/Syntax) (field input syntax)))
  (set! (.pending context)
        (primitive/cast (ptr code/Syntax) (field output syntax)))
  (set! (.output context) output)
  (let [store (field (field input syntax) store)
        items (.f0 (get (.rows2 store) (.index (.runtime input))))
        (mut roots) (ArrayList::new [forms/N0Id] (.allocator context))]
    (defer (free! (mut roots)))
    (set! (.root context)
          (match (forms/sequence-item-0 store items 0)
            (Some [id] id)
            (None [] (panic "generation root"))))
    (block :done
      (match (route context)
        (Err [e] (break :done (Err e)))
        (Ok [event]
            (match event
              (protocol/Event-Done []
                                   (set! (.pending-root context)
                                         (match (code/promote! (.pending context)
                                                               (.current context)
                                                               (.root context))
                                           (Ok [id] id)
                                           (Err [_] (panic "stable promotion")))))
              (protocol/Event-Request []
                                      (match (install context)
                                        (Err [e] (break :done (Err e)))
                                        (Ok [_]))
                                      (match (invoke context)
                                        (Err [e] (break :done (Err e)))
                                        (Ok [_]))
                                      (set! (.rounds context)
                                            (+ (.rounds context) 1)))
              (_ (panic "route outcome")))))
      (push! (mut roots) (.pending-root context))
      (let [seq (forms/sequence-0 (mut (.store (.syntax output))) (mut roots))]
        (set! (mut (.rows2 (.store (.syntax output))))
              (.index (.runtime output))
              (forms/N2Row :f0 seq)))
      (Ok true))))

(defn main [] (-> i64)
  (let [(mut scratch) (zeroed ScratchArena)
        started (init (mut scratch) (malloc-allocator))
        a (allocator (mut scratch))
        (mut session) (rounds/session a)
        (mut phase-store) (p/store-new a)
        (mut history) (p/program-history-new a (mut phase-store))
        (mut context)
          (Expansion
            :allocator a
            :store (primitive/cast (ptr p/Store) (mut phase-store))
            :history (primitive/cast (ptr p/ProgramHistory) (mut history))
            :current (zeroed (ptr code/Syntax))
            :root (forms/N0Id :index 0)
            :pending (zeroed (ptr code/Syntax))
            :pending-root (forms/N0Id :index 0)
            :output (zeroed (ptr rounds/Generation))
            :markers (ArrayList::new [(slice u8)] a)
            :image (None)
            :stage 0
            :rounds 0
            :ok true)]
    (match (rounds/read! (mut (.current session))
                         false
                         1
                         "chain.guest"
                         "(chain-a (chain-b (defn entry [(n i64)] (-> i64) (+ n 1))))")
      (Ok [_])
      (Err [_] (panic "guest input")))
    (match (rounds/run! (mut session) (mut context) (fnptr-of round-effect))
      (Ok [_])
      (Err [_] (panic "owned staging rounds")))
    ; Reborrow the accepted generation after the runner has finished.
    (set! (.current context)
          (primitive/cast (ptr code/Syntax)
                          (field (mut (.current session)) syntax)))
    (let [store
            (primitive/cast (ptr forms/Store)
                            (field (mut (.syntax (.current session))) store))
          items
            (.f0 (get (.rows2 store) (.index (.runtime (.current session)))))]
      (set! (.root context)
            (match (forms/sequence-item-0 store items 0)
              (Some [id] id)
              (None [] (panic "accepted root")))))
    (unless (and (= (.calls session) 3) (= (.accepted session) 2))
      (set! (.ok context) false))
    (unless (and (= (.rounds context) 2) (= (len (.ids history)) 3))
      (set! (.ok context) false))
    (let [(mut form)
            (match (projection/project a (.current context) (.root context))
              (Ok [f] f)
              (Err [_] (panic "runtime projection")))
          (mut store) (r/store-new a)
          (mut ids) (ArrayList::new [r/N1Id] a)]
      (match (get (.documents (.source-data (.store (.current context)))) 1)
        (Some [doc]
              (match (r/store-source! (mut store) 1 (.name doc) (.text doc))
                (Ok [_])
                (Err [_] (panic "runtime source document"))))
        (None [] (panic "promoted source missing")))
      (push! (mut ids)
             (match (r/surface-1 (mut store) (mut form))
               (Ok [id] id)
               (Err [_] (panic "runtime grammar"))))
      (let [runtime
              (match (r/compile-program a (mut store) (mut ids))
                (Ok [im] im)
                (Err [_] (panic "runtime compile")))
            loaded (native/load-image a runtime)
            run
              (primitive/cast (fnptr (cc/C) [i64] i64)
                              (jit/address-of loaded 0))]
        (unless (and (= (len (.names runtime)) 1)
                     (= (get (.names runtime) 0) "entry")
                     (= (get (.defined runtime) 0) 0)
                     (= (run 41) 42))
          (set! (.ok context) false))
        (jit/unload! loaded)))
    (let [ok (.ok context)]
      (unless (and (= (len (.markers context)) 1)
                   (= (get (.markers context) 0) "phase-request"))
        (panic "marker history"))
      (free! (mut (.markers context)))
      (p/program-history-free! (mut history))
      (rounds/close! (mut session))
      (close! (mut scratch))
      (println "owned staging rounds: cumulative helper, resumption, equality, teardown and runtime image: {}"
               ok)
      (if ok 0 1))))
