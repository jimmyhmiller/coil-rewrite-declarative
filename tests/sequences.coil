(module rewrite.tests.sequences)
(import "rewrite.sequence" :as sequence)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(import "coil.primitive" :as primitive)

(defsum MapFailure
  (Rejected [(value i64)])
  (Storage [(error sequence/SequenceError)]))

(defstruct Mapper [(output (sequence/Table i64)) (calls i64) (reject i64)])

(defn map-value [(context (ptr Mapper)) (value i64)]
  (-> (Result i64 MapFailure))
  (store! (field context calls) (+ (.calls context) 1))
  (if (= value (.reject context))
      (Err (Rejected value))
      (Ok (sequence/singleton! (mut (.output context)) value))))

(defn map-error [(error sequence/SequenceError)] (-> MapFailure)
  (Storage error))

(defn check-map [(a (dyn Allocator))
                 (input (mut (sequence/Table i64)))
                 (root i64)] (-> bool)
  (let [(mut context)
          (Mapper
            :output (sequence/create [i64] a)
            :calls 0
            :reject 5000)
        (mut memo) (ArrayList::new [i64] a)
        (mut values) (ArrayList::new [i64] a)
        (mut ok) true]
    (for [i 0 (len (.segments input))] (push! (mut memo) (- 0 1)))
    (match (sequence/map! a
                          input
                          (mut (.output context))
                          (mut memo)
                          root
                          (mut context)
                          (primitive/fnptr-of map-value)
                          (primitive/fnptr-of map-error))
      (Err [e]
           (match e
             (Rejected [value] (unless (= value 5000) (set! ok false)))
             (_ (set! ok false))))
      (Ok [_] (set! ok false)))
    (for value memo (when (= value (- 0 2)) (set! ok false)))
    (store! (mut (.reject context)) (- 0 1))
    (match (sequence/map! a
                          input
                          (mut (.output context))
                          (mut memo)
                          root
                          (mut context)
                          (primitive/fnptr-of map-value)
                          (primitive/fnptr-of map-error))
      (Ok [mapped]
          (match (sequence/materialize! a
                                        (field (mut context) output)
                                        mapped
                                        (mut values))
            (Ok [n] (unless (= n 10001) (set! ok false)))
            (Err [_] (set! ok false))))
      (Err [_] (set! ok false)))
    (unless (= (.calls context) 10002) (set! ok false))
    (for [i 0 (len values)] (unless (= (get values i) i) (set! ok false)))
    ; Corrupt a private test graph to exercise cycle failure and visiting-marker cleanup.
    (let [edge (.start (get (.segments input) root))
          old (get (.edges input) edge)]
      (for [i 0 (len memo)] (set! (mut memo) i (- 0 1)))
      (set! (mut (.edges input)) edge root)
      (match (sequence/map! a
                            input
                            (mut (.output context))
                            (mut memo)
                            root
                            (mut context)
                            (primitive/fnptr-of map-value)
                            (primitive/fnptr-of map-error))
        (Err [e]
             (match e
               (Storage [error]
                        (match error
                          (sequence/SequenceCycle [index])
                          (_ (set! ok false))))
               (_ (set! ok false))))
        (Ok [_] (set! ok false)))
      (for value memo (when (= value (- 0 2)) (set! ok false)))
      (set! (mut (.edges input)) edge old))
    (sequence/singleton! (mut input) 42)
    (match (sequence/map! a
                          input
                          (mut (.output context))
                          (mut memo)
                          root
                          (mut context)
                          (primitive/fnptr-of map-value)
                          (primitive/fnptr-of map-error))
      (Err [e]
           (match e
             (Storage [error]
                      (match error
                        (sequence/SequenceSourceChanged [])
                        (_ (set! ok false))))
             (_ (set! ok false))))
      (Ok [_] (set! ok false)))
    (sequence/release! (mut (.output context)))
    (free! (mut memo))
    (free! (mut values))
    ok))

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut table) (sequence/create [i64] a)
        (mut parts) (ArrayList::new [i64] a)
        (mut output) (ArrayList::new [i64] a)
        first (sequence/singleton! (mut table) 0)
        (mut root) first
        (mut ok) true]
    (push! (mut parts) 0)
    (push! (mut parts) 0)
    (for [i 0 10000]
      (let [leaf (sequence/singleton! (mut table) (+ i 1))]
        (set! (mut parts) 0 root)
        (set! (mut parts) 1 leaf)
        (set! root
              (match (sequence/join! (mut table) (mut parts))
                (Ok [id] id)
                (Err [_] (panic "join"))))))
    (unless (and (= (len (.segments table)) 20001)
                 (= (len (.edges table)) 20000)
                 (= (len (.values table)) 10001))
      (set! ok false))
    (match (sequence/materialize! a (mut table) root (mut output))
      (Ok [n] (unless (= n 10001) (set! ok false)))
      (Err [_] (set! ok false)))
    (for [i 0 (len output)] (unless (= (get output i) i) (set! ok false)))
    (match (sequence/item (mut table) first 0)
      (Some [n] (unless (= n 0) (set! ok false)))
      (None [] (set! ok false)))
    (match (sequence/item (mut table) root 10000)
      (Some [n] (unless (= n 10000) (set! ok false)))
      (None [] (set! ok false)))
    (match (sequence/item (mut table) root 10001)
      (None [])
      (Some [_] (set! ok false)))
    (match (sequence/item (mut table) (- 0 1) 0)
      (None [])
      (Some [_] (set! ok false)))
    (unless (check-map a (mut table) root) (set! ok false))
    ; A compact shared DAG can describe an enormous sequence without allocating it.
    (set! root first)
    (for [i 0 62]
      (set! (mut parts) 0 root)
      (set! (mut parts) 1 root)
      (set! root
            (match (sequence/join! (mut table) (mut parts))
              (Ok [id] id)
              (Err [_] (panic "doubling")))))
    (match (sequence/size (mut table) root)
      (Some [n] (unless (= n 4611686018427387904) (set! ok false)))
      (None [] (set! ok false)))
    (let [segments (len (.segments table))
          edges (len (.edges table))]
      (set! (mut parts) 0 root)
      (set! (mut parts) 1 root)
      (match (sequence/join! (mut table) (mut parts))
        (Err [e] (match e (sequence/SequenceCapacity []) (_ (set! ok false))))
        (Ok [_] (set! ok false)))
      (set! (mut parts) 1 (- 0 1))
      (match (sequence/join! (mut table) (mut parts))
        (Err [e]
             (match e
               (sequence/InvalidSequence [id]
                                         (unless (= id (- 0 1)) (set! ok false)))
               (_ (set! ok false))))
        (Ok [_] (set! ok false)))
      (unless (and (= segments (len (.segments table)))
                   (= edges (len (.edges table))))
        (set! ok false)))
    (sequence/release! (mut table))
    (free! (mut parts))
    (free! (mut output))
    (println "sequence growth, sharing, deep traversal and capacity: {}" ok)
    (if ok 0 1)))
