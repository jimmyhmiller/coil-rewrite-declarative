(module rewrite.tests.sequences)
(import "rewrite.sequence" :as sequence)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)

(defn main [] (-> i64)
  (let [a (malloc-allocator)
        (mut table) (sequence/create [i64] a)
        (mut parts) (ArrayList::new [i64] a)
        (mut output) (ArrayList::new [i64] a)
        first (sequence/singleton! (mut table) 0)
        (mut root) first
        (mut ok) true]
    (push! (mut parts) 0)
    (push! (mut parts) 0)
    (for [i 0 10000]
      (let [leaf (sequence/singleton! (mut table) (+ i 1))]
        (set! (mut parts) 0 root)
        (set! (mut parts) 1 leaf)
        (set! root
              (match (sequence/join! (mut table) (mut parts))
                (Ok [id] id)
                (Err [_] (panic "join"))))))
    (unless (and (= (len (.segments table)) 20001)
                 (= (len (.edges table)) 20000)
                 (= (len (.values table)) 10001))
      (set! ok false))
    (match (sequence/materialize! a (mut table) root (mut output))
      (Ok [n] (unless (= n 10001) (set! ok false)))
      (Err [_] (set! ok false)))
    (for [i 0 (len output)] (unless (= (get output i) i) (set! ok false)))
    (match (sequence/item (mut table) first 0)
      (Some [n] (unless (= n 0) (set! ok false)))
      (None [] (set! ok false)))
    (match (sequence/item (mut table) root 10000)
      (Some [n] (unless (= n 10000) (set! ok false)))
      (None [] (set! ok false)))
    (match (sequence/item (mut table) root 10001)
      (None [])
      (Some [_] (set! ok false)))
    (match (sequence/item (mut table) (- 0 1) 0)
      (None [])
      (Some [_] (set! ok false)))
    ; A compact shared DAG can describe an enormous sequence without allocating it.
    (set! root first)
    (for [i 0 62]
      (set! (mut parts) 0 root)
      (set! (mut parts) 1 root)
      (set! root
            (match (sequence/join! (mut table) (mut parts))
              (Ok [id] id)
              (Err [_] (panic "doubling")))))
    (match (sequence/size (mut table) root)
      (Some [n] (unless (= n 4611686018427387904) (set! ok false)))
      (None [] (set! ok false)))
    (let [segments (len (.segments table))
          edges (len (.edges table))]
      (set! (mut parts) 0 root)
      (set! (mut parts) 1 root)
      (match (sequence/join! (mut table) (mut parts))
        (Err [e] (match e (sequence/SequenceCapacity []) (_ (set! ok false))))
        (Ok [_] (set! ok false)))
      (set! (mut parts) 1 (- 0 1))
      (match (sequence/join! (mut table) (mut parts))
        (Err [e]
             (match e
               (sequence/InvalidSequence [id]
                                         (unless (= id (- 0 1)) (set! ok false)))
               (_ (set! ok false))))
        (Ok [_] (set! ok false)))
      (unless (and (= segments (len (.segments table)))
                   (= edges (len (.edges table))))
        (set! ok false)))
    (sequence/release! (mut table))
    (free! (mut parts))
    (free! (mut output))
    (println "sequence growth, sharing, deep traversal and capacity: {}" ok)
    (if ok 0 1)))
