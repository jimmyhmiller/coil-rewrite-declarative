(module rewrite.testrounds)
(import "rewrite.rounds" :as rounds)
(import "rewrite.beforeprotocol" :as p)
(import "rewrite.codeforms" :as forms)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(import "coil.str" :use [StrBuf])
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(defstruct Script
  [(session (ptr rounds/Session)) (target i64) (mode i64) (effects i64)])

(defn first-value [(g (ptr rounds/Generation))] (-> i64)
  (let [s (field (field g syntax) store)
        roots (.f0 (get (.rows2 s) (.index (.runtime g))))
        id
          (match (forms/sequence-item-0 s roots 0)
            (Some [id] id)
            (None [] (panic "root")))]
    (match (get (.rows0 s) (.index id))
      (forms/N0V0 [n] n)
      (_ (panic "integer")))))

(defn effect :cc (cc/C) [(script (ptr Script))
                         (input (ptr rounds/Generation))
                         (output (ptr rounds/Generation))]
  (-> (Result bool i64))
  (let [s (.session script)
        a (.allocator s)
        n (first-value input)
        next (if (< n (.target script)) (+ n 1) n)
        (mut text) (StrBuf::new a)]
    (defer (free! (mut text)))
    (set! (.effects script) (+ (.effects script) 1))
    ; Re-entry and teardown must not invalidate the live input/output borrows.
    (when (rounds/close! s) (panic "closed active round"))
    (match (rounds/run! s script (primitive/fnptr-of effect))
      (Err [e] (match e (rounds/AlreadyRunning []) (_ (panic "reentry error"))))
      (_ (panic "reentry accepted")))
    (push-i64! (mut text) next)
    (unless (= (.mode script) 7)
      (push-str! (mut text) (if (= (.mode script) 6) " changed" " sentinel")))
    (match (rounds/read! output false 1 "round.coil" (str (load text)))
      (Ok [_])
      (Err [_] (panic "round output")))
    ; Actual candidate declaration batches determine stage progress.
    (when (or (= (.mode script) 1)
              (and (= (.mode script) 2) (< n 16))
              (and (= (.mode script) 3) (= n 16)))
      (match (rounds/read! output
                           true
                           2
                           "stage.coil"
                           "(defn helper [] (-> i64) 42)")
        (Ok [_])
        (Err [_] (panic "stage output"))))
    ; Equality ignores metadata changes and keeps the existing generation.
    (set! (.f0 (elem (field (field output syntax) contexts) 0)) 99)
    (cond (= (.mode script) 4) (Err 77)
          (= (.mode script) 5)
            (do (set! (.runtime output) (forms/N2Id :index (- 0 1))) (Ok true))
          :else (Ok true))))

(defn check [(target i64) (mode i64) (calls i64) (accepted i64) (limit i64)]
  (-> void)
  (let [a (malloc-allocator)
        (mut s) (rounds/session a)
        (mut script)
          (Script
            :session (primitive/cast (ptr rounds/Session) (mut s))
            :target target
            :mode mode
            :effects 0)]
    (match (rounds/read! (mut (.current s)) false 1 "initial.coil" "0 sentinel")
      (Ok [_])
      (Err [_] (panic "initial")))
    (match (rounds/run! (mut s) (mut script) (primitive/fnptr-of effect))
      (Ok [_] (unless (= limit 0) (panic "missing guard")))
      (Err [e]
           (match e
             (rounds/ProtocolFailure [failure]
                                     (match failure
                                       (p/Exhausted [budget actual]
                                                    (unless (and (= actual
                                                                    limit)
                                                                 (= (p/budget-name budget)
                                                                    "rounds"))
                                                      (panic "wrong guard")))
                                       (p/HandlerError [_ cause]
                                                       (match cause
                                                         (rounds/Effect [value]
                                                                        (unless (and (= mode
                                                                                        4)
                                                                                     (= value
                                                                                        77))
                                                                          (panic "effect error")))
                                                         (rounds/Comparison [_]
                                                                            (unless (= mode
                                                                                       5)
                                                                              (panic "comparison error")))))
                                       (_ (panic "protocol failure"))))
             (_ (panic "runner failure")))))
    (unless (and (= (.calls s) calls)
                 (= (.accepted s) accepted)
                 (= (.effects script) calls)
                 (= (first-value (mut (.current s))) accepted))
      (panic "publication counts"))
    (when (= accepted 0)
      (unless (= (.f0 (get (.contexts (.syntax (.current s))) 0)) 0)
        (panic "equal candidate published")))
    ; The last candidate, including a failed effect's output, remains owned.
    (unless (>= (len (.rows0 (.store (.syntax (.candidate s))))) 2)
      (panic "candidate lost"))
    ; A fresh run keeps accepted input but receives a fresh budget/candidate.
    (set! (.mode script) 0)
    (set! (.target script) accepted)
    (set! (.effects script) 0)
    (match (rounds/run! (mut s) (mut script) (primitive/fnptr-of effect))
      (Ok [_])
      (Err [_] (panic "retry")))
    (unless (and (= (.calls s) 1) (= (.accepted s) 0)) (panic "fresh run"))
    (unless (and (rounds/close! (mut s)) (rounds/close! (mut s)))
      (panic "close"))
    (match (rounds/run! (mut s) (mut script) (primitive/fnptr-of effect))
      (Err [e] (match e (rounds/Closed []) (_ (panic "closed error"))))
      (_ (panic "closed run accepted")))))

(defn check-whole-forms [(mode i64)] (-> void)
  (let [a (malloc-allocator)
        (mut s) (rounds/session a)
        (mut script)
          (Script
            :session (primitive/cast (ptr rounds/Session) (mut s))
            :target 0
            :mode mode
            :effects 0)]
    (match (rounds/read! (mut (.current s)) false 1 "initial.coil" "0 sentinel")
      (Ok [_])
      (Err [_] (panic "initial")))
    (match (rounds/run! (mut s) (mut script) (primitive/fnptr-of effect))
      (Ok [_])
      (Err [_] (panic "whole form round")))
    (unless (and (= (.calls s) 2)
                 (= (.accepted s) 1)
                 (= (first-value (mut (.current s))) 0))
      (panic "ignored later root or arity"))
    (rounds/close! (mut s))))

(defn main [] (-> i64)
  (check-whole-forms 6)
  (check-whole-forms 7)
  (check 0 0 1 0 0)
  (check 0 1 1 0 0)
  (check 16 0 17 16 0)
  (check 17 0 17 16 16)
  (check 64 1 65 64 0)
  (check 65 1 65 64 64)
  (check 16 2 17 16 0)
  (check 17 2 17 16 16)
  (check 17 3 18 17 0)
  (check 18 3 18 17 16)
  (check 1 4 1 0 0)
  (check 1 5 1 0 0)
  (println "owned expansion rounds: whole-form equality, stage batches, publication, limits, effects, reuse and lifetimes passed")
  0)
