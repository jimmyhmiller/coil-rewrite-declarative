(defn entry [(x i64)] (-> i64)
  (let [y (increment x)]
    (if true (+ y y) 0)))

(defn increment [(x i64)] (-> i64)
  (+ x 1))

(defn factorial [(x i64)] (-> i64)
  (if (<= x 1) 1 (* x (factorial (- x 1)))))

(defn fibonacci [(x i64)] (-> i64)
  (if (< x 2) x (+ (fibonacci (- x 1)) (fibonacci (- x 2)))))

(defn even [(x i64)] (-> i64)
  (if (= x 0) 1 (odd (- x 1))))

(defn odd [(x i64)] (-> i64)
  (if (!= x 0) (even (- x 1)) 0))

(defn comparisons [(x i64)] (-> i64)
  (+ (+ (+ (if (= x 0) 1 0) (if (!= x 0) 2 0))
        (+ (if (< x 0) 4 0) (if (<= x 0) 8 0)))
     (+ (if (> x 0) 16 0) (if (>= x 0) 32 0))))
