(module fixture.main)
(import "rewrite.generated" :use *)
(import "rewrite.source" :as source)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)

(defn main [] (-> i64)
  (let [a (malloc-allocator) (mut input) (store-new a) (mut output) (store-new a)
        origin (source/Origin :source 101 :lo 0 :hi 1)
        leaf (append-0 (mut (.rows0 input)) (N0V0 7))
        empty (append-0 (mut (.rows0 input)) (N0V1))
        shared (append-0 (mut (.rows0 input)) (N0V2 leaf leaf))
        (mut root) shared (mut ok) true (mut small) (N1Seq :index 0)
        (mut values) (ArrayList::new [N1Id] a)]
    (match (store-source! (mut input) 101 "maps.coil" "x") (Ok [_]) (Err [_] (set! ok false)))
    (for [i 0 3] (push! (mut (.origins0 input)) origin))
    (for [i 0 60]
      (set! root (append-0 (mut (.rows0 input)) (N0V2 root root)))
      (push! (mut (.origins0 input)) origin))
    (let [overflow (append-0 (mut (.rows0 input)) (N0V2 root root))]
      (push! (mut (.origins0 input)) origin)
      (let [(mut state) (transform-state-new a (mut input) (mut output))]
        (match (transform-many-0-1 (mut state) empty)
          (Ok [ids] (match (sequence-size-1 (mut output) ids)
                      (Some [n] (unless (= n 0) (set! ok false))) (None [] (set! ok false))))
          (Err [_] (set! ok false)))
        (match (transform-many-0-1 (mut state) shared)
          (Ok [ids] (set! small ids)) (Err [_] (set! ok false)))
        (match (transform-many-0-1 (mut state) root)
          (Ok [ids] (match (sequence-size-1 (mut output) ids)
                      (Some [n] (unless (= n 4611686018427387904) (set! ok false))) (None [] (set! ok false))))
          (Err [_] (set! ok false)))
        (unless (and (= (len (.rows1 output)) 2) (= (len (.traces output)) 2)
                     (= (len (.values (.sequences1 output))) 2)
                     (< (len (.segments (.sequences1 output))) 70)
                     (< (len (.edges (.sequences1 output))) 130)) (set! ok false))
        (for [attempt 0 2]
          (match (transform-many-0-1 (mut state) overflow)
            (Err [e] (match e (TransformSequence [error]) (_ (set! ok false))))
            (Ok [_] (set! ok false))))
        ; Scalar and sequence maps for the same schemas coexist without cardinality coercion.
        (match (transform-0-1 (mut state) leaf)
          (Ok [id] (unless (= (.f0 (get (.rows1 output) (.index id))) 7) (set! ok false)))
          (Err [_] (set! ok false)))
        (transform-state-free! (mut state))))
    (store-free! (mut input))
    (match (sequence-materialize-1 a (mut output) small (mut values))
      (Ok [n] (unless (= n 4) (set! ok false))) (Err [_] (set! ok false)))
    (when (= (len values) 4)
      (unless (and (= (.index (get values 0)) (.index (get values 2)))
                   (= (.index (get values 1)) (.index (get values 3)))
                   (= (.f0 (get (.rows1 output) (.index (get values 0)))) 7)
                   (= (.f0 (get (.rows1 output) (.index (get values 1)))) 99))
        (set! ok false)))
    (store-free! (mut output)) (free! (mut values))
    (println "sequence maps: omission, sharing, cardinality, lifetime, capacity: {}" ok)
    (if ok 0 1)))
