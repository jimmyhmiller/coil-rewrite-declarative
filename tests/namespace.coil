(module rewrite.testnamespace)
(import "rewrite.namespace" :as namespace)
(import "rewrite.nameforms" :as forms)
(import "rewrite.searchruntime" :as search)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.debug-allocator" :use [DebugAllocator])
(import "coil.result" :use *)

(defn expect [(a (dyn Allocator))
              (view (ptr namespace/View))
              (owner (slice u8))
              (name (slice u8))
              (depth i64)
              (target (Option (slice u8)))]
  (-> search/Stats)
  (let [(mut stats) (search/Stats :expanded 0 :cached 0)]
    (match (namespace/exported a view owner name depth (mut stats))
      (Err [_] (panic "lookup error"))
      (Ok [actual]
          (match target
            (None [] (match actual (None []) (_ (panic "expected missing"))))
            (Some [target]
                  (match actual
                    (Some [actual]
                          (unless (= target actual) (panic "wrong target")))
                    (None [] (panic "missing target")))))))
    stats))

(defn check [(a (dyn Allocator))] (-> void)
  (let [(mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        (mut store) (forms/store-new a)
        source
          "(Namespace
          [(Declaration \"base.a\") (Declaration \"base.b\") (Declaration \"other.a\")
           (Declaration \"facade.own\") (Declaration \"unrecorded.x\") (Declaration \"base.own\") (Declaration \"hidden.a\")]
          [(Alias \"facade.alias\" \"base.a\") (Alias \"facade.chain\" \"facade.alias\")]
          [(ExportModule \"facade\" true [(Name \"a\") (Name \"local\") (Name \"own\") (Name \"alias\") (Name \"chain\")]
             [(Reexport \"base\" (Refer false [] [] [(Rename \"b\" \"local\")]))
              (Reexport \"base\" (Refer true [] [] []))
              (Reexport \"other\" (Refer true [] [] []))])
           (ExportModule \"base\" true [(Name \"a\") (Name \"b\") (Name \"own\")] [])
           (ExportModule \"variants\" false [] [(Reexport \"base\" (Refer false [] [] [(Rename \"ghost\" \"x\")])) (Reexport \"base\" (Refer false [] [] [(Rename \"a\" \"x\")]))])
           (ExportModule \"hidden\" true [] [(Reexport \"base\" (Refer true [] [] []))])
           (ExportModule \"cycle\" false [] [(Reexport \"cycle\" (Refer true [] [] [])) (Reexport \"base\" (Refer true [] [] []))])
           (ExportModule \"diamond\" false [] [(Reexport \"dead\" (Refer true [] [] [])) (Reexport \"dead\" (Refer true [] [] []))])
           (ExportModule \"dead\" false [] [(Reexport \"dead\" (Refer true [] [] [])) (Reexport \"dead\" (Refer true [] [] []))])])"
        input
          (match (read-all sa source 0)
            (Ok [forms] forms)
            (Err [_] (panic "read")))
        root
          (match (forms/parse-7 (mut store) (elem input 0))
            (Ok [id] id)
            (Err [_] (panic "graph")))]
    (defer (close! (mut scratch)))
    (defer (forms/store-free! (mut store)))
    (let [(mut view)
            (match (namespace/compile a (mut store) root)
              (Ok [view] view)
              (Err [_] (panic "view")))]
      (defer (namespace/release! (mut view)))
      (expect a (mut view) "facade" "a" 0 (Some "base.a"))
      (expect a (mut view) "facade" "local" 0 (Some "base.b"))
      (expect a (mut view) "facade" "b" 0 (None))
      (expect a (mut view) "facade" "own" 0 (Some "facade.own"))
      (expect a (mut view) "facade" "alias" 0 (Some "base.a"))
      ; Declaration alias lookup is one hop, matching the reference table.
      (expect a (mut view) "facade" "chain" 0 (None))
      (expect a (mut view) "variants" "x" 0 (Some "base.a"))
      (expect a (mut view) "hidden" "a" 0 (None))
      (expect a (mut view) "unrecorded" "x" 0 (Some "unrecorded.x"))
      (expect a (mut view) "base" "a" 63 (Some "base.a"))
      (expect a (mut view) "base" "a" 64 (None))
      (expect a (mut view) "facade" "a" 63 (None))
      (expect a (mut view) "cycle" "a" 0 (Some "base.a"))
      (let [stats (expect a (mut view) "diamond" "missing" 0 (None))]
        (unless (and (= (.expanded stats) 64) (>= (.cached stats) 63))
          (panic "shared cyclic search was not memoized by depth")))
      (let [(mut stats) (search/Stats :expanded 7 :cached 9)]
        (match (namespace/exported a (mut view) "base" "a" -1 (mut stats))
          (Err [e] (match e (search/InvalidDepth []) (_ (panic "depth error"))))
          (Ok [_] (panic "negative starting depth accepted")))
        (unless (and (= (.expanded stats) 0) (= (.cached stats) 0))
          (panic "stale stats"))))))

(defn failure-check [(a (dyn Allocator)) (duplicate? bool)] (-> void)
  (let [(mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        (mut store) (forms/store-new a)
        source
          (if duplicate?
              "(Namespace [] [] [(ExportModule \"first\" false [] [(Reexport \"base\" (Refer true [] [] []))]) (ExportModule \"first\" false [] [])])"
              "(Namespace [] [] [(ExportModule \"first\" false [] [(Reexport \"base\" (Refer true [] [] [])) (Reexport \"bad\" (Refer true [] [] []))])])")
        input
          (match (read-all sa source 0)
            (Ok [forms] forms)
            (Err [_] (panic "failure read")))
        root
          (match (forms/parse-7 (mut store) (elem input 0))
            (Ok [id] id)
            (Err [_] (panic "failure parse")))]
    (defer (close! (mut scratch)))
    (defer (forms/store-free! (mut store)))
    (unless duplicate?
      (set! (mut (.rows6 store))
            1
            (forms/N6Row
              :f0 "bad"
              :f1 (forms/N2Id :index 999))))
    (match (namespace/compile a (mut store) root)
      (Ok [view]
          (let [(mut owned) view] (namespace/release! (mut owned)))
          (panic "invalid view accepted"))
      (Err [e]
           (if duplicate?
               (match e
                 (namespace/Index [_])
                 (_ (panic "expected duplicate index failure")))
               (match e
                 (namespace/Refer [edge _]
                                  (unless (= edge 1)
                                    (panic "wrong failed edge")))
                 (_ (panic "expected refer failure"))))))))

(defn main [] (-> i64)
  (let [debug (DebugAllocator::new (malloc-allocator))]
    (check (DebugAllocator::view debug))
    (failure-check (DebugAllocator::view debug) true)
    (failure-check (DebugAllocator::view debug) false)
    (unless (= (DebugAllocator::deinit! debug) 0) (panic "namespace leak")))
  (println "namespace exports: visibility, direct/alias precedence, ordered renamed edges, missing modules, exact depth and memoized cycles passed")
  0)
