(module rewrite.testtypeelaboration)
(import "rewrite.typesyntax" :as forms)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.debug-allocator" :use [DebugAllocator])
(import "coil.primitive" :as primitive)

(defn context! [(form (ptr Sexp)) (scope i64) (module (ptr HygModule))]
  (-> void)
  (when (sexp-sym? form) (set! (.hyg form) scope) (set! (.hmod form) module))
  (when (or (sexp-list? form) (sexp-vec? form))
    (for [i 0 (sexp-count form)] (context! (sexp-nth form i) scope module))))

(defn elaborate [(a (dyn Allocator))
                 (target (ptr forms/Store))
                 (text (slice u8))
                 (scope i64)] (-> forms/N9Id)
  (let [(mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        (mut input) (forms/store-new a)
        roots (match (read-all sa text 1) (Ok [v] v) (_ (panic "reader")))
        (mut module) (HygModule :name "definition")]
    (defer (close! (mut scratch)))
    (defer (forms/store-free! (mut input)))
    (context! (elem roots 0)
              scope
              (primitive/cast (ptr HygModule) (mut module)))
    (match (forms/store-source! (mut input) 1 "type.coil" text)
      (Ok [_])
      (_ (panic "source registration")))
    (let [root
            (match (forms/surface-3 (mut input) (elem roots 0))
              (Ok [v] v)
              (_ (panic "written type")))
          (mut state) (forms/transform-state-new a (mut input) target)
          before (next-node-id)
          result
            (match (forms/transform-3-9 (mut state) root)
              (Ok [v] v)
              (_ (panic "elaboration")))]
      (defer (forms/transform-state-free! (mut state)))
      (unless (= (next-node-id) (+ before 1))
        (panic "early lexical allocation"))
      (for value (.strings (.source-data input))
        (for [i 0 (len value)] (set! value i 88)))
      result)))

(defn expect [(a (dyn Allocator)) (source (slice u8)) (expected (slice u8))]
  (-> void)
  (let [(mut target) (forms/store-new a)
        (mut reference) (forms/store-new a)
        (mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        actual (elaborate a (mut target) source (- 0 7))
        roots
          (match (read-all sa expected 2)
            (Ok [v] v)
            (_ (panic "expected source")))
        wanted
          (match (forms/parse-9 (mut reference) (elem roots 0))
            (Ok [v] v)
            (_ (panic "expected type")))]
    (defer (close! (mut scratch)))
    (defer (forms/store-free! (mut target)))
    (defer (forms/store-free! (mut reference)))
    (match (forms/equal-9 a (mut target) actual (mut reference) wanted)
      (Ok [same]
          (unless same
            (println "wrong elaboration: {}" source)
            (panic "type shape")))
      (_ (panic "type comparison")))))

(defn main [] (-> i64)
  (let [debug (DebugAllocator::new (malloc-allocator))
        a (DebugAllocator::view debug)]
    (expect a "(ptr)" "(Pointer (Integer 64 true))")
    (expect a
            "(ptr T ignored)"
            "(Pointer (UnclassifiedName (Identifier \"T\" -7 \"definition\")))")
    (expect a "(mask 3)" "(Vector (Boolean) (Fixed 3))")
    (expect a
            "(mask W)"
            "(Vector (Boolean) (Parameter (Identifier \"W\" -7 \"definition\")))")
    (expect a
            "(mut (ref (ptr)))"
            "(Reference true (Reference false (Pointer (Integer 64 true))))")
    (expect a "(array (ptr) 0)" "(Array (Pointer (Integer 64 true)) (Fixed 0))")
    (expect a
            "(array (ptr) N)"
            "(Array (Pointer (Integer 64 true)) (Parameter (Identifier \"N\" -7 \"definition\")))")
    (expect a "(slice (ptr))" "(Slice (Pointer (Integer 64 true)))")
    (expect a "(vec (ptr) 4)" "(Vector (Pointer (Integer 64 true)) (Fixed 4))")
    (expect a "(struct Foo)" "(Nominal \"Foo\")")
    (expect a "(dyn Show)" "(Dynamic \"Show\")")
    (expect a "42" "(Constant (Integer 42))")
    (expect a ":meters" "(Constant (Keyword \"meters\"))")
    (expect a "true" "(Constant (Boolean true))")
    (expect a "(const false)" "(Constant (Boolean false))")
    (expect a "(const 42)" "(Constant (Integer 42))")
    (expect a "(const :meters)" "(Constant (Keyword \"meters\"))")
    (expect a
            "(const N)"
            "(Constant (Reference (Identifier \"N\" -7 \"definition\")))")
    (expect a
            "(fnptr (cc/C) [(ptr)] (ptr))"
            "(Function (Value (Identifier \"cc/C\" -7 \"definition\")) [(Pointer (Integer 64 true))] (Pointer (Integer 64 true)))")
    (expect a
            "(fnptr fast [] (ptr))"
            "(Function (Named (Identifier \"fast\" -7 \"definition\")) [] (Pointer (Integer 64 true)))")
    (expect a
            "(Box (ptr) (const N))"
            "(Application (Identifier \"Box\" -7 \"definition\") [(Pointer (Integer 64 true)) (Constant (Reference (Identifier \"N\" -7 \"definition\")))])")
    (expect a "i64" "(UnclassifiedName (Identifier \"i64\" -7 \"definition\"))")
    (unless (= (DebugAllocator::deinit! debug) 0) (panic "elaboration leak")))
  (println "structural type elaboration: defaults, references, extents, constants, conventions, applications, ownership and retained identities passed")
  0)
