(sum Calc
  (Constant (value Int)) (Truth (value Bool)) (Read (label Text))
  (Plus (left Calc) (right Calc))
  (Outer (label Text) (value Calc) (body Calc))
  (Parallel (left-name Text) (right-name Text) (left Calc) (right Calc) (body Calc)))
(bindings Calc
  (Read (reference label))
  (Outer (scope body label))
  (Parallel (scope body left-name right-name)))
(judgment Calc
  (Constant Int) (Truth Bool) (Read (lookup))
  (Plus Int (left Int) (right Int))
  (Outer ?body (value ?value) (body ?body (with ?value)))
  (Parallel ?body (left ?left) (right ?right) (body ?body (with ?left ?right))))
(lower Calc
  (Constant (const value)) (Truth (bool value)) (Read (name))
  (Plus (add left right))
  (Outer (let value body))
  (Parallel (let left right body)))
(syntax Calc
  (Constant (int value)) (Truth (bool value)) (Read (symbol label))
  (Plus (list "plus" (ref left) (ref right)))
  (Outer (list "outer" (symbol label) (ref value) (ref body)))
  (Parallel (list "parallel" (vector (symbol left-name) (ref left) (symbol right-name) (ref right)) (ref body))))
