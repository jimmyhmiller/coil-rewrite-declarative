(sum Expr
  (Integer (value Int))
  (Boolean (value Bool))
  (Add (left Expr) (right Expr))
  (Choose (condition Expr) (yes Expr) (no Expr))
  (Project (left Expr) (right Expr))
  (Variable (name Text))
  (Let (name Text) (value Expr) (body Expr))
  (LambdaInt (name Text) (body Expr))
  (LambdaBool (name Text) (body Expr))
  (Call (callee Expr) (argument Expr))
  (Endomorphism (value Expr))
  (Higher (value Expr))
  (Place (value Expr))
  (Read (place Expr)))
(bindings Expr (Variable (reference name)) (Let (scope body name)) (LambdaInt (scope body name)) (LambdaBool (scope body name)))
(judgment Expr
  (Integer Int)
  (Boolean Bool)
  (Add Int (left Int) (right Int))
  (Choose ?result (condition Bool) (yes ?result) (no ?result))
  (Project ?right (left ?left) (right ?right))
  (Variable (lookup))
  (Let ?body (value ?value) (body ?body (with ?value)))
  (LambdaInt (Fn Int ?body) (body ?body (with Int)))
  (LambdaBool (Fn Bool ?body) (body ?body (with Bool)))
  (Call ?result (callee (Fn ?argument ?result)) (argument ?argument))
  (Endomorphism Bool (value (Fn ?same ?same)))
  (Higher Bool (value (Fn Int (Fn Bool Int))))
  (Place (as address ?type) (value ?type))
  (Read ?type (place (in [address] ?type))))
