(sum Declarations
  (Define (name Text) (parameter Text) (body Surface))
  (DefineAlias (name Text) (alias Text) (parameter Text) (body Surface))
  (Ignore)
  (Group (left Declarations) (right Declarations)))
(transform Declarations (many Function)
  (Define (items (Function name parameter body)))
  (DefineAlias
    (items
      (Function alias parameter (Call (Variable name) (Variable parameter)))
      (Function name parameter body)))
  (Ignore (items))
  (Group (items (spread left) (spread right))))
(syntax Declarations
  (Define (list "define" (symbol name) (symbol parameter) (ref body)))
  (DefineAlias (list "define-alias" (symbol name) (symbol alias) (symbol parameter) (ref body)))
  (Ignore (list "ignore"))
  (Group (list "group" (ref left) (ref right))))
