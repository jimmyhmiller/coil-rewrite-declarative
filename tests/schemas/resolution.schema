(sum Expr (Lit (value Int)) (Var (name Text)) (Let (name Text) (value Expr) (body Expr)) (Both (left Expr) (right Expr)) (Group (items (many Expr))))
(node Root (name Text) (body Expr))
(bindings Expr (Var (reference name)) (Let (scope body name)))
(bindings Root (Root (scope body name)))
(node ScopeList (name Text) (items (many Expr)))
(bindings ScopeList (ScopeList (scope items name)))
(node TwoScope (name Text) (left Expr) (right Expr))
(bindings TwoScope (TwoScope (scope left name) (scope right name)))
(node Ordered (first Text) (second Text) (body Expr))
(bindings Ordered (Ordered (scope body second first)))
