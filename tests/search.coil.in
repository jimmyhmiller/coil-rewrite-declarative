(module fixture.main)
(import "fixture.policy" :as policy)
(import "rewrite.searchruntime" :as search)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)
(import "coil.debug-allocator" :use [DebugAllocator])

(defstruct Context [(allocator (dyn Allocator)) (mode i64)])

(defn visible :cc (cc/C) [(c (ptr Context)) (q (ptr search/Query))]
  (-> (Result bool i64))
  (if (and (= (.mode c) 2) (= (.owner q) "child"))
      (Err 22)
      (Ok (not (= (.mode c) 1)))))

(defn direct :cc (cc/C) [(c (ptr Context)) (q (ptr search/Query))]
  (-> (Result (Option i64) i64))
  (cond (and (= (.mode c) 3) (= (.owner q) "child")) (Err 33)
        (= (.mode c) 4) (Ok (None))
        :else (Ok (Some (if (= (.owner q) "child") 2 1)))))

(defn edges :cc (cc/C) [(c (ptr Context)) (q (ptr search/Query))]
  (-> (Result (ArrayList search/Query) i64))
  (if (= (.mode c) 4)
      (Err 44)
      (let [(mut children) (ArrayList::new [search/Query] (.allocator c))]
        (when (= (.owner q) "root")
          (push! (mut children) (search/Query :owner "child" :name "x"))
          (push! (mut children) (search/Query :owner "unvisited" :name "x")))
        (Ok children))))

(defn check [(a (dyn Allocator))] (-> void)
  (let [(mut c) (Context :allocator a :mode 0)
        (mut handlers)
          (policy/Handlers [Context i64 i64]
                           :guard-visible
                           (primitive/fnptr-of visible)
                           :prefer-direct
                           (primitive/fnptr-of direct)
                           :follow-edges
                           (primitive/fnptr-of edges))
        (mut stats) (search/Stats :expanded 0 :cached 0)]
    (for [mode 0 5]
      (set! (.mode c) mode)
      (let [result
              (policy/search-pick a
                                  (mut c)
                                  (mut handlers)
                                  (search/Query :owner "root" :name "x")
                                  0
                                  (mut stats))]
        (if (or (= LIMIT 0) (= mode 1))
            (match result
              (Ok [value] (match value (None []) (_ (panic "guard/depth"))))
              (_ (panic "guard/depth error")))
            (if (and (>= mode 2) (or FOLLOW_FIRST (= mode 4)))
                (match result
                  (Err [e]
                       (match e
                         (search/Callback [n]
                                          (unless (= n (* mode 11))
                                            (panic "callback payload")))
                         (_ (panic "callback kind"))))
                  (_ (panic "callback error lost")))
                (match result
                  (Ok [value]
                      (match value
                        (Some [n]
                              (unless (= n EXPECTED)
                                (panic "alternative order")))
                        (_ (panic "missing candidate"))))
                  (_ (panic "unexpected callback error")))))))
    (set! (.mode c) 0)
    (match (policy/search-pick a
                               (mut c)
                               (mut handlers)
                               (search/Query :owner "root" :name "x")
                               LIMIT
                               (mut stats))
      (Ok [value] (match value (None []) (_ (panic "boundary"))))
      (_ (panic "boundary error")))
    (unless (= (.expanded stats) 0) (panic "depth still invoked callback"))))

(defn main [] (-> i64)
  (let [debug (DebugAllocator::new (malloc-allocator))]
    (check (DebugAllocator::view debug))
    (unless (= (DebugAllocator::deinit! debug) 0) (panic "search leaked")))
  (println "generated search: ordering, guards, depth, callback errors and ownership passed")
  0)
