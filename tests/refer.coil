(module rewrite.testrefer)
(import "rewrite.nameforms" :as forms)
(import "rewrite.refer" :as refer)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.str" :use [StrBuf])
(import "coil.scratch" :use [ScratchArena])
(import "coil.debug-allocator" :use [DebugAllocator])
(import "coil.result" :use *)

(defn name [(a (dyn Allocator)) (prefix (slice u8)) (i i64)] (-> (slice u8))
  (let [(mut b) (StrBuf::new a)]
    (push-str! (mut b) prefix)
    (push-i64! (mut b) i)
    (str b)))

(defn check [(a (dyn Allocator))] (-> void)
  (let [(mut store) (forms/store-new a)
        (mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        (mut renames) (ArrayList::new [forms/N1Id] a)
        (mut names) (ArrayList::new [forms/N0Id] a)
        (mut freed?) false
        count 2000]
    (defer (unless freed? (forms/store-free! (mut store))))
    (defer (close! (mut scratch)))
    (defer (free! (mut renames)))
    (defer (free! (mut names)))
    (for [i 0 count]
      (let [from (forms/store-text! (mut store) (name sa "exported" i))
            to (forms/store-text! (mut store) (name sa "local" i))]
        (push! (mut renames)
               (forms/append-1 (mut (.rows1 store))
                               (forms/N1Row :f0 from :f1 to)))))
    (let [empty (forms/sequence-0 (mut store) (mut names))
          root
            (forms/append-2 (mut (.rows2 store))
                            (forms/N2Row
                              :f0 false
                              :f1 empty
                              :f2 empty
                              :f3 (forms/sequence-1 (mut store) (mut renames))))]
      (match (forms/refer-imports a (mut store) (forms/N2Id :index 999999))
        (Err [e]
             (match e
               (refer/InvalidRow [schema _]
                                 (unless (= schema 2) (panic "root schema")))
               (_ (panic "root error"))))
        (Ok [_] (panic "invalid root accepted")))
      ; Fail after all rename decisions were allocated, then successfully retry.
      (push! (mut names) (forms/N0Id :index 999999))
      (set! (.f1 (elem (field (mut store) rows2) (.index root)))
            (forms/sequence-0 (mut store) (mut names)))
      (match (forms/refer-imports a (mut store) root)
        (Err [e]
             (match e
               (refer/InvalidRow [schema _]
                                 (unless (= schema 0) (panic "child schema")))
               (_ (panic "child error"))))
        (Ok [_] (panic "invalid child accepted")))
      (set! (.f1 (elem (field (mut store) rows2) (.index root)))
            (forms/N0Seq :index -1))
      (match (forms/refer-imports a (mut store) root)
        (Err [e]
             (match e
               (refer/InvalidSequence [schema _]
                                      (unless (= schema 0)
                                        (panic "sequence schema")))
               (_ (panic "sequence error"))))
        (Ok [_] (panic "invalid sequence accepted")))
      (set! (.f1 (elem (field (mut store) rows2) (.index root))) empty)
      (let [(mut policy)
              (match (forms/refer-imports a (mut store) root)
                (Ok [policy] policy)
                (Err [_] (panic "policy")))]
        (defer (refer/release! (mut policy)))
        (forms/store-free! (mut store))
        (set! freed? true)
        (for [i 0 count]
          (let [from (name sa "exported" i)
                to (name sa "local" i)]
            (match (refer/referred (mut policy) to)
              (Some [hit] (unless (= hit from) (panic "forward")))
              (None [] (panic "missing forward")))
            (match (refer/local-name (mut policy) from)
              (Some [hit] (unless (= hit to) (panic "reverse")))
              (None [] (panic "missing reverse")))
            (match (refer/referred (mut policy) from)
              (None [])
              (Some [_] (panic "renamed source leaked")))
            (unless (and (refer/drops? (mut policy) from)
                         (not (refer/drops? (mut policy) to)))
              (panic "drop membership"))))))))

(defn main [] (-> i64)
  (let [debug (DebugAllocator::new (malloc-allocator))]
    (check (DebugAllocator::view debug))
    (unless (= (DebugAllocator::deinit! debug) 0) (panic "refer policy leak")))
  (println "refer indexes: 2000 renames, independent ownership, invalid graphs, failure cleanup and retry passed")
  0)
