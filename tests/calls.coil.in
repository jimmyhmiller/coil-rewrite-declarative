(module fixture.main)
(import "rewrite.generated" :use *)
(import "rewrite.types" :as types)
(import "rewrite.native" :as native)
(import "coil.alloc" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.arraylist" :use *)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)
(import "native.cir" :as cir)
(import "native.cir-ops" :as cop)
(import "declarative.rt.image" :as image)
(import "declarative.rt.jit" :as jit)
(defn parse-source [(a (dyn Allocator)) (store (mut Store)) (text (slice u8))] (-> N0Id)
  (match (read-all a text 0)
    (Err [_] (panic "test syntax"))
    (Ok [forms] (match (parse-0 (mut store) (elem forms 0))
      (Err [_] (panic "test constructor")) (Ok [id] id)))))
(defn main [] (-> i64)
  (let [(mut arena) (zeroed ScratchArena)
        initialized (init (mut arena) (malloc-allocator))
        a (allocator (mut arena))
        (mut store) (store-new a) (mut types) (types/create a)
        (mut im) (image/create a)
        inc-symbol (image/symbol! (mut im) "increment")
        main-symbol (image/symbol! (mut im) "entry")
        callee (parse-source a (mut store) "(Add (Variable \"x\") (Integer 1))")
        caller (parse-source a (mut store) "(Let \"once\" (Call (Variable \"inc\") (Integer 20)) (Add (Add (Variable \"once\") (Variable \"once\")) (Call (Choose (Boolean true) (Variable \"inc\") (Variable \"inc\")) (Integer 20))))")
        signature (match (types/function (mut types) 1 1) (Ok [id] id) (Err [_] (panic "type construction")))
        (mut empty) (zeroed Context)
        (mut parameter) (Context :present true :name "x" :type 1 :parent (primitive/cast (ptr Context) (mut empty)))
        (mut functions) (Context :present true :name "inc" :type signature :parent (primitive/cast (ptr Context) (mut empty)))
        (mut callee-f) (cir/Func::new) (mut caller-f) (cir/Func::new)
        cf (primitive/cast (ptr cir/Func) (mut callee-f))
        mf (primitive/cast (ptr cir/Func) (mut caller-f))
        (mut values) (zeroed ValueContext)]
    (unless (and
      (match (judge-worker-0 (mut types) (mut (.rows0 store)) callee (len (.rows0 store)) (mut parameter)) (Typed [ty] (= ty 1)) (_ false))
      (match (judge-worker-0 (mut types) (mut (.rows0 store)) caller (len (.rows0 store)) (mut functions)) (Typed [ty] (= ty 1)) (_ false)))
      (panic "test program failed typing"))
    (cir/set-block! cf (cir/new-block! cf))
    (let [(mut scope) (ValueContext :present true :name "x" :value (cir/arg! cf cop/T-I64 false) :parent (primitive/cast (ptr ValueContext) (mut values)))]
      (cir/ret1! cf (lower-worker-0 (mut (.rows0 store)) callee cf (mut scope))))
    (cir/finish! cf)
    (cir/set-block! mf (cir/new-block! mf))
    (let [(mut scope) (ValueContext :present true :name "inc" :value (cir/sym! mf (cast u32 inc-symbol) 0) :parent (primitive/cast (ptr ValueContext) (mut values)))]
      (cir/ret1! mf (lower-worker-0 (mut (.rows0 store)) caller mf (mut scope))))
    (cir/finish! mf)
    (let [(mut direct) 0 (mut indirect) 0]
      (for [i 0 (len (.values caller-f))]
        (let [value (elem (mut (.values caller-f)) i)]
          (when (= (cast i64 (.op value)) cop/OP-CALL)
            (if (= (.imm value) inc-symbol) (set! direct (+ direct 1)) (set! indirect (+ indirect 1))))))
      (unless (and (= direct 1) (= indirect 1)) (panic "expected exactly one direct and one indirect call")))
    (native/emit! a (mut im) cf inc-symbol)
    (native/emit! a (mut im) mf main-symbol)
    (let [loaded (native/load-image a im)
          run (primitive/cast (fnptr (cc/C) [] i64) (jit/address-of loaded main-symbol))
          ok (= (run) 63)]
      (jit/unload! loaded)
      (cir/func-free! cf) (cir/func-free! mf)
      (store-free! (mut store)) (types/release! (mut types))
      (close! (mut arena))
      (if ok 0 1))))
