(module fixture.main)
(import "rewrite.generated" :use *)
(import "rewrite.equality" :as equality)
(import "rewrite.sequence" :as sequence)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)

(defn expect [(result (Result bool equality/Error)) (expected bool)] (-> void)
  (match result (Ok [same] (unless (= same expected) (panic "record equality")))
    (Err [_] (panic "record comparison failed"))))

(defn main [] (-> i64)
  (let [a (malloc-allocator) (mut s) (store-new a)
        x (append-0 (mut (.rows0 s)) (N0Row :f0 42 :f1 "value" :f2 true))
        y (append-0 (mut (.rows0 s)) (N0Row :f0 42 :f1 "value" :f2 true))
        (mut parts) (ArrayList::new [i64] a)
        (mut xs) (ArrayList::new [N0Id] a)]
    (defer (free! (mut parts))) (defer (store-free! (mut s))) (defer (free! (mut xs)))
    (push! (mut xs) x) (push! (mut xs) x)
    (let [flat (sequence-0 (mut s) (mut xs))
          singleton (sequence/singleton! (mut (.sequences0 s)) y)
          joined (do (push! (mut parts) singleton) (push! (mut parts) singleton)
                   (match (sequence/join! (mut (.sequences0 s)) (mut parts))
                   (Ok [id] (N0Seq :index id)) (Err [_] (panic "join"))))
          l (append-1 (mut (.rows1 s)) (N1Row :f0 x :f1 flat))
          r (append-1 (mut (.rows1 s)) (N1Row :f0 y :f1 joined))]
      (expect (equal-1 a (mut s) l (mut s) r) true)
      (set! (.f2 (elem (field (mut s) rows0) (.index y))) false)
      (expect (equal-1 a (mut s) l (mut s) r) false)
      (set! (.f2 (elem (field (mut s) rows0) (.index y))) true)
      (set! (.f1 (elem (field (mut s) rows0) (.index y))) "different")
      (expect (equal-1 a (mut s) l (mut s) r) false)
      (set! (.f1 (elem (field (mut s) rows0) (.index y))) "value")
      (set! (.f1 (elem (field (mut s) rows1) (.index r))) (N0Seq :index (- 0 1)))
      (match (equal-1 a (mut s) l (mut s) r)
        (Err [e] (match e (equality/InvalidSequence [_ right? _] (unless right? (panic "side"))) (_ (panic "sequence error"))))
        (_ (panic "invalid sequence accepted")))
      (set! (.f1 (elem (field (mut s) rows1) (.index r))) joined)
      (set! (.f0 (elem (field (mut s) rows1) (.index r))) (N0Id :index 9999))
      (match (equal-1 a (mut s) l (mut s) r)
        (Err [e] (match e (equality/InvalidReference [_ right? _] (unless right? (panic "side"))) (_ (panic "child error"))))
        (_ (panic "invalid child accepted"))))
    (println "record equality: cross-schema fields, text/bool, sequence segmentation and invalid edges passed")
    0))
