;;; Scalar CIR/image boundary. The caller owns the allocator and image lifetime.
(module rewrite.native)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use [ArrayList])
(import "native.cir" :as cir)
(import "declarative.rt.image" :as image)
(import "declarative.rt.jit" :as jit)
(import "declarative.target" :as target)

(target/machine-pick (import "declarative.a64-direct.unit" :as dst)
                     (import "declarative.x64-direct.unit" :as dst))

(target/machine-pick (import "declarative.a64-direct.plans" :as plans)
                     (import "declarative.x64-direct.plans" :as plans))

(target/machine-pick (import "declarative.a64.target" :as isa)
                     (import "declarative.x64.target" :as isa))

(defn emit! [(a (dyn Allocator))
             (im (mut image/Image))
             (f (ptr cir/Func))
             (symbol i64)] (-> void)
  (let [(mut state) (dst/create a)]
    (set! (.f state) f)
    (dst/begin! (mut state))
    (plans/quick (mut state))
    (image/add-function! (mut im)
                         symbol
                         (.code state)
                         (.reloc-at state)
                         (.reloc-symbol state)
                         (.reloc-op state)
                         isa/ALIGN)))

(defn load-image [(a (dyn Allocator)) (im image/Image)] (-> jit/Loaded)
  (let [(mut imports) (ArrayList::new [HostFunction] a)]
    (defer (free! (mut imports)))
    (match (load-image-with a im (mut imports))
      (Ok [loaded] loaded)
      (Err [_] (panic "native image has unresolved or malformed symbols")))))

(import "coil.hashmap" :use [HashMap])
(import "coil.str" :as str)
(import "coil.result" :use *)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

;;; The initial scalar ABI is explicit; other signatures need distinct contracts.
(defstruct HostFunction [(name (slice u8)) (function (fnptr (cc/C) [i64] i64))])

(defsum LinkError
  (MalformedSymbols)
  (DuplicateImport [(name (slice u8))])
  (UnknownImport [(name (slice u8))])
  (DefinedImport [(name (slice u8))])
  (NullImport [(name (slice u8))])
  (MissingImport [(name (slice u8))]))

(defstruct LinkRequest [(name (slice u8)) (address u64)])

(defstruct LinkPlan [(symbols (ArrayList i64)) (outside (ArrayList u64))])

;;; Internal plan shared by both typed callback interfaces. No executable memory
;;; is allocated until every required and supplied binding has been checked.
(defn prepare-links [(a (dyn Allocator))
                     (im image/Image)
                     (imports (ptr (ArrayList LinkRequest)))]
  (-> (Result LinkPlan LinkError))
  (block :done
    (unless (and (= (len (.names im)) (len (.defined im)))
                 (= (len (.names im)) (len (.in-data im))))
      (break :done (Err (MalformedSymbols))))
    (let [(mut symbols) (HashMap::new [(slice u8) i64] a (str/keyops-borrowed))
          (mut indices) (ArrayList::new [i64] a)
          (mut outside) (ArrayList::new [u64] a)
          (mut complete) false]
      (defer (free! (mut symbols)))
      (defer (unless complete (free! (mut indices)) (free! (mut outside))))
      (for [i 0 (len (.names im))]
        (let [name (get (.names im) i)]
          (match (get symbols name)
            (Some [_] (break :done (Err (MalformedSymbols))))
            (None []))
          (set! (mut symbols) name i)
          (push! (mut outside) 0)))
      (for host (load imports)
        (let [name (.name host)
              i
                (match (get symbols name)
                  (Some [i] i)
                  (None [] (break :done (Err (UnknownImport name)))))
              address (.address host)]
          (when (>= (get (.defined im) i) 0)
            (break :done (Err (DefinedImport name))))
          (when (!= (get outside i) 0)
            (break :done (Err (DuplicateImport name))))
          (when (= address 0) (break :done (Err (NullImport name))))
          (set! (mut outside) i address)
          (push! (mut indices) i)))
      (for [i 0 (len (.names im))]
        (when (and (< (get (.defined im) i) 0) (= (get outside i) 0))
          (break :done (Err (MissingImport (get (.names im) i))))))
      (set! complete true)
      (Ok (LinkPlan :symbols indices :outside outside)))))

(defn release-links! [(plan (mut LinkPlan))] (-> void)
  (free! (mut (.symbols plan)))
  (free! (mut (.outside plan))))

(defn load-image-with [(a (dyn Allocator))
                       (im image/Image)
                       (imports (ptr (ArrayList HostFunction)))]
  (-> (Result jit/Loaded LinkError))
  (let [(mut requests) (ArrayList::new [LinkRequest] a)]
    (defer (free! (mut requests)))
    (for host (load imports)
      (push! (mut requests)
             (LinkRequest
               :name (.name host)
               :address
                 (primitive/cast u64 (primitive/cast (ptr i8) (.function host))))))
    (match (prepare-links a im (mut requests))
      (Err [e] (Err e))
      (Ok [plan]
          (let [(mut plan) plan]
            (defer (release-links! (mut plan)))
            (Ok (jit/load-image im (.outside plan) (fnptr-of isa/patch))))))))

(import "native.cir-ops" :as cop)

;;; A typed callback and its explicit borrowed context. The closure wrapper is
;;; image-local; calls never consult an ambient current-context pointer.
(defstruct ContextFunction [C]
  [(name (slice u8))
   (context (ptr C))
   (function (fnptr (cc/C) [(ptr C) i64] i64))])

(defstruct ContextImage [(program jit/Loaded) (callbacks (Option jit/Loaded))])

(defn emit-context-wrapper! [(a (dyn Allocator))
                             (im (mut image/Image))
                             (symbol i64)
                             (context u64)
                             (callback u64)] (-> void)
  (let [(mut function) (cir/Func::new)
        (mut args) (ArrayList::new [u32] a)
        (mut flags) (ArrayList::new [u32] a)
        (mut results) (ArrayList::new [u8] a)]
    (defer (cir/func-free! (mut function)))
    (defer (free! (mut args)))
    (defer (free! (mut flags)))
    (defer (free! (mut results)))
    (cir/set-block! (mut function) (cir/new-block! (mut function)))
    (let [argument (cir/arg! (mut function) cop/T-I64 false)
          ctx (cir/const! (mut function) cop/T-I64 context 0)
          target (cir/const! (mut function) cop/T-I64 callback 0)]
      (push! (mut args) ctx)
      (push! (mut args) argument)
      (push! (mut flags) 0)
      (push! (mut flags) 0)
      (push! (mut results) (cast u8 cop/T-I64))
      (cir/ret1! (mut function)
                 (cir/call! (mut function)
                            (cir/none)
                            target
                            (mut args)
                            (mut flags)
                            (mut results)
                            false))
      (cir/finish! (mut function))
      (emit! a (mut im) (mut function) symbol))))

;;; Context objects and callback code must outlive the returned image. The caller
;;; owns both executable mappings through ContextImage and unload-context-image!.
(defn load-image-with-contexts [C] [(a (dyn Allocator))
                                    (im image/Image)
                                    (imports (ptr (ArrayList (ContextFunction C))))]
  (-> (Result ContextImage LinkError))
  (block
    :done
      (let [(mut requests) (ArrayList::new [LinkRequest] a)]
        (defer (free! (mut requests)))
        (for host (load imports)
          (push! (mut requests)
                 (LinkRequest
                   :name (.name host)
                   :address
                     (primitive/cast u64
                                     (primitive/cast (ptr i8) (.function host))))))
        (let [(mut plan)
                (match (prepare-links a im (mut requests))
                  (Ok [plan] plan)
                  (Err [e] (break :done (Err e))))]
          (defer (release-links! (mut plan)))
          (if (= (len (load imports)) 0)
              (Ok (ContextImage
                    :program
                      (jit/load-image im (.outside plan) (fnptr-of isa/patch))
                    :callbacks (None [jit/Loaded])))
              (let [(mut wrappers) (image/create a)]
                (for [i 0 (len (load imports))]
                  (let [host (get (load imports) i)
                        name (get (.names im) (get (.symbols plan) i))
                        symbol (image/symbol! (mut wrappers) name)]
                    (emit-context-wrapper! a
                                           (mut wrappers)
                                           symbol
                                           (primitive/cast u64 (.context host))
                                           (.address (get requests i)))))
                (let [callbacks (load-image a wrappers)]
                  (for [i 0 (len (load imports))]
                    (set! (mut (.outside plan))
                          (get (.symbols plan) i)
                          (primitive/cast u64 (jit/address-of callbacks i))))
                  (Ok (ContextImage
                        :program
                          (jit/load-image im
                                          (.outside plan)
                                          (fnptr-of isa/patch))
                        :callbacks (Some callbacks))))))))))

(defn unload-context-image! [(loaded ContextImage)] (-> void)
  (jit/unload! (.program loaded))
  (match (.callbacks loaded)
    (Some [callbacks] (jit/unload! callbacks))
    (None [])))
