;;; Finite namespace routes driven by the declared resolution protocol.
(module rewrite.routing)
(import "rewrite.namespace" :as namespace)
(import "rewrite.routingfacts" :as facts)
(import "rewrite.resolveprotocol" :as policy)
(import "rewrite.nameforms" :as forms)
(import "rewrite.refer" :as refer)
(import "rewrite.searchruntime" :as search)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.result" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.text" :use [sconcat3])
(import "coil.slice" :use [subslice])
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(defstruct Answer [(target (Option (slice u8))) (route (Option forms/N8Row))])

(defsum Error
  (Use [(error namespace/UseError)])
  (Export [(error (search/Failure namespace/QueryError))]))

(defstruct Context
  [(allocator (dyn Allocator))
   (view (ptr namespace/View))
   (world (ptr facts/World))
   (head (slice u8))
   (module (Option (slice u8)))
   (asking (slice u8))
   (own (slice u8))
   (macro? bool)
   (slash i64)
   (answer Answer)])

(defn spelling :cc (cc/C) [(c (ptr Context))] (-> (Result policy/Event Error))
  (block
    :done
      (let [(mut dotted?) false]
        (for [i 0 (len (.head c))]
          (let [byte (get (.head c) i)]
            (when (= byte 47)
              (set! (.slash c) i)
              (break :done (Ok (policy/Event-Slash))))
            (when (= byte 46) (set! dotted? true))))
        (Ok (if (and dotted? (> (len (.head c)) 0) (!= (get (.head c) 0) 46))
                (policy/Event-Dotted)
                (policy/Event-Bare))))))

(defn own-result [(c (ptr Context))] (-> policy/Event)
  (let [result (namespace/declaration (.view c) (.own c))]
    (set! (.target (.answer c)) result)
    (match result
      (Some [_] (policy/Event-Found))
      (None [] (policy/Event-Missing)))))

(defn dotted-own :cc (cc/C) [(c (ptr Context))] (-> (Result policy/Event Error))
  (Ok (match (.module c)
        (Some [_] (own-result c))
        (None [] (policy/Event-Missing)))))

(defn bare-own :cc (cc/C) [(c (ptr Context))] (-> (Result policy/Event Error))
  (Ok (own-result c)))

(defn absolute :cc (cc/C) [(c (ptr Context))] (-> (Result policy/Event Error))
  (set! (.target (.answer c)) (namespace/declaration (.view c) (.head c)))
  (Ok (policy/Event-Done)))

(defn shadow :cc (cc/C) [(c (ptr Context))] (-> (Result policy/Event Error))
  (Ok (if (and (.macro? c)
               (match (get (.declared (.world c))
                           (namespace/alias-name (.view c) (.own c)))
                 (Some [_] true)
                 (None [] false)))
          (policy/Event-Blocked)
          (policy/Event-Clear))))

(defn exported [(c (ptr Context))
                (owner (slice u8))
                (name (slice u8))
                (depth i64)]
  (-> (Result (Option (slice u8)) Error))
  (let [(mut stats) (search/Stats :expanded 0 :cached 0)]
    (match (namespace/exported (.allocator c)
                               (.view c)
                               owner
                               name
                               depth
                               (mut stats))
      (Ok [value] (Ok value))
      (Err [e] (Err (Export e))))))

(defn slash :cc (cc/C) [(c (ptr Context))] (-> (Result policy/Event Error))
  (block
    :done
      (let [module
              (match (.module c)
                (Some [m] m)
                (None [] (break :done (Ok (policy/Event-Done)))))
            alias (subslice (.head c) 0 (.slash c))
            rest (subslice (.head c) (+ (.slash c) 1) (len (.head c)))]
        (when (and (not (.macro? c)) (= alias module))
          ; Own full-module slash access ignores export restrictions.
          (let [qualified (sconcat3 (.allocator c) module "." rest)]
            (set! (.target (.answer c))
                  (namespace/declaration (.view c) qualified)))
          (break :done (Ok (policy/Event-Done))))
        (let [(mut imports)
                (match (facts/module-of (.world c) module)
                  (Some [m] m)
                  (None [] (break :done (Ok (policy/Event-Done)))))
              target
                (match (get (.aliases imports) alias)
                  (Some [t] t)
                  (None []
                        (when (.macro? c)
                          (break :done (Ok (policy/Event-Done))))
                        (match (get (.imported imports) alias)
                          (Some [_] alias)
                          (None [] (break :done (Ok (policy/Event-Done)))))))]
          (match (exported c target rest 0)
            (Err [e] (break :done (Err e)))
            (Ok [answer]
                (set! (.target (.answer c)) answer)
                (when (.macro? c)
                  (match answer
                    (None [])
                    (Some [name]
                          (set! (.route (.answer c))
                                (Some (forms/N8Row
                                        :f0 target
                                        :f1 rest
                                        :f2 name)))))))))
        (Ok (policy/Event-Done)))))

(defn uses :cc (cc/C) [(c (ptr Context))] (-> (Result policy/Event Error))
  (block
    :done
      (let [(mut imports)
              (match (facts/module-of (.world c) (.asking c))
                (Some [m] m)
                (None [] (break :done (Ok (policy/Event-Missing)))))]
        (match (namespace/used (.allocator c)
                               (.view c)
                               (field imports uses)
                               (.head c)
                               (.macro? c))
          (Err [e] (Err (Use e)))
          (Ok [candidate]
              (match candidate
                (None [] (Ok (policy/Event-Missing)))
                (Some [candidate]
                      (set! (.target (.answer c)) (Some (.f2 candidate)))
                      (when (.macro? c)
                        (set! (.route (.answer c)) (Some candidate)))
                      (Ok (policy/Event-Found)))))))))

(defn core :cc (cc/C) [(c (ptr Context))] (-> (Result policy/Event Error))
  (block
    :done
      (let [world (.world c)
            prelude (.prelude world)]
        (when (= (.asking c) prelude) (break :done (Ok (policy/Event-Done))))
        (let [name
                (match (facts/module-of world (.asking c))
                  (None [] (.head c))
                  (Some [module]
                        (let [(mut imports) module]
                          (match (refer/referred (field imports core) (.head c))
                            (Some [name] name)
                            (None [] (break :done (Ok (policy/Event-Done))))))))]
          (match (facts/module-of world prelude)
            (Some [_])
            (None [] (break :done (Ok (policy/Event-Done)))))
          (let [owner (facts/provider world name (.asking c))]
            (match (exported c
                             (if (> (len owner) 0) owner prelude)
                             name
                             (if (> (len owner) 0) 1 0))
              (Err [e] (break :done (Err e)))
              (Ok [value] (set! (.target (.answer c)) value)))))
        (Ok (policy/Event-Done)))))

;;; Inputs remain immutable through the call. Results borrow the namespace store,
;;; routing store/policies and head; they never borrow the temporary query arena.
;;; Route metadata is returned to the caller, not published as a side effect.
(defn resolve [(a (dyn Allocator))
               (view (ptr namespace/View))
               (world (ptr facts/World))
               (head (slice u8))
               (module (Option (slice u8)))
               (macro? bool)]
  (-> (Result Answer (policy/Failure Error)))
  (let [(mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        sa (allocator (mut scratch))
        (mut context)
          (Context
            :allocator sa
            :view view
            :world world
            :head head
            :module module
            :asking (match module (Some [m] m) (None [] ""))
            :own
              (match module (Some [m] (sconcat3 sa m "." head)) (None [] head))
            :macro? macro?
            :slash -1
            :answer (Answer :target (None) :route (None)))
        (mut handlers)
          (policy/Handlers [Context Error]
                           :step-spelling
                           (primitive/fnptr-of spelling)
                           :step-slash
                           (primitive/fnptr-of slash)
                           :step-dotted-own
                           (primitive/fnptr-of dotted-own)
                           :step-absolute
                           (primitive/fnptr-of absolute)
                           :step-bare-own
                           (primitive/fnptr-of bare-own)
                           :step-shadow
                           (primitive/fnptr-of shadow)
                           :step-uses
                           (primitive/fnptr-of uses)
                           :step-core
                           (primitive/fnptr-of core))]
    (defer (close! (mut scratch)))
    (match (policy/run (mut context) (mut handlers))
      (Err [e] (Err e))
      (Ok [_] (Ok (.answer context))))))
