;;; Publish generated trait membership without rebuilding import/export facts.
(module rewrite.traitdeclarations)
(import "rewrite.codeforms" :as forms)
(import "rewrite.namespace" :as namespace)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.str" :use [StrBuf])

;;; Availability precedes full declaration validation in the reference. Malformed
;;; trait heads/names are ignored here; declaration parsing remains authoritative.
;;; The caller supplies scratch storage for borrowed views and traversal results.
;;; This operation does not settle pending derivations: query/finish do that.
(defn observe! [(a (dyn Allocator))
                (view (ptr namespace/View))
                (form (ptr Sexp))
                (module (Option (slice u8)))] (-> i64)
  (let [(mut count) 0
        (mut qualified) (StrBuf::new a)
        (mut leaves) (forms/leaves-produced-forms a form)]
    (defer (free! (mut qualified)))
    (defer (free! (mut leaves)))
    (for leaf leaves
      (match (forms/view-7 a leaf)
        (Err [_])
        (Ok [matched]
            (match matched
              (None [])
              (Some [matched]
                    (let [capture (get (.captures matched) 0)
                          name (sexp-sym (.source capture))]
                      (clear! (mut (.bytes qualified)))
                      (match module
                        (None [])
                        (Some [name]
                              (push-str! (mut qualified) name)
                              (push-str! (mut qualified) ".")))
                      (push-str! (mut qualified) name)
                      (when (namespace/introduce! view (str qualified))
                        (set! count (+ count 1)))))))))
    count))
