;;; Invocation-owned syntax handles. Native values never encode row addresses.
(module rewrite.invocation)
(import "rewrite.code" :as code)
(import "rewrite.codeforms" :as forms)
(import "coil.alloc" :use [Allocator])
(import "coil.hashmap" :use [HashMap])
(import "coil.result" :use *)
(import "coil.primitive" :as primitive)
(import "coil.atomic" :as atomic)
(import "coil.cc" :as cc)

(defsum InvocationError
  (ClosedInvocation)
  (InvocationBusy)
  (OutsideInvocation)
  (HandleCapacity)
  (NullEntry)
  (InvalidHandle [(handle i64)])
  (InvalidRow [(row i64)])
  (RootArity [(count i64)])
  (ExpectedContainer [(handle i64)])
  (EmptyContainer [(handle i64)])
  (ExpectedInteger [(handle i64)])
  (SyntaxFailure [(error code/SyntaxError)])
  (PromotionFailure [(error code/PromotionError)]))

(defstruct Invocation
  [(syntax code/Syntax)
   (handles (HashMap i64 forms/N0Id))
   (rows (HashMap i64 i64))
   (active bool)
   (running bool)
   (error (Option InvocationError))])

;;; A shared identity supply, not an ambient invocation. Never wrap/recycle IDs.
;;; Counter storage must be private to the runtime; the explicit form permits a
;;; boundary test without exhausting or resetting the runtime's actual supply.
(defn mint-counter! [(counter (ptr i64))] (-> (Result i64 InvocationError))
  (block :done
    (loop (let [prior (atomic/read counter)]
            (when (or (< prior 0) (= prior 9223372036854775807))
              (break :done (Err (HandleCapacity))))
            (let [next (+ prior 1)]
              (when (= (atomic/cas counter prior next) prior)
                (break :done (Ok next))))))
    (Err (HandleCapacity))))

(defn mint! [] (-> (Result i64 InvocationError))
  (mint-counter! (primitive/alloc-static i64)))

(defn create [(a (dyn Allocator))] (-> Invocation)
  (Invocation
    :syntax (code/create a)
    :handles (HashMap::new-scalar [i64 forms/N0Id] a)
    :rows (HashMap::new-scalar [i64 i64] a)
    :active true
    :running false
    :error (None)))

(defn close! [(invocation (mut Invocation))] (-> (Result bool InvocationError))
  (cond (.running invocation) (Err (InvocationBusy))
        (not (.active invocation)) (Ok false)
        :else
          (do
            (set! (.active invocation) false)
            (set! (.error invocation) (None))
            (free! (mut (.handles invocation)))
            (free! (mut (.rows invocation)))
            (code/release! (mut (.syntax invocation)))
            (Ok true))))

(defn lookup [(invocation (ptr Invocation)) (handle i64)]
  (-> (Result forms/N0Id InvocationError))
  (if (not (.active invocation))
      (Err (ClosedInvocation))
      (match (get (.handles invocation) handle)
        (Some [id] (Ok id))
        (None [] (Err (InvalidHandle handle))))))

;;; Internal publication of an ID from this invocation's own syntax store.
(defn publish! [(invocation (mut Invocation)) (id forms/N0Id)]
  (-> (Result i64 InvocationError))
  (block :done
    (unless (.active invocation) (break :done (Err (ClosedInvocation))))
    (unless (and (>= (.index id) 0)
                 (< (.index id) (len (.rows0 (.store (.syntax invocation)))))
                 (< (.index id) (len (.contexts (.syntax invocation)))))
      (break :done (Err (InvalidRow (.index id)))))
    (match (get (.rows invocation) (.index id))
      (Some [handle] (Ok handle))
      (None []
            (let [handle
                    (match (mint!)
                      (Ok [handle] handle)
                      (Err [e] (break :done (Err e))))]
              (set! (mut (.handles invocation)) handle id)
              (set! (mut (.rows invocation)) (.index id) handle)
              (Ok handle))))))

(defn read-one! [(invocation (mut Invocation))
                 (source i64)
                 (name (slice u8))
                 (text (slice u8))]
  (-> (Result i64 InvocationError))
  (block :done
    (unless (.active invocation) (break :done (Err (ClosedInvocation))))
    (when (.running invocation) (break :done (Err (InvocationBusy))))
    (let [roots
            (match (code/read! (mut (.syntax invocation)) source name text)
              (Ok [roots] roots)
              (Err [e] (break :done (Err (SyntaxFailure e)))))
          store
            (primitive/cast (ptr forms/Store)
                            (field (mut (.syntax invocation)) store))
          count
            (match (forms/sequence-size-0 store roots)
              (Some [n] n)
              (None [] (panic "owned roots")))]
      (unless (= count 1) (break :done (Err (RootArity count))))
      (match (forms/sequence-item-0 store roots 0)
        (Some [id] (publish! (mut invocation) id))
        (None [] (panic "owned root"))))))

(defn integer [(invocation (ptr Invocation)) (handle i64)]
  (-> (Result i64 InvocationError))
  (match (lookup invocation handle)
    (Err [e] (Err e))
    (Ok [id]
        (match (get (.rows0 (.store (.syntax invocation))) (.index id))
          (forms/N0V0 [value] (Ok value))
          (_ (Err (ExpectedInteger handle)))))))

(defn child! [(invocation (mut Invocation)) (handle i64) (last? bool)]
  (-> (Result i64 InvocationError))
  (block
    :done
      (let [id
              (match (lookup invocation handle)
                (Ok [id] id)
                (Err [e] (break :done (Err e))))
            store
              (primitive/cast (ptr forms/Store)
                              (field (mut (.syntax invocation)) store))
            items
              (match (get (.rows0 store) (.index id))
                (forms/N0V6 [items] items)
                (forms/N0V7 [items] items)
                (_ (break :done (Err (ExpectedContainer handle)))))
            count
              (match (forms/sequence-size-0 store items)
                (Some [n] n)
                (None [] (panic "owned children")))]
        (when (= count 0) (break :done (Err (EmptyContainer handle))))
        (match (forms/sequence-item-0 store items (if last? (- count 1) 0))
          (Some [child] (publish! (mut invocation) child))
          (None [] (panic "owned child"))))))

;;; Callback failures remain sticky until the next entry invocation. Zero is an
;;; ABI failure sentinel, never a minted handle; scalar zero remains a valid value.
(defn callback-result! [(invocation (mut Invocation))
                        (result (Result i64 InvocationError))] (-> i64)
  (match result
    (Ok [value] value)
    (Err [e]
         (match (.error invocation)
           (Some [_])
           (None [] (set! (.error invocation) (Some e))))
         0)))

(defn callback-ready? [(invocation (mut Invocation))] (-> bool)
  (cond (not (.active invocation))
          (do
            (callback-result! (mut invocation)
                              (Err [i64 InvocationError] (ClosedInvocation)))
            false)
        (not (.running invocation))
          (do
            (callback-result! (mut invocation)
                              (Err [i64 InvocationError] (OutsideInvocation)))
            false)
        :else (match (.error invocation) (Some [_] false) (None [] true))))

(defn first-callback :cc (cc/C) [(invocation (ptr Invocation)) (handle i64)]
  (-> i64)
  (if (callback-ready? invocation)
      (callback-result! invocation (child! invocation handle false))
      0))

(defn last-callback :cc (cc/C) [(invocation (ptr Invocation)) (handle i64)]
  (-> i64)
  (if (callback-ready? invocation)
      (callback-result! invocation (child! invocation handle true))
      0))

(defn integer-callback :cc (cc/C) [(invocation (ptr Invocation)) (handle i64)]
  (-> i64)
  (if (callback-ready? invocation)
      (callback-result! invocation (integer invocation handle))
      0))

(defn invoke-value! [(invocation (mut Invocation))
                     (entry (fnptr (cc/C) [i64] i64))
                     (argument i64)]
  (-> (Result i64 InvocationError))
  (block :done
    (when (.running invocation) (break :done (Err (InvocationBusy))))
    (match (lookup invocation argument)
      (Err [e] (break :done (Err e)))
      (Ok [_]))
    (when (= (primitive/cast i64 (primitive/cast (ptr i8) entry)) 0)
      (break :done (Err (NullEntry))))
    (set! (.error invocation) (None))
    (set! (.running invocation) true)
    (defer (set! (.running invocation) false))
    (let [value (entry argument)]
      (match (.error invocation) (Some [e] (Err e)) (None [] (Ok value))))))

(defn invoke-code! [(invocation (mut Invocation))
                    (entry (fnptr (cc/C) [i64] i64))
                    (argument i64)]
  (-> (Result i64 InvocationError))
  (match (invoke-value! (mut invocation) entry argument)
    (Err [e] (Err e))
    (Ok [handle]
        (match (lookup invocation handle)
          (Ok [_] (Ok handle))
          (Err [e] (Err e))))))

;;; Copy a completed invocation result before closing its owned syntax store.
(defn promote! [(target (mut code/Syntax))
                (invocation (ptr Invocation))
                (handle i64)]
  (-> (Result forms/N0Id InvocationError))
  (if (.running invocation)
      (Err (InvocationBusy))
      (match (lookup invocation handle)
        (Err [e] (Err e))
        (Ok [id]
            (match (code/promote! (mut target) (field invocation syntax) id)
              (Ok [out] (Ok out))
              (Err [e] (Err (PromotionFailure e))))))))

;;; Import a resumed generation into a fresh invocation without sharing storage.
(defn import! [(invocation (mut Invocation))
               (input (ptr code/Syntax))
               (root forms/N0Id)]
  (-> (Result i64 InvocationError))
  (cond (not (.active invocation)) (Err (ClosedInvocation))
        (.running invocation) (Err (InvocationBusy))
        :else
          (match (code/promote! (mut (.syntax invocation)) input root)
            (Err [e] (Err (PromotionFailure e)))
            (Ok [id] (publish! (mut invocation) id)))))
