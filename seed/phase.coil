;;; Typed artifact prerequisites derive a deterministic serial phase schedule.
(module rewrite.phase)
(import "rewrite.schema" :use [problem])
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use [HashMap])
(import "coil.str" :use [keyops])
(import "coil.reader" :use *)
(import "coil.result" :use *)

(defstruct Artifact
  [(name (slice u8)) (kind (slice u8)) (producer i64) (origin Sexp)])

(defstruct Phase [(name (slice u8)) (needs (ArrayList Sexp)) (origin Sexp)])

(defn add-artifact! [(artifacts (mut (ArrayList Artifact)))
                     (names (mut (HashMap (slice u8) i64)))
                     (name (ptr Sexp))
                     (kind (ptr Sexp))
                     (producer i64)]
  (-> (Result i64 Diag))
  (block :done
    (unless (and (sexp-sym? name) (sexp-sym? kind))
      (break
        :done
          (Err (problem name "artifact name and representation must be symbols"))))
    (match (get (load names) (sexp-sym name))
      (Some [_]
            (break :done (Err (problem name "artifact has multiple producers"))))
      (None []))
    (let [index (len (load artifacts))]
      (push! (mut artifacts)
             (Artifact
               :name (sexp-sym name)
               :kind (sexp-sym kind)
               :producer producer
               :origin (load name)))
      (set! (mut names) (sexp-sym name) index)
      (Ok index))))

;;; Pass an arena: parser/planner intermediates share its lifetime, on errors too.
;;; Returned phase names borrow the source text.
;;; Artifacts are single-assignment and all phases are scheduled exactly once.
(defn schedule [(a (dyn Allocator)) (text (slice u8)) (source i64)]
  (-> (Result (ArrayList (slice u8)) Diag))
  (block
    :done
      (let [forms
              (match (read-all a text source)
                (Err [d] (break :done (Err d)))
                (Ok [forms] forms))]
        (unless (= (len (load forms)) 1)
          (break
            :done
              (Err (Diag
                     :lo 0
                     :hi (len text)
                     :source source
                     :ctxt 0
                     :msg "expected one phases form"))))
        (let [form (elem forms 0)
              (mut artifacts) (ArrayList::new [Artifact] a)
              (mut names) (HashMap::new [(slice u8) i64] a (keyops))
              (mut phase-names) (HashMap::new [(slice u8) i64] a (keyops))
              (mut phases) (ArrayList::new [Phase] a)]
          (unless (and (sexp-list? form)
                       (> (sexp-count form) 0)
                       (sexp-sym-is (sexp-nth form 0) "phases"))
            (break :done (Err (problem form "expected phases form"))))
          (for [i 1 (sexp-count form)]
            (let [item (sexp-nth form i)]
              (unless (and (sexp-list? item) (> (sexp-count item) 0))
                (break :done (Err (problem item "expected input or phase"))))
              (cond (sexp-sym-is (sexp-nth item 0) "input")
                      (do
                        (unless (= (sexp-count item) 3)
                          (break
                            :done
                              (Err (problem item
                                            "expected (input name Representation)"))))
                        (match (add-artifact! (mut artifacts)
                                              (mut names)
                                              (sexp-nth item 1)
                                              (sexp-nth item 2)
                                              (- 0 1))
                          (Err [d] (break :done (Err d)))
                          (Ok [_])))
                    (sexp-sym-is (sexp-nth item 0) "phase")
                      (do
                        (unless (and (= (sexp-count item) 4)
                                     (sexp-sym? (sexp-nth item 1)))
                          (break
                            :done
                              (Err (problem item
                                            "expected (phase name (needs ...) (makes ...))"))))
                        (let [name (sexp-sym (sexp-nth item 1))
                              needs (sexp-nth item 2)
                              makes (sexp-nth item 3)
                              index (len phases)
                              (mut requirements) (ArrayList::new [Sexp] a)]
                          (match (get phase-names name)
                            (Some [_]
                                  (break
                                    :done
                                      (Err (problem (sexp-nth item 1)
                                                    "duplicate phase"))))
                            (None []))
                          (unless (and (sexp-list? needs)
                                       (> (sexp-count needs) 0)
                                       (sexp-sym-is (sexp-nth needs 0) "needs")
                                       (sexp-list? makes)
                                       (> (sexp-count makes) 1)
                                       (sexp-sym-is (sexp-nth makes 0) "makes"))
                            (break
                              :done
                                (Err (problem item
                                              "phase requires needs and nonempty makes clauses"))))
                          (for [j 1 (sexp-count needs)]
                            (let [need (sexp-nth needs j)]
                              (unless (and (sexp-list? need)
                                           (= (sexp-count need) 2)
                                           (sexp-sym? (sexp-nth need 0))
                                           (sexp-sym? (sexp-nth need 1)))
                                (break
                                  :done
                                    (Err (problem need
                                                  "expected (artifact Representation) requirement"))))
                              (push! (mut requirements) (load need))))
                          (for [j 1 (sexp-count makes)]
                            (let [product (sexp-nth makes j)]
                              (unless (and (sexp-list? product)
                                           (= (sexp-count product) 2))
                                (break
                                  :done
                                    (Err (problem product
                                                  "expected (artifact Representation) product"))))
                              (match (add-artifact! (mut artifacts)
                                                    (mut names)
                                                    (sexp-nth product 0)
                                                    (sexp-nth product 1)
                                                    index)
                                (Err [d] (break :done (Err d)))
                                (Ok [_]))))
                          (set! (mut phase-names) name index)
                          (push! (mut phases)
                                 (Phase
                                   :name name
                                   :needs requirements
                                   :origin (load item)))))
                    :else
                      (break
                        :done (Err (problem item "expected input or phase"))))))
          (let [(mut counts) (ArrayList::new [i64] a)
                (mut outgoing) (ArrayList::new [(ArrayList i64)] a)
                (mut ready) (ArrayList::new [i64] a)
                (mut order) (ArrayList::new [(slice u8)] a)]
            (for [i 0 (len phases)]
              (push! (mut counts) 0)
              (push! (mut outgoing) (ArrayList::new [i64] a)))
            (for [i 0 (len phases)]
              (let [phase (elem (mut phases) i)]
                (for [j 0 (len (.needs phase))]
                  (let [need (elem (field phase needs) j)
                        artifact
                          (match (get names (sexp-sym (sexp-nth need 0)))
                            (None []
                                  (break
                                    :done
                                      (Err (problem need
                                                    "phase requires an artifact with no producer"))))
                            (Some [index] (get artifacts index)))]
                    (unless (sexp-sym-is (sexp-nth need 1) (.kind artifact))
                      (break
                        :done
                          (Err (problem need
                                        "phase artifact representation mismatch"))))
                    (when (>= (.producer artifact) 0)
                      (set! (mut counts) i (+ (get counts i) 1))
                      (push! (elem (mut outgoing) (.producer artifact)) i))))))
            (for [i 0 (len phases)]
              (when (= (get counts i) 0) (push! (mut ready) i)))
            (let [(mut cursor) 0]
              (while (< cursor (len ready))
                (let [i (get ready cursor)
                      edges (elem (mut outgoing) i)]
                  (push! (mut order) (.name (elem (mut phases) i)))
                  (for [j 0 (len (load edges))]
                    (let [dependent (get (load edges) j)
                          remaining (- (get counts dependent) 1)]
                      (set! (mut counts) dependent remaining)
                      (when (= remaining 0) (push! (mut ready) dependent)))))
                (set! cursor (+ cursor 1))))
            (unless (= (len order) (len phases))
              (for [i 0 (len phases)]
                (when (> (get counts i) 0)
                  (break
                    :done
                      (Err (problem (field (elem (mut phases) i) origin)
                                    "cyclic phase prerequisites"))))))
            (Ok order))))))
