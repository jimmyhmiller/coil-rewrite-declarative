;;; Owned route evidence for one source-analysis session. Resolution stays pure.
(module rewrite.sourceroutes)
(import "rewrite.nameforms" :as forms)
(import "rewrite.source" :as source)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use [HashMap])
(import "coil.str" :use *)
(import "coil.result" :use *)

(defstruct Table
  [(allocator (dyn Allocator))
   (enabled? bool)
   (scoped? bool)
   (strings source/Sources)
   (modules (HashMap (slice u8) bool))
   (routes (HashMap (slice u8) forms/N8Row))
   (probe StrBuf)])

(defn create [(a (dyn Allocator))] (-> Table)
  (Table
    :allocator a
    :enabled? false
    :scoped? false
    :strings (source/create a)
    :modules (HashMap::new [(slice u8) bool] a (keyops-borrowed))
    :routes (HashMap::new [(slice u8) forms/N8Row] a (keyops-borrowed))
    :probe (StrBuf::new a)))

(defn release! [(table (mut Table))] (-> void)
  (free! (mut (.modules table)))
  (free! (mut (.routes table)))
  (free! (mut (.probe table)))
  (source/release! (mut (.strings table))))

;;; All previously returned borrowed records are invalidated by start/stop/release.
(defn stop! [(table (mut Table))] (-> void)
  (let [a (.allocator table)] (release! (mut table)) (set! table (create a))))

(defn start! [(table (mut Table))] (-> void)
  (stop! (mut table))
  (set! (.enabled? table) true))

;;; Like source-facts-scope!, repeated calls add modules; an empty list restricts
;;; an analysis to none. Start resets this filter to unrestricted.
(defn scope! [(table (mut Table)) (modules (ptr (ArrayList (slice u8))))]
  (-> void)
  (for name (load modules)
    (let [owned (source/intern! (mut (.strings table)) name)]
      (set! (mut (.modules table)) owned true)))
  (set! (.scoped? table) true))

(defn observing? [(table (ptr Table)) (module (slice u8))] (-> bool)
  (and (.enabled? table)
       (or (not (.scoped? table))
           (match (get (.modules table) module) (Some [_] true) (None [] false)))))

;;; Length-framed keys keep arbitrary internal spellings unambiguous. This is a
;;; private representation, not the reference's printable source-name key format.
(defn key! [(table (ptr Table)) (module (slice u8)) (raw (slice u8)) (kind i64)]
  (-> (slice u8))
  (clear! (field (field table probe) bytes))
  (push-i64! (field table probe) (len module))
  (push-str! (field table probe) ":")
  (push-str! (field table probe) module)
  (push-str! (field table probe) ":")
  (push-i64! (field table probe) kind)
  (push-str! (field table probe) ":")
  (push-str! (field table probe) raw)
  (str (.probe table)))

(defn lookup [(table (ptr Table))
              (module (slice u8))
              (raw (slice u8))
              (kind i64)]
  (-> (Option forms/N8Row))
  (get (.routes table) (key! table module raw kind)))

;;; True means the stored value changed. Misses and disabled/out-of-scope queries
;;; do not erase prior evidence. Returned records borrow table-owned text.
(defn record! [(table (ptr Table))
               (module (slice u8))
               (raw (slice u8))
               (kind i64)
               (candidate forms/N8Row)] (-> bool)
  (block :done
    (unless (observing? table module) (break :done false))
    (let [key (key! table module raw kind)]
      (match (get (.routes table) key)
        (None [])
        (Some [old]
              (let [(mut previous) old
                    (mut next) candidate]
                (when (forms/equivalent-same-route (mut previous) (mut next))
                  (break :done false)))))
      (let [owned-key (source/intern! (field table strings) key)
            value
              (forms/N8Row
                :f0 (source/intern! (field table strings) (.f0 candidate))
                :f1 (source/intern! (field table strings) (.f1 candidate))
                :f2 (source/intern! (field table strings) (.f2 candidate)))]
        (set! (field table routes) owned-key value))
      true)))

(defn copy! [(table (ptr Table))
             (module (slice u8))
             (raw (slice u8))
             (from i64)
             (to i64)] (-> bool)
  (if (not (observing? table module))
      false
      (match (lookup table module raw from)
        (None [] false)
        (Some [value] (record! table module raw to value)))))
