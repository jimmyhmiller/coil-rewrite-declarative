;;; Schema-driven readers for constructor syntax, using checked field layouts.
(module rewrite.readers)
(import "rewrite.schema" :use *)
(import "rewrite.emit" :use [number!])
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.str" :use *)

(defn quoted! [(b (mut StrBuf)) (text (slice u8))] (-> void)
  (push! (mut b) (: 34 u8))
  (for byte text
    (when (or (= byte (: 34 u8)) (= byte (: 92 u8))) (push! (mut b) (: 92 u8)))
    (push! (mut b) byte))
  (push! (mut b) (: 34 u8)))

(defn emit [(a (dyn Allocator)) (s (ptr Schema))] (-> (slice u8))
  (let [(mut b) (StrBuf::new a)]
    (push-str! (mut b)
               "(import \"coil.reader\" :use *)\n(import \"coil.result\" :use *)\n(import \"coil.alloc\" :use *)\n(import \"rewrite.source\" :as source)\n(import \"rewrite.sequence\" :as sequence)\n(defstruct Store [(source-data source/Sources) (traces (ArrayList source/Trace)) ")
    (for [i 0 (len (.nodes s))]
      (push-str! (mut b) "(rows")
      (number! (mut b) i)
      (push-str! (mut b) " (ArrayList N")
      (number! (mut b) i)
      (push-str! (mut b) "Row)) (origins")
      (number! (mut b) i)
      (push-str! (mut b) " (ArrayList source/Origin)) (sequences")
      (number! (mut b) i)
      (push-str! (mut b) " (sequence/Table N")
      (number! (mut b) i)
      (push-str! (mut b) "Id))"))
    (push-str! (mut b)
               "])\n(defn store-new [(a (dyn Allocator))] (-> Store) (Store :source-data (source/create a) :traces (ArrayList::new [source/Trace] a) ")
    (for [i 0 (len (.nodes s))]
      (push-str! (mut b) ":rows")
      (number! (mut b) i)
      (push-str! (mut b) " (ArrayList::new [N")
      (number! (mut b) i)
      (push-str! (mut b) "Row] a) :origins")
      (number! (mut b) i)
      (push-str! (mut b) " (ArrayList::new [source/Origin] a) :sequences")
      (number! (mut b) i)
      (push-str! (mut b) " (sequence/create [N")
      (number! (mut b) i)
      (push-str! (mut b) "Id] a) "))
    (push-str! (mut b)
               "))\n(defn store-free! [(store (mut Store))] (-> void) (free! (mut (.traces store))) (source/release! (mut (.source-data store))) ")
    (for [i 0 (len (.nodes s))]
      (push-str! (mut b) "(free! (mut (.rows")
      (number! (mut b) i)
      (push-str! (mut b) " store))) ")
      (push-str! (mut b) "(free! (mut (.origins")
      (number! (mut b) i)
      (push-str! (mut b) " store))) (sequence/release! (mut (.sequences")
      (number! (mut b) i)
      (push-str! (mut b) " store))) "))
    (push-str! (mut b)
               ")\n(defn store-text! [(store (mut Store)) (text (slice u8))] (-> (slice u8)) (source/intern! (mut (.source-data store)) text))\n(defn origin-of [(form (ptr Sexp))] (-> source/Origin) (source/origin form))\n(defn store-source! [(store (mut Store)) (id i64) (name (slice u8)) (text (slice u8))] (-> (Result bool source/SourceError)) (source/register! (mut (.source-data store)) id name text))\n(defn input-error [(form (ptr Sexp)) (message (slice u8))] (-> Diag) (Diag :lo (.lo form) :hi (.hi form) :source (.source form) :ctxt 0 :msg message))\n")
    (for [i 0 (len (.nodes s))]
      (push-str! (mut b) "(defstruct N")
      (number! (mut b) i)
      (push-str! (mut b) "Seq [(index i64)])\n(defn sequence-")
      (number! (mut b) i)
      (push-str! (mut b) " [(store (mut Store)) (items (ptr (ArrayList N")
      (number! (mut b) i)
      (push-str! (mut b) "Id)))] (-> N")
      (number! (mut b) i)
      (push-str! (mut b) "Seq) (N")
      (number! (mut b) i)
      (push-str! (mut b) "Seq :index (sequence/append! (mut (.sequences")
      (number! (mut b) i)
      (push-str! (mut b) " store)) items)))\n(defn sequence-size-")
      (number! (mut b) i)
      (push-str! (mut b) " [(store (ptr Store)) (ids N")
      (number! (mut b) i)
      (push-str! (mut b)
                 "Seq)] (-> (Option i64)) (sequence/size (field store sequences")
      (number! (mut b) i)
      (push-str! (mut b) ") (.index ids)))\n(defn sequence-item-")
      (number! (mut b) i)
      (push-str! (mut b) " [(store (ptr Store)) (ids N")
      (number! (mut b) i)
      (push-str! (mut b) "Seq) (position i64)] (-> (Option N")
      (number! (mut b) i)
      (push-str! (mut b) "Id)) (sequence/item (field store sequences")
      (number! (mut b) i)
      (push-str! (mut b)
                 ") (.index ids) position))\n(defn sequence-materialize-")
      (number! (mut b) i)
      (push-str! (mut b) " [(a (dyn Allocator)) (store (ptr Store)) (ids N")
      (number! (mut b) i)
      (push-str! (mut b) "Seq) (output (mut (ArrayList N")
      (number! (mut b) i)
      (push-str! (mut b)
                 "Id)))] (-> (Result i64 sequence/SequenceError)) (sequence/materialize! a (field store sequences")
      (number! (mut b) i)
      (push-str! (mut b) ") (.index ids) (mut output)))\n"))
    (for [i 0 (len (.nodes s))]
      (let [n (elem (field s nodes) i)]
        (push-str! (mut b) "(defn parse-")
        (number! (mut b) i)
        (push-str! (mut b)
                   " [(store (mut Store)) (form (ptr Sexp))] (-> (Result N")
        (number! (mut b) i)
        (push-str! (mut b)
                   "Id Diag)) (block :parsed (unless (and (sexp-list? form) (> (sexp-count form) 0)) (break :parsed (Err (input-error form \"expected constructor form\")))) ")
        (for [vi 0 (len (.variants n))]
          (let [v (elem (field n variants) vi)]
            (push-str! (mut b) "(when (sexp-sym-is (sexp-nth form 0) ")
            (quoted! (mut b) (.name v))
            (push-str! (mut b) ") (unless (= (sexp-count form) ")
            (number! (mut b) (+ 1 (len (.fields v))))
            (push-str! (mut b)
                       ") (break :parsed (Err (input-error form \"wrong constructor arity\")))) (let [")
            (for [f 0 (len (.fields v))]
              (let [field (elem (field v fields) f)
                    ty (.type-name field)]
                (push-str! (mut b) "x")
                (number! (mut b) f)
                (push-str! (mut b) " (sexp-nth form ")
                (number! (mut b) (+ f 1))
                (push-str! (mut b) ") f")
                (number! (mut b) f)
                (push-str! (mut b) " ")
                (if (scalar? ty)
                    (do
                      (push-str! (mut b) "(if ")
                      (if (= ty "Bool")
                          (do
                            (push-str! (mut b) "(or (sexp-sym-is x")
                            (number! (mut b) f)
                            (push-str! (mut b) " \"true\") (sexp-sym-is x")
                            (number! (mut b) f)
                            (push-str! (mut b) " \"false\"))"))
                          (do
                            (push-str! (mut b)
                                       (if (= ty "Int")
                                           "(sexp-int? x"
                                           "(sexp-str? x"))
                            (number! (mut b) f)
                            (push-str! (mut b) ")")))
                      (push-str! (mut b)
                                 (cond (= ty "Int") " (sexp-int x"
                                       (= ty "Text")
                                         " (store-text! (mut store) (sexp-str x"
                                       :else " (sexp-sym-is x"))
                      (number! (mut b) f)
                      (when (= ty "Bool") (push-str! (mut b) " \"true\""))
                      (when (= ty "Text") (push-str! (mut b) ")"))
                      (push-str! (mut b) ") (break :parsed (Err (input-error x")
                      (number! (mut b) f)
                      (push-str! (mut b) " \"wrong scalar field type\")))) "))
                    (for [target 0 (len (.nodes s))]
                      (when (= ty (.name (elem (field s nodes) target)))
                        (when (.many? field)
                          (push-str! (mut b)
                                     "(block :sequence (unless (sexp-vec? x")
                          (number! (mut b) f)
                          (push-str! (mut b)
                                     ") (break :parsed (Err (input-error x")
                          (number! (mut b) f)
                          (push-str! (mut b)
                                     " \"expected sequence vector\")))) (let [(mut children) (ArrayList::new [N")
                          (number! (mut b) target)
                          (push-str! (mut b)
                                     "Id] (.allocator (.source-data store)))] (defer (free! (mut children))) (for [child-index 0 (sexp-count x")
                          (number! (mut b) f)
                          (push-str! (mut b) ")] (push! (mut children) "))
                        (push-str! (mut b) "(match (parse-")
                        (number! (mut b) target)
                        (push-str! (mut b) " (mut store) ")
                        (when (.many? field) (push-str! (mut b) "(sexp-nth "))
                        (push-str! (mut b) "x")
                        (number! (mut b) f)
                        (when (.many? field)
                          (push-str! (mut b) " child-index)"))
                        (push-str! (mut b)
                                   ") (Ok [id] id) (Err [d] (break :parsed (Err d)))) ")
                        (when (.many? field)
                          (push-str! (mut b) ")) (sequence-")
                          (number! (mut b) target)
                          (push-str! (mut b) " (mut store) (mut children)))) ")))))))
            (push-str! (mut b) "id (append-")
            (number! (mut b) i)
            (push-str! (mut b) " (mut (.rows")
            (number! (mut b) i)
            (push-str! (mut b) " store)) (N")
            (number! (mut b) i)
            (if (.sum? n)
                (do (push-str! (mut b) "V") (number! (mut b) vi))
                (push-str! (mut b) "Row"))
            (for [f 0 (len (.fields v))]
              (unless (.sum? n) (push-str! (mut b) " :f") (number! (mut b) f))
              (push-str! (mut b) " f")
              (number! (mut b) f))
            (push-str! (mut b) "))] (push! (mut (.origins")
            (number! (mut b) i)
            (push-str! (mut b)
                       " store)) (origin-of form)) (break :parsed (Ok id)))) ")))
        (push-str! (mut b)
                   "(Err (input-error (sexp-nth form 0) \"unknown constructor\"))))\n")))
    (push-str! (mut b)
               "(defsum SyntaxWalk (KeepSyntax) (VisitChildren [(start i64)]))\n(defstruct SyntaxCapture [(source (ptr Sexp)) (start i64) (rest? bool)])\n(defstruct SyntaxView [(variant i64) (captures (ArrayList SyntaxCapture))])\n")
    (push-str! (mut b)
               "(defn syntax-float-bits [(form (ptr Sexp))] (-> i64) (match (.kind form) (KFloat [bits] bits) (_ (panic \"invalid float capture\"))))\n(defn syntax-cstring? [(form (ptr Sexp))] (-> bool) (match (.kind form) (KCStr [_] true) (_ false)))\n(defn syntax-cstring [(form (ptr Sexp))] (-> (slice u8)) (match (.kind form) (KCStr [text] text) (_ (panic \"invalid cstring capture\"))))\n")
    (str (load b))))
