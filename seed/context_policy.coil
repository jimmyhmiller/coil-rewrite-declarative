;;; Schema-directed metadata edits; unmentioned variants and fields are preserved.
(module rewrite.contextpolicy)
(import "rewrite.schema" :use *)
(import "rewrite.resolve" :use [indexed!])
(import "rewrite.emit" :use [number!])
(import "rewrite.readers" :use [quoted!])
(import "rewrite.protocol" :use [name?])
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use *)
(import "coil.str" :use [StrBuf])
(import "coil.reader" :use *)
(import "coil.result" :use *)

(defn find-node [(schema (ptr Schema)) (name (slice u8))] (-> i64)
  (block :done
    (for [i 0 (len (.nodes schema))]
      (when (= name (.name (elem (field schema nodes) i))) (break :done i)))
    (- 0 1)))

(defn emit [(a (dyn Allocator))
            (schema (ptr Schema))
            (forms (ptr (ArrayList Sexp)))]
  (-> (Result (slice u8) Diag))
  (block
    :done
      (let [(mut out) (StrBuf::new a)
            (mut names) (ArrayList::new [(slice u8)] a)]
        (for [i 0 (len (load forms))]
          (let [form (elem forms i)]
            (when (and (sexp-list? form)
                       (> (sexp-count form) 0)
                       (sexp-sym-is (sexp-nth form 0) "context-policy"))
              (unless (and (>= (sexp-count form) 4)
                           (sexp-sym? (sexp-nth form 1))
                           (sexp-sym? (sexp-nth form 2))
                           (sexp-sym? (sexp-nth form 3)))
                (break
                  :done
                    (Err (problem form
                                  "expected (context-policy Name Sum Record (Variant (field value)...)...)"))))
              (let [name (sexp-sym (sexp-nth form 1))
                    n (find-node schema (sexp-sym (sexp-nth form 2)))
                    m (find-node schema (sexp-sym (sexp-nth form 3)))]
                (unless (name? name)
                  (break
                    :done (Err (problem form "invalid context policy name"))))
                (for previous names
                  (when (= name previous)
                    (break
                      :done (Err (problem form "duplicate context policy")))))
                (push! (mut names) name)
                (when (or (< n 0) (< m 0))
                  (break
                    :done (Err (problem form "unknown context policy schema"))))
                (let [node (elem (field schema nodes) n)
                      metadata (elem (field schema nodes) m)]
                  (unless (and (.sum? node) (not (.sum? metadata)))
                    (break
                      :done
                        (Err (problem form
                                      "context policy needs a sum and a record"))))
                  (let [fields (field (elem (field metadata variants) 0) fields)
                        (mut rules) (ArrayList::new [i64] a)
                        (mut fresh-cases) (StrBuf::new a)]
                    (push-str! (mut out) "(defn context-")
                    (push-str! (mut out) name)
                    (indexed! (mut out) " [(kind N" n "Row) (context N")
                    (indexed! (mut out) "" m "Row) (fresh i64)] (-> N")
                    (indexed! (mut out) "" m "Row) (match kind ")
                    (for [r 4 (sexp-count form)]
                      (let [rule (sexp-nth form r)
                            (mut variant) (- 0 1)
                            (mut fresh?) false
                            (mut assignments) (ArrayList::new [i64] a)]
                        (unless (and (sexp-list? rule)
                                     (> (sexp-count rule) 0)
                                     (sexp-sym? (sexp-nth rule 0)))
                          (break
                            :done
                              (Err (problem rule
                                            "expected context variant rule"))))
                        (for [v 0 (len (.variants node))]
                          (when (sexp-sym-is (sexp-nth rule 0)
                                             (.name (elem (field node variants)
                                                          v)))
                            (set! variant v)))
                        (when (< variant 0)
                          (break
                            :done (Err (problem rule "unknown context variant"))))
                        (for v rules
                          (when (= v variant)
                            (break
                              :done
                                (Err (problem rule "duplicate context variant")))))
                        (push! (mut rules) variant)
                        (for [f 0 (len (load fields))]
                          (push! (mut assignments) (- 0 1)))
                        (for [j 1 (sexp-count rule)]
                          (let [assignment (sexp-nth rule j)
                                (mut field-index) (- 0 1)]
                            (unless (and (sexp-list? assignment)
                                         (= (sexp-count assignment) 2)
                                         (sexp-sym? (sexp-nth assignment 0)))
                              (break
                                :done
                                  (Err (problem assignment
                                                "expected (field literal-or-fresh)"))))
                            (for [f 0 (len (load fields))]
                              (when (sexp-sym-is (sexp-nth assignment 0)
                                                 (.name (elem fields f)))
                                (set! field-index f)))
                            (when (< field-index 0)
                              (break
                                :done
                                  (Err (problem assignment
                                                "unknown context field"))))
                            (when (>= (get assignments field-index) 0)
                              (break
                                :done
                                  (Err (problem assignment
                                                "duplicate context field"))))
                            (let [field (elem fields field-index)
                                  value (sexp-nth assignment 1)]
                              (unless (and (not (.many? field))
                                           (cond (= (.type-name field) "Int")
                                                   (or (sexp-int? value)
                                                       (sexp-sym-is value
                                                                    "fresh"))
                                                 (= (.type-name field) "Text")
                                                   (sexp-str? value)
                                                 (= (.type-name field) "Bool")
                                                   (or (sexp-sym-is value
                                                                    "true")
                                                       (sexp-sym-is value
                                                                    "false"))
                                                 :else false))
                                (break
                                  :done
                                    (Err (problem value
                                                  "context value disagrees with field type"))))
                              (when (sexp-sym-is value "fresh")
                                (set! fresh? true)))
                            (set! (mut assignments) field-index j)))
                        (indexed! (mut out) "(N" n "V")
                        (number! (mut out) variant)
                        (push-str! (mut out) " [")
                        (indexed! (mut fresh-cases) "(N" n "V")
                        (number! (mut fresh-cases) variant)
                        (push-str! (mut fresh-cases) " [")
                        (for [f
                              0
                              (len (.fields (elem (field node variants) variant)))]
                          (push-str! (mut out) "_ ")
                          (push-str! (mut fresh-cases) "_ "))
                        (push-str! (mut fresh-cases)
                                   (if fresh? "] true)" "] false)"))
                        (indexed! (mut out) "] (N" m "Row ")
                        (for [f 0 (len (load fields))]
                          (indexed! (mut out) ":f" f " ")
                          (let [j (get assignments f)]
                            (if (< j 0)
                                (indexed! (mut out) "(.f" f " context)")
                                (let [value (sexp-nth (sexp-nth rule j) 1)]
                                  (cond (sexp-int? value)
                                          (number! (mut out) (sexp-int value))
                                        (sexp-str? value)
                                          (quoted! (mut out) (sexp-str value))
                                        :else
                                          (push-str! (mut out) (sexp-sym value))))))
                          (push-str! (mut out) " "))
                        (push-str! (mut out) "))")))
                    (push-str! (mut out) "(_ context)))\n(defn context-")
                    (push-str! (mut out) name)
                    (indexed! (mut out)
                              "-fresh? [(kind N"
                              n
                              "Row)] (-> bool) (match kind ")
                    (push-str! (mut out) (str (load fresh-cases)))
                    (push-str! (mut out) "(_ false)))\n")))))))
        (Ok (str (load out))))))
