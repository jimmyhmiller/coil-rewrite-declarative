;;; Bootstrap schema language. All references are resolved before consumers run.
(module rewrite.schema)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)

(defstruct Field [(name (slice u8)) (type-name (slice u8)) (origin Sexp)])

(defstruct Variant [(name (slice u8)) (fields (ArrayList Field)) (origin Sexp)])

(defstruct Node
  [(name (slice u8)) (variants (ArrayList Variant)) (sum? bool) (origin Sexp)])

(defstruct Schema [(nodes (ArrayList Node))])

(defn problem [(at (ptr Sexp)) (message (slice u8))] (-> Diag)
  (Diag
    :lo (.lo at)
    :hi (.hi at)
    :source (.source at)
    :ctxt 0
    :msg message))

(defn scalar? [(name (slice u8))] (-> bool)
  (or (= name "Int") (or (= name "Bool") (= name "Text"))))

(defn known? [(nodes (ptr (ArrayList Node))) (name (slice u8))] (-> bool)
  (block :found
    (for [i 0 (len (load nodes))]
      (when (= (.name (elem nodes i)) name) (break :found true)))
    false))

(defn parse-field [(form (ptr Sexp))] (-> (Result Field Diag))
  (if (not (and (sexp-list? form) (= (sexp-count form) 2)))
      (Err (problem form "expected (field-name Type)"))
      (let [name (sexp-nth form 0)
            ty (sexp-nth form 1)]
        (if (not (and (sexp-sym? name) (sexp-sym? ty)))
            (Err (problem form "field name and type must be symbols"))
            (Ok (Field
                  :name (sexp-sym name)
                  :type-name (sexp-sym ty)
                  :origin (load form)))))))

(defn parse-variant [(a (dyn Allocator)) (form (ptr Sexp)) (offset i64)]
  (-> (Result Variant Diag))
  (block :result
    (unless (and (sexp-list? form) (> (sexp-count form) offset))
      (break :result (Err (problem form "expected named variant"))))
    (let [name (sexp-nth form offset)
          (mut fields) (ArrayList::new [Field] a)]
      (unless (sexp-sym? name)
        (break :result (Err (problem name "variant name must be a symbol"))))
      (for [i (+ offset 1) (sexp-count form)]
        (match (parse-field (sexp-nth form i))
          (Err [d] (break :result (Err d)))
          (Ok [f]
              (do
                (for [j 0 (len fields)]
                  (when (= (.name (elem (mut fields) j)) (.name f))
                    (break
                      :result
                        (Err (problem (sexp-nth form i) "duplicate field")))))
                (push! (mut fields) f)))))
      (Ok (Variant
            :name (sexp-sym name)
            :fields fields
            :origin (load form))))))

(defn parse-node [(a (dyn Allocator)) (form (ptr Sexp))] (-> (Result Node Diag))
  (block :result
    (unless (and (sexp-list? form) (>= (sexp-count form) 2))
      (break :result (Err (problem form "expected node or sum declaration"))))
    (let [head (sexp-nth form 0)
          name (sexp-nth form 1)
          sum? (sexp-sym-is head "sum")
          (mut variants) (ArrayList::new [Variant] a)]
      (unless (or sum? (sexp-sym-is head "node"))
        (break :result (Err (problem head "expected node or sum declaration"))))
      (unless (sexp-sym? name)
        (break :result (Err (problem name "node name must be a symbol"))))
      (when (scalar? (sexp-sym name))
        (break
          :result (Err (problem name "node name is reserved for a scalar type"))))
      (if sum?
          (do
            (when (= (sexp-count form) 2)
              (break
                :result (Err (problem form "sum requires at least one variant"))))
            (for [i 2 (sexp-count form)]
              (match (parse-variant a (sexp-nth form i) 0)
                (Err [d] (break :result (Err d)))
                (Ok [v]
                    (do
                      (for [j 0 (len variants)]
                        (when (= (.name (elem (mut variants) j)) (.name v))
                          (break
                            :result
                              (Err (problem (sexp-nth form i)
                                            "duplicate variant")))))
                      (push! (mut variants) v))))))
          (match (parse-variant a form 1)
            (Err [d] (break :result (Err d)))
            (Ok [v] (push! (mut variants) v))))
      (Ok (Node
            :name (sexp-sym name)
            :variants variants
            :sum? sum?
            :origin (load form))))))

;;; Storage and source text must outlive the returned schema, including diagnostics.
;;; Pass an arena: unsuccessful parsing also belongs to that allocation lifetime.
(defn parse-forms [(a (dyn Allocator)) (forms (ptr (ArrayList Sexp)))]
  (-> (Result Schema Diag))
  (block
    :result
      (let [(mut nodes) (ArrayList::new [Node] a)]
        (for [i 0 (len (load forms))]
          (unless (and (sexp-list? (elem forms i))
                       (> (sexp-count (elem forms i)) 0)
                       (or (sexp-sym-is (sexp-nth (elem forms i) 0) "judgment")
                           (or (sexp-sym-is (sexp-nth (elem forms i) 0) "lower") (sexp-sym-is (sexp-nth (elem forms i) 0) "program"))))
            (match (parse-node a (elem forms i))
              (Err [d] (break :result (Err d)))
              (Ok [n]
                  (do
                    (when (known? (mut nodes) (.name n))
                      (break
                        :result (Err (problem (elem forms i) "duplicate node"))))
                    (push! (mut nodes) n))))))
        (for [i 0 (len nodes)]
          (let [n (elem (mut nodes) i)]
            (for [v 0 (len (.variants n))]
              (let [variant (elem (field n variants) v)]
                (for [j 0 (len (.fields variant))]
                  (let [f (elem (field variant fields) j)]
                    (unless (or (scalar? (.type-name f))
                                (known? (mut nodes) (.type-name f)))
                      (break
                        :result
                          (Err (problem (sexp-nth (field f origin) 1)
                                        "unknown field type"))))))))))
        (Ok (Schema :nodes nodes)))))

(defn parse [(a (dyn Allocator)) (text (slice u8)) (source i64)]
  (-> (Result Schema Diag))
  (match (read-all a text source)
    (Err [d] (Err d))
    (Ok [forms] (parse-forms a forms))))
