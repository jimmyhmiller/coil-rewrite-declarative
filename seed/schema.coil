;;; Bootstrap schema language. All references are resolved before consumers run.
(module rewrite.schema)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.hashmap" :use [HashMap])
(import "coil.str" :as keystr)
(import "rewrite.schemaforms" :as grammar)

(defstruct Field
  [(name (slice u8))
   (type-name (slice u8))
   (many? bool)
   (key? bool)
   (origin Sexp)])

(defstruct Variant [(name (slice u8)) (fields (ArrayList Field)) (origin Sexp)])

(defstruct Node
  [(name (slice u8)) (variants (ArrayList Variant)) (sum? bool) (origin Sexp)])

(defstruct Schema [(nodes (ArrayList Node))])

(defn problem [(at (ptr Sexp)) (message (slice u8))] (-> Diag)
  (Diag
    :lo (.lo at)
    :hi (.hi at)
    :source (.source at)
    :ctxt 0
    :msg message))

(defn scalar? [(name (slice u8))] (-> bool)
  (or (= name "Int") (or (= name "Bool") (= name "Text"))))

(defn validate-keys [(a (dyn Allocator)) (node (ptr Node))]
  (-> (Result bool Diag))
  (block
    :done
      (let [(mut expected)
              (HashMap::new [(slice u8) (slice u8)] a (keystr/keyops-borrowed))
            (mut expected-count) 0]
        (defer (free! (mut expected)))
        (for [v 0 (len (.variants node))]
          (let [variant (elem (field node variants) v)
                (mut count) 0]
            (for [f 0 (len (.fields variant))]
              (let [field (elem (field variant fields) f)]
                (when (.key? field)
                  (unless (and (not (.many? field))
                               (scalar? (.type-name field)))
                    (break
                      :done
                        (Err (problem (field field origin)
                                      "key requires a scalar field"))))
                  (set! count (+ count 1))
                  (if (= v 0)
                      (when (> (len (.variants node)) 1)
                        (set! (mut expected) (.name field) (.type-name field)))
                      (unless (match (get expected (.name field))
                                (Some [ty] (= ty (.type-name field)))
                                (None [] false))
                        (break
                          :done
                            (Err (problem (field field origin)
                                          "sum key must have the same name and scalar type in every variant"))))))))
            (if (= v 0)
                (set! expected-count count)
                (unless (= expected-count count)
                  (break
                    :done
                      (Err (problem (field variant origin)
                                    "sum key must have the same name and scalar type in every variant")))))))
        (Ok true))))

;;; The generated parser owns shape checking; these adapters retain the current
;;; semantic model and its original syntax locations until those clients migrate.
(defn decode-field [(store (ptr grammar/Store))
                    (id grammar/N2Id)
                    (form (ptr Sexp))]
  (-> (Result Field Diag))
  (block
    :done
      (let [row (get (.rows2 store) (.index id))
            ty (get (.rows1 store) (.index (.f1 row)))
            many? (match ty (grammar/N1V1 [_] true) (_ false))
            name
              (match ty (grammar/N1V0 [name] name) (grammar/N1V1 [name] name))
            attributes
              (match (grammar/sequence-size-0 store (.f2 row))
                (Some [n] n)
                (None [] (panic "generated attribute sequence")))]
        (when (> attributes 1)
          (break :done (Err (problem form "expected (field-name Type [:key])"))))
        (when (= attributes 1)
          (let [attribute
                  (match (grammar/sequence-item-0 store (.f2 row) 0)
                    (Some [id] (get (.rows0 store) (.index id)))
                    (None [] (panic "generated attribute")))]
            (unless (= (.f0 attribute) "key")
              (break
                :done
                  (Err (problem form
                                "unknown field attribute; only optional :key is supported"))))))
        (when (and many? (scalar? name))
          (break
            :done
              (Err (problem (sexp-nth form 1)
                            "sequence fields require node elements"))))
        (Ok (Field
              :name (.f0 row)
              :type-name name
              :many? many?
              :key? (= attributes 1)
              :origin (load form))))))

(defn decode-fields [(a (dyn Allocator))
                     (store (ptr grammar/Store))
                     (ids grammar/N2Seq)
                     (form (ptr Sexp))
                     (offset i64)] (-> (Result (ArrayList Field) Diag))
  (block
    :done
      (let [(mut fields) (ArrayList::new [Field] a)
            (mut names) (grammar/new-index-2-0 a)
            count
              (match (grammar/sequence-size-2 store ids)
                (Some [n] n)
                (None [] (panic "generated field sequence")))]
        (defer (free! (mut names)))
        (for [i 0 count]
          (let [id
                  (match (grammar/sequence-item-2 store ids i)
                    (Some [id] id)
                    (None [] (panic "generated field")))
                at (sexp-nth form (+ offset i))
                field
                  (match (decode-field store id at)
                    (Ok [field] field)
                    (Err [d] (break :done (Err d))))]
            (match (grammar/insert-index-2-0 (mut names) (field store rows2) id)
              (Ok [_])
              (Err [e]
                   (match e
                     (grammar/DuplicateKey [_ _ _ _]
                                           (break
                                             :done
                                               (Err (problem at
                                                             "duplicate field"))))
                     (_ (panic "invalid generated field identity")))))
            (push! (mut fields) field)))
        (Ok fields))))

(defn decode-node [(a (dyn Allocator))
                   (store (ptr grammar/Store))
                   (id grammar/N4Id)
                   (form (ptr Sexp))] (-> (Result Node Diag))
  (block
    :done
      (let [row (get (.rows4 store) (.index id))
            name
              (match row
                (grammar/N4V0 [name _] name)
                (grammar/N4V1 [name _] name))
            sum? (match row (grammar/N4V1 [_ _] true) (_ false))
            (mut variants) (ArrayList::new [Variant] a)]
        (when (scalar? name)
          (break
            :done
              (Err (problem (sexp-nth form 1)
                            "node name is reserved for a scalar type"))))
        (match row
          (grammar/N4V0 [_ fields]
                        (let [fields
                                (match (decode-fields a store fields form 2)
                                  (Ok [fields] fields)
                                  (Err [d] (break :done (Err d))))]
                          (push! (mut variants)
                                 (Variant
                                   :name name
                                   :fields fields
                                   :origin (load form)))))
          (grammar/N4V1 [_ ids]
                        (let [(mut names) (grammar/new-index-3-0 a)
                              count
                                (match (grammar/sequence-size-3 store ids)
                                  (Some [n] n)
                                  (None [] (panic "generated variant sequence")))]
                          (defer (free! (mut names)))
                          (when (= count 0)
                            (break
                              :done
                                (Err (problem form
                                              "sum requires at least one variant"))))
                          (for [i 0 count]
                            (let [id
                                    (match (grammar/sequence-item-3 store ids i)
                                      (Some [id] id)
                                      (None [] (panic "generated variant")))
                                  variant (get (.rows3 store) (.index id))
                                  at (sexp-nth form (+ i 2))
                                  fields
                                    (match (decode-fields a
                                                          store
                                                          (.f1 variant)
                                                          at
                                                          1)
                                      (Ok [fields] fields)
                                      (Err [d] (break :done (Err d))))]
                              (match (grammar/insert-index-3-0 (mut names)
                                                               (field store
                                                                      rows3)
                                                               id)
                                (Ok [_])
                                (Err [e]
                                     (match e
                                       (grammar/DuplicateKey [_ _ _ _]
                                                             (break
                                                               :done
                                                                 (Err (problem at
                                                                               "duplicate variant"))))
                                       (_ (panic "invalid generated variant identity")))))
                              (push! (mut variants)
                                     (Variant
                                       :name (.f0 variant)
                                       :fields fields
                                       :origin (load at))))))))
        (Ok (Node
              :name name
              :variants variants
              :sum? sum?
              :origin (load form))))))

;;; Storage and source text must outlive the returned schema, including diagnostics.
;;; Pass an arena: generated parse tables, interned names and failed parses share its lifetime.
(defn parse-forms [(a (dyn Allocator)) (forms (ptr (ArrayList Sexp)))]
  (-> (Result Schema Diag))
  (block
    :result
      (let [(mut nodes) (ArrayList::new [Node] a)
            (mut parsed) (grammar/store-new a)
            (mut names) (grammar/new-index-4-0 a)]
        (defer (free! (mut names)))
        (for [i 0 (len (load forms))]
          (unless (and (sexp-list? (elem forms i))
                       (> (sexp-count (elem forms i)) 0)
                       (or (sexp-sym-is (sexp-nth (elem forms i) 0)
                                        "pair-selection")
                           (sexp-sym-is (sexp-nth (elem forms i) 0)
                                        "text-classifier")
                           (sexp-sym-is (sexp-nth (elem forms i) 0) "intern")
                           (sexp-sym-is (sexp-nth (elem forms i) 0)
                                        "transform-context")
                           (sexp-sym-is (sexp-nth (elem forms i) 0) "selection")
                           (sexp-sym-is (sexp-nth (elem forms i) 0) "walk")
                           (sexp-sym-is (sexp-nth (elem forms i) 0) "module")
                           (sexp-sym-is (sexp-nth (elem forms i) 0)
                                        "context-policy")
                           (sexp-sym-is (sexp-nth (elem forms i) 0) "equality")
                           (sexp-sym-is (sexp-nth (elem forms i) 0)
                                        "equivalence")
                           (sexp-sym-is (sexp-nth (elem forms i) 0)
                                        "refer-policy")
                           (sexp-sym-is (sexp-nth (elem forms i) 0) "bindings")
                           (sexp-sym-is (sexp-nth (elem forms i) 0) "transform")
                           (sexp-sym-is (sexp-nth (elem forms i) 0) "syntax")
                           (sexp-sym-is (sexp-nth (elem forms i) 0) "judgment")
                           (or (sexp-sym-is (sexp-nth (elem forms i) 0) "lower")
                               (sexp-sym-is (sexp-nth (elem forms i) 0)
                                            "program"))))
            (let [id
                    (match (grammar/surface-4 (mut parsed) (elem forms i))
                      (Ok [id] id)
                      (Err [d] (break :result (Err d))))
                  node
                    (match (decode-node a (mut parsed) id (elem forms i))
                      (Ok [node] node)
                      (Err [d] (break :result (Err d))))]
              (match (grammar/insert-index-4-0 (mut names)
                                               (field (mut parsed) rows4)
                                               id)
                (Ok [_])
                (Err [e]
                     (match e
                       (grammar/DuplicateKey [_ _ _ _]
                                             (break
                                               :result
                                                 (Err (problem (elem forms i)
                                                               "duplicate node"))))
                       (_ (panic "invalid generated declaration identity")))))
              (push! (mut nodes) node))))
        (for [i 0 (len nodes)]
          (let [n (elem (mut nodes) i)]
            (match (validate-keys a n)
              (Err [d] (break :result (Err d)))
              (Ok [_]))
            (for [v 0 (len (.variants n))]
              (let [variant (elem (field n variants) v)]
                (for [j 0 (len (.fields variant))]
                  (let [f (elem (field variant fields) j)]
                    (unless (or (scalar? (.type-name f))
                                (match (get names (.type-name f))
                                  (Some [_] true)
                                  (None [] false)))
                      (break
                        :result
                          (Err (problem (sexp-nth (field f origin) 1)
                                        "unknown field type"))))))))))
        (Ok (Schema :nodes nodes)))))

(defn parse [(a (dyn Allocator)) (text (slice u8)) (source i64)]
  (-> (Result Schema Diag))
  (match (read-all a text source)
    (Err [d] (Err d))
    (Ok [forms] (parse-forms a forms))))
