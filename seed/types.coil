;;; Canonical concrete types. IDs belong to one store, with scalar IDs 1..3.
(module rewrite.types)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use *)
(import "coil.result" :use *)

(defstruct Function [(argument i64) (result i64)])

(defstruct Types [(functions (ArrayList Function)) (index (HashMap u64 i64))])

(defsum TypeError (InvalidType [(id i64)]) (TypeCapacity))

(defn create [(a (dyn Allocator))] (-> Types)
  (Types
    :functions (ArrayList::new [Function] a)
    :index (HashMap::new-scalar [u64 i64] a)))

(defn release! [(types (mut Types))] (-> void)
  (free! (mut (.functions types)))
  (free! (mut (.index types))))

(defn valid? [(types (ptr Types)) (id i64)] (-> bool)
  (and (> id 0) (< id (+ 4 (len (.functions types))))))

;;; The 32-bit halves encode a pair injectively, without padding or hash equality assumptions.
;;; Input IDs are checked before packing; exhaustion is an explicit error.
(defn function [(types (mut Types)) (argument i64) (result i64)]
  (-> (Result i64 TypeError))
  (cond (not (valid? types argument)) (Err (InvalidType argument))
        (not (valid? types result)) (Err (InvalidType result))
        :else
          (let [key
                  (+ (* (cast u64 argument) (: 4294967296 u64))
                     (cast u64 result))]
            (match (get (.index types) key)
              (Some [id] (Ok id))
              (None []
                    (let [id (+ 4 (len (.functions types)))]
                      (if (> id 4294967295)
                          (Err (TypeCapacity))
                          (do
                            (push! (mut (.functions types))
                                   (Function :argument argument :result result))
                            (set! (mut (.index types)) key id)
                            (Ok id)))))))))

(defn as-function [(types (ptr Types)) (id i64)] (-> (Option Function))
  (if (and (>= id 4) (valid? types id))
      (Some (get (.functions types) (- id 4)))
      (None)))
