;;; Program declarations derive global signature collection and all-body validation.
(module rewrite.program)
(import "rewrite.schema" :use *)
(import "rewrite.command" :as command)
(import "rewrite.lower" :use [field-number])
(import "rewrite.emit" :use [number!])
(import "rewrite.index" :use [index-name!])
(import "rewrite.phase" :as phase)
(import "rewrite.readers" :use [quoted!])
(import "coil.hashmap" :use [HashMap])
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.str" :use *)

(def program-phases
  "(phases\n  (input declarations Declarations)\n  (phase emit (needs (checked CheckedProgram)) (makes (image NativeImage)))\n  (phase hosts (needs (globals GlobalEnvironment)) (makes (all-globals GlobalEnvironment)))\n  (phase check (needs (all-globals GlobalEnvironment)) (makes (checked CheckedProgram)))\n  (phase register (needs (declarations Declarations)) (makes (globals GlobalEnvironment))))")

(defn emit-history! [(b (mut StrBuf)) (declaration i64)] (-> void)
  (push-str! (mut b)
             "(defstruct ProgramHistory [(store (ptr Store)) (ids (ArrayList N")
  (number! (mut b) declaration)
  (push-str! (mut b)
             "Id))])\n(defn program-history-new [(a (dyn Allocator)) (store (ptr Store))] (-> ProgramHistory) (ProgramHistory :store store :ids (ArrayList::new [N")
  (number! (mut b) declaration)
  (push-str! (mut b)
             "Id] a)))\n(defn program-history-free! [(history (mut ProgramHistory))] (-> void) (free! (mut (.ids history))))\n(defn extend-program [(a (dyn Allocator)) (history (mut ProgramHistory)) (added (ptr (ArrayList N")
  (number! (mut b) declaration)
  (push-str! (mut b)
             "Id)))] (-> (Result image/Image ProgramError)) (let [(mut candidate) (ArrayList::new [N")
  (number! (mut b) declaration)
  (push-str! (mut b)
             "Id] a)] (defer (free! (mut candidate))) (for id (.ids history) (push! (mut candidate) id)) (for id (load added) (push! (mut candidate) id)) (match (compile-program a (.store history) (mut candidate)) (Err [e] (Err e)) (Ok [im] (for id (load added) (push! (mut (.ids history)) id)) (Ok im)))))\n"))

(defn compile-one [(a (dyn Allocator)) (s (ptr Schema)) (form (ptr Sexp))]
  (-> (Result (slice u8) Diag))
  (block :done
    (unless (>= (sexp-count form) 8)
      (break
        :done
          (Err (problem form
                        "expected (program Expr Function name parameter body Int Int)"))))
    (unless (and (sexp-sym-is (sexp-nth form 6) "Int")
                 (sexp-sym-is (sexp-nth form 7) "Int"))
      (break
        :done
          (Err (problem form
                        "program currently supports unary Int -> Int signatures"))))
    (let [(mut names) (HashMap::new [(slice u8) bool] a (keyops))
          (mut cumulative?) false]
      (defer (free! (mut names)))
      (for [i 8 (sexp-count form)]
        (let [host (sexp-nth form i)]
          (if (and (sexp-list? host)
                   (= (sexp-count host) 1)
                   (sexp-sym-is (sexp-nth host 0) "cumulative"))
              (do
                (when cumulative?
                  (break
                    :done
                      (Err (problem host "duplicate cumulative program policy"))))
                (set! cumulative? true))
              (do
                (unless (and (sexp-list? host)
                             (= (sexp-count host) 4)
                             (sexp-sym-is (sexp-nth host 0) "host")
                             (sexp-sym? (sexp-nth host 1))
                             (sexp-sym-is (sexp-nth host 2) "Int")
                             (sexp-sym-is (sexp-nth host 3) "Int"))
                  (break
                    :done (Err (problem host "expected (host name Int Int)"))))
                (let [name (sexp-sym (sexp-nth host 1))]
                  (match (get names name)
                    (Some [_]
                          (break
                            :done
                              (Err (problem host "duplicate host declaration"))))
                    (None []))
                  (set! (mut names) name true)))))))
    (let [(mut expression) (- 0 1)
          (mut declaration) (- 0 1)
          (mut b) (StrBuf::new a)
          order
            (match (phase/schedule a program-phases 0)
              (Err [d] (break :done (Err d)))
              (Ok [order] order))]
      (for [i 0 (len (.nodes s))]
        (let [n (elem (field s nodes) i)]
          (when (sexp-sym-is (sexp-nth form 1) (.name n)) (set! expression i))
          (when (sexp-sym-is (sexp-nth form 2) (.name n)) (set! declaration i))))
      (unless (and (>= expression 0) (>= declaration 0))
        (break :done (Err (problem form "unknown program schema"))))
      (let [expr (elem (field s nodes) expression)
            decl (elem (field s nodes) declaration)]
        (unless (and (.sum? expr) (not (.sum? decl)))
          (break
            :done
              (Err (problem form
                            "program needs expression sum and function record"))))
        (let [fields (elem (field decl variants) 0)
              name (field-number fields (sexp-nth form 3) "Text")
              projection (sexp-nth form 4)
              (mut parameter) (field-number fields projection "Text")
              (mut nested-node) -1
              (mut nested-field) -1
              body (field-number fields (sexp-nth form 5) (.name expr))]
          (when (and (sexp-list? projection) (= (sexp-count projection) 2))
            (for [i 0 (len (.nodes s))]
              (let [node (elem (field s nodes) i)
                    parent
                      (field-number fields (sexp-nth projection 0) (.name node))]
                (when (and (>= parent 0) (not (.sum? node)))
                  (let [child
                          (field-number (elem (field node variants) 0)
                                        (sexp-nth projection 1)
                                        "Text")]
                    (when (>= child 0)
                      (set! parameter parent)
                      (set! nested-node i)
                      (set! nested-field child)))))))
          (when (and (sexp-list? projection)
                     (= (sexp-count projection) 3)
                     (sexp-sym-is (sexp-nth projection 0) "each"))
            (for [f 0 (len (.fields fields))]
              (let [slot (elem (field fields fields) f)]
                (when (and (.many? slot)
                           (sexp-sym-is (sexp-nth projection 1) (.name slot)))
                  (for [i 0 (len (.nodes s))]
                    (let [node (elem (field s nodes) i)]
                      (when (and (= (.name node) (.type-name slot))
                                 (not (.sum? node)))
                        (let [child
                                (field-number (elem (field node variants) 0)
                                              (sexp-nth projection 2)
                                              "Text")]
                          (when (>= child 0)
                            (set! parameter f)
                            (set! nested-node i)
                            (set! nested-field child))))))))))
          (unless (and (>= name 0)
                       (>= parameter 0)
                       (>= body 0)
                       (!= name parameter))
            (break :done (Err (problem form "invalid program fields"))))
          (unless (.key? (elem (field fields fields) name))
            (break
              :done (Err (problem form "program name field requires :key"))))
          (let [many? (.many? (elem (field fields fields) parameter))]
            (push-str! (mut b)
                       "(import \"rewrite.native\" :as native)\n(import \"declarative.rt.image\" :as image)\n(defstruct ProgramFunction [(name (slice u8)) ")
            (push-str! (mut b)
                       (if many?
                           "(parameters (slice (slice u8)))"
                           "(parameter (slice u8))"))
            (push-str! (mut b) " (body N")
            (number! (mut b) expression)
            (push-str! (mut b)
                       "Id)])\n(defsum ProgramError (DuplicateParameter [(parameter (slice u8))]) (DuplicateFunction [(name (slice u8))]) (InvalidFunction [(index i64)]) (InvalidBody [(name (slice u8)) (reason Judgment)]) (WrongReturn [(name (slice u8)) (actual i64)]))\n")
            (push-str! (mut b)
                       "(defn program-functions [(a (dyn Allocator)) (store (ptr Store)) (ids (ptr (ArrayList N")
            (number! (mut b) declaration)
            (push-str! (mut b)
                       "Id)))] (-> (Result (ArrayList ProgramFunction) ProgramError)) (block :done (let [(mut names) (match (")
            (index-name! (mut b) declaration name)
            (push-str! (mut b) " a (field store rows")
            (number! (mut b) declaration)
            (push-str! (mut b)
                       ") ids) (Ok [index] index) (Err [error] (match error (DuplicateKey [_ _ _ second] (break :done (Err (DuplicateFunction (.f")
            (number! (mut b) name)
            (push-str! (mut b) " (get (.rows")
            (number! (mut b) declaration)
            (push-str! (mut b)
                       " store) second)))))) (InvalidIndexReference [_ id] (break :done (Err (InvalidFunction id))))))) (mut declarations) (ArrayList::new [ProgramFunction] a)] (defer (free! (mut names))) (for [i 0 (len (load ids))] (match (lookup-")
            (number! (mut b) declaration)
            (push-str! (mut b) " (field store rows")
            (number! (mut b) declaration)
            (push-str! (mut b)
                       ") (get (load ids) i)) (None [] (break :done (Err (InvalidFunction i)))) (Some [row] (push! (mut declarations) (ProgramFunction :name (.f")
            (number! (mut b) name)
            (if many?
                (do
                  (push-str! (mut b)
                             " row) :parameters (let [(mut ids) (ArrayList::new [N")
                  (number! (mut b) nested-node)
                  (push-str! (mut b)
                             "Id] a) (mut names) (ArrayList::new [(slice u8)] a) (mut seen) (HashMap::new [(slice u8) bool] a (keystr/keyops))] (defer (free! (mut seen))) (defer (free! (mut ids))) (match (sequence-materialize-")
                  (number! (mut b) nested-node)
                  (push-str! (mut b) " a store (.f")
                  (number! (mut b) parameter)
                  (push-str! (mut b)
                             " row) (mut ids)) (Err [_] (break :done (Err (InvalidFunction i)))) (Ok [_])) (for id ids (let [p (match (lookup-")
                  (number! (mut b) nested-node)
                  (push-str! (mut b) " (field store rows")
                  (number! (mut b) nested-node)
                  (push-str! (mut b)
                             ") id) (Some [v] v) (None [] (break :done (Err (InvalidFunction i))))) name (.f")
                  (number! (mut b) nested-field)
                  (push-str! (mut b)
                             " p)] (when (match (get seen name) (Some [_] true) (None [] false)) (break :done (Err (DuplicateParameter name)))) (set! (mut seen) name true) (push! (mut names) name))) (into-slice (mut names)))"))
                (do
                  (push-str! (mut b) " row) :parameter (.f")
                  (if (< nested-node 0)
                      (do
                        (number! (mut b) parameter)
                        (push-str! (mut b) " row)"))
                      (do
                        (number! (mut b) nested-field)
                        (push-str! (mut b) " (match (lookup-")
                        (number! (mut b) nested-node)
                        (push-str! (mut b) " (field store rows")
                        (number! (mut b) nested-node)
                        (push-str! (mut b) ") (.f")
                        (number! (mut b) parameter)
                        (push-str! (mut b)
                                   " row)) (Some [parameter] parameter) (None [] (break :done (Err (InvalidFunction i))))))")))))
            (push-str! (mut b) " :body (.f")
            (number! (mut b) body)
            (push-str! (mut b) " row)))))) (Ok declarations))))\n")
            (push-str! (mut b)
                       "(defn program-check [(type-store (mut types/Types)) (store (ptr Store)) (declaration ProgramFunction) (context (ptr (Scope TypeBinding)))] (-> Judgment) ")
            (push-str! (mut b)
                       (if many?
                           "(let [(mut frames) (ArrayList::new [(Scope TypeBinding)] (malloc-allocator)) (mut local) context] (defer (free! (mut frames))) (reserve! (mut frames) (len (.parameters declaration))) (for name (.parameters declaration) (push! (mut frames) (scope-bind local name (TypeBinding :type 1 :category \"value\"))) (set! local (elem (mut frames) (- (len frames) 1)))) (judge-worker-"
                           "(let [(mut local) (scope-bind context (.parameter declaration) (TypeBinding :type 1 :category \"value\"))] (judge-worker-"))
            (number! (mut b) expression)
            (push-str! (mut b) " (mut type-store) (field store rows")
            (number! (mut b) expression)
            (push-str! (mut b) ") (.body declaration) (len (.rows")
            (number! (mut b) expression)
            (push-str! (mut b)
                       (if many?
                           " store)) local)))\n"
                           " store)) (mut local))))\n"))
            (push-str! (mut b)
                       "(defn program-lower [(store (ptr Store)) (declaration ProgramFunction) (function (ptr cir/Func)) (context (ptr (Scope ValueBinding)))] (-> u32) ")
            (push-str! (mut b)
                       (if many?
                           "(let [(mut frames) (ArrayList::new [(Scope ValueBinding)] (malloc-allocator)) (mut local) context] (defer (free! (mut frames))) (reserve! (mut frames) (len (.parameters declaration))) (for name (.parameters declaration) (push! (mut frames) (scope-bind local name (LocalValue (cir/arg! function cop/T-I64 false)))) (set! local (elem (mut frames) (- (len frames) 1)))) (lower-worker-"
                           "(let [(mut local) (scope-bind context (.parameter declaration) (LocalValue (cir/arg! function cop/T-I64 false)))] (lower-worker-"))
            (number! (mut b) expression)
            (push-str! (mut b) " (field store rows")
            (number! (mut b) expression)
            (push-str! (mut b)
                       (if many?
                           ") (.body declaration) function local)))\n"
                           ") (.body declaration) function (mut local))))\n"))
            (push-str! (mut b)
                       "(defn compile-program [(a (dyn Allocator)) (store (ptr Store)) (ids (ptr (ArrayList N")
            (number! (mut b) declaration)
            (push-str! (mut b)
                       "Id)))] (-> (Result image/Image ProgramError)) (block :done (let [declarations (match (program-functions a store ids) (Err [error] (break :done (Err error))) (Ok [items] (box! a (ArrayList ProgramFunction) items))) (mut type-store) (types/create a) signature (match (types/function (mut type-store) 1 1) (Ok [id] id) (Err [_] (panic \"cannot construct program signature\"))) (mut im) (image/create a) (mut global-types) (HashMap::new [(slice u8) TypeBinding] a (keystr/keyops)) (mut global-values) (HashMap::new [(slice u8) ValueBinding] a (keystr/keyops)) (mut context) (scope-global (mut global-types)) (mut values) (scope-global (mut global-values))] (defer (types/release! (mut type-store))) (defer (free! (mut global-types))) (defer (free! (mut global-values))) ")
            (for [step 0 (len order)]
              (let [name (get order step)]
                (cond (= name "register")
                        (do
                          (push-str! (mut b)
                                     "(for [i 0 (len (load declarations))] (let [d (get (load declarations) i) ")
                          (when many?
                            (push-str! (mut b)
                                       "(mut args) (ArrayList::new [i64] a) signature (do (defer (free! (mut args))) (for name (.parameters d) (push! (mut args) 1)) (match (types/signature (mut type-store) (slice args) 1) (Ok [id] id) (Err [_] (panic \"invalid signature\")))) "))
                          (push-str! (mut b)
                                     "] (image/symbol! (mut im) (.name d)) (set! (mut global-types) (.name d) (TypeBinding :type signature :category \"function\")) (set! (mut global-values) (.name d) (GlobalSymbol (cast u32 i))))) "))
                      (= name "hosts")
                        (for [i 8 (sexp-count form)]
                          (when (sexp-sym-is (sexp-nth (sexp-nth form i) 0)
                                             "host")
                            (push-str! (mut b) "(let [name ")
                            (quoted! (mut b)
                                     (sexp-sym (sexp-nth (sexp-nth form i) 1)))
                            (push-str! (mut b)
                                       "] (match (get global-types name) (Some [_] (break :done (Err (DuplicateFunction name)))) (None [])) (let [symbol (image/symbol! (mut im) name)] (set! (mut global-types) name (TypeBinding :type signature :category \"function\")) (set! (mut global-values) name (GlobalSymbol (cast u32 symbol))))) ")))
                      (= name "check")
                        (push-str! (mut b)
                                   "(for [i 0 (len (load declarations))] (let [d (get (load declarations) i) result (program-check (mut type-store) store d (mut context))] (match result (Typed [ty] (unless (= ty 1) (break :done (Err (WrongReturn (.name d) ty))))) (_ (break :done (Err (InvalidBody (.name d) result))))))) ")
                      (= name "emit")
                        (push-str! (mut b)
                                   "(for [i 0 (len (load declarations))] (let [d (get (load declarations) i) (mut function) (cir/Func::new)] (cir/set-block! (mut function) (cir/new-block! (mut function))) (cir/ret1! (mut function) (program-lower store d (mut function) (mut values))) (cir/finish! (mut function)) (native/emit! a (mut im) (mut function) i) (cir/func-free! (mut function)))) ")
                      :else
                        (break
                          :done
                            (Err (problem form
                                          "unknown program phase implementation"))))))
            (push-str! (mut b) "(Ok im))))\n")
            (for [i 8 (sexp-count form)]
              (when (sexp-sym-is (sexp-nth (sexp-nth form i) 0) "cumulative")
                (emit-history! (mut b) declaration)))
            (if many?
                (do
                  (push-str! (mut b)
                             "(defn entry-arity [(store (ptr Store)) (symbol i64)] (-> i64) (let [row (get (.rows")
                  (number! (mut b) declaration)
                  (push-str! (mut b) " store) symbol)] (match (sequence-size-")
                  (number! (mut b) nested-node)
                  (push-str! (mut b) " store (.f")
                  (number! (mut b) parameter)
                  (push-str! (mut b) " row)) (Some [n] n) (None [] -1))))\n"))
                (push-str! (mut b)
                           "(defn entry-arity [(store (ptr Store)) (symbol i64)] (-> i64) 1)\n"))
            (Ok (str (load b)))))))))

;;; A typed source entry composes the declared reader and program compiler. The
;;; caller owns Store and the compilation arena through the returned image's use.
(defn compile-source-entry [(a (dyn Allocator))
                            (s (ptr Schema))
                            (forms (ptr (ArrayList Sexp)))
                            (form (ptr Sexp))]
  (-> (Result (slice u8) Diag))
  (block :done
    (unless (and (or (= (sexp-count form) 2)
                     (and (= (sexp-count form) 3)
                          (sexp-list? (sexp-nth form 2))
                          (= (sexp-count (sexp-nth form 2)) 1)
                          (sexp-sym-is (sexp-nth (sexp-nth form 2) 0) "command")))
                 (sexp-sym? (sexp-nth form 1)))
      (break
        :done (Err (problem form "expected (source-program FunctionSchema)"))))
    (let [(mut declaration) -1
          (mut syntax?) false
          (mut program?) false
          (mut count) 0
          (mut b) (StrBuf::new a)]
      (for [i 0 (len (.nodes s))]
        (when (sexp-sym-is (sexp-nth form 1) (.name (elem (field s nodes) i)))
          (set! declaration i)))
      (for [i 0 (len (load forms))]
        (let [other (elem forms i)]
          (when (and (sexp-list? other) (> (sexp-count other) 0))
            (when (sexp-sym-is (sexp-nth other 0) "source-program")
              (set! count (+ count 1)))
            (when (and (>= (sexp-count other) 2)
                       (sexp-sym-is (sexp-nth other 0) "syntax")
                       (sexp-sym-is (sexp-nth other 1)
                                    (sexp-sym (sexp-nth form 1))))
              (set! syntax? true))
            (when (and (>= (sexp-count other) 3)
                       (sexp-sym-is (sexp-nth other 0) "program")
                       (sexp-sym-is (sexp-nth other 2)
                                    (sexp-sym (sexp-nth form 1))))
              (set! program? true)))))
      (unless (and (= count 1) (>= declaration 0) syntax? program?)
        (break
          :done
            (Err (problem form
                          "source-program requires one entry with matching syntax and program declarations"))))
      (push-str! (mut b)
                 "(defsum ProgramSourceError (SourceRead [(diagnostic Diag)]) (SourceDeclaration [(diagnostic Diag)]) (SourceChecking [(error ProgramError)]) (SourceDocument [(error source/SourceError)]))\n(defn compile-source [(a (dyn Allocator)) (store (mut Store)) (path (slice u8)) (text (slice u8)) (source-id i64)] (-> (Result image/Image ProgramSourceError)) (block :done (match (store-source! (mut store) source-id path text) (Err [e] (break :done (Err (SourceDocument e)))) (Ok [_])) (let [forms (match (read-all a text source-id) (Err [d] (break :done (Err (SourceRead d)))) (Ok [v] v)) (mut declarations) (ArrayList::new [N")
      (number! (mut b) declaration)
      (push-str! (mut b)
                 "Id] a)] (defer (free! (mut declarations))) (for [i 0 (len forms)] (match (surface-")
      (number! (mut b) declaration)
      (push-str! (mut b)
                 " (mut store) (elem forms i)) (Err [d] (break :done (Err (SourceDeclaration d)))) (Ok [v] (push! (mut declarations) v)))) (match (compile-program a store (mut declarations)) (Err [e] (Err (SourceChecking e))) (Ok [image] (Ok image))))))\n")
      (when (= (sexp-count form) 3) (push-str! (mut b) (command/emit)))
      (Ok (finish! (mut b))))))
