;;; Program declarations derive global signature collection and all-body validation.
(module rewrite.program)
(import "rewrite.schema" :use *)
(import "rewrite.lower" :use [field-number])
(import "rewrite.emit" :use [number!])
(import "rewrite.index" :use [index-name!])
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.str" :use *)

(defn compile-one [(a (dyn Allocator)) (s (ptr Schema)) (form (ptr Sexp))]
  (-> (Result (slice u8) Diag))
  (block :done
    (unless (= (sexp-count form) 8)
      (break
        :done
          (Err (problem form
                        "expected (program Expr Function name parameter body Int Int)"))))
    (unless (and (sexp-sym-is (sexp-nth form 6) "Int")
                 (sexp-sym-is (sexp-nth form 7) "Int"))
      (break
        :done
          (Err (problem form
                        "program currently supports unary Int -> Int signatures"))))
    (let [(mut expression) (- 0 1)
          (mut declaration) (- 0 1)
          (mut b) (StrBuf::new a)]
      (for [i 0 (len (.nodes s))]
        (let [n (elem (field s nodes) i)]
          (when (sexp-sym-is (sexp-nth form 1) (.name n)) (set! expression i))
          (when (sexp-sym-is (sexp-nth form 2) (.name n)) (set! declaration i))))
      (unless (and (>= expression 0) (>= declaration 0))
        (break :done (Err (problem form "unknown program schema"))))
      (let [expr (elem (field s nodes) expression)
            decl (elem (field s nodes) declaration)]
        (unless (and (.sum? expr) (not (.sum? decl)))
          (break
            :done
              (Err (problem form
                            "program needs expression sum and function record"))))
        (let [fields (elem (field decl variants) 0)
              name (field-number fields (sexp-nth form 3) "Text")
              parameter (field-number fields (sexp-nth form 4) "Text")
              body (field-number fields (sexp-nth form 5) (.name expr))]
          (unless (and (>= name 0)
                       (>= parameter 0)
                       (>= body 0)
                       (!= name parameter))
            (break :done (Err (problem form "invalid program fields"))))
          (unless (.key? (elem (field fields fields) name))
            (break
              :done (Err (problem form "program name field requires :key"))))
          (push-str! (mut b)
                     "(import \"rewrite.native\" :as native)\n(import \"declarative.rt.image\" :as image)\n(defstruct ProgramFunction [(name (slice u8)) (parameter (slice u8)) (body N")
          (number! (mut b) expression)
          (push-str! (mut b)
                     "Id)])\n(defsum ProgramError (DuplicateFunction [(name (slice u8))]) (InvalidFunction [(index i64)]) (InvalidBody [(name (slice u8)) (reason Judgment)]) (WrongReturn [(name (slice u8)) (actual i64)]))\n")
          (push-str! (mut b)
                     "(defn program-functions [(a (dyn Allocator)) (store (ptr Store)) (ids (ptr (ArrayList N")
          (number! (mut b) declaration)
          (push-str! (mut b)
                     "Id)))] (-> (Result (ArrayList ProgramFunction) ProgramError)) (block :done (let [(mut names) (match (")
          (index-name! (mut b) declaration name)
          (push-str! (mut b) " a (field store rows")
          (number! (mut b) declaration)
          (push-str! (mut b)
                     ") ids) (Ok [index] index) (Err [error] (match error (DuplicateKey [_ _ _ second] (break :done (Err (DuplicateFunction (.f")
          (number! (mut b) name)
          (push-str! (mut b) " (get (.rows")
          (number! (mut b) declaration)
          (push-str! (mut b)
                     " store) second)))))) (InvalidIndexReference [_ id] (break :done (Err (InvalidFunction id))))))) (mut declarations) (ArrayList::new [ProgramFunction] a)] (defer (free! (mut names))) (for [i 0 (len (load ids))] (match (lookup-")
          (number! (mut b) declaration)
          (push-str! (mut b) " (field store rows")
          (number! (mut b) declaration)
          (push-str! (mut b)
                     ") (get (load ids) i)) (None [] (break :done (Err (InvalidFunction i)))) (Some [row] (push! (mut declarations) (ProgramFunction :name (.f")
          (number! (mut b) name)
          (push-str! (mut b) " row) :parameter (.f")
          (number! (mut b) parameter)
          (push-str! (mut b) " row) :body (.f")
          (number! (mut b) body)
          (push-str! (mut b) " row)))))) (Ok declarations))))\n")
          (push-str! (mut b)
                     "(defn program-check [(type-store (mut types/Types)) (store (ptr Store)) (declaration ProgramFunction) (context (ptr Context))] (-> Judgment) (let [(mut local) (Context :present true :name (.parameter declaration) :type 1 :parent context)] (judge-worker-")
          (number! (mut b) expression)
          (push-str! (mut b) " (mut type-store) (field store rows")
          (number! (mut b) expression)
          (push-str! (mut b) ") (.body declaration) (len (.rows")
          (number! (mut b) expression)
          (push-str! (mut b) " store)) (mut local))))\n")
          (push-str! (mut b)
                     "(defn program-lower [(store (ptr Store)) (declaration ProgramFunction) (function (ptr cir/Func)) (context (ptr ValueContext))] (-> u32) (let [(mut local) (ValueContext :present true :name (.parameter declaration) :value (cir/arg! function cop/T-I64 false) :parent context)] (lower-worker-")
          (number! (mut b) expression)
          (push-str! (mut b) " (field store rows")
          (number! (mut b) expression)
          (push-str! (mut b) ") (.body declaration) function (mut local))))\n")
          (push-str! (mut b)
                     "(defn compile-program [(a (dyn Allocator)) (store (ptr Store)) (ids (ptr (ArrayList N")
          (number! (mut b) declaration)
          (push-str! (mut b)
                     "Id)))] (-> (Result image/Image ProgramError)) (block :done (let [declarations (match (program-functions a store ids) (Err [error] (break :done (Err error))) (Ok [items] (box! a (ArrayList ProgramFunction) items))) (mut type-store) (types/create a) signature (match (types/function (mut type-store) 1 1) (Ok [id] id) (Err [_] (panic \"cannot construct program signature\"))) (mut im) (image/create a) (mut context) (box! a Context (zeroed Context))] (defer (types/release! (mut type-store))) (for [i 0 (len (load declarations))] (let [d (get (load declarations) i)] (image/symbol! (mut im) (.name d)) (set! context (box! a Context (Context :present true :name (.name d) :type signature :parent context))))) (for [i 0 (len (load declarations))] (let [d (get (load declarations) i) result (program-check (mut type-store) store d context)] (match result (Typed [ty] (unless (= ty 1) (break :done (Err (WrongReturn (.name d) ty))))) (_ (break :done (Err (InvalidBody (.name d) result))))))) (for [i 0 (len (load declarations))] (let [d (get (load declarations) i) (mut function) (cir/Func::new) (mut values) (box! a ValueContext (zeroed ValueContext))] (cir/set-block! (mut function) (cir/new-block! (mut function))) (for [j 0 (len (load declarations))] (let [other (get (load declarations) j)] (set! values (box! a ValueContext (ValueContext :present true :name (.name other) :value (cir/sym! (mut function) (cast u32 j) 0) :parent values))))) (cir/ret1! (mut function) (program-lower store d (mut function) values)) (cir/finish! (mut function)) (native/emit! a (mut im) (mut function) i) (cir/func-free! (mut function)))) (Ok im))))\n")
          (Ok (str (load b))))))))
