;;; Scoped macro-head lookup. The result owns generated lexical spelling storage.
(module rewrite.macrohead)
(import "rewrite.code" :as code)
(import "rewrite.codeforms" :as forms)
(import "rewrite.namespace" :as namespace)
(import "rewrite.routingfacts" :as facts)
(import "rewrite.routing" :as routing)
(import "rewrite.resolveprotocol" :as routes)
(import "rewrite.headprotocol" :as policy)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(import "coil.str" :use *)
(import "coil.reader" :use [next-node-id Sexp KSym hmod-name])
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(defsum Error
  (InvalidHead [(index i64)])
  (MissingContext [(index i64)])
  (ExpectedSymbol [(index i64)])
  (Route [(error (routes/Failure routing/Error))]))

(defstruct Outcome
  [(result (Result routing/Answer (policy/Failure Error)))
   (lexical StrBuf)
   (spelling (slice u8))
   (module (Option (slice u8)))])

;;; Both representations share scope selection and routing; input text is borrowed.
(defsum Input
  (Owned [(syntax (ptr code/Syntax)) (head forms/N0Id)])
  (Reader [(form Sexp)]))

(defstruct Symbol [(name (slice u8)) (scope i64) (module (slice u8))])

(defn symbol [(input Input)] (-> (Result Symbol Error))
  (block
    :done
      (match input
        (Reader [form]
                (match (.kind form)
                  (KSym [name]
                        (Ok (Symbol
                              :name name
                              :scope (.hyg form)
                              :module (hmod-name (.hmod form)))))
                  (_ (Err (ExpectedSymbol (.node-id form))))))
        (Owned [syntax head]
               (let [index (.index head)
                     row
                       (match (forms/lookup-0 (field (field syntax store) rows0)
                                              head)
                         (Some [row] row)
                         (None [] (break :done (Err (InvalidHead index)))))
                     name
                       (match row
                         (forms/N0V2 [name] name)
                         (_ (break :done (Err (ExpectedSymbol index)))))]
                 (unless (< index (len (.contexts syntax)))
                   (break :done (Err (MissingContext index))))
                 (let [metadata (get (.contexts syntax) index)]
                   (Ok (Symbol
                         :name name
                         :scope (.f0 metadata)
                         :module (.f1 metadata)))))))))

(defstruct Context
  [(allocator (dyn Allocator))
   (view (ptr namespace/View))
   (world (ptr facts/World))
   (input Input)
   (fallback (Option (slice u8)))
   (module (Option (slice u8)))
   (raw (slice u8))
   (spelling (slice u8))
   (lexical StrBuf)
   (answer routing/Answer)])

(defn release! [(outcome (mut Outcome))] (-> void)
  (free! (mut (.lexical outcome))))

(defn prepare :cc (cc/C) [(c (ptr Context))] (-> (Result policy/Event Error))
  (block
    :done
      (let [head
              (match (symbol (.input c))
                (Ok [head] head)
                (Err [error] (break :done (Err error))))]
        (let [name (.name head)
              scope (.scope head)
              module (.module head)]
          (set! (.raw c) name)
          (set! (.module c)
                (if (> scope 0)
                    (if (= (len module) 0) (None) (Some module))
                    (.fallback c)))
          (when (= scope 0) (break :done (Ok (policy/Event-Raw))))
          (if (< scope 0)
              (do
                (push-str! (mut (.lexical c)) "$datum")
                (push-i64! (mut (.lexical c)) (next-node-id)))
              (do
                (push-str! (mut (.lexical c)) "$scope")
                (push-i64! (mut (.lexical c)) scope)
                (push-str! (mut (.lexical c)) "@")
                (push-str! (mut (.lexical c)) module)))
          (push-str! (mut (.lexical c)) "$")
          (push-str! (mut (.lexical c)) name)
          (Ok (policy/Event-Scoped))))))

(defn lookup! [(c (ptr Context)) (spelling (slice u8))] (-> (Result bool Error))
  (set! (.spelling c) spelling)
  (match (routing/resolve (.allocator c)
                          (.view c)
                          (.world c)
                          spelling
                          (.module c)
                          true)
    (Err [error] (Err (Route error)))
    (Ok [answer]
        (set! (.answer c) answer)
        (Ok (match (.target answer) (Some [_] true) (None [] false))))))

(defn scoped :cc (cc/C) [(c (ptr Context))] (-> (Result policy/Event Error))
  (match (lookup! c (str (.lexical c)))
    (Err [e] (Err e))
    (Ok [found?] (Ok (if found? (policy/Event-Found) (policy/Event-Missing))))))

(defn raw :cc (cc/C) [(c (ptr Context))] (-> (Result policy/Event Error))
  (match (lookup! c (.raw c))
    (Err [e] (Err e))
    (Ok [_] (Ok (policy/Event-Done)))))

;;; Release every outcome, including failures. Other strings borrow the input
;;; syntax, namespace/routing stores and fallback module. Negative scopes use the
;;; bootstrap reader's shared same-session identity domain, also used by Code.
;;; Internal route failures propagate instead of being silently treated as misses.
(defn resolve-input [(a (dyn Allocator))
                     (view (ptr namespace/View))
                     (world (ptr facts/World))
                     (input Input)
                     (fallback (Option (slice u8)))] (-> Outcome)
  (let [(mut context)
          (Context
            :allocator a
            :view view
            :world world
            :input input
            :fallback fallback
            :module (None)
            :raw ""
            :spelling ""
            :lexical (StrBuf::new a)
            :answer (routing/Answer :target (None) :route (None)))
        (mut handlers)
          (policy/Handlers [Context Error]
                           :step-prepare
                           (primitive/fnptr-of prepare)
                           :step-scoped
                           (primitive/fnptr-of scoped)
                           :step-raw
                           (primitive/fnptr-of raw))
        result
          (match (policy/run (mut context) (mut handlers))
            (Err [error] (Err [routing/Answer (policy/Failure Error)] error))
            (Ok [_]
                (Ok [routing/Answer (policy/Failure Error)] (.answer context))))]
    (Outcome
      :result result
      :lexical (.lexical context)
      :spelling (.spelling context)
      :module (.module context))))

(defn resolve [(a (dyn Allocator))
               (view (ptr namespace/View))
               (world (ptr facts/World))
               (syntax (ptr code/Syntax))
               (head forms/N0Id)
               (fallback (Option (slice u8)))] (-> Outcome)
  (resolve-input a view world (Owned syntax head) fallback))

;;; A reader symbol carries the same scope/module facts as an owned syntax row.
;;; No source-document copy or temporary Syntax store is needed for lookup.
(defn resolve-reader [(a (dyn Allocator))
                      (view (ptr namespace/View))
                      (world (ptr facts/World))
                      (head Sexp)
                      (fallback (Option (slice u8)))] (-> Outcome)
  (resolve-input a view world (Reader head) fallback))
