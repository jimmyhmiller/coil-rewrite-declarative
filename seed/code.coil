;;; Owned syntax values generated from languages/code.schema. Scope/context numbers
;;; are opaque identities of the originating session, not globally portable IDs.
(module rewrite.code)
(import "rewrite.codeforms" :as forms)
(import "rewrite.equality" :as equality)
(import "coil.cc" :as eqcc)
(import "coil.primitive" :as eqprimitive)
(import "rewrite.source" :as source)
(import "coil.alloc" :use [Allocator malloc-allocator])
(import "coil.scratch" :use [ScratchArena])
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)

(defstruct Syntax [(store forms/Store) (contexts (ArrayList forms/N1Row))])

(defsum SyntaxError
  (ReadError [(diagnostic Diag)])
  (DocumentError [(error source/SourceError)]))

(defn create [(a (dyn Allocator))] (-> Syntax)
  (Syntax :store (forms/store-new a) :contexts (ArrayList::new [forms/N1Row] a)))

(defn release! [(syntax (mut Syntax))] (-> void)
  (free! (mut (.contexts syntax)))
  (forms/store-free! (mut (.store syntax))))

;;; The generated shape parser selects values and owns Text. This traversal
;;; preserves reader metadata against the actual generated child identities.
(defn contexts! [(syntax (mut Syntax)) (id forms/N0Id) (form (ptr Sexp))]
  (-> (Result bool source/SourceError))
  (block :done
    (match (get (.documents (.source-data (.store syntax))) (.source form))
      (None [] (break :done (Err (source/SourceMissing (.source form)))))
      (Some [doc]
            (unless (and (>= (.lo form) 0)
                         (>= (.hi form) (.lo form))
                         (<= (.hi form) (len (.text doc))))
              (break
                :done
                  (Err (source/SourceSpan (.source form) (.lo form) (.hi form)))))))
    (let [module
            (forms/store-text! (mut (.store syntax)) (hmod-name (.hmod form)))]
      (set! (mut (.contexts syntax))
            (.index id)
            (forms/N1Row
              :f0 (.hyg form)
              :f1 module
              :f2 (.ctxt form)
              :f3 (.horigin form)
              :f4 (.hflags form)
              :f5 (.node-id form))))
    (when (or (sexp-list? form) (sexp-vec? form))
      (let [ids
              (match (get (.rows0 (.store syntax)) (.index id))
                (forms/N0V6 [ids] ids)
                (forms/N0V7 [ids] ids)
                (_ (panic "generated syntax container")))]
        (for [i 0 (sexp-count form)]
          (let [child
                  (match (forms/sequence-item-0 (field syntax store) ids i)
                    (Some [id] id)
                    (None [] (panic "generated syntax child")))]
            (match (contexts! (mut syntax) child (sexp-nth form i))
              (Ok [_])
              (Err [e] (break :done (Err e))))))))
    (Ok true)))

(defn own-diagnostic! [(syntax (mut Syntax)) (d Diag)] (-> Diag)
  (Diag
    :source (.source d)
    :lo (.lo d)
    :hi (.hi d)
    :ctxt (.ctxt d)
    :msg (forms/store-text! (mut (.store syntax)) (.msg d))))

;;; Register all referenced immutable documents before importing a reader form.
;;; Failure publishes no root, but may leave unreferenced rows in the owned store.
(defn import-form! [(syntax (mut Syntax)) (form (ptr Sexp))]
  (-> (Result forms/N0Id SyntaxError))
  (let [parsed (forms/surface-0 (mut (.store syntax)) form)]
    (while (< (len (.contexts syntax)) (len (.rows0 (.store syntax))))
      (push! (mut (.contexts syntax))
             (forms/N1Row
               :f0 0
               :f1 ""
               :f2 0
               :f3 0
               :f4 0
               :f5 0)))
    (match parsed
      (Err [d] (Err (ReadError (own-diagnostic! (mut syntax) d))))
      (Ok [id]
          (match (contexts! (mut syntax) id form)
            (Err [e] (Err (DocumentError e)))
            (Ok [_] (Ok id)))))))

;;; Parsing lives in temporary storage; the returned root sequence and all its
;;; values, metadata and documents belong to syntax, including on repeated reads.
(defn read! [(syntax (mut Syntax))
             (source-id i64)
             (name (slice u8))
             (text (slice u8))]
  (-> (Result forms/N0Seq SyntaxError))
  (block :done
    (match (forms/store-source! (mut (.store syntax)) source-id name text)
      (Err [e] (break :done (Err (DocumentError e))))
      (Ok [_]))
    (let [(mut scratch) (zeroed ScratchArena)
          initialized (init (mut scratch) (malloc-allocator))
          a (allocator (mut scratch))
          (mut roots) (ArrayList::new [forms/N0Id] a)]
      (defer (close! (mut scratch)))
      (match (read-all a text source-id)
        (Err [d]
             (break :done (Err (ReadError (own-diagnostic! (mut syntax) d)))))
        (Ok [forms]
            (for [i 0 (len (load forms))]
              (match (import-form! (mut syntax) (elem forms i))
                (Err [e] (break :done (Err e)))
                (Ok [id] (push! (mut roots) id))))))
      (Ok (forms/sequence-0 (mut (.store syntax)) (mut roots))))))

(defsum PromotionError
  (PromotionShape [(error forms/TransformError)])
  (PromotionContextMissing [(row i64)]))

;;; Promote a reachable syntax graph into independent storage. Generated rules
;;; copy structure, texts, origins and documents; generated provenance transports
;;; metadata to each emitted row. A policy may edit owned metadata; returned Text
;;; must borrow that owned value or have a lifetime at least as long as target.
;;; Failed promotion publishes no root but may retain unreachable target rows.
(defn promote-with! [C] [(target (mut Syntax))
                         (input (ptr Syntax))
                         (root forms/N0Id)
                         (sharing? bool)
                         (user (ptr C))
                         (policy (fnptr (eqcc/C)
                                        [(ptr C)
                                         (ptr forms/N0Row)
                                         (ptr forms/N1Row)]
                                        forms/N1Row))]
  (-> (Result forms/N0Id PromotionError))
  (let [trace-start (len (.traces (.store target)))
        (mut state)
          (forms/transform-state-new (.allocator (.source-data (.store target)))
                                     (field input store)
                                     (field target store))]
    (set! (.sharing? state) sharing?)
    (defer (forms/transform-state-free! (mut state)))
    (let [result (forms/transform-0-0 (mut state) root)]
      (while (< (len (.contexts target)) (len (.rows0 (.store target))))
        (push! (mut (.contexts target))
               (forms/N1Row
                 :f0 0
                 :f1 ""
                 :f2 0
                 :f3 0
                 :f4 0
                 :f5 0)))
      (block
        :done
          (let [out
                  (match result
                    (Ok [id] id)
                    (Err [e] (break :done (Err (PromotionShape e)))))]
            (for [t trace-start (len (.traces (.store target)))]
              (let [trace (get (.traces (.store target)) t)
                    row (.source-node trace)
                    destination (.target-node trace)]
                (when (and (= (.source-schema trace) 0)
                           (= (.target-schema trace) 0))
                  (unless (< row (len (.contexts input)))
                    (break :done (Err (PromotionContextMissing row))))
                  (let [context (get (.contexts input) row)
                        (mut kind) (get (.rows0 (.store input)) row)
                        (mut owned)
                          (forms/N1Row
                            :f0 (.f0 context)
                            :f1
                              (forms/store-text! (mut (.store target))
                                                 (.f1 context))
                            :f2 (.f2 context)
                            :f3 (.f3 context)
                            :f4 (.f4 context)
                            :f5 (.f5 context))]
                    (set! (mut (.contexts target))
                          destination
                          (policy user (mut kind) (mut owned)))))))
            (Ok out))))))

(defn preserve-context :cc (eqcc/C) [(user (ptr i64))
                                     (kind (ptr forms/N0Row))
                                     (context (ptr forms/N1Row))]
  (-> forms/N1Row)
  (load context))

(defn stage-context :cc (eqcc/C) [(user (ptr i64))
                                  (kind (ptr forms/N0Row))
                                  (context (ptr forms/N1Row))]
  (-> forms/N1Row)
  (forms/context-stage-datum (load kind)
                             (load context)
                             (if (forms/context-stage-datum-fresh? (load kind))
                                 (next-node-id)
                                 0)))

(defn promote! [(target (mut Syntax)) (input (ptr Syntax)) (root forms/N0Id)]
  (-> (Result forms/N0Id PromotionError))
  (let [(mut user) 0]
    (promote-with! (mut target)
                   input
                   root
                   true
                   (mut user)
                   (eqprimitive/fnptr-of preserve-context))))

;;; Separate compilation datum policy is declared in code.schema. The bootstrap
;;; reader's identity supply remains shared with imported reader syntax.
(defn stage-datum! [(target (mut Syntax))
                    (input (ptr Syntax))
                    (root forms/N0Id)]
  (-> (Result forms/N0Id PromotionError))
  (let [(mut user) 0]
    (promote-with! (mut target)
                   input
                   root
                   false
                   (mut user)
                   (eqprimitive/fnptr-of stage-context))))

;;; Fixpoint equality ignores locations and hygiene, comparing float bit patterns.
(defn equal? [(a (dyn Allocator))
              (left (ptr Syntax))
              (l forms/N0Id)
              (right (ptr Syntax))
              (r forms/N0Id)]
  (-> (Result bool equality/Error))
  (forms/equal-0 a (field left store) l (field right store) r))

(defstruct ReuseContext [(left (ptr Syntax)) (right (ptr Syntax))])

(defn reuse-metadata :cc (eqcc/C) [(context (ptr ReuseContext))
                                   (pair (ptr equality/Pair))]
  (-> (Result bool equality/Error))
  (let [left (.left context)
        right (.right context)]
    (if (and (< (.left pair) (len (.contexts left)))
             (< (.right pair) (len (.contexts right))))
        (let [l (get (.contexts left) (.left pair))
              r (get (.contexts right) (.right pair))]
          (Ok (and (= (.f0 l) (.f0 r)) (= (.f1 l) (.f1 r)))))
        (Err (equality/MissingMetadata (load pair))))))

;;; Source reuse additionally requires equal scope and definition module at every
;;; node. Context, transport flags, reader identity and locations are not equality.
(defn source-equal? [(a (dyn Allocator))
                     (left (ptr Syntax))
                     (l forms/N0Id)
                     (right (ptr Syntax))
                     (r forms/N0Id)]
  (-> (Result bool equality/Error))
  (let [(mut context) (ReuseContext :left left :right right)]
    (forms/equal-0-with a
                        (field left store)
                        l
                        (field right store)
                        r
                        (mut context)
                        (eqprimitive/fnptr-of reuse-metadata))))
