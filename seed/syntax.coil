;;; Typed source patterns construct schema rows without an intermediate syntax rewrite.
(module rewrite.syntax)
(import "rewrite.schema" :use *)
(import "rewrite.emit" :use [number!])
(import "rewrite.readers" :use [quoted!])
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.str" :use *)

(defn locations? [(forms (ptr (ArrayList Sexp))) (name (slice u8))] (-> bool)
  (block :found
    (for [i 0 (len (load forms))]
      (let [form (elem forms i)]
        (when (and (sexp-list? form)
                   (= (sexp-count form) 2)
                   (sexp-sym-is (sexp-nth form 0) "syntax-locations")
                   (sexp-sym-is (sexp-nth form 1) name))
          (break :found true))))
    false))

(defn validate-locations [(s (ptr Schema)) (forms (ptr (ArrayList Sexp)))]
  (-> (Result bool Diag))
  (block :done
    (for [i 0 (len (load forms))]
      (let [form (elem forms i)]
        (when (and (sexp-list? form)
                   (> (sexp-count form) 0)
                   (sexp-sym-is (sexp-nth form 0) "syntax-locations"))
          (unless (and (= (sexp-count form) 2) (sexp-sym? (sexp-nth form 1)))
            (break
              :done (Err (problem form "expected (syntax-locations Schema)"))))
          (let [name (sexp-sym (sexp-nth form 1))
                (mut found?) false
                (mut syntax?) false]
            (for node (.nodes s)
              (when (= (.name node) name) (set! found? true)))
            (unless found?
              (break
                :done (Err (problem form "unknown syntax-locations schema"))))
            (for [j 0 (len (load forms))]
              (let [other (elem forms j)]
                (when (and (sexp-list? other)
                           (>= (sexp-count other) 2)
                           (sexp-sym-is (sexp-nth other 1) name))
                  (when (sexp-sym-is (sexp-nth other 0) "syntax")
                    (set! syntax? true))
                  (when (and (< j i)
                             (sexp-sym-is (sexp-nth other 0) "syntax-locations"))
                    (break
                      :done
                        (Err (problem form
                                      "duplicate syntax-locations declaration")))))))
            (unless syntax?
              (break
                :done
                  (Err (problem form "syntax-locations requires syntax rules"))))))))
    (Ok true)))

(defn location! [(b (mut StrBuf)) (schema i64) (field i64) (path (slice u8))]
  (-> void)
  (push-str! (mut b) "(source/capture! (mut (.source-data store)) ")
  (number! (mut b) schema)
  (push-str! (mut b) " (.index id) ")
  (number! (mut b) field)
  (push-str! (mut b) " ")
  (push-str! (mut b) path)
  (push-str! (mut b) ") "))

(defstruct Capture
  [(field i64) (mode (slice u8)) (path (slice u8)) (start i64) (limit i64)])

;;; Count only selected children; ignored tails are never recursively parsed.
(defn capture-count! [(b (mut StrBuf)) (capture Capture)] (-> void)
  (push-str! (mut b) "(let [available (- (sexp-count ")
  (push-str! (mut b) (.path capture))
  (push-str! (mut b) ") ")
  (number! (mut b) (.start capture))
  (push-str! (mut b) ")] ")
  (if (>= (.limit capture) 0)
      (do
        (push-str! (mut b) "(if (< available ")
        (number! (mut b) (.limit capture))
        (push-str! (mut b) ") available ")
        (number! (mut b) (.limit capture))
        (push-str! (mut b) "))"))
      (push-str! (mut b) "available)")))

(defn predicate! [(b (mut StrBuf)) (mode (slice u8)) (path (slice u8))]
  (-> void)
  (cond (= mode "cstring")
          (do
            (push-str! (mut b) "(syntax-cstring? ")
            (push-str! (mut b) path)
            (push-str! (mut b) ")"))
        (= mode "bool")
          (do
            (push-str! (mut b) "(or (sexp-sym-is ")
            (push-str! (mut b) path)
            (push-str! (mut b) " \"true\") (sexp-sym-is ")
            (push-str! (mut b) path)
            (push-str! (mut b) " \"false\"))"))
        :else
          (do
            (push-str! (mut b) "(sexp-")
            (push-str! (mut b)
                       (cond (= mode "float-bits") "float"
                             (or (= mode "symbol") (= mode "identifier")) "sym"
                             (= mode "keyword") "kw"
                             (= mode "text") "str"
                             (= mode "vector") "vec"
                             :else mode))
            (push-str! (mut b) "? ")
            (push-str! (mut b) path)
            (push-str! (mut b) ")"))))

(defn guard-end! [(b (mut StrBuf)) (path (slice u8)) (message (slice u8))]
  (-> void)
  (push-str! (mut b) " (break :parsed (Err (input-error ")
  (push-str! (mut b) path)
  (push-str! (mut b) " ")
  (quoted! (mut b) message)
  (push-str! (mut b) ")))) "))

;;; Capture spelling and lexical context from the same symbol occurrence.
(defn identifier! [(b (mut StrBuf))
                   (v (ptr Variant))
                   (pattern (ptr Sexp))
                   (path (slice u8))
                   (captures (mut (ArrayList Capture)))] (-> (Result i64 Diag))
  (block :done
    (unless (= (sexp-count pattern) 4)
      (break
        :done
          (Err (problem pattern "expected (identifier spelling scope module)"))))
    (push-str! (mut b) "(unless (sexp-sym? ")
    (push-str! (mut b) path)
    (push-str! (mut b) ")")
    (guard-end! (mut b) path "expected identifier")
    (for [slot 1 4]
      (let [name (sexp-nth pattern slot)
            (mut field) (- 0 1)]
        (unless (sexp-sym? name)
          (break
            :done (Err (problem name "identifier capture requires field names"))))
        (for [i 0 (len (.fields v))]
          (when (= (sexp-sym name) (.name (elem (field v fields) i)))
            (set! field i)))
        (when (< field 0)
          (break :done (Err (problem name "unknown identifier field"))))
        (let [f (elem (field v fields) field)]
          (unless (and (not (.many? f))
                       (= (.type-name f) (if (= slot 2) "Int" "Text")))
            (break
              :done
                (Err (problem name "identifier fields require Text Int Text")))))
        (for capture (load captures)
          (when (= (.field capture) field)
            (break
              :done (Err (problem name "syntax field captured more than once")))))
        (push! (mut captures)
               (Capture
                 :field field
                 :mode
                   (cond (= slot 1) "symbol"
                         (= slot 2) "hygiene"
                         :else "definition-module")
                 :path path
                 :start 0
                 :limit (- 0 1)))))
    (Ok 0)))

(defn pattern! [(a (dyn Allocator))
                (b (mut StrBuf))
                (v (ptr Variant))
                (pattern (ptr Sexp))
                (path (slice u8))
                (start i64)
                (captures (mut (ArrayList Capture)))]
  (-> (Result i64 Diag))
  (block :done
    (when (sexp-str? pattern)
      (push-str! (mut b) "(unless (sexp-sym-is ")
      (push-str! (mut b) path)
      (push-str! (mut b) " ")
      (quoted! (mut b) (sexp-str pattern))
      (push-str! (mut b) ")")
      (guard-end! (mut b) path "expected literal symbol")
      (break :done (Ok 0)))
    (unless (and (sexp-list? pattern)
                 (> (sexp-count pattern) 0)
                 (sexp-sym? (sexp-nth pattern 0)))
      (break :done (Err (problem pattern "expected a syntax pattern"))))
    (let [mode (sexp-sym (sexp-nth pattern 0))]
      (when (= mode "identifier")
        (break :done (identifier! (mut b) v pattern path (mut captures))))
      (when (= mode "skip-rest")
        (unless (= (sexp-count pattern) 1)
          (break :done (Err (problem pattern "skip-rest takes no arguments"))))
        (break :done (Ok 0)))
      (if (or (= mode "list") (= mode "vector"))
          (let [last (sexp-nth pattern (- (sexp-count pattern) 1))
                rest?
                  (and (> (sexp-count pattern) 1)
                       (sexp-list? last)
                       (> (sexp-count last) 0)
                       (or (sexp-sym-is (sexp-nth last 0) "rest")
                           (sexp-sym-is (sexp-nth last 0) "skip-rest")))]
            (push-str! (mut b) "(unless ")
            (predicate! (mut b) mode path)
            (guard-end! (mut b) path "wrong syntax container")
            (push-str! (mut b)
                       (if rest?
                           "(unless (>= (sexp-count "
                           "(unless (= (sexp-count "))
            (push-str! (mut b) path)
            (push-str! (mut b) ") ")
            (number! (mut b) (- (sexp-count pattern) (if rest? 2 1)))
            (push-str! (mut b) ")")
            (guard-end! (mut b) path "wrong syntax arity")
            (for [i 1 (sexp-count pattern)]
              (let [(mut child) (StrBuf::new a)
                    child-form (sexp-nth pattern i)
                    child-rest?
                      (and (sexp-list? child-form)
                           (> (sexp-count child-form) 0)
                           (or (sexp-sym-is (sexp-nth child-form 0) "rest")
                               (sexp-sym-is (sexp-nth child-form 0) "skip-rest")))]
                (when (and child-rest? (!= i (- (sexp-count pattern) 1)))
                  (break
                    :done
                      (Err (problem child-form
                                    "rest capture must be last in its container"))))
                (push-str! (mut child) "(sexp-nth ")
                (push-str! (mut child) path)
                (push-str! (mut child) " ")
                (number! (mut child) (- i 1))
                (push-str! (mut child) ")")
                (match (pattern! a
                                 (mut b)
                                 v
                                 (sexp-nth pattern i)
                                 (if child-rest? path (str (load child)))
                                 (if child-rest? (- i 1) 0)
                                 (mut captures))
                  (Err [d] (break :done (Err d)))
                  (Ok [_]))))
            (Ok 0))
          (do
            (unless (and (or (= (sexp-count pattern) 2)
                             (and (= (sexp-count pattern) 4)
                                  (sexp-kw? (sexp-nth pattern 2))
                                  (sexp-int? (sexp-nth pattern 3))
                                  (or (and (= mode "rest")
                                           (= (sexp-kw (sexp-nth pattern 2))
                                              "limit")
                                           (>= (sexp-int (sexp-nth pattern 3))
                                               0))
                                      (and (= mode "int")
                                           (= (sexp-kw (sexp-nth pattern 2))
                                              "min")))))
                         (sexp-sym? (sexp-nth pattern 1))
                         (or (= mode "float-bits")
                             (= mode "cstring")
                             (= mode "int")
                             (= mode "bool")
                             (= mode "text")
                             (= mode "symbol")
                             (= mode "keyword")
                             (= mode "ref")
                             (= mode "rest")))
              (break
                :done (Err (problem pattern "expected typed field capture"))))
            (let [(mut field) (- 0 1)]
              (for [i 0 (len (.fields v))]
                (when (sexp-sym-is (sexp-nth pattern 1)
                                   (.name (elem (field v fields) i)))
                  (set! field i)))
              (when (< field 0)
                (break :done (Err (problem pattern "unknown syntax field"))))
              (let [ty (.type-name (elem (field v fields) field))
                    many? (.many? (elem (field v fields) field))]
                (unless (and (= many? (= mode "rest"))
                             (cond (or (= mode "int") (= mode "float-bits"))
                                     (= ty "Int")
                                   (= mode "bool") (= ty "Bool")
                                   (or (= mode "cstring")
                                       (= mode "symbol")
                                       (= mode "keyword")
                                       (= mode "text"))
                                     (= ty "Text")
                                   :else (not (scalar? ty))))
                  (break
                    :done
                      (Err (problem pattern
                                    "syntax capture type disagrees with schema")))))
              (for [i 0 (len (load captures))]
                (when (= (.field (elem captures i)) field)
                  (break
                    :done
                      (Err (problem pattern
                                    "syntax field captured more than once")))))
              (unless (or (= mode "ref") (= mode "rest"))
                (push-str! (mut b) "(unless ")
                (predicate! (mut b) mode path)
                (guard-end! (mut b) path "wrong syntax scalar"))
              (when (and (= mode "int") (= (sexp-count pattern) 4))
                (push-str! (mut b) "(unless (>= (sexp-int ")
                (push-str! (mut b) path)
                (push-str! (mut b) ") ")
                (number! (mut b) (sexp-int (sexp-nth pattern 3)))
                (push-str! (mut b) ")")
                (guard-end! (mut b) path "integer below syntax minimum"))
              (push! (mut captures)
                     (Capture
                       :field field
                       :mode mode
                       :path path
                       :start start
                       :limit
                         (if (= (sexp-count pattern) 4)
                             (sexp-int (sexp-nth pattern 3))
                             (- 0 1))))
              (Ok 0)))))))

;;; A literal list head commits to its rule, including malformed arity diagnostics.
(defn dispatch! [(b (mut StrBuf)) (pattern (ptr Sexp))] (-> (Result i64 Diag))
  (if (not (and (sexp-list? pattern)
                (> (sexp-count pattern) 0)
                (sexp-sym? (sexp-nth pattern 0))))
      (Err (problem pattern "syntax root must consume a scalar or container"))
      (let [mode (sexp-sym (sexp-nth pattern 0))]
        (if (not (or (= mode "float-bits")
                     (= mode "cstring")
                     (= mode "int")
                     (= mode "bool")
                     (= mode "text")
                     (= mode "symbol")
                     (= mode "identifier")
                     (= mode "keyword")
                     (= mode "list")
                     (= mode "vector")))
            (Err (problem pattern
                          "syntax root must consume a scalar or container"))
            (do
              (if (and (= mode "list")
                       (> (sexp-count pattern) 1)
                       (sexp-str? (sexp-nth pattern 1)))
                  (do
                    (push-str! (mut b)
                               "(and (sexp-list? form) (> (sexp-count form) 0) (sexp-sym-is (sexp-nth form 0) ")
                    (quoted! (mut b) (sexp-str (sexp-nth pattern 1)))
                    (push-str! (mut b) "))"))
                  (predicate! (mut b) mode "form"))
              (Ok 0))))))

;;; Dispatch commits before field parsing, so a broader earlier root shadows later roots.
(defn shadows? [(earlier (ptr Sexp)) (later (ptr Sexp))] (-> bool)
  (let [raw-a (sexp-sym (sexp-nth earlier 0))
        raw-b (sexp-sym (sexp-nth later 0))
        a (if (= raw-a "identifier") "symbol" raw-a)
        b (if (= raw-b "identifier") "symbol" raw-b)]
    (cond (and (= a "symbol") (= b "bool")) true
          (!= a b) false
          (= a "list")
            (let [literal-a
                    (and (> (sexp-count earlier) 1)
                         (sexp-str? (sexp-nth earlier 1)))
                  literal-b
                    (and (> (sexp-count later) 1)
                         (sexp-str? (sexp-nth later 1)))]
              (or (not literal-a)
                  (and literal-b
                       (= (sexp-str (sexp-nth earlier 1))
                          (sexp-str (sexp-nth later 1))))))
          :else true)))

(defn fold-prefix! [(out (mut StrBuf))
                    (ni i64)
                    (declaration (ptr Sexp))
                    (owned? bool)] (-> void)
  (push-str! (mut out)
             "(when (and (sexp-list? form) (= (sexp-count form) 3) (sexp-sym-is (sexp-nth form 0) ")
  (quoted! (mut out)
           (sexp-str (sexp-nth declaration 2)))
  (push-str! (mut out)
             ") (sexp-vec? (sexp-nth form 1)) (!= (sexp-count (sexp-nth form 1)) ")
  (number! (mut out)
           (sexp-int (sexp-nth declaration 3)))
  (push-str! (mut out) ")) (match (syntaxfold/fold ")
  (push-str! (mut out)
             (if owned?
                 "(.allocator (.source-data store))"
                 "a"))
  (push-str! (mut out) " form ")
  (number! (mut out)
           (sexp-int (sexp-nth declaration 3)))
  (push-str! (mut out)
             ") (Err [d] (break :parsed (Err d))) (Ok [tail] (break :parsed (")
  (push-str! (mut out) (if owned? "surface-" "view-"))
  (number! (mut out) ni)
  (push-str! (mut out)
             (if owned?
                 " (mut store) tail))))) "
                 " a tail))))) ")))

(defn compile-one [(a (dyn Allocator))
                   (s (ptr Schema))
                   (forms (ptr (ArrayList Sexp)))
                   (form (ptr Sexp))]
  (-> (Result (slice u8) Diag))
  (block :done
    (unless (and (>= (sexp-count form) 3) (sexp-sym? (sexp-nth form 1)))
      (break
        :done
          (Err (problem form
                        "expected (syntax Schema (Constructor pattern) ...)"))))
    (let [labeled? (sexp-kw? (sexp-nth form 2))
          start (if labeled? 4 2)
          (mut ni) (- 0 1)
          (mut b) (StrBuf::new a)
          (mut views) (StrBuf::new a)]
      (when labeled?
        (unless (and (>= (sexp-count form) 5)
                     (= (sexp-kw (sexp-nth form 2)) "expect")
                     (sexp-str? (sexp-nth form 3)))
          (break
            :done
              (Err (problem form "expected :expect string before syntax rules")))))
      (for [i 0 (len (.nodes s))]
        (when (sexp-sym-is (sexp-nth form 1) (.name (elem (field s nodes) i)))
          (set! ni i)))
      (when (< ni 0) (break :done (Err (problem form "unknown syntax schema"))))
      (let [node (elem (field s nodes) ni)
            (mut seen) (ArrayList::new [i64] a)]
        (for [i 0 (len (.variants node))] (push! (mut seen) 0))
        (push-str! (mut views)
                   "(import \"rewrite.syntaxfold\" :as syntaxfold)\n(defn view-")
        (number! (mut views) ni)
        (push-str! (mut views)
                   " [(a (dyn Allocator)) (form (ptr Sexp))] (-> (Result (Option SyntaxView) Diag)) (block :parsed ")
        (push-str! (mut b) "(defn surface-")
        (number! (mut b) ni)
        (push-str! (mut b)
                   " [(store (mut Store)) (form (ptr Sexp))] (-> (Result N")
        (number! (mut b) ni)
        (push-str! (mut b) "Id Diag)) (block :parsed ")
        (for [declaration-index 0 (len (load forms))]
          (when (and (sexp-list? (elem forms declaration-index))
                     (> (sexp-count (elem forms declaration-index)) 0)
                     (sexp-sym-is (sexp-nth (elem forms declaration-index) 0)
                                  "fold-vector")
                     (sexp-sym-is (sexp-nth (elem forms declaration-index) 1)
                                  (.name node)))
            (unless (and (= (sexp-count (elem forms declaration-index)) 4)
                         (sexp-str? (sexp-nth (elem forms declaration-index) 2))
                         (sexp-int? (sexp-nth (elem forms declaration-index) 3))
                         (> (sexp-int (sexp-nth (elem forms declaration-index)
                                                3))
                            0))
              (break
                :done
                  (Err (problem (elem forms declaration-index)
                                "expected (fold-vector Schema head positive-width)"))))

            (fold-prefix! (mut b) ni (elem forms declaration-index) true)
            (fold-prefix! (mut views) ni (elem forms declaration-index) false)))
        (for [r start (sexp-count form)]
          (let [rule (sexp-nth form r)
                (mut vi) (- 0 1)]
            (unless (and (sexp-list? rule) (= (sexp-count rule) 2))
              (break
                :done (Err (problem rule "expected (Constructor pattern)"))))
            (for [i 0 (len (.variants node))]
              (when (sexp-sym-is (sexp-nth rule 0)
                                 (.name (elem (field node variants) i)))
                (set! vi i)))
            (when (< vi 0)
              (break :done (Err (problem rule "unknown syntax constructor"))))
            (set! (mut seen) vi (+ (get seen vi) 1))
            (let [v (elem (field node variants) vi)
                  pattern (sexp-nth rule 1)
                  (mut captures) (ArrayList::new [Capture] a)
                  (mut guards) (StrBuf::new a)]
              (push-str! (mut b) "(when ")
              (match (dispatch! (mut b) pattern)
                (Err [d] (break :done (Err d)))
                (Ok [_]))
              (for [previous start r]
                (when (shadows? (sexp-nth (sexp-nth form previous) 1) pattern)
                  (break
                    :done
                      (Err (problem pattern
                                    "syntax rule shadowed by an earlier root pattern")))))
              (push-str! (mut b) " ")
              (match (pattern! a (mut guards) v pattern "form" 0 (mut captures))
                (Err [d] (break :done (Err d)))
                (Ok [_]))
              (unless (= (len captures) (len (.fields v)))
                (break
                  :done
                    (Err (problem rule "syntax must capture every schema field"))))
              (push-str! (mut b) (str (load guards)))
              (push-str! (mut views) "(when ")
              (match (dispatch! (mut views) pattern)
                (Err [d] (break :done (Err d)))
                (Ok [_]))
              (push-str! (mut views) " ")
              (push-str! (mut views) (str (load guards)))
              (push-str! (mut views)
                         "(let [(mut captures) (ArrayList::new [SyntaxCapture] a)] ")
              (for [f 0 (len (.fields v))]
                (for capture captures
                  (when (= f (.field capture))
                    (push-str! (mut views)
                               "(push! (mut captures) (SyntaxCapture :source ")
                    (push-str! (mut views) (.path capture))
                    (push-str! (mut views) " :start ")
                    (number! (mut views) (.start capture))
                    (push-str! (mut views) " :count ")
                    (if (= (.mode capture) "rest")
                        (capture-count! (mut views) capture)
                        (push-str! (mut views) "1"))
                    (push-str! (mut views)
                               (if (= (.mode capture) "rest")
                                   " :rest? true)) "
                                   " :rest? false)) ")))))
              (push-str! (mut views)
                         "(break :parsed (Ok (Some (SyntaxView :variant ")
              (number! (mut views) vi)
              (push-str! (mut views) " :captures captures)))))) ")
              (push-str! (mut b) "(let [")
              (for [c 0 (len captures)]
                (let [capture (elem (mut captures) c)
                      mode (.mode capture)
                      path (.path capture)
                      ty (.type-name (elem (field v fields) (.field capture)))]
                  (push-str! (mut b) "f")
                  (number! (mut b) (.field capture))
                  (push-str! (mut b) " ")
                  (if (or (= mode "ref") (= mode "rest"))
                      (let [(mut target) (- 0 1)
                            (mut has-syntax) false]
                        (for [i 0 (len (.nodes s))]
                          (when (= (.name (elem (field s nodes) i)) ty)
                            (set! target i)))
                        (for [i 0 (len (load forms))]
                          (let [candidate (elem forms i)]
                            (when (and (sexp-list? candidate)
                                       (>= (sexp-count candidate) 2)
                                       (sexp-sym-is (sexp-nth candidate 0)
                                                    "syntax")
                                       (sexp-sym-is (sexp-nth candidate 1) ty))
                              (set! has-syntax true))))
                        (unless has-syntax
                          (break
                            :done
                              (Err (problem rule
                                            "referenced schema needs a syntax declaration"))))
                        (when (= mode "rest")
                          (push-str! (mut b)
                                     "(let [(mut children) (ArrayList::new [N")
                          (number! (mut b) target)
                          (push-str! (mut b)
                                     "Id] (.allocator (.source-data store)))] (defer (free! (mut children))) (for [child-index ")
                          (number! (mut b) (.start capture))
                          (push-str! (mut b) " (+ ")
                          (number! (mut b) (.start capture))
                          (push-str! (mut b) " ")
                          (capture-count! (mut b) (load capture))
                          (push-str! (mut b) ")] (push! (mut children) "))
                        (push-str! (mut b) "(match (surface-")
                        (number! (mut b) target)
                        (push-str! (mut b) " (mut store) ")
                        (when (= mode "rest") (push-str! (mut b) "(sexp-nth "))
                        (push-str! (mut b) path)
                        (when (= mode "rest")
                          (push-str! (mut b) " child-index)"))
                        (push-str! (mut b)
                                   ") (Ok [id] id) (Err [d] (break :parsed (Err d)))) ")
                        (when (= mode "rest")
                          (push-str! (mut b) ")) (sequence-")
                          (number! (mut b) target)
                          (push-str! (mut b) " (mut store) (mut children))) ")))
                      (do
                        (when (or (= mode "cstring")
                                  (= mode "text")
                                  (= mode "symbol")
                                  (= mode "keyword")
                                  (= mode "definition-module"))
                          (push-str! (mut b) "(store-text! (mut store) "))
                        (push-str! (mut b)
                                   (cond (= mode "float-bits")
                                           "(syntax-float-bits "
                                         (= mode "cstring") "(syntax-cstring "
                                         (= mode "int") "(sexp-int "
                                         (= mode "hygiene") "(.hyg "
                                         (= mode "definition-module")
                                           "(hmod-name (.hmod "
                                         (= mode "text") "(sexp-str "
                                         (= mode "symbol") "(sexp-sym "
                                         (= mode "keyword") "(sexp-kw "
                                         :else "(sexp-sym-is "))
                        (push-str! (mut b) path)
                        (when (= mode "definition-module")
                          (push-str! (mut b) ")"))
                        (when (= mode "bool") (push-str! (mut b) " \"true\""))
                        (push-str! (mut b)
                                   (if (or (= mode "cstring")
                                           (= mode "text")
                                           (= mode "symbol")
                                           (= mode "keyword")
                                           (= mode "definition-module"))
                                       ")) "
                                       ") "))))))
              (push-str! (mut b) "id (append-")
              (number! (mut b) ni)
              (push-str! (mut b) " (mut (.rows")
              (number! (mut b) ni)
              (push-str! (mut b) " store)) (N")
              (number! (mut b) ni)
              (if (.sum? node)
                  (do (push-str! (mut b) "V") (number! (mut b) vi))
                  (push-str! (mut b) "Row"))
              (for [f 0 (len (.fields v))]
                (unless (.sum? node)
                  (push-str! (mut b) " :f")
                  (number! (mut b) f))
                (push-str! (mut b) " f")
                (number! (mut b) f))
              (push-str! (mut b) "))] (push! (mut (.origins")
              (number! (mut b) ni)
              (push-str! (mut b) " store)) (origin-of form)) ")
              (when (locations? forms (.name node))
                (location! (mut b) ni -1 "form")
                (push-str! (mut b)
                           "(when (and (sexp-list? form) (> (sexp-count form) 0)) ")
                (location! (mut b) ni -2 "(sexp-nth form 0)")
                (push-str! (mut b) ") ")
                (for capture captures
                  (location! (mut b) ni (.field capture) (.path capture))))
              (push-str! (mut b) "(break :parsed (Ok id)))) "))))
        (for [i 0 (len seen)]
          (unless (= (get seen i) 1)
            (break
              :done
                (Err (problem form
                              "each constructor needs exactly one syntax rule")))))
        (push-str! (mut b) "(Err (input-error form ")
        (quoted! (mut b)
                 (if labeled?
                     (sexp-str (sexp-nth form 3))
                     "no syntax rule matches"))
        (push-str! (mut b) "))))\n")
        (push-str! (mut views) "(Ok (None))))\n")
        (push-str! (mut b) (str (load views)))
        (Ok (str (load b)))))))
