;;; Binding topology is shared by semantic clients; payloads belong to each client.
(module rewrite.binding)
(import "rewrite.schema" :use *)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)

(defstruct Reference [(node i64) (variant i64) (field i64)])

(defstruct ChildScope
  [(node i64) (variant i64) (child i64) (names (ArrayList i64))])

(defstruct Bindings
  [(references (ArrayList Reference)) (scopes (ArrayList ChildScope))])

(defn reference [(bindings (ptr Bindings)) (node i64) (variant i64)] (-> i64)
  (block :done
    (for r (.references bindings)
      (when (and (= (.node r) node) (= (.variant r) variant))
        (break :done (.field r))))
    (- 0 1)))

(defn child-scope [(bindings (ptr Bindings))
                   (node i64)
                   (variant i64)
                   (child i64)]
  (-> (Option ChildScope))
  (block :done
    (for scope (.scopes bindings)
      (when (and (= (.node scope) node)
                 (= (.variant scope) variant)
                 (= (.child scope) child))
        (break :done (Some scope))))
    (None)))

(defn scope-count [(bindings (ptr Bindings)) (node i64) (variant i64)] (-> i64)
  (let [(mut count) 0]
    (for scope (.scopes bindings)
      (when (and (= (.node scope) node) (= (.variant scope) variant))
        (set! count (+ count 1))))
    count))

(defn field-number [(variant (ptr Variant)) (name (ptr Sexp))] (-> i64)
  (block :done
    (for [i 0 (len (.fields variant))]
      (when (sexp-sym-is name (.name (elem (field variant fields) i)))
        (break :done i)))
    (- 0 1)))

;;; The result and any errors borrow schema/source storage and use the caller's arena.
(defn parse [(a (dyn Allocator))
             (schema (ptr Schema))
             (forms (ptr (ArrayList Sexp)))]
  (-> (Result Bindings Diag))
  (block
    :done
      (let [(mut bindings)
              (Bindings
                :references (ArrayList::new [Reference] a)
                :scopes (ArrayList::new [ChildScope] a))
            (mut seen) (ArrayList::new [i64] a)]
        (for [i 0 (len (.nodes schema))] (push! (mut seen) 0))
        (for [i 0 (len (load forms))]
          (let [form (elem forms i)]
            (when (and (sexp-list? form)
                       (> (sexp-count form) 0)
                       (sexp-sym-is (sexp-nth form 0) "bindings"))
              (unless (and (>= (sexp-count form) 2)
                           (sexp-sym? (sexp-nth form 1)))
                (break
                  :done
                    (Err (problem form
                                  "expected (bindings Schema (Constructor annotations...) ...)"))))
              (let [(mut node) (- 0 1)]
                (for [n 0 (len (.nodes schema))]
                  (when (sexp-sym-is (sexp-nth form 1)
                                     (.name (elem (field schema nodes) n)))
                    (set! node n)))
                (when (< node 0)
                  (break :done (Err (problem form "unknown binding schema"))))
                (when (> (get seen node) 0)
                  (break
                    :done (Err (problem form "duplicate binding declaration"))))
                (set! (mut seen) node 1)
                (let [n (elem (field schema nodes) node)
                      (mut variants) (ArrayList::new [i64] a)]
                  (for [v 0 (len (.variants n))] (push! (mut variants) 0))
                  (for [r 2 (sexp-count form)]
                    (let [rule (sexp-nth form r)
                          (mut vi) (- 0 1)]
                      (unless (and (sexp-list? rule) (>= (sexp-count rule) 2))
                        (break
                          :done
                            (Err (problem rule
                                          "expected constructor binding annotations"))))
                      (for [v 0 (len (.variants n))]
                        (when (sexp-sym-is (sexp-nth rule 0)
                                           (.name (elem (field n variants) v)))
                          (set! vi v)))
                      (when (< vi 0)
                        (break
                          :done
                            (Err (problem rule "unknown binding constructor"))))
                      (when (> (get variants vi) 0)
                        (break
                          :done
                            (Err (problem rule
                                          "duplicate constructor binding rule"))))
                      (set! (mut variants) vi 1)
                      (let [variant (elem (field n variants) vi)]
                        (for [j 1 (sexp-count rule)]
                          (let [annotation (sexp-nth rule j)]
                            (unless (and (sexp-list? annotation)
                                         (>= (sexp-count annotation) 2))
                              (break
                                :done
                                  (Err (problem annotation
                                                "expected reference or scope annotation"))))
                            (let [ref?
                                    (sexp-sym-is (sexp-nth annotation 0)
                                                 "reference")
                                  scope?
                                    (sexp-sym-is (sexp-nth annotation 0)
                                                 "scope")]
                              (unless (or (and ref?
                                               (= (sexp-count annotation) 2))
                                          (and scope?
                                               (>= (sexp-count annotation) 3)))
                                (break
                                  :done
                                    (Err (problem annotation
                                                  "expected (reference name) or (scope child names...)"))))
                              (let [field
                                      (field-number variant
                                                    (sexp-nth annotation 1))]
                                (when (< field 0)
                                  (break
                                    :done
                                      (Err (problem annotation
                                                    "unknown binding field"))))
                                (if ref?
                                    (do
                                      (let [f
                                              (elem (field variant fields)
                                                    field)]
                                        (unless (and (not (.many? f))
                                                     (= (.type-name f) "Text"))
                                          (break
                                            :done
                                              (Err (problem annotation
                                                            "reference requires a Text field")))))
                                      (when (>= (reference (mut bindings)
                                                           node
                                                           vi)
                                                0)
                                        (break
                                          :done
                                            (Err (problem annotation
                                                          "constructor already has a reference"))))
                                      (push! (mut (.references bindings))
                                             (Reference
                                               :node node
                                               :variant vi
                                               :field field)))
                                    (let [(mut names) (ArrayList::new [i64] a)]
                                      (when (scalar? (.type-name (elem (field variant
                                                                              fields)
                                                                       field)))
                                        (break
                                          :done
                                            (Err (problem annotation
                                                          "scope child must be a node reference"))))
                                      (match (child-scope (mut bindings)
                                                          node
                                                          vi
                                                          field)
                                        (Some [_]
                                              (break
                                                :done
                                                  (Err (problem annotation
                                                                "duplicate child scope"))))
                                        (None []))
                                      (for [k 2 (sexp-count annotation)]
                                        (let [name
                                                (field-number variant
                                                              (sexp-nth annotation
                                                                        k))]
                                          (when (< name 0)
                                            (break
                                              :done
                                                (Err (problem annotation
                                                              "scope binding requires a Text field"))))
                                          (let [f
                                                  (elem (field variant fields)
                                                        name)]
                                            (unless (and (not (.many? f))
                                                         (= (.type-name f)
                                                            "Text"))
                                              (break
                                                :done
                                                  (Err (problem annotation
                                                                "scope binding requires a Text field")))))
                                          (for prior names
                                            (when (= prior name)
                                              (break
                                                :done
                                                  (Err (problem annotation
                                                                "duplicate scope binding field")))))
                                          (push! (mut names) name)))
                                      (push! (mut (.scopes bindings))
                                             (ChildScope
                                               :node node
                                               :variant vi
                                               :child field
                                               :names names))))))))))))))))
        (Ok bindings))))
