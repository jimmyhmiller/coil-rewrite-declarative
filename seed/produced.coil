;;; Normalize returned top-level bundles using the declared walk policy.
(module rewrite.produced)
(import "rewrite.code" :as code)
(import "rewrite.codeforms" :as forms)
(import "rewrite.stage" :as stage)
(import "rewrite.syntaxreader" :as projection)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.primitive" :as primitive)
(import "coil.scratch" :use [ScratchArena])

(defsum Error
  (AliasedStores)
  (Projection [(error projection/ProjectionError)])
  (Import [(error code/SyntaxError)]))

;;; The returned list owns its array; its roots and module names belong to output.
;;; Errors publish no list, but output may retain unreachable rows/documents.
;;; This is structural normalization only: declaration registration follows it.
(defn normalize! [(a (dyn Allocator))
                  (output (ptr code/Syntax))
                  (input (ptr code/Syntax))
                  (root forms/N0Id)
                  (module (Option (slice u8)))]
  (-> (Result (ArrayList stage/Tagged) Error))
  (block :done
    (when (= (primitive/cast i64 output) (primitive/cast i64 input))
      (break :done (Err (AliasedStores))))
    (let [(mut scratch) (zeroed ScratchArena)
          initialized (init (mut scratch) (malloc-allocator))
          sa (allocator (mut scratch))
          (mut result) (ArrayList::new [stage/Tagged] a)
          (mut complete?) false]
      (defer (close! (mut scratch)))
      (defer (unless complete? (free! (mut result))))
      (let [(mut form)
              (match (projection/project sa input root)
                (Err [e] (break :done (Err (Projection e))))
                (Ok [form] form))
            leaves (forms/leaves-produced-forms sa (mut form))
            owned-module
              (match module
                (None [] (None))
                (Some [name]
                      (Some (forms/store-text! (mut (.store output)) name))))]
        (for leaf leaves
          (match (code/import-from! output
                                    (field (mut (.store input)) source-data)
                                    leaf)
            (Err [e] (break :done (Err (Import e))))
            (Ok [id]
                (push! (mut result)
                       (stage/Tagged :form id :module owned-module)))))
        (set! complete? true)
        (Ok result)))))
