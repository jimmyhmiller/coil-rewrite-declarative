(defn index-11-0 [(a (dyn Allocator)) (rows (ptr (ArrayList N11Row))) (ids (ptr (ArrayList N11Id)))] (-> (Result (HashMap (slice u8) N11Id) IndexError)) (block :done (let [(mut index) (new-index-11-0 a)] (for [i 0 (len (load ids))] (match (insert-index-11-0 (mut index) rows (get (load ids) i)) (Ok [_]) (Err [e] (free! (mut index)) (break :done (Err e))))) (Ok index))))
(import "rewrite.refer" :as refer)
(defn refer-imports [(a (dyn Allocator)) (store (ptr Store)) (root N2Id)] (-> (Result refer/Policy refer/Error)) (block :done (let [row (match (lookup-2 (field store rows2) root) (Some [row] row) (None [] (break :done (Err (refer/InvalidRow 2 (.index root)))))) (mut policy) (refer/create a) (mut complete?) false] (defer (unless complete? (refer/release! (mut policy)))) (set! (.all? policy) (.f0 row)) (let [(mut ids) (ArrayList::new [N1Id] a)] (defer (free! (mut ids))) (match (sequence-materialize-1 a store (.f3 row) (mut ids)) (Err [e] (break :done (Err (refer/InvalidSequence 1 e)))) (Ok [_])) (for id ids (let [entry (match (lookup-1 (field store rows1) id) (Some [row] row) (None [] (break :done (Err (refer/InvalidRow 1 (.index id))))))] (refer/rename! (mut policy) (.f0 entry) (.f1 entry))))) (let [(mut ids) (ArrayList::new [N0Id] a)] (defer (free! (mut ids))) (match (sequence-materialize-0 a store (.f2 row) (mut ids)) (Err [e] (break :done (Err (refer/InvalidSequence 0 e)))) (Ok [_])) (for id ids (let [entry (match (lookup-0 (field store rows0) id) (Some [row] row) (None [] (break :done (Err (refer/InvalidRow 0 (.index id))))))] (refer/exclude! (mut policy) (.f0 entry))))) (let [(mut ids) (ArrayList::new [N0Id] a)] (defer (free! (mut ids))) (match (sequence-materialize-0 a store (.f1 row) (mut ids)) (Err [e] (break :done (Err (refer/InvalidSequence 0 e)))) (Ok [_])) (for id ids (let [entry (match (lookup-0 (field store rows0) id) (Some [row] row) (None [] (break :done (Err (refer/InvalidRow 0 (.index id))))))] (refer/select! (mut policy) (.f0 entry))))) (set! complete? true) (Ok policy))))
(import "coil.cc" :as eqcc)
(defn equivalent-same-route :cc (eqcc/C) [(left (ptr N8Row)) (right (ptr N8Row))] (-> bool) (and (= (.f0 left) (.f0 right)) (= (.f1 left) (.f1 right)) (= (.f2 left) (.f2 right)) ))
