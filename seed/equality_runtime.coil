;;; Pair-memoized structural comparison. Schema-specific steps enqueue child pairs.
(module rewrite.equality)
(import "rewrite.sequence" :as sequence)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use [HashMap KeyOps])
(import "coil.result" :use *)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(defstruct Pair [(schema i64) (left i64) (right i64)])

(defstruct Frame [(pair Pair) (exit? bool)])

(defstruct Work
  [(allocator (dyn Allocator))
   (stack (ArrayList Frame))
   (seen (HashMap Pair i64))])

(defsum Error
  (InvalidSchema [(schema i64)])
  (InvalidReference [(schema i64) (right? bool) (row i64)])
  (InvalidSequence [(schema i64) (right? bool) (index i64)])
  (SequenceFailure [(error sequence/SequenceError)])
  (ComparisonCycle [(pair Pair)])
  (MissingMetadata [(pair Pair)]))

(defn pair-hash :cc (cc/C) [(bytes (ptr i8)) (size i64)] (-> i64)
  (let [pair (primitive/cast (ptr Pair) bytes)
        (mut h) (- 0 3750763034362895579)]
    (for [part 0 3]
      (let [value
              (cond (= part 0) (.schema pair)
                    (= part 1) (.left pair)
                    :else (.right pair))]
        (for [i 0 8]
          (set! h
                (primitive/imul (primitive/ixor h
                                                (primitive/iand (primitive/ishr value
                                                                                (* i
                                                                                   8))
                                                                255))
                                1099511628211)))))
    h))

(defn pair-equal :cc (cc/C) [(left (ptr i8)) (right (ptr i8)) (size i64)]
  (-> bool)
  (let [a (primitive/cast (ptr Pair) left)
        b (primitive/cast (ptr Pair) right)]
    (and (= (.schema a) (.schema b))
         (= (.left a) (.left b))
         (= (.right a) (.right b)))))

(defn pair-ops [] (-> (ptr KeyOps))
  (primitive/alloc-static KeyOps
                          (KeyOps
                            :hash (primitive/fnptr-of pair-hash)
                            :eq (primitive/fnptr-of pair-equal)
                            :size (primitive/sizeof Pair)
                            :copy
                              (zeroed (fnptr (cc/C)
                                             [(ptr (dyn Allocator)) (ptr i8)]
                                             i64))
                            :free
                              (zeroed (fnptr (cc/C)
                                             [(ptr (dyn Allocator)) (ptr i8)]
                                             i64))
                            :owns 0)))

(defn enqueue! [(work (mut Work)) (pair Pair)] (-> void)
  (push! (mut (.stack work)) (Frame :pair pair :exit? false)))

;;; Each successful pair is checked once. Stores and metadata must remain immutable
;;; throughout a call. A mismatch may stop before unrelated invalid data is visited;
;;; this comparison is not a whole-store graph verifier.
(defn run [C] [(a (dyn Allocator))
               (context (ptr C))
               (root Pair)
               (step (fnptr (cc/C)
                            [(ptr C) (ptr Work) (ptr Pair)]
                            (Result bool Error)))]
  (-> (Result bool Error))
  (let [(mut work)
          (Work
            :allocator a
            :stack (ArrayList::new [Frame] a)
            :seen (HashMap::new [Pair i64] a (pair-ops)))]
    (defer (free! (mut (.stack work))))
    (defer (free! (mut (.seen work))))
    (enqueue! (mut work) root)
    (block :done
      (while (> (len (.stack work)) 0)
        (let [frame
                (match (pop! (mut (.stack work)))
                  (Some [frame] frame)
                  (None [] (panic "comparison frame")))
              (mut pair) (.pair frame)]
          (if (.exit? frame)
              (set! (mut (.seen work)) pair 2)
              (match (get (.seen work) pair)
                (Some [state]
                      (when (= state 1)
                        (break :done (Err (ComparisonCycle pair)))))
                (None []
                      (set! (mut (.seen work)) pair 1)
                      (push! (mut (.stack work)) (Frame :pair pair :exit? true))
                      (match (step context (mut work) (mut pair))
                        (Err [e] (break :done (Err e)))
                        (Ok [same?] (unless same? (break :done (Ok false))))))))))
      (Ok true))))
