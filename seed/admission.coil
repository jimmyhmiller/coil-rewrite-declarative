;;; Ordered admission of normalized generated forms, with explicit declaration work.
(module rewrite.admission)
(import "rewrite.admissionprotocol" :as policy)
(import "rewrite.deriveregistration" :as registration)
(import "rewrite.deriveresolution" :as derives)
(import "rewrite.deriveregistry" :as registry)
(import "rewrite.traitdeclarations" :as traits)
(import "rewrite.revision" :as revision)
(import "rewrite.functionnames" :as functions)
(import "rewrite.stage" :as stage)
(import "rewrite.code" :as code)
(import "rewrite.equality" :as equality)
(import "rewrite.syntaxreader" :as projection)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use *)
(import "coil.reader" :use [Sexp])
(import "coil.result" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(defsum Error [E]
  (Comparison [(error equality/Error)])
  (Derive [(error (registration/Error derives/Error))])
  (Declaration [(error E)])
  (Version [(error revision/Error)]))

(defsum Failure [E]
  (Projection [(index i64) (error projection/ProjectionError)])
  (Protocol [(index i64) (error (policy/Failure (Error E)))]))

(defstruct Context [C E]
  [(scratch (dyn Allocator))
   (user (ptr C))
   (declaration (fnptr (cc/C)
                       [(ptr C) (ptr Sexp) (Option (slice u8))]
                       (Result bool E)))
   (derives (ptr derives/Context))
   (registry (ptr registry/Registry))
   (functions (ptr functions/Names))
   (supply (ptr revision/Supply))
   (original (Option revision/Tagged))
   (input (ptr code/Syntax))
   (output (ptr code/Syntax))
   (entry stage/Tagged)
   (form (ptr Sexp))
   (count i64)
   (index i64)
   (published (ptr (ArrayList revision/Tagged)))])

(defn classify :cc (cc/C) [C E] [(c (ptr (Context C E)))]
  (-> (Result policy/Event (Error E)))
  (Ok (if (registration/recognizes? (.form c))
          (policy/Event-Registration)
          (policy/Event-Ordinary))))

(defn reuse :cc (cc/C) [C E] [(c (ptr (Context C E)))]
  (-> (Result policy/Event (Error E)))
  (if (!= (.count c) 1)
      (Ok (policy/Event-Changed))
      (match (.original c)
        (None [] (Ok (policy/Event-Changed)))
        (Some [prior]
              (match (code/revision-equal? (.scratch c)
                                           (.input c)
                                           (.form (.entry prior))
                                           (.output c)
                                           (.form (.entry c)))
                (Err [e] (Err (Comparison [E] e)))
                (Ok [same]
                    (Ok (if same
                            (policy/Event-Unchanged)
                            (policy/Event-Changed)))))))))

(defn register :cc (cc/C) [C E] [(c (ptr (Context C E)))]
  (-> (Result policy/Event (Error E)))
  (match (derives/register! (.derives c)
                            (.registry c)
                            (.form c)
                            (.module (.entry c)))
    (Ok [_] (Ok (policy/Event-Done)))
    (Err [e] (Err (Derive [E] e)))))

(defn accept-declaration :cc (cc/C) [C E] [(c (ptr (Context C E)))]
  (-> (Result policy/Event (Error E)))
  (traits/observe! (.scratch c)
                   (.traits (.derives c))
                   (.form c)
                   (.module (.entry c)))
  (let [declaration (.declaration c)]
    (match (declaration (.user c) (.form c) (.module (.entry c)))
      (Ok [_] (Ok (policy/Event-Done)))
      (Err [e] (Err (Declaration [E] e))))))

(defn collect :cc (cc/C) [C E] [(c (ptr (Context C E)))]
  (-> (Result policy/Event (Error E)))
  (functions/observe! (.scratch c)
                      (.functions c)
                      (.form c)
                      (.module (.entry c)))
  (Ok (policy/Event-Done)))

(defn publish :cc (cc/C) [C E] [(c (ptr (Context C E)))]
  (-> (Result policy/Event (Error E)))
  (match (revision/version! (.scratch c)
                            (.supply c)
                            (.original c)
                            (.input c)
                            (.output c)
                            (.entry c)
                            (.count c)
                            (.index c))
    (Err [e] (Err (Version [E] e)))
    (Ok [version]
        (push! (.published c)
               (revision/Tagged :entry (.entry c) :version version))
        (Ok (policy/Event-Done)))))

;;; Normalized forms must remain immutable. Declaration work is mandatory: the
;;; callback must validate/register generated structs/sums for its compiler.
;;; Function-name collection follows successful declaration work. There is no default acceptance callback or old-host fallback.
;;; Result array is owned by caller; forms borrow output. On error no array is
;;; returned, but prior registration/declaration effects and spent IDs persist.
(defn run! [C E] [(a (dyn Allocator))
                  (user (ptr C))
                  (declaration (fnptr (cc/C)
                                      [(ptr C) (ptr Sexp) (Option (slice u8))]
                                      (Result bool E)))
                  (derives (ptr derives/Context))
                  (registry (ptr registry/Registry))
                  (functions (ptr functions/Names))
                  (supply (ptr revision/Supply))
                  (original (Option revision/Tagged))
                  (input (ptr code/Syntax))
                  (output (ptr code/Syntax))
                  (normalized (ptr (ArrayList stage/Tagged)))]
  (-> (Result (ArrayList revision/Tagged) (Failure E)))
  (block
    :done
      (let [(mut scratch) (zeroed ScratchArena)
            initialized (init (mut scratch) a)
            sa (allocator (mut scratch))
            (mut projector) (projection/create sa output)
            (mut result) (ArrayList::new [revision/Tagged] a)
            (mut complete?) false
            (mut handlers)
              (policy/Handlers [(Context C E) (Error E)]
                               :step-classify
                               (primitive/fnptr-of classify [C E])
                               :step-reuse
                               (primitive/fnptr-of reuse [C E])
                               :step-register
                               (primitive/fnptr-of register [C E])
                               :step-declare
                               (primitive/fnptr-of accept-declaration [C E])
                               :step-collect
                               (primitive/fnptr-of collect [C E])
                               :step-publish
                               (primitive/fnptr-of publish [C E]))]
        (defer (close! (mut scratch)))
        (defer (projection/release! (mut projector)))
        (defer (unless complete? (free! (mut result))))
        (for [i 0 (len (load normalized))]
          (let [entry (get (load normalized) i)
                (mut form)
                  (match (projection/project! (mut projector) (.form entry))
                    (Ok [form] form)
                    (Err [e] (break :done (Err (Projection [E] i e)))))
                (mut context)
                  (Context [C E]
                           :scratch
                           sa
                           :user
                           user
                           :declaration
                           declaration
                           :derives
                           derives
                           :registry
                           registry
                           :functions
                           functions
                           :supply
                           supply
                           :original
                           original
                           :input
                           input
                           :output
                           output
                           :entry
                           entry
                           :form
                           (primitive/cast (ptr Sexp) (mut form))
                           :count
                           (len (load normalized))
                           :index
                           i
                           :published
                           (primitive/cast (ptr (ArrayList revision/Tagged))
                                           (mut result)))]
            (match (policy/run (mut context) (mut handlers))
              (Ok [_])
              (Err [e] (break :done (Err (Protocol [E] i e)))))))
        (set! complete? true)
        (Ok result))))
