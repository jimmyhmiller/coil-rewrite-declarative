;;; Connect derive admission to production namespace routing and route evidence.
(module rewrite.deriveresolution)
(import "rewrite.deriveregistry" :as registry)
(import "rewrite.deriveregistration" :as registration)
(import "rewrite.namespace" :as namespace)
(import "rewrite.routingfacts" :as facts)
(import "rewrite.routing" :as routing)
(import "rewrite.resolveprotocol" :as routes)
(import "rewrite.headprotocol" :as heads)
(import "rewrite.macrohead" :as head)
(import "rewrite.observedresolution" :as observed)
(import "rewrite.sourceroutes" :as evidence)
(import "coil.alloc" :use [Allocator])
(import "coil.reader" :use [Sexp])
(import "coil.result" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(defsum Error
  (Macro [(error (heads/Failure head/Error))])
  (Trait [(error (routes/Failure routing/Error))]))

;;; Borrowed immutable namespace snapshots. Replace traits only between calls;
;;; pending settlement then observes the new snapshot, without caching misses.
;;; Callback failures may borrow these snapshots until inspected.
(defstruct Context
  [(allocator (dyn Allocator))
   (macros (ptr namespace/View))
   (traits (ptr namespace/View))
   (world (ptr facts/World))
   (records (ptr evidence/Table))])

(defn macro-head :cc (cc/C) [(c (ptr Context))
                             (node Sexp)
                             (module (Option (slice u8)))]
  (-> (Result (Option (slice u8)) Error))
  (let [(mut outcome)
          (observed/reader-head! (.allocator c)
                                 (.records c)
                                 (.macros c)
                                 (.world c)
                                 node
                                 module)]
    (defer (head/release! (mut outcome)))
    (match (.result outcome)
      (Err [e] (Err (Macro e)))
      ; Targets belong to the namespace, not the released lexical buffer.
      (Ok [answer] (Ok (.target answer))))))

(defn trait :cc (cc/C) [(c (ptr Context))
                        (name (slice u8))
                        (module (Option (slice u8)))]
  (-> (Result (Option (slice u8)) Error))
  (match (routing/resolve (.allocator c)
                          (.traits c)
                          (.world c)
                          name
                          module
                          false)
    (Err [e] (Err (Trait e)))
    (Ok [answer] (Ok (.target answer)))))

(defn resolver [(c (ptr Context))] (-> (registry/Resolver Context Error))
  (registry/Resolver [Context Error]
                     :context
                     c
                     :lookup
                     (primitive/fnptr-of trait)))

(defn register! [(c (ptr Context))
                 (r (ptr registry/Registry))
                 (form (ptr Sexp))
                 (module (Option (slice u8)))]
  (-> (Result i64 (registration/Error Error)))
  (let [(mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) (.allocator c))
        (mut traits) (resolver c)
        (mut macros)
          (registration/Macros [Context Error]
                               :context
                               c
                               :resolve
                               (primitive/fnptr-of macro-head))]
    (defer (close! (mut scratch)))
    (registration/register! (allocator (mut scratch))
                            r
                            (mut traits)
                            (mut macros)
                            form
                            module)))

(defn settle! [(c (ptr Context)) (r (ptr registry/Registry))]
  (-> (Result bool (registry/Failure Error)))
  (let [(mut traits) (resolver c)] (registry/settle! r (mut traits))))

(defn finish! [(c (ptr Context)) (r (ptr registry/Registry))]
  (-> (Result bool (registry/Failure Error)))
  (let [(mut traits) (resolver c)] (registry/finish! r (mut traits))))
