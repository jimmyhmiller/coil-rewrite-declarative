;;; Scalar lowering rules derive CIR traversal and branch/SSA construction.
(module rewrite.lower)
(import "rewrite.schema" :use *)
(import "rewrite.binding" :as binding)
(import "rewrite.emit" :use [number!])
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.str" :use *)

(defn field-number [(v (ptr Variant)) (name (ptr Sexp)) (ty (slice u8))]
  (-> i64)
  (block :found
    (for [i 0 (len (.fields v))]
      (let [f (elem (field v fields) i)]
        (when (and (not (.many? f))
                   (sexp-sym-is name (.name f))
                   (= (.type-name f) ty))
          (break :found i))))
    (- 0 1)))

(defn child! [(b (mut StrBuf)) (node i64) (field i64) (with-store? bool)]
  (-> void)
  (push-str! (mut b) "(lower-worker-")
  (number! (mut b) node)
  (when with-store? (push-str! (mut b) " store"))
  (push-str! (mut b) " rows f")
  (number! (mut b) field)
  (push-str! (mut b) " function context)"))

(defn rule! [(b (mut StrBuf))
             (n (ptr Node))
             (bindings (ptr binding/Bindings))
             (ni i64)
             (vi i64)
             (rule (ptr Sexp))] (-> (Result i64 Diag))
  (block :done
    (unless (and (sexp-list? rule) (= (sexp-count rule) 2))
      (break
        :done (Err (problem rule "expected (Variant lowering-expression)"))))
    (let [expression (sexp-nth rule 1)
          v (elem (field n variants) vi)]
      (unless (and (sexp-list? expression) (> (sexp-count expression) 0))
        (break :done (Err (problem expression "expected lowering operation"))))
      (let [op (sexp-nth expression 0)
            constant? (sexp-sym-is op "const")
            boolean? (sexp-sym-is op "bool")
            binary-op
              (cond (sexp-sym-is op "add") "cop/OP-ADD"
                    (sexp-sym-is op "sub") "cop/OP-SUB"
                    (sexp-sym-is op "mul") "cop/OP-MUL"
                    :else "")
            predicate
              (cond (sexp-sym-is op "eq") "cir/P-EQ"
                    (sexp-sym-is op "ne") "cir/P-NE"
                    (sexp-sym-is op "slt") "cir/P-SLT"
                    (sexp-sym-is op "sle") "cir/P-SLE"
                    (sexp-sym-is op "sgt") "cir/P-SGT"
                    (sexp-sym-is op "sge") "cir/P-SGE"
                    :else "")
            binary? (or (!= binary-op "") (!= predicate ""))
            sequence? (sexp-sym-is op "sequence")
            call? (sexp-sym-is op "call")
            branch? (sexp-sym-is op "if")
            lookup? (sexp-sym-is op "name")
            identity? (sexp-sym-is op "identity")
            bind? (sexp-sym-is op "let")
            arity
              (cond lookup? 0
                    bind? (- (sexp-count expression) 1)
                    (or constant? boolean? identity? sequence?) 1
                    call? (- (sexp-count expression) 1)
                    binary? 2
                    branch? 3
                    :else 0)
            (mut fields) (ArrayList::new [i64] (malloc-allocator))]
        (defer (free! (mut fields)))
        (unless (and (or lookup? (> arity 0))
                     (or (not bind?) (>= arity 2))
                     (= (sexp-count expression) (+ arity 1)))
          (break
            :done
              (Err (problem expression
                            "unknown lowering operation or wrong arity"))))
        (unless (and (= lookup? (>= (binding/reference bindings ni vi) 0))
                     (= (binding/scope-count bindings ni vi) (if bind? 1 0)))
          (break
            :done
              (Err (problem expression
                            "lowering must consume declared references and scopes"))))
        (for [i 1 (+ arity 1)]
          (let [field (sexp-nth expression i)
                index
                  (if sequence?
                      (recursive-field n v field true)
                      (if (and call?
                               (> i 1)
                               (sexp-list? field)
                               (= (sexp-count field) 2)
                               (sexp-sym-is (sexp-nth field 0) "spread"))
                          (recursive-field n v (sexp-nth field 1) true)
                          (field-number v
                                        field
                                        (cond constant? "Int"
                                              boolean? "Bool"
                                              :else (.name n)))))]
            (when (< index 0)
              (break
                :done
                  (Err (problem field
                                "lowering field has wrong type or is missing"))))
            (push! (mut fields) index)))
        (push-str! (mut b) "(N")
        (number! (mut b) ni)
        (push-str! (mut b) "V")
        (number! (mut b) vi)
        (push-str! (mut b) " [")
        (for [i 0 (len (.fields v))]
          (push-str! (mut b) " f")
          (number! (mut b) i))
        (push-str! (mut b) "] ")
        (cond (or constant? boolean?)
                (do
                  (push-str! (mut b) "(cir/iconst! function ")
                  (when boolean? (push-str! (mut b) "(if "))
                  (push-str! (mut b) "f")
                  (number! (mut b) (get fields 0))
                  (when boolean? (push-str! (mut b) " 1 0)"))
                  (push-str! (mut b) ")"))
              sequence?
                (do
                  (push-str! (mut b) "(let [(mut items) (ArrayList::new [N")
                  (number! (mut b) ni)
                  (push-str! (mut b)
                             "Id] (malloc-allocator))] (defer (free! (mut items))) (match (sequence-materialize-")
                  (number! (mut b) ni)
                  (push-str! (mut b) " (malloc-allocator) store f")
                  (number! (mut b) (get fields 0))
                  (push-str! (mut b)
                             " (mut items)) (Err [_] (panic \"invalid checked sequence\")) (Ok [_])) (if (= (len items) 0) (cir/iconst! function 0) (let [(mut value) (: 0 u32)] (for item items (set! value (lower-worker-")
                  (number! (mut b) ni)
                  (push-str! (mut b)
                             " store rows item function context))) value)))"))
              identity?
                (child! (mut b) ni (get fields 0) (recursive-sequence? n))
              lookup?
                (do
                  (push-str! (mut b) "(match (value-lookup context f")
                  (number! (mut b) (binding/reference bindings ni vi))
                  (push-str! (mut b)
                             ") (LocalValue [value] value) (GlobalSymbol [symbol] (cir/sym! function symbol 0)))"))
              bind?
                (let [scope
                        (match (binding/child-scope bindings
                                                    ni
                                                    vi
                                                    (get fields (- arity 1)))
                          (Some [scope] scope)
                          (None []
                                (break
                                  :done
                                    (Err (problem expression
                                                  "let body must be the declared scoped child")))))
                      names (.names scope)
                      count (- arity 1)]
                  (unless (= (len names) count)
                    (break
                      :done
                        (Err (problem expression
                                      "let values must match declared binding names"))))
                  (push-str! (mut b) "(let [")
                  (for [i 0 count]
                    (push-str! (mut b) "value")
                    (number! (mut b) i)
                    (push-str! (mut b) " ")
                    (child! (mut b) ni (get fields i) (recursive-sequence? n))
                    (push-str! (mut b) " "))
                  (for [i 0 count]
                    (push-str! (mut b) "(mut scope")
                    (unless (= i (- count 1)) (number! (mut b) i))
                    (push-str! (mut b) ") (scope-bind ")
                    (if (= i 0)
                        (push-str! (mut b) "context")
                        (do
                          (push-str! (mut b) "(mut scope")
                          (number! (mut b) (- i 1))
                          (push-str! (mut b) ")")))
                    (push-str! (mut b) " f")
                    (number! (mut b) (get names i))
                    (push-str! (mut b) " (LocalValue value")
                    (number! (mut b) i)
                    (push-str! (mut b) ")) "))
                  (push-str! (mut b) "] (lower-worker-")
                  (number! (mut b) ni)
                  (when (recursive-sequence? n) (push-str! (mut b) " store"))
                  (push-str! (mut b) " rows f")
                  (number! (mut b) (get fields (- arity 1)))
                  (push-str! (mut b) " function (mut scope)))"))
              call?
                (do
                  (push-str! (mut b) "(let [callee ")
                  (child! (mut b) ni (get fields 0) (recursive-sequence? n))
                  (push-str! (mut b)
                             " (mut args) (ArrayList::new [u32] (malloc-allocator)) (mut flags) (ArrayList::new [u32] (malloc-allocator)) (mut results) (ArrayList::new [u8] (malloc-allocator))] (defer (free! (mut args))) (defer (free! (mut flags))) (defer (free! (mut results))) ")
                  (for [i 1 arity]
                    (if (sexp-list? (sexp-nth expression (+ i 1)))
                        (let [slot (get fields i)]
                          (push-str! (mut b)
                                     "(let [(mut items) (ArrayList::new [N")
                          (number! (mut b) ni)
                          (push-str! (mut b)
                                     "Id] (malloc-allocator))] (defer (free! (mut items))) (match (sequence-materialize-")
                          (number! (mut b) ni)
                          (push-str! (mut b) " (malloc-allocator) store f")
                          (number! (mut b) slot)
                          (push-str! (mut b)
                                     " (mut items)) (Ok [_]) (Err [_] (panic \"invalid checked argument list\"))) (for item items (push! (mut args) (lower-worker-")
                          (number! (mut b) ni)
                          (push-str! (mut b)
                                     " store rows item function context)) (push! (mut flags) 0))) "))
                        (do
                          (push-str! (mut b) "(push! (mut args) ")
                          (child! (mut b)
                                  ni
                                  (get fields i)
                                  (recursive-sequence? n))
                          (push-str! (mut b) ") (push! (mut flags) 0) "))))
                  (push-str! (mut b)
                             "(push! (mut results) (cast u8 cop/T-I64)) (let [value (cir/val function callee) direct (and (= (cast i64 (.op value)) cop/OP-SYM) (= (.imm2 value) 0))] (cir/call! function (if direct (cast u32 (.imm value)) (cir/none)) (if direct (cir/none) callee) (mut args) (mut flags) (mut results) false)))"))
              binary?
                (do
                  (push-str! (mut b) "(let [left ")
                  (child! (mut b) ni (get fields 0) (recursive-sequence? n))
                  (push-str! (mut b) " right ")
                  (child! (mut b) ni (get fields 1) (recursive-sequence? n))
                  (push-str! (mut b) "] (cir/op2! function ")
                  (push-str! (mut b)
                             (if (= predicate "") binary-op "cop/OP-ICMP"))
                  (push-str! (mut b) " cop/T-I64 left right ")
                  (push-str! (mut b) (if (= predicate "") "0" predicate))
                  (push-str! (mut b) " 0))"))
              :else
                (do
                  (push-str! (mut b) "(let [condition ")
                  (child! (mut b) ni (get fields 0) (recursive-sequence? n))
                  (push-str! (mut b)
                             " yes (cir/new-block! function) no (cir/new-block! function) join (cir/new-block! function) result (cir/new-var! function cop/T-I64)] (cir/condbr! function condition yes no) (cir/set-block! function yes) (cir/def-var! function result ")
                  (child! (mut b) ni (get fields 1) (recursive-sequence? n))
                  (push-str! (mut b)
                             ") (cir/br! function join) (cir/set-block! function no) (cir/def-var! function result ")
                  (child! (mut b) ni (get fields 2) (recursive-sequence? n))
                  (push-str! (mut b)
                             ") (cir/br! function join) (cir/set-block! function join) (cir/use-var! function result))")))
        (push-str! (mut b) ")\n")
        (Ok 0)))))

(defn compile-one [(a (dyn Allocator))
                   (s (ptr Schema))
                   (bindings (ptr binding/Bindings))
                   (form (ptr Sexp))]
  (-> (Result (slice u8) Diag))
  (block :done
    (unless (>= (sexp-count form) 2)
      (break :done (Err (problem form "lower requires a sum name"))))
    (let [(mut ni) (- 0 1)
          (mut b) (StrBuf::new a)]
      (for [i 0 (len (.nodes s))]
        (when (sexp-sym-is (sexp-nth form 1) (.name (elem (field s nodes) i)))
          (set! ni i)))
      (when (< ni 0) (break :done (Err (problem form "unknown lowering sum"))))
      (let [n (elem (field s nodes) ni)]
        (unless (.sum? n)
          (break :done (Err (problem form "lower requires a sum"))))
        (push-str! (mut b)
                   "(import \"native.cir\" :as cir)\n(import \"native.cir-ops\" :as cop)\n(defn lower-worker-")
        (number! (mut b) ni)
        (push-str! (mut b)
                   (if (recursive-sequence? n)
                       " [(store (ptr Store)) (rows (ptr (ArrayList N"
                       " [(rows (ptr (ArrayList N"))
        (number! (mut b) ni)
        (push-str! (mut b) "Row))) (id N")
        (number! (mut b) ni)
        (push-str! (mut b)
                   "Id) (function (ptr cir/Func)) (context (ptr (Scope ValueBinding)))] (-> u32) (match (lookup-")
        (number! (mut b) ni)
        (push-str! (mut b)
                   " rows id) (None [] (panic \"invalid lowering reference\")) (Some [row] (match row ")
        (for [vi 0 (len (.variants n))]
          (let [(mut count) 0]
            (for [r 2 (sexp-count form)]
              (let [rule (sexp-nth form r)]
                (unless (and (sexp-list? rule) (= (sexp-count rule) 2))
                  (break :done (Err (problem rule "expected lowering case"))))
                (when (sexp-sym-is (sexp-nth rule 0)
                                   (.name (elem (field n variants) vi)))
                  (set! count (+ count 1))
                  (match (rule! (mut b) n bindings ni vi rule)
                    (Err [d] (break :done (Err d)))
                    (Ok [_] 0)))))
            (unless (= count 1)
              (break
                :done
                  (Err (problem form
                                "each variant needs exactly one lowering case"))))))
        (unless (= (- (sexp-count form) 2) (len (.variants n)))
          (break :done (Err (problem form "extra lowering case"))))
        (push-str! (mut b) "))))\n")
        (push-str! (mut b) "(defn lower-")
        (number! (mut b) ni)
        (push-str! (mut b)
                   (if (recursive-sequence? n)
                       " [(store (ptr Store)) (rows (ptr (ArrayList N"
                       " [(rows (ptr (ArrayList N"))
        (number! (mut b) ni)
        (push-str! (mut b) "Row))) (id N")
        (number! (mut b) ni)
        (push-str! (mut b)
                   "Id) (function (ptr cir/Func))] (-> u32) (let [(mut context) (zeroed (Scope ValueBinding))] (lower-worker-")
        (number! (mut b) ni)
        (when (recursive-sequence? n) (push-str! (mut b) " store"))
        (push-str! (mut b) " rows id function (mut context))))\n")
        (Ok (str (load b)))))))
