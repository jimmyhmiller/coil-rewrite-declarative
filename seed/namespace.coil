;;; Immutable namespace/import facts with owned, monotonically introduced declarations.
(module rewrite.namespace)
(import "rewrite.nameforms" :as forms)
(import "rewrite.refer" :as refer)
(import "rewrite.selection" :as selection)
(import "rewrite.exportsearch" :as policy)
(import "rewrite.searchruntime" :as search)
(import "rewrite.sequence" :as sequence)
(import "rewrite.source" :as source)
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use [HashMap])
(import "coil.str" :use [keyops-borrowed StrBuf])
(import "coil.result" :use *)
(import "coil.scratch" :use [ScratchArena])
(import "coil.cc" :as cc)
(import "coil.primitive" :as primitive)

(defstruct Edge [(target (slice u8)) (refer refer/Policy)])

(defstruct Module
  [(restricted? bool)
   (exports (HashMap (slice u8) bool))
   (edges (ArrayList Edge))])

(defstruct View
  [(store (ptr forms/Store))
   (declarations (HashMap (slice u8) forms/N3Id))
   (aliases (HashMap (slice u8) forms/N4Id))
   (modules (HashMap (slice u8) forms/N5Id))
   (compiled (ArrayList (Option Module)))
   (introduced-text source/Sources)
   (introduced-rows (ArrayList forms/N3Row))
   (introduced-index (HashMap (slice u8) forms/N3Id))])

(defsum Error
  (Row [(schema i64) (index i64)])
  (Sequence [(error sequence/SequenceError)])
  (Index [(error forms/IndexError)])
  (Refer [(edge i64) (error refer/Error)])
  (CoreRefer [(module (slice u8)) (error refer/Error)]))

(defsum QueryError (InvalidView))

(defn release-edges! [(edges (mut (ArrayList Edge)))] (-> void)
  (for [i 0 (len edges)]
    (refer/release! (mut (.refer (elem (mut edges) i)))))
  (free! (mut edges)))

(defn release-module! [(module (mut Module))] (-> void)
  (release-edges! (mut (.edges module)))
  (free! (mut (.exports module))))

(defn release! [(view (mut View))] (-> void)
  (for entry (.compiled view)
    (match entry
      (Some [module] (let [(mut owned) module] (release-module! (mut owned))))
      (None [])))
  (free! (mut (.compiled view)))
  (free! (mut (.declarations view)))
  (free! (mut (.aliases view)))
  (free! (mut (.modules view)))
  (free! (mut (.introduced-index view)))
  (free! (mut (.introduced-rows view)))
  (source/release! (mut (.introduced-text view))))

(defn compile-edges [(a (dyn Allocator))
                     (store (ptr forms/Store))
                     (sequence forms/N6Seq)]
  (-> (Result (ArrayList Edge) Error))
  (block
    :done
      (let [(mut edges) (ArrayList::new [forms/N6Id] a)
            (mut output) (ArrayList::new [Edge] a)
            (mut complete?) false]
        (defer (free! (mut edges)))
        (defer (unless complete? (release-edges! (mut output))))
        (match (forms/sequence-materialize-6 a store sequence (mut edges))
          (Ok [_])
          (Err [e] (break :done (Err (Sequence e)))))
        (for id edges
          (let [edge
                  (match (forms/lookup-6 (field store rows6) id)
                    (Some [edge] edge)
                    (None [] (break :done (Err (Row 6 (.index id))))))
                refer
                  (match (forms/refer-imports a store (.f1 edge))
                    (Ok [refer] refer)
                    (Err [e] (break :done (Err (Refer (.index id) e)))))]
            (push! (mut output) (Edge :target (.f0 edge) :refer refer))))
        (set! complete? true)
        (Ok output))))

(defn compile-uses [(a (dyn Allocator))
                    (store (ptr forms/Store))
                    (root forms/N9Id)]
  (-> (Result (ArrayList Edge) Error))
  (match (forms/lookup-9 (field store rows9) root)
    (None [] (Err (Row 9 (.index root))))
    (Some [row] (compile-edges a store (.f0 row)))))

(defn compile-module [(a (dyn Allocator))
                      (store (ptr forms/Store))
                      (row forms/N5Row)]
  (-> (Result Module Error))
  (block
    :done
      (let [(mut module)
              (Module
                :restricted? (.f1 row)
                :exports (HashMap::new [(slice u8) bool] a (keyops-borrowed))
                :edges (ArrayList::new [Edge] a))
            (mut names) (ArrayList::new [forms/N0Id] a)
            (mut complete?) false]
        (defer (unless complete? (release-module! (mut module))))
        (defer (free! (mut names)))
        (match (forms/sequence-materialize-0 a store (.f2 row) (mut names))
          (Ok [_])
          (Err [e] (break :done (Err (Sequence e)))))
        (for id names
          (match (forms/lookup-0 (field store rows0) id)
            (None [] (break :done (Err (Row 0 (.index id)))))
            (Some [name] (set! (mut (.exports module)) (.f0 name) true))))
        (match (compile-edges a store (.f3 row))
          (Err [e] (break :done (Err e)))
          (Ok [edges] (set! (.edges module) edges)))
        (set! complete? true)
        (Ok module))))

;;; The view borrows the Store, which must remain immutable and live until release.
;;; Derived indexes validate unique declarations, aliases and module records.
;;; Missing target module records are legal: their direct declarations can exist.
(defn compile [(a (dyn Allocator)) (store (ptr forms/Store)) (root forms/N7Id)]
  (-> (Result View Error))
  (block
    :done
      (let [row
              (match (forms/lookup-7 (field store rows7) root)
                (Some [row] row)
                (None [] (break :done (Err (Row 7 (.index root))))))
            (mut view)
              (View
                :store store
                :declarations (forms/new-index-3-0 a)
                :aliases (forms/new-index-4-0 a)
                :modules (forms/new-index-5-0 a)
                :compiled (ArrayList::new [(Option Module)] a)
                :introduced-text (source/create a)
                :introduced-rows (ArrayList::new [forms/N3Row] a)
                :introduced-index (forms/new-index-3-0 a))
            (mut declarations) (ArrayList::new [forms/N3Id] a)
            (mut aliases) (ArrayList::new [forms/N4Id] a)
            (mut modules) (ArrayList::new [forms/N5Id] a)
            (mut complete?) false]
        (defer (unless complete? (release! (mut view))))
        (defer (free! (mut declarations)))
        (defer (free! (mut aliases)))
        (defer (free! (mut modules)))
        (match (forms/sequence-materialize-3 a
                                             store
                                             (.f0 row)
                                             (mut declarations))
          (Ok [_])
          (Err [e] (break :done (Err (Sequence e)))))
        (match (forms/sequence-materialize-4 a store (.f1 row) (mut aliases))
          (Ok [_])
          (Err [e] (break :done (Err (Sequence e)))))
        (match (forms/sequence-materialize-5 a store (.f2 row) (mut modules))
          (Ok [_])
          (Err [e] (break :done (Err (Sequence e)))))
        (for id declarations
          (match (forms/insert-index-3-0 (mut (.declarations view))
                                         (field store rows3)
                                         id)
            (Ok [_])
            (Err [e] (break :done (Err (Index e))))))
        (for id aliases
          (match (forms/insert-index-4-0 (mut (.aliases view))
                                         (field store rows4)
                                         id)
            (Ok [_])
            (Err [e] (break :done (Err (Index e))))))
        (for [i 0 (len (.rows5 store))] (push! (mut (.compiled view)) (None)))
        (for id modules
          (match (forms/insert-index-5-0 (mut (.modules view))
                                         (field store rows5)
                                         id)
            (Ok [_])
            (Err [e] (break :done (Err (Index e)))))
          (let [row (get (.rows5 store) (.index id))]
            (match (compile-module a store row)
              (Err [e] (break :done (Err e)))
              (Ok [module]
                  (set! (mut (.compiled view)) (.index id) (Some module))))))
        (set! complete? true)
        (Ok view))))

(defstruct Context
  [(view (ptr View)) (scratch (dyn Allocator)) (allocator (dyn Allocator))])

(defn module-of [(view (ptr View)) (name (slice u8))] (-> (Option Module))
  (match (get (.modules view) name)
    (None [] (None))
    (Some [id] (get (.compiled view) (.index id)))))

(defn visible :cc (cc/C) [(context (ptr Context)) (query (ptr search/Query))]
  (-> (Result bool QueryError))
  (Ok (match (module-of (.view context) (.owner query))
        (None [] true)
        (Some [module]
              (or (not (.restricted? module))
                  (match (get (.exports module) (.name query))
                    (Some [_] true)
                    (None [] false)))))))

(defn alias-name [(view (ptr View)) (qualified (slice u8))] (-> (slice u8))
  (match (get (.aliases view) qualified)
    (Some [id] (.f1 (get (.rows4 (.store view)) (.index id))))
    (None [] qualified)))

;;; Publish only between queries. Existing base and introduced memberships are
;;; idempotent; aliases remain a separate lookup policy. All text is copied.
;;; Earlier returned canonical strings remain valid until view release.
(defn introduce! [(view (ptr View)) (qualified (slice u8))] (-> bool)
  (block :done
    (match (get (.declarations view) qualified)
      (Some [_] (break :done false))
      (None []))
    (match (get (.introduced-index view) qualified)
      (Some [_] (break :done false))
      (None []))
    (let [name (source/intern! (field view introduced-text) qualified)
          id
            (forms/append-3 (field view introduced-rows) (forms/N3Row :f0 name))]
      (match (forms/insert-index-3-0 (field view introduced-index)
                                     (field view introduced-rows)
                                     id)
        (Ok [_] true)
        (Err [_] (panic "introduced declaration index invariant"))))))

(defn declaration [(view (ptr View)) (qualified (slice u8))]
  (-> (Option (slice u8)))
  (let [name (alias-name view qualified)]
    (match (get (.introduced-index view) name)
      (Some [id] (Some (.f0 (get (.introduced-rows view) (.index id)))))
      (None []
            (match (get (.declarations view) name)
              (None [] (None))
              (Some [id] (Some (.f0 (get (.rows3 (.store view)) (.index id))))))))))

(defn direct :cc (cc/C) [(context (ptr Context)) (query (ptr search/Query))]
  (-> (Result (Option (slice u8)) QueryError))
  (let [(mut b) (StrBuf::new (.scratch context))]
    (push-str! (mut b) (.owner query))
    (push-str! (mut b) ".")
    (push-str! (mut b) (.name query))
    (Ok (declaration (.view context) (str b)))))

(defn reexports :cc (cc/C) [(context (ptr Context)) (query (ptr search/Query))]
  (-> (Result (ArrayList search/Query) QueryError))
  (let [(mut children) (ArrayList::new [search/Query] (.allocator context))]
    (match (module-of (.view context) (.owner query))
      (None [])
      (Some [module]
            (for [i 0 (len (.edges module))]
              (let [(mut edge) (get (.edges module) i)]
                (match (refer/referred (field edge refer) (.name query))
                  (None [])
                  (Some [name]
                        (push! (mut children)
                               (search/Query :owner (.target edge) :name name))))))))
    (Ok children)))

;;; Returned targets borrow the input Store, never this query's temporary buffers.
(defn exported [(a (dyn Allocator))
                (view (ptr View))
                (module (slice u8))
                (name (slice u8))
                (depth i64)
                (stats (mut search/Stats))]
  (-> (Result (Option (slice u8)) (search/Failure QueryError)))
  (let [(mut scratch) (zeroed ScratchArena)
        initialized (init (mut scratch) a)
        (mut context)
          (Context
            :view view
            :scratch (allocator (mut scratch))
            :allocator a)
        (mut handlers)
          (policy/Handlers [Context (slice u8) QueryError]
                           :guard-visible
                           (primitive/fnptr-of visible)
                           :prefer-direct
                           (primitive/fnptr-of direct)
                           :follow-reexports
                           (primitive/fnptr-of reexports))]
    (defer (close! (mut scratch)))
    (policy/search-exported a
                            (mut context)
                            (mut handlers)
                            (search/Query :owner module :name name)
                            depth
                            (mut stats))))

(defsum UseError
  (Export [(error (search/Failure QueryError))])
  (Ambiguous [(first forms/N8Row) (next forms/N8Row)]))

;;; Ordered use lookup. Candidates and errors borrow the view, edges and spelling.
;;; Macro selection stops immediately; nominal selection compares with the first
;;; successful witness, including the declared same-import-owner exception.
(defn used [(a (dyn Allocator))
            (view (ptr View))
            (edges (ptr (ArrayList Edge)))
            (name (slice u8))
            (macro? bool)] (-> (Result (Option forms/N8Row) UseError))
  (block
    :done
      (let [(mut prior) (None [forms/N8Row])
            (mut stats) (search/Stats :expanded 0 :cached 0)]
        (for [i 0 (len (load edges))]
          (let [edge (elem edges i)]
            (match (refer/referred (field edge refer) name)
              (None [])
              (Some [exported-name]
                    (match (exported a
                                     view
                                     (.target edge)
                                     exported-name
                                     0
                                     (mut stats))
                      (Err [e] (break :done (Err (Export e))))
                      (Ok [answer]
                          (match answer
                            (None [])
                            (Some [target]
                                  (let [candidate
                                          (forms/N8Row
                                            :f0 (.target edge)
                                            :f1 exported-name
                                            :f2 target)
                                        decision
                                          (if macro?
                                              (forms/select-macro-use prior
                                                                      candidate)
                                              (forms/select-unique-use prior
                                                                       candidate))]
                                    (match decision
                                      (selection/Stop [chosen]
                                                      (break
                                                        :done (Ok (Some chosen))))
                                      (selection/Continue [chosen]
                                                          (set! prior
                                                                (Some chosen)))
                                      (selection/Conflict [first next]
                                                          (break
                                                            :done
                                                              (Err (Ambiguous first
                                                                              next))))))))))))))
        (Ok prior))))
