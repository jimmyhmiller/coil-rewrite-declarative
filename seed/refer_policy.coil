;;; Import referring is one policy over declared fields, shared by its consumers.
(module rewrite.referpolicy)
(import "rewrite.schema" :use *)
(import "rewrite.contextpolicy" :use [find-node])
(import "rewrite.protocol" :use [name?])
(import "rewrite.resolve" :use [indexed!])
(import "rewrite.emit" :use [number!])
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.str" :use [StrBuf])

(defn field-index [(schema (ptr Schema)) (node i64) (name (ptr Sexp))]
  (-> (Result i64 Diag))
  (block :done
    (unless (sexp-sym? name)
      (break :done (Err (problem name "expected refer field name"))))
    (let [n (elem (field schema nodes) node)]
      (when (.sum? n)
        (break :done (Err (problem name "refer policy fields need records"))))
      (let [fields (field (elem (field n variants) 0) fields)]
        (for [i 0 (len (load fields))]
          (when (sexp-sym-is name (.name (elem fields i))) (break :done (Ok i))))))
    (Err (problem name "unknown refer field"))))

(defn record-field [(schema (ptr Schema)) (node i64) (index i64)]
  (-> (ptr Field))
  (elem (field (elem (field (elem (field schema nodes) node) variants) 0)
               fields)
        index))

(defn checked-field [(schema (ptr Schema))
                     (node i64)
                     (term (ptr Sexp))
                     (kind (slice u8))]
  (-> (Result i64 Diag))
  (match (field-index schema node term)
    (Err [e] (Err e))
    (Ok [f]
        (let [field (record-field schema node f)]
          (if (and (not (.many? field)) (= (.type-name field) kind))
              (Ok f)
              (Err (problem term "refer field has wrong scalar type")))))))

(defn emit [(a (dyn Allocator))
            (schema (ptr Schema))
            (forms (ptr (ArrayList Sexp)))]
  (-> (Result (slice u8) Diag))
  (block
    :done
      (let [(mut b) (StrBuf::new a)
            (mut names) (ArrayList::new [(slice u8)] a)]
        (for [i 0 (len (load forms))]
          (let [form (elem forms i)]
            (when (and (sexp-list? form)
                       (> (sexp-count form) 0)
                       (sexp-sym-is (sexp-nth form 0) "refer-policy"))
              (unless (and (= (sexp-count form) 6)
                           (sexp-sym? (sexp-nth form 1))
                           (name? (sexp-sym (sexp-nth form 1)))
                           (sexp-sym? (sexp-nth form 2)))
                (break
                  :done
                    (Err (problem form
                                  "expected (refer-policy Name Record (selection all names text) (exclude names text) (rename names from to))"))))
              (let [name (sexp-sym (sexp-nth form 1))
                    n (find-node schema (sexp-sym (sexp-nth form 2)))
                    selection (sexp-nth form 3)
                    exclusion (sexp-nth form 4)
                    renaming (sexp-nth form 5)]
                (for prior names
                  (when (= prior name)
                    (break :done (Err (problem form "duplicate refer policy")))))
                (push! (mut names) name)
                (when (< n 0)
                  (break :done (Err (problem form "unknown refer record"))))
                (unless (and (sexp-list? selection)
                             (= (sexp-count selection) 4)
                             (sexp-sym-is (sexp-nth selection 0) "selection")
                             (sexp-list? exclusion)
                             (= (sexp-count exclusion) 3)
                             (sexp-sym-is (sexp-nth exclusion 0) "exclude")
                             (sexp-list? renaming)
                             (= (sexp-count renaming) 4)
                             (sexp-sym-is (sexp-nth renaming 0) "rename"))
                  (break
                    :done
                      (Err (problem form
                                    "expected selection, exclude and rename clauses"))))
                (let [all
                        (match (checked-field schema
                                              n
                                              (sexp-nth selection 1)
                                              "Bool")
                          (Ok [f] f)
                          (Err [e] (break :done (Err e))))]
                  (when (= (len names) 1)
                    (push-str! (mut b) "(import \"rewrite.refer\" :as refer)\n"))
                  (push-str! (mut b) "(defn refer-")
                  (push-str! (mut b) name)
                  (indexed! (mut b)
                            " [(a (dyn Allocator)) (store (ptr Store)) (root N"
                            n
                            "Id)] (-> (Result refer/Policy refer/Error)) (block :done (let [row (match (lookup-")
                  (indexed! (mut b) "" n " (field store rows")
                  (indexed! (mut b)
                            ""
                            n
                            ") root) (Some [row] row) (None [] (break :done (Err (refer/InvalidRow ")
                  (number! (mut b) n)
                  (push-str! (mut b)
                             " (.index root)))))) (mut policy) (refer/create a) (mut complete?) false] (defer (unless complete? (refer/release! (mut policy)))) (set! (.all? policy) (.f")
                  (indexed! (mut b) "" all " row)) ")
                  ; Processing order is policy semantics, independent of storage layout.
                  (for [clause 0 3]
                    (let [spec
                            (cond (= clause 0) renaming
                                  (= clause 1) exclusion
                                  :else selection)
                          list-pos (if (= clause 2) 2 1)
                          field-pos (+ list-pos 1)
                          f
                            (match (field-index schema
                                                n
                                                (sexp-nth spec list-pos))
                              (Ok [f] f)
                              (Err [e] (break :done (Err e))))
                          field (record-field schema n f)
                          target (find-node schema (.type-name field))]
                      (unless (and (.many? field) (>= target 0))
                        (break
                          :done
                            (Err (problem spec
                                          "refer collections must contain records"))))
                      (let [first
                              (match (checked-field schema
                                                    target
                                                    (sexp-nth spec field-pos)
                                                    "Text")
                                (Ok [f] f)
                                (Err [e] (break :done (Err e))))
                            second
                              (if (= clause 0)
                                  (match (checked-field schema
                                                        target
                                                        (sexp-nth spec
                                                                  (+ field-pos
                                                                     1))
                                                        "Text")
                                    (Ok [f] f)
                                    (Err [e] (break :done (Err e))))
                                  0)]
                        (indexed! (mut b)
                                  "(let [(mut ids) (ArrayList::new [N"
                                  target
                                  "Id] a)] (defer (free! (mut ids))) (match (sequence-materialize-")
                        (indexed! (mut b) "" target " a store (.f")
                        (indexed! (mut b)
                                  ""
                                  f
                                  " row) (mut ids)) (Err [e] (break :done (Err (refer/InvalidSequence ")
                        (indexed! (mut b)
                                  ""
                                  target
                                  " e)))) (Ok [_])) (for id ids (let [entry (match (lookup-")
                        (indexed! (mut b) "" target " (field store rows")
                        (indexed! (mut b)
                                  ""
                                  target
                                  ") id) (Some [row] row) (None [] (break :done (Err (refer/InvalidRow ")
                        (indexed! (mut b)
                                  ""
                                  target
                                  " (.index id))))))] (refer/")
                        (push-str! (mut b)
                                   (cond (= clause 0) "rename!"
                                         (= clause 1) "exclude!"
                                         :else "select!"))
                        (indexed! (mut b) " (mut policy) (.f" first " entry)")
                        (when (= clause 0)
                          (indexed! (mut b) " (.f" second " entry)"))
                        (push-str! (mut b) ")))) "))))
                  (push-str! (mut b) "(set! complete? true) (Ok policy))))\n"))))))
        (Ok (str (load b))))))
