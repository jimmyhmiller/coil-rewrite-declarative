;;; Initial finite typing judgments: exhaustive cases and recursive premises.
(module rewrite.judgment)
(import "rewrite.schema" :use *)
(import "rewrite.binding" :as binding)
(import "rewrite.emit" :use [number!])
(import "rewrite.readers" :use [quoted!])
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.str" :use *)

(defn tag [(name (slice u8))] (-> i64)
  (cond (= name "Int") 1 (= name "Bool") 2 (= name "Text") 3 :else 0))

(defn variable? [(name (slice u8))] (-> bool)
  (and (> (len name) 1) (= (get name 0) (: 63 u8))))

;;; Categories describe expressions, independently of their canonical types.
(defn qualified? [(term (ptr Sexp))] (-> bool)
  (and (sexp-list? term)
       (> (sexp-count term) 0)
       (sexp-sym-is (sexp-nth term 0) "in")))

(defn expected-type [(term (ptr Sexp))] (-> (ptr Sexp))
  (if (and (qualified? term) (= (sexp-count term) 3)) (sexp-nth term 2) term))

(defn validate-category [(term (ptr Sexp))] (-> (Result i64 Diag))
  (block :done
    (when (qualified? term)
      (unless (and (= (sexp-count term) 3)
                   (sexp-vec? (sexp-nth term 1))
                   (> (sexp-count (sexp-nth term 1)) 0))
        (break :done (Err (problem term "expected (in [Category ...] Type)"))))
      (let [categories (sexp-nth term 1)]
        (for [i 0 (sexp-count categories)]
          (unless (sexp-sym? (sexp-nth categories i))
            (break
              :done
                (Err (problem (sexp-nth categories i)
                              "category must be a symbol"))))
          (for [j 0 i]
            (when (sexp-sym-is (sexp-nth categories j)
                               (sexp-sym (sexp-nth categories i)))
              (break
                :done (Err (problem categories "duplicate accepted category"))))))))
    (Ok 0)))

(defn match-category! [(b (mut StrBuf))
                       (expected (ptr Sexp))
                       (premise (ptr Sexp))
                       (field i64)] (-> void)
  (push-str! (mut b) "(unless ")
  (if (qualified? expected)
      (let [categories (sexp-nth expected 1)]
        (push-str! (mut b) "(or false ")
        (for [i 0 (sexp-count categories)]
          (push-str! (mut b) "(= category ")
          (quoted! (mut b) (sexp-sym (sexp-nth categories i)))
          (push-str! (mut b) ") "))
        (push-str! (mut b) ")"))
      (push-str! (mut b) "(= category \"value\")"))
  (push-str! (mut b) " (break :rule (CategoryMismatch (.index f")
  (number! (mut b) field)
  (push-str! (mut b) ") category ")
  (number! (mut b) (.lo premise))
  (push-str! (mut b) " ")
  (number! (mut b) (.hi premise))
  (push-str! (mut b) "))) "))

(defn parameter-count [(term (ptr Sexp))] (-> i64)
  (let [parameters (sexp-nth term 1)]
    (if (sexp-vec? parameters) (sexp-count parameters) 1)))

(defn parameter [(term (ptr Sexp)) (index i64)] (-> (ptr Sexp))
  (let [parameters (sexp-nth term 1)]
    (if (sexp-vec? parameters) (sexp-nth parameters index) parameters)))

(defn occurrence [(term (ptr Sexp)) (name (slice u8))] (-> i64)
  (if (sexp-sym-is term name)
      (.lo term)
      (block :found
        (when (and (sexp-list? term)
                   (= (sexp-count term) 3)
                   (sexp-sym-is (sexp-nth term 0) "Fn"))
          (for [i 0 (parameter-count term)]
            (let [found (occurrence (parameter term i) name)]
              (when (>= found 0) (break :found found))))
          (let [found (occurrence (sexp-nth term 2) name)]
            (when (>= found 0) (break :found found))))
        (- 0 1))))

(defn binding-slot [(rule (ptr Sexp)) (name (slice u8))] (-> i64)
  (block :found
    (for [p 2 (sexp-count rule)]
      (let [premise (sexp-nth rule p)]
        (when (and (sexp-list? premise) (>= (sexp-count premise) 2))
          (let [found (occurrence (expected-type (sexp-nth premise 1)) name)]
            (when (>= found 0) (break :found found))))))
    (- 0 1)))

(defn binding-index [(rule (ptr Sexp)) (name (slice u8))] (-> i64)
  (block :found
    (for [p 2 (sexp-count rule)]
      (let [premise (sexp-nth rule p)]
        (when (and (sexp-list? premise)
                   (or (= (sexp-count premise) 2) (= (sexp-count premise) 3))
                   (>= (occurrence (expected-type (sexp-nth premise 1)) name) 0))
          (break :found p))))
    (- 0 1)))

(defn type-expression! [(b (mut StrBuf)) (rule (ptr Sexp)) (name (slice u8))]
  (-> void)
  (if (variable? name)
      (do (push-str! (mut b) "t") (number! (mut b) (binding-slot rule name)))
      (number! (mut b) (tag name))))

(defn validate-term [(term (ptr Sexp)) (rule (ptr Sexp))] (-> (Result i64 Diag))
  (if (sexp-sym? term)
      (cond (scalar? (sexp-sym term)) (Ok 0)
            (variable? (sexp-sym term))
              (if (>= (binding-index rule (sexp-sym term)) 2)
                  (Ok 0)
                  (Err (problem term "unbound result type variable")))
            :else (Err (problem term "unknown judgment result type")))
      (if (and (sexp-list? term)
               (= (sexp-count term) 3)
               (sexp-sym-is (sexp-nth term 0) "Fn"))
          (block :done
            (for [i 0 (parameter-count term)]
              (match (validate-term (parameter term i) rule)
                (Err [d] (break :done (Err d)))
                (Ok [_])))
            (validate-term (sexp-nth term 2) rule))
          (Err (problem term "expected (Fn Argument Result) type")))))

(defn emit-term! [(b (mut StrBuf)) (rule (ptr Sexp)) (term (ptr Sexp))]
  (-> void)
  (if (sexp-sym? term)
      (type-expression! (mut b) rule (sexp-sym term))
      (let [count (parameter-count term)]
        (when (> count 1)
          (push-str! (mut b)
                     "(let [(mut arguments) (ArrayList::new [i64] (.allocator type-store))] (defer (free! (mut arguments))) ")
          (for [i 0 count]
            (push-str! (mut b) "(push! (mut arguments) ")
            (emit-term! (mut b) rule (parameter term i))
            (push-str! (mut b) ") ")))
        (if (= count 1)
            (do
              (push-str! (mut b) "(match (types/function (mut type-store) ")
              (emit-term! (mut b) rule (parameter term 0))
              (push-str! (mut b) " "))
            (do
              (push-str! (mut b) "(match (types/signature (mut type-store) ")
              (push-str! (mut b)
                         (if (= count 0)
                             "(zeroed (slice i64)) "
                             "(slice arguments) "))))
        (emit-term! (mut b) rule (sexp-nth term 2))
        (push-str! (mut b)
                   ") (Ok [ty] ty) (Err [error] (break :rule (TypeConstruction error))))")
        (when (> count 1) (push-str! (mut b) ")")))))

(defn declare-pattern! [(b (mut StrBuf)) (rule (ptr Sexp)) (term (ptr Sexp))]
  (-> void)
  (if (sexp-sym? term)
      (when (and (variable? (sexp-sym term))
                 (= (binding-slot rule (sexp-sym term)) (.lo term)))
        (push-str! (mut b) "(mut t")
        (number! (mut b) (.lo term))
        (push-str! (mut b) ") 0 "))
      (when (and (sexp-list? term)
                 (= (sexp-count term) 3)
                 (sexp-sym-is (sexp-nth term 0) "Fn"))
        (for [i 0 (parameter-count term)]
          (declare-pattern! (mut b) rule (parameter term i)))
        (declare-pattern! (mut b) rule (sexp-nth term 2)))))

(defn match-type! [(b (mut StrBuf))
                   (rule (ptr Sexp))
                   (term (ptr Sexp))
                   (premise (ptr Sexp))
                   (field i64)] (-> void)
  (if (sexp-sym? term)
      (do
        (when (and (variable? (sexp-sym term))
                   (= (binding-slot rule (sexp-sym term)) (.lo term)))
          (push-str! (mut b) "(set! t")
          (number! (mut b) (.lo term))
          (push-str! (mut b) " actual) "))
        (push-str! (mut b) "(unless (= actual ")
        (type-expression! (mut b) rule (sexp-sym term))
        (push-str! (mut b) ") (break :rule (Mismatch (.index f")
        (number! (mut b) field)
        (push-str! (mut b) ") ")
        (number! (mut b) field)
        (push-str! (mut b) " ")
        (type-expression! (mut b) rule (sexp-sym term))
        (push-str! (mut b) " actual ")
        (number! (mut b) (.lo premise))
        (push-str! (mut b) " ")
        (number! (mut b) (.hi premise))
        (push-str! (mut b) "))) "))
      (do
        (push-str! (mut b)
                   "(match (types/as-signature type-store actual) (None [] (break :rule (ExpectedFunction (.index f")
        (number! (mut b) field)
        (push-str! (mut b) ") actual))) (Some [parts] (do ")
        (push-str! (mut b) "(unless (= (len (.arguments parts)) ")
        (number! (mut b) (parameter-count term))
        (push-str! (mut b) ") (break :rule (FunctionArity (.index f")
        (number! (mut b) field)
        (push-str! (mut b) ") ")
        (number! (mut b) (parameter-count term))
        (push-str! (mut b) " (len (.arguments parts))))) ")
        (for [i 0 (parameter-count term)]
          (push-str! (mut b) "(let [actual (get (.arguments parts) ")
          (number! (mut b) i)
          (push-str! (mut b) ")] ")
          (match-type! (mut b) rule (parameter term i) premise field)
          (push-str! (mut b) ") "))
        (push-str! (mut b) "(let [actual (.result parts)] ")
        (match-type! (mut b) rule (sexp-nth term 2) premise field)
        (push-str! (mut b) ")))) "))))

(defn scope! [(b (mut StrBuf))
              (bindings (ptr binding/Bindings))
              (node i64)
              (variant i64)
              (field i64)
              (rule (ptr Sexp))
              (premise (ptr Sexp))
              (p i64)] (-> (Result i64 Diag))
  (block
    :done
      (let [names
              (match (binding/child-scope bindings node variant field)
                (Some [scope] (.names scope))
                (None [] (zeroed (ArrayList i64))))
            count (len names)]
        (unless (if (= count 0)
                    (= (sexp-count premise) 2)
                    (and (= (sexp-count premise) 3)
                         (sexp-list? (sexp-nth premise 2))
                         (sexp-sym-is (sexp-nth (sexp-nth premise 2) 0) "with")
                         (= (sexp-count (sexp-nth premise 2)) (+ count 1))))
          (break
            :done
              (Err (problem premise
                            "scope payloads must match declared bindings: (with Types...)"))))
        (push-str! (mut b) "(let [")
        (for [i 0 count]
          (let [ty (sexp-nth (sexp-nth premise 2) (+ i 1))]
            (unless (and (sexp-sym? ty)
                         (or (scalar? (sexp-sym ty))
                             (and (variable? (sexp-sym ty))
                                  (>= (binding-index rule (sexp-sym ty)) 2)
                                  (< (binding-index rule (sexp-sym ty)) p))))
              (break
                :done
                  (Err (problem ty
                                "binding type must be known before this premise"))))
            (push-str! (mut b) "(mut scope")
            (unless (= i (- count 1)) (number! (mut b) i))
            (push-str! (mut b) ") (scope-bind ")
            (if (= i 0)
                (push-str! (mut b) "context")
                (do
                  (push-str! (mut b) "(mut scope")
                  (number! (mut b) (- i 1))
                  (push-str! (mut b) ")")))
            (push-str! (mut b) " f")
            (number! (mut b) (get names i))
            (push-str! (mut b) " (TypeBinding :type ")
            (type-expression! (mut b) rule (sexp-sym ty))
            (push-str! (mut b) " :category \"value\")) ")))
        (Ok count))))

(defn compile-rule [(b (mut StrBuf))
                    (n (ptr Node))
                    (bindings (ptr binding/Bindings))
                    (ni i64)
                    (vi i64)
                    (rule (ptr Sexp))] (-> (Result i64 Diag))
  (block :done
    (unless (and (sexp-list? rule) (>= (sexp-count rule) 2))
      (break :done (Err (problem rule "expected (Variant Result premises...)"))))
    (let [result-form (sexp-nth rule 1)
          categorized?
            (and (sexp-list? result-form)
                 (> (sexp-count result-form) 0)
                 (sexp-sym-is (sexp-nth result-form 0) "as"))
          result
            (if (and categorized? (= (sexp-count result-form) 3))
                (sexp-nth result-form 2)
                result-form)
          v (elem (field n variants) vi)
          lookup?
            (and (sexp-list? result)
                 (= (sexp-count result) 1)
                 (sexp-sym-is (sexp-nth result 0) "lookup"))]
      (unless (= lookup? (>= (binding/reference bindings ni vi) 0))
        (break
          :done
            (Err (problem rule
                          "judgment lookup must match the declared reference"))))
      (for scope (.scopes bindings)
        (when (and (= (.node scope) ni) (= (.variant scope) vi))
          (let [(mut uses) 0
                name (.name (elem (field v fields) (.child scope)))]
            (for [p 2 (sexp-count rule)]
              (when (and (sexp-list? (sexp-nth rule p))
                         (> (sexp-count (sexp-nth rule p)) 0)
                         (sexp-sym-is (sexp-nth (sexp-nth rule p) 0) name))
                (set! uses (+ uses 1))))
            (unless (= uses 1)
              (break
                :done
                  (Err (problem rule
                                "judgment must check each declared scoped child once")))))))
      (when categorized?
        (unless (and (= (sexp-count result-form) 3)
                     (sexp-sym? (sexp-nth result-form 1))
                     (not lookup?))
          (break
            :done
              (Err (problem result-form "expected (as Category Type) result")))))
      (for [p 2 (sexp-count rule)]
        (let [premise (sexp-nth rule p)]
          (unless (and (sexp-list? premise)
                       (or (= (sexp-count premise) 2)
                           (= (sexp-count premise) 3)))
            (break :done (Err (problem premise "expected child premise"))))
          (match (validate-category (sexp-nth premise 1))
            (Err [d] (break :done (Err d)))
            (Ok [_]))
          (match (validate-term (expected-type (sexp-nth premise 1)) rule)
            (Err [d] (break :done (Err d)))
            (Ok [_] 0))))
      (unless lookup?
        (match (validate-term result rule)
          (Err [d] (break :done (Err d)))
          (Ok [_] 0)))
      (push-str! (mut b) "(N")
      (number! (mut b) ni)
      (push-str! (mut b) "V")
      (number! (mut b) vi)
      (push-str! (mut b) " [")
      (for [i 0 (len (.fields v))] (push-str! (mut b) " f") (number! (mut b) i))
      (push-str! (mut b) "] (block :rule (let [")
      (for [p 2 (sexp-count rule)]
        (let [premise (sexp-nth rule p)]
          (when (and (sexp-list? premise) (>= (sexp-count premise) 2))
            (declare-pattern! (mut b) rule (expected-type (sexp-nth premise 1))))))
      (push-str! (mut b) "] ")
      (for [p 2 (sexp-count rule)]
        (let [premise (sexp-nth rule p)]
          (unless (and (sexp-list? premise)
                       (or (= (sexp-count premise) 2)
                           (= (sexp-count premise) 3)))
            (break
              :done
                (Err (problem premise "expected (child-field ExpectedType)"))))
          (let [field-name (sexp-nth premise 0)
                expected (sexp-nth premise 1)
                (mut found) false]
            (unless (sexp-sym? field-name)
              (break
                :done
                  (Err (problem field-name "premise field must be a symbol"))))
            (match (validate-term (expected-type expected) rule)
              (Err [d] (break :done (Err d)))
              (Ok [_] 0))
            (for [f 0 (len (.fields v))]
              (let [field (elem (field v fields) f)]
                (when (= (.name field) (sexp-sym field-name))
                  (set! found true)
                  (unless (and (not (.many? field))
                               (= (.type-name field) (.name n)))
                    (break
                      :done
                        (Err (problem field-name
                                      "premise field must reference the judged sum"))))
                  (match (scope! (mut b) bindings ni vi f rule premise p)
                    (Err [d] (break :done (Err d)))
                    (Ok [_] 0))
                  (push-str! (mut b) "answer (judge-worker-")
                  (number! (mut b) ni)
                  (push-str! (mut b) " (mut type-store) rows f")
                  (number! (mut b) f)
                  (push-str! (mut b)
                             " (- fuel 1) ")
                  (push-str! (mut b)
                             (if (= (sexp-count premise) 3)
                                 "(mut scope)"
                                 "context"))
                  (push-str! (mut b)
                             ") actual (match answer (Typed [ty] ty) (Classified [ty _] ty) (_ (break :rule answer))) category (match answer (Typed [_] \"value\") (Classified [_ category] category) (_ (break :rule answer)))] ")
                  (match-category! (mut b) expected premise f)
                  (match-type! (mut b) rule (expected-type expected) premise f)
                  (push-str! (mut b) ") "))))
            (unless found
              (break :done (Err (problem field-name "unknown premise field")))))))
      (if lookup?
          (let [index (binding/reference bindings ni vi)]
            (push-str! (mut b) "(context-lookup context f")
            (number! (mut b) index)
            (push-str! (mut b) " (.index id))"))
          (do
            (push-str! (mut b) (if categorized? "(classify " "(Typed "))
            (emit-term! (mut b) rule result)
            (when categorized?
              (push-str! (mut b) " ")
              (quoted! (mut b) (sexp-sym (sexp-nth result-form 1))))
            (push-str! (mut b) ")")))
      (push-str! (mut b) ")))\n")
      (Ok 0))))

(defn compile-one [(a (dyn Allocator))
                   (s (ptr Schema))
                   (bindings (ptr binding/Bindings))
                   (form (ptr Sexp))]
  (-> (Result (slice u8) Diag))
  (block :done
    (unless (>= (sexp-count form) 2)
      (break :done (Err (problem form "judgment requires a sum name"))))
    (let [name (sexp-nth form 1)
          (mut ni) (- 0 1)
          (mut b) (StrBuf::new a)]
      (unless (sexp-sym? name)
        (break :done (Err (problem name "judgment requires a sum name"))))
      (for [i 0 (len (.nodes s))]
        (when (= (.name (elem (field s nodes) i)) (sexp-sym name)) (set! ni i)))
      (when (< ni 0) (break :done (Err (problem name "unknown judged sum"))))
      (let [n (elem (field s nodes) ni)]
        (unless (.sum? n)
          (break :done (Err (problem name "judgment requires a sum"))))
        (push-str! (mut b) "(defn judge-worker-")
        (number! (mut b) ni)
        (push-str! (mut b)
                   " [(type-store (mut types/Types)) (rows (ptr (ArrayList N")
        (number! (mut b) ni)
        (push-str! (mut b) "Row))) (id N")
        (number! (mut b) ni)
        (push-str! (mut b)
                   "Id) (fuel i64) (context (ptr (Scope TypeBinding)))] (-> Judgment) (match (lookup-")
        (number! (mut b) ni)
        (push-str! (mut b)
                   " rows id) (None [] (InvalidReference (.index id))) (Some [row] (if (<= fuel 0) (CyclicInput (.index id)) (match row ")
        (for [v 0 (len (.variants n))]
          (let [(mut matches) 0]
            (for [r 2 (sexp-count form)]
              (let [rule (sexp-nth form r)]
                (unless (and (sexp-list? rule) (>= (sexp-count rule) 2))
                  (break :done (Err (problem rule "expected variant rule"))))
                (when (sexp-sym-is (sexp-nth rule 0)
                                   (.name (elem (field n variants) v)))
                  (set! matches (+ matches 1))
                  (match (compile-rule (mut b) n bindings ni v rule)
                    (Err [d] (break :done (Err d)))
                    (Ok [_] 0)))))
            (unless (= matches 1)
              (break
                :done
                  (Err (problem form "each variant requires exactly one rule"))))))
        (unless (= (- (sexp-count form) 2) (len (.variants n)))
          (break :done (Err (problem form "unknown or extra variant rule"))))
        (push-str! (mut b) ")))))\n(defn judge-")
        (number! (mut b) ni)
        (push-str! (mut b)
                   " [(type-store (mut types/Types)) (rows (ptr (ArrayList N")
        (number! (mut b) ni)
        (push-str! (mut b) "Row))) (id N")
        (number! (mut b) ni)
        (push-str! (mut b)
                   "Id)] (-> Judgment) (let [(mut context) (zeroed (Scope TypeBinding))] (judge-worker-")
        (number! (mut b) ni)
        (push-str! (mut b)
                   " (mut type-store) rows id (len (load rows)) (mut context))))\n")
        (Ok (str (load b)))))))
