;;; Initial finite typing judgments: exhaustive cases and recursive premises.
(module rewrite.judgment)
(import "rewrite.schema" :use *)
(import "rewrite.emit" :use [number!])
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.str" :use *)

(defn tag [(name (slice u8))] (-> i64)
  (cond (= name "Int") 1 (= name "Bool") 2 (= name "Text") 3 :else 0))

(defn variable? [(name (slice u8))] (-> bool)
  (and (> (len name) 1) (= (get name 0) (: 63 u8))))

(defn occurrence [(term (ptr Sexp)) (name (slice u8))] (-> i64)
  (if (sexp-sym-is term name)
      (.lo term)
      (block :found
        (when (and (sexp-list? term)
                   (= (sexp-count term) 3)
                   (sexp-sym-is (sexp-nth term 0) "Fn"))
          (for [i 1 3]
            (let [found (occurrence (sexp-nth term i) name)]
              (when (>= found 0) (break :found found)))))
        (- 0 1))))

(defn binding-slot [(rule (ptr Sexp)) (name (slice u8))] (-> i64)
  (block :found
    (for [p 2 (sexp-count rule)]
      (let [premise (sexp-nth rule p)]
        (when (and (sexp-list? premise) (>= (sexp-count premise) 2))
          (let [found (occurrence (sexp-nth premise 1) name)]
            (when (>= found 0) (break :found found))))))
    (- 0 1)))

(defn binding-index [(rule (ptr Sexp)) (name (slice u8))] (-> i64)
  (block :found
    (for [p 2 (sexp-count rule)]
      (let [premise (sexp-nth rule p)]
        (when (and (sexp-list? premise)
                   (or (= (sexp-count premise) 2) (= (sexp-count premise) 3))
                   (>= (occurrence (sexp-nth premise 1) name) 0))
          (break :found p))))
    (- 0 1)))

(defn type-expression! [(b (mut StrBuf)) (rule (ptr Sexp)) (name (slice u8))]
  (-> void)
  (if (variable? name)
      (do (push-str! (mut b) "t") (number! (mut b) (binding-slot rule name)))
      (number! (mut b) (tag name))))

(defn validate-term [(term (ptr Sexp)) (rule (ptr Sexp))] (-> (Result i64 Diag))
  (if (sexp-sym? term)
      (cond (scalar? (sexp-sym term)) (Ok 0)
            (variable? (sexp-sym term))
              (if (>= (binding-index rule (sexp-sym term)) 2)
                  (Ok 0)
                  (Err (problem term "unbound result type variable")))
            :else (Err (problem term "unknown judgment result type")))
      (if (and (sexp-list? term)
               (= (sexp-count term) 3)
               (sexp-sym-is (sexp-nth term 0) "Fn"))
          (match (validate-term (sexp-nth term 1) rule)
            (Err [d] (Err d))
            (Ok [_] (validate-term (sexp-nth term 2) rule)))
          (Err (problem term "expected (Fn Argument Result) type")))))

(defn emit-term! [(b (mut StrBuf)) (rule (ptr Sexp)) (term (ptr Sexp))]
  (-> void)
  (if (sexp-sym? term)
      (type-expression! (mut b) rule (sexp-sym term))
      (do
        (push-str! (mut b) "(match (types/function (mut type-store) ")
        (emit-term! (mut b) rule (sexp-nth term 1))
        (push-str! (mut b) " ")
        (emit-term! (mut b) rule (sexp-nth term 2))
        (push-str! (mut b)
                   ") (Ok [ty] ty) (Err [error] (break :rule (TypeConstruction error))))"))))

(defn declare-pattern! [(b (mut StrBuf)) (rule (ptr Sexp)) (term (ptr Sexp))]
  (-> void)
  (if (sexp-sym? term)
      (when (and (variable? (sexp-sym term))
                 (= (binding-slot rule (sexp-sym term)) (.lo term)))
        (push-str! (mut b) "(mut t")
        (number! (mut b) (.lo term))
        (push-str! (mut b) ") 0 "))
      (when (and (sexp-list? term)
                 (= (sexp-count term) 3)
                 (sexp-sym-is (sexp-nth term 0) "Fn"))
        (declare-pattern! (mut b) rule (sexp-nth term 1))
        (declare-pattern! (mut b) rule (sexp-nth term 2)))))

(defn match-type! [(b (mut StrBuf))
                   (rule (ptr Sexp))
                   (term (ptr Sexp))
                   (premise (ptr Sexp))
                   (field i64)] (-> void)
  (if (sexp-sym? term)
      (do
        (when (and (variable? (sexp-sym term))
                   (= (binding-slot rule (sexp-sym term)) (.lo term)))
          (push-str! (mut b) "(set! t")
          (number! (mut b) (.lo term))
          (push-str! (mut b) " actual) "))
        (push-str! (mut b) "(unless (= actual ")
        (type-expression! (mut b) rule (sexp-sym term))
        (push-str! (mut b) ") (break :rule (Mismatch (.index f")
        (number! (mut b) field)
        (push-str! (mut b) ") ")
        (number! (mut b) field)
        (push-str! (mut b) " ")
        (type-expression! (mut b) rule (sexp-sym term))
        (push-str! (mut b) " actual ")
        (number! (mut b) (.lo premise))
        (push-str! (mut b) " ")
        (number! (mut b) (.hi premise))
        (push-str! (mut b) "))) "))
      (do
        (push-str! (mut b)
                   "(match (types/as-function type-store actual) (None [] (break :rule (ExpectedFunction (.index f")
        (number! (mut b) field)
        (push-str! (mut b) ") actual))) (Some [parts] (do ")
        (push-str! (mut b) "(let [actual (.argument parts)] ")
        (match-type! (mut b) rule (sexp-nth term 1) premise field)
        (push-str! (mut b) ") ")
        (push-str! (mut b) "(let [actual (.result parts)] ")
        (match-type! (mut b) rule (sexp-nth term 2) premise field)
        (push-str! (mut b) ")))) "))))

(defn text-field [(v (ptr Variant)) (name (ptr Sexp))] (-> i64)
  (block :found
    (for [i 0 (len (.fields v))]
      (let [f (elem (field v fields) i)]
        (when (and (sexp-sym-is name (.name f)) (= (.type-name f) "Text"))
          (break :found i))))
    (- 0 1)))

(defn scope! [(b (mut StrBuf))
              (v (ptr Variant))
              (rule (ptr Sexp))
              (premise (ptr Sexp))
              (p i64)] (-> (Result i64 Diag))
  (block
    :done
      (if (= (sexp-count premise) 2)
          (do (push-str! (mut b) "(let [") (Ok 0))
          (let [binding (sexp-nth premise 2)]
            (unless (and (sexp-list? binding)
                         (= (sexp-count binding) 3)
                         (sexp-sym-is (sexp-nth binding 0) "bind"))
              (break
                :done (Err (problem binding "expected (bind name-field Type)"))))
            (let [name (sexp-nth binding 1)
                  ty (sexp-nth binding 2)
                  index (text-field v name)]
              (when (< index 0)
                (break
                  :done (Err (problem name "binding requires a Text field"))))
              (unless (and (sexp-sym? ty)
                           (or (scalar? (sexp-sym ty))
                               (and (variable? (sexp-sym ty))
                                    (>= (binding-index rule (sexp-sym ty)) 2)
                                    (< (binding-index rule (sexp-sym ty)) p))))
                (break
                  :done
                    (Err (problem ty
                                  "binding type must be known before this premise"))))
              (push-str! (mut b)
                         "(let [(mut scope) (scope-bind context f")
              (number! (mut b) index)
              (push-str! (mut b) " ")
              (type-expression! (mut b) rule (sexp-sym ty))
              (push-str! (mut b) ") ")
              (Ok 0))))))

(defn compile-rule [(b (mut StrBuf))
                    (n (ptr Node))
                    (ni i64)
                    (vi i64)
                    (rule (ptr Sexp))] (-> (Result i64 Diag))
  (block :done
    (unless (and (sexp-list? rule) (>= (sexp-count rule) 2))
      (break :done (Err (problem rule "expected (Variant Result premises...)"))))
    (let [result (sexp-nth rule 1)
          v (elem (field n variants) vi)
          lookup?
            (and (sexp-list? result)
                 (= (sexp-count result) 2)
                 (sexp-sym-is (sexp-nth result 0) "lookup"))]
      (for [p 2 (sexp-count rule)]
        (let [premise (sexp-nth rule p)]
          (unless (and (sexp-list? premise)
                       (or (= (sexp-count premise) 2)
                           (= (sexp-count premise) 3)))
            (break :done (Err (problem premise "expected child premise"))))
          (match (validate-term (sexp-nth premise 1) rule)
            (Err [d] (break :done (Err d)))
            (Ok [_] 0))))
      (unless lookup?
        (match (validate-term result rule)
          (Err [d] (break :done (Err d)))
          (Ok [_] 0)))
      (push-str! (mut b) "(N")
      (number! (mut b) ni)
      (push-str! (mut b) "V")
      (number! (mut b) vi)
      (push-str! (mut b) " [")
      (for [i 0 (len (.fields v))] (push-str! (mut b) " f") (number! (mut b) i))
      (push-str! (mut b) "] (block :rule (let [")
      (for [p 2 (sexp-count rule)]
        (let [premise (sexp-nth rule p)]
          (when (and (sexp-list? premise) (>= (sexp-count premise) 2))
            (declare-pattern! (mut b) rule (sexp-nth premise 1)))))
      (push-str! (mut b) "] ")
      (for [p 2 (sexp-count rule)]
        (let [premise (sexp-nth rule p)]
          (unless (and (sexp-list? premise)
                       (or (= (sexp-count premise) 2)
                           (= (sexp-count premise) 3)))
            (break
              :done
                (Err (problem premise "expected (child-field ExpectedType)"))))
          (let [field-name (sexp-nth premise 0)
                expected (sexp-nth premise 1)
                (mut found) false]
            (unless (sexp-sym? field-name)
              (break
                :done
                  (Err (problem field-name "premise field must be a symbol"))))
            (match (validate-term expected rule)
              (Err [d] (break :done (Err d)))
              (Ok [_] 0))
            (for [f 0 (len (.fields v))]
              (let [field (elem (field v fields) f)]
                (when (= (.name field) (sexp-sym field-name))
                  (set! found true)
                  (unless (= (.type-name field) (.name n))
                    (break
                      :done
                        (Err (problem field-name
                                      "premise field must reference the judged sum"))))
                  (match (scope! (mut b) v rule premise p)
                    (Err [d] (break :done (Err d)))
                    (Ok [_] 0))
                  (push-str! (mut b) "answer (judge-worker-")
                  (number! (mut b) ni)
                  (push-str! (mut b) " (mut type-store) rows f")
                  (number! (mut b) f)
                  (push-str! (mut b)
                             " (- fuel 1) ")
                  (push-str! (mut b)
                             (if (= (sexp-count premise) 3)
                                 "(mut scope)"
                                 "context"))
                  (push-str! (mut b) ")] (match answer (Typed [actual] (do ")
                  (match-type! (mut b) rule expected premise f)
                  (push-str! (mut b) ")) (_ (break :rule answer)))) "))))
            (unless found
              (break :done (Err (problem field-name "unknown premise field")))))))
      (if lookup?
          (let [index (text-field v (sexp-nth result 1))]
            (when (< index 0)
              (break
                :done (Err (problem result "lookup requires a Text field"))))
            (push-str! (mut b) "(context-lookup context f")
            (number! (mut b) index)
            (push-str! (mut b) " (.index id))"))
          (do
            (push-str! (mut b) "(Typed ")
            (emit-term! (mut b) rule result)
            (push-str! (mut b) ")")))
      (push-str! (mut b) ")))\n")
      (Ok 0))))

(defn compile-one [(a (dyn Allocator)) (s (ptr Schema)) (form (ptr Sexp))]
  (-> (Result (slice u8) Diag))
  (block :done
    (unless (>= (sexp-count form) 2)
      (break :done (Err (problem form "judgment requires a sum name"))))
    (let [name (sexp-nth form 1)
          (mut ni) (- 0 1)
          (mut b) (StrBuf::new a)]
      (unless (sexp-sym? name)
        (break :done (Err (problem name "judgment requires a sum name"))))
      (for [i 0 (len (.nodes s))]
        (when (= (.name (elem (field s nodes) i)) (sexp-sym name)) (set! ni i)))
      (when (< ni 0) (break :done (Err (problem name "unknown judged sum"))))
      (let [n (elem (field s nodes) ni)]
        (unless (.sum? n)
          (break :done (Err (problem name "judgment requires a sum"))))
        (push-str! (mut b) "(defn judge-worker-")
        (number! (mut b) ni)
        (push-str! (mut b)
                   " [(type-store (mut types/Types)) (rows (ptr (ArrayList N")
        (number! (mut b) ni)
        (push-str! (mut b) "Row))) (id N")
        (number! (mut b) ni)
        (push-str! (mut b)
                   "Id) (fuel i64) (context (ptr (Scope i64)))] (-> Judgment) (match (lookup-")
        (number! (mut b) ni)
        (push-str! (mut b)
                   " rows id) (None [] (InvalidReference (.index id))) (Some [row] (if (<= fuel 0) (CyclicInput (.index id)) (match row ")
        (for [v 0 (len (.variants n))]
          (let [(mut matches) 0]
            (for [r 2 (sexp-count form)]
              (let [rule (sexp-nth form r)]
                (unless (and (sexp-list? rule) (>= (sexp-count rule) 2))
                  (break :done (Err (problem rule "expected variant rule"))))
                (when (sexp-sym-is (sexp-nth rule 0)
                                   (.name (elem (field n variants) v)))
                  (set! matches (+ matches 1))
                  (match (compile-rule (mut b) n ni v rule)
                    (Err [d] (break :done (Err d)))
                    (Ok [_] 0)))))
            (unless (= matches 1)
              (break
                :done
                  (Err (problem form "each variant requires exactly one rule"))))))
        (unless (= (- (sexp-count form) 2) (len (.variants n)))
          (break :done (Err (problem form "unknown or extra variant rule"))))
        (push-str! (mut b) ")))))\n(defn judge-")
        (number! (mut b) ni)
        (push-str! (mut b)
                   " [(type-store (mut types/Types)) (rows (ptr (ArrayList N")
        (number! (mut b) ni)
        (push-str! (mut b) "Row))) (id N")
        (number! (mut b) ni)
        (push-str! (mut b)
                   "Id)] (-> Judgment) (let [(mut context) (zeroed (Scope i64))] (judge-worker-")
        (number! (mut b) ni)
        (push-str! (mut b)
                   " (mut type-store) rows id (len (load rows)) (mut context))))\n")
        (Ok (str (load b)))))))
