(module rewrite.reader)
(import "coil.primitive" :as primitive)
(import "coil.meta" :as meta)
(import "coil.reader" :use *)
(import "coil.str" :use *)
(import "coil.result" :use *)
(import "rewrite.language" :as language)

(reader-provider "rewrite.reader" read-language)

(defn fail [(path (slice u8)) (diagnostic Diag)] (-> never)
  (let [(mut message) (StrBuf::new (meta/expansion-allocator))]
    (push-str! (mut message) path)
    (push-str! (mut message) ": byte ")
    (push-i64! (mut message) (.lo diagnostic))
    (push-str! (mut message) ": ")
    (push-str! (mut message) (.msg diagnostic))
    (primitive/error (finish! (mut message)))
    (unreachable)))

(defn read-language [(context Code)] (-> Code)
  (let [a (meta/expansion-allocator)
        path (primitive/code-str (get context 1))
        text (primitive/code-str (get context 2))
        forms
          (match (read-all a text 0)
            (Ok [items] items)
            (Err [d] (fail path d)))
        output
          (match (language/compile-forms a forms)
            (Ok [source] source)
            (Err [d] (fail path d)))]
    (primitive/code-read output `(reader-config))))
