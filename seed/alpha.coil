;;; Identity-directed alpha copying is derived from lexical topology, not spellings.
(module rewrite.alpha)
(import "rewrite.schema" :use *)
(import "rewrite.binding" :as binding)
(import "rewrite.resolve" :use [indexed! node-number binder?])
(import "rewrite.emit" :use [number!])
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use *)
(import "coil.str" :use [StrBuf])

(defn case! [(b (mut StrBuf))
             (schema (ptr Schema))
             (bindings (ptr binding/Bindings))
             (n i64)
             (v i64)] (-> void)
  (let [node (elem (field schema nodes) n)
        variant (elem (field node variants) v)
        reference (binding/reference bindings n v)]
    (when (and (>= reference 0) (binder? bindings n v reference))
      (push-str! (mut b) "(break :done (Err (AlphaOverlappingRole ")
      (number! (mut b) n)
      (push-str! (mut b) " ")
      (number! (mut b) reference)
      (push-str! (mut b) "))) "))
    (push-str! (mut b) "(let [")
    (for [f 0 (len (.fields variant))]
      (let [field (elem (field variant fields) f)]
        (indexed! (mut b) "x" f " ")
        (cond (binder? bindings n v f)
                (do
                  (push-str! (mut b)
                             "(resolution/alpha-declaration (.resolved state) (field state names) occurrence ")
                  (number! (mut b) f)
                  (push-str! (mut b) ")"))
              (= reference f)
                (push-str! (mut b)
                           "(match (.target resolved) (Some [binding] (get (.names (.names state)) (.index binding))) (None [] (break :done (Err (AlphaResolutionMismatch occurrence)))))")
              (= (.type-name field) "Text")
                (indexed! (mut b) "(store-text! store f" f ")")
              (scalar? (.type-name field)) (indexed! (mut b) "f" f "")
              :else
                (let [target (node-number schema (.type-name field))]
                  (when (.many? field)
                    (indexed! (mut b)
                              "(let [(mut items) (ArrayList::new [N"
                              target
                              "Id] (.allocator (.source-data store))) count (match (sequence-size-")
                    (number! (mut b) target)
                    (indexed! (mut b)
                              " input f"
                              f
                              ") (Some [n] n) (None [] (break :done (Err (AlphaResolutionMismatch occurrence)))))] (defer (free! (mut items))) (for [i 0 count] (let [child (match (sequence-item-")
                    (number! (mut b) target)
                    (indexed! (mut b)
                              " input f"
                              f
                              " i) (Some [id] id) (None [] (break :done (Err (AlphaResolutionMismatch occurrence)))))] (push! (mut items) "))
                  (indexed! (mut b)
                            "(match (alpha-walk-"
                            target
                            " (mut state) ")
                  (if (.many? field)
                      (push-str! (mut b) "child")
                      (indexed! (mut b) "f" f ""))
                  (push-str! (mut b)
                             ") (Ok [out] out) (Err [e] (break :done (Err e))))")
                  (when (.many? field)
                    (indexed! (mut b)
                              "))) (sequence-"
                              target
                              " store (mut items)))"))))
        (push-str! (mut b) " ")))
    (indexed! (mut b) "out (append-" n " (field store rows")
    (number! (mut b) n)
    (indexed! (mut b) ") (N" n (if (.sum? node) "V" "Row"))
    (when (.sum? node) (number! (mut b) v))
    (for [f 0 (len (.fields variant))]
      (unless (.sum? node) (indexed! (mut b) " :f" f ""))
      (indexed! (mut b) " x" f ""))
    (indexed! (mut b)
              "))] (push! (field store origins"
              n
              ") origin) (set! (mut (.mapped state)) occurrence (.index out)) (Ok out))")))

(defn emit [(a (dyn Allocator))
            (schema (ptr Schema))
            (bindings (ptr binding/Bindings))] (-> (slice u8))
  (let [(mut b) (StrBuf::new a)]
    (when (or (> (len (.references bindings)) 0) (> (len (.scopes bindings)) 0))
      (push-str! (mut b)
                 "(import \"coil.primitive\" :as alpha-primitive)\n(defsum AlphaError (AlphaResolve [(error resolution/ResolveError)]) (AlphaSource [(error source/SourceError)]) (AlphaAliasedStores) (AlphaOriginMissing [(schema i64) (row i64)]) (AlphaResolutionMismatch [(occurrence i64)]) (AlphaOverlappingRole [(schema i64) (field i64)]))\n(defstruct AlphaState [(input (ptr Store)) (target (ptr Store)) (resolved (ptr resolution/Resolution)) (names resolution/AlphaNames) (cursor i64) (mapped (ArrayList i64)) (copied (HashMap i64 bool))])\n")
      (for [n 0 (len (.nodes schema))]
        (let [node (elem (field schema nodes) n)]
          (indexed! (mut b) "(defstruct Alpha" n " [(root N")
          (number! (mut b) n)
          (push-str! (mut b) "Id) (rows (ArrayList i64))])\n")
          (indexed! (mut b)
                    "(defn alpha-walk-"
                    n
                    " [(state (mut AlphaState)) (id N")
          (number! (mut b) n)
          (indexed! (mut b)
                    "Id)] (-> (Result N"
                    n
                    "Id AlphaError)) (block :done (let [input (.input state) store (.target state) occurrence (.cursor state)] (unless (< occurrence (len (.occurrences (.resolved state)))) (break :done (Err (AlphaResolutionMismatch occurrence)))) (let [resolved (get (.occurrences (.resolved state)) occurrence)] (unless (and (= (.schema resolved) ")
          (number! (mut b) n)
          (push-str! (mut b)
                     ") (= (.row resolved) (.index id))) (break :done (Err (AlphaResolutionMismatch occurrence)))) (set! (.cursor state) (+ occurrence 1)) ")
          (indexed! (mut b)
                    "(unless (< (.index id) (len (.origins"
                    n
                    " input))) (break :done (Err (AlphaOriginMissing ")
          (number! (mut b) n)
          (indexed! (mut b)
                    " (.index id))))) (let [origin (get (.origins"
                    n
                    " input) (.index id)) row (get (.rows")
          (number! (mut b) n)
          (push-str! (mut b)
                     " input) (.index id))] (match (source/transfer! (field store source-data) (field input source-data) origin (mut (.copied state))) (Ok [_]) (Err [e] (break :done (Err (AlphaSource e))))) ")
          (if (.sum? node)
              (do
                (push-str! (mut b) "(match row ")
                (for [v 0 (len (.variants node))]
                  (indexed! (mut b) "(N" n "V")
                  (number! (mut b) v)
                  (push-str! (mut b) " [")
                  (for [f 0 (len (.fields (elem (field node variants) v)))]
                    (indexed! (mut b) "f" f " "))
                  (push-str! (mut b) "] ")
                  (case! (mut b) schema bindings n v)
                  (push-str! (mut b) ")"))
                (push-str! (mut b) ")"))
              (do
                (push-str! (mut b) "(let [")
                (for [f 0 (len (.fields (elem (field node variants) 0)))]
                  (indexed! (mut b) "f" f " (.f")
                  (number! (mut b) f)
                  (push-str! (mut b) " row) "))
                (push-str! (mut b) "] ")
                (case! (mut b) schema bindings n 0)
                (push-str! (mut b) ")")))
          (push-str! (mut b) ")))))\n")
          (indexed! (mut b)
                    "(defn alpha-"
                    n
                    " [(a (dyn Allocator)) (input (ptr Store)) (target (ptr Store)) (id N")
          (number! (mut b) n)
          (indexed! (mut b)
                    "Id) (globals (ptr (ArrayList (slice u8))))] (-> (Result Alpha"
                    n
                    " AlphaError)) (block :done (when (= (alpha-primitive/cast i64 input) (alpha-primitive/cast i64 target)) (break :done (Err (AlphaAliasedStores)))) (let [(mut resolved) (match (resolve-")
          (number! (mut b) n)
          (push-str! (mut b)
                     " a input id globals) (Ok [result] result) (Err [e] (break :done (Err (AlphaResolve e))))) (mut state) (AlphaState :input input :target target :resolved (alpha-primitive/cast (ptr resolution/Resolution) (mut resolved)) :names (resolution/alpha-names a (mut resolved) (field target source-data)) :cursor 0 :mapped (ArrayList::new [i64] a) :copied (HashMap::new-scalar [i64 bool] a))] (defer (do (resolution/alpha-names-free! (mut (.names state))) (resolution/release! (mut resolved)) (free! (mut (.copied state))))) (for [i 0 (len (.occurrences resolved))] (push! (mut (.mapped state)) (- 0 1))) (match (alpha-walk-")
          (number! (mut b) n)
          (indexed! (mut b)
                    " (mut state) id) (Ok [root] (Ok (Alpha"
                    n
                    " :root root :rows (.mapped state)))) (Err [e] (free! (mut (.mapped state))) (Err e))))))\n"))))
    (str (load b))))
