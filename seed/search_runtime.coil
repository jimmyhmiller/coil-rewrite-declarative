;;; Ordered bounded graph search. Queries and successful values borrow the caller.
(module rewrite.searchruntime)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use *)
(import "coil.hashmap" :use [HashMap KeyOps])
(import "coil.result" :use *)
(import "coil.primitive" :as primitive)
(import "coil.cc" :as cc)

(defstruct Query [(owner (slice u8)) (name (slice u8))])

(defstruct Key [(query Query) (remaining i64)])

(defstruct Frame
  [(key Key)
   (rule i64)
   (started? bool)
   (following? bool)
   (children (ArrayList Query))
   (cursor i64)])

(defstruct Stats [(expanded i64) (cached i64)])

(defsum Decision [V]
  (Reject)
  (Accept [(value V)])
  (Next)
  (Follow [(children (ArrayList Query))]))

(defsum Failure [E] (InvalidDepth) (Callback [(error E)]))

(defn hash-key :cc (cc/C) [(bytes (ptr i8)) (size i64)] (-> i64)
  (let [key (primitive/cast (ptr Key) bytes)
        (mut h) (- 0 3750763034362895579)]
    (for byte (.owner (.query key))
      (set! h
            (primitive/imul (primitive/ixor h (primitive/cast i64 byte))
                            1099511628211)))
    (set! h (primitive/imul (primitive/ixor h 0) 1099511628211))
    (for byte (.name (.query key))
      (set! h
            (primitive/imul (primitive/ixor h (primitive/cast i64 byte))
                            1099511628211)))
    (for [i 0 8]
      (set! h
            (primitive/imul (primitive/ixor h
                                            (primitive/iand (primitive/ishr (.remaining key)
                                                                            (* i
                                                                               8))
                                                            255))
                            1099511628211)))
    h))

(defn equal-key :cc (cc/C) [(left (ptr i8)) (right (ptr i8)) (size i64)]
  (-> bool)
  (let [l (primitive/cast (ptr Key) left)
        r (primitive/cast (ptr Key) right)]
    (and (= (.remaining l) (.remaining r))
         (= (.owner (.query l)) (.owner (.query r)))
         (= (.name (.query l)) (.name (.query r))))))

(defn key-ops [] (-> (ptr KeyOps))
  (primitive/alloc-static KeyOps
                          (KeyOps
                            :hash (primitive/fnptr-of hash-key)
                            :eq (primitive/fnptr-of equal-key)
                            :size (primitive/sizeof Key)
                            :copy
                              (zeroed (fnptr (cc/C)
                                             [(ptr (dyn Allocator)) (ptr i8)]
                                             i64))
                            :free
                              (zeroed (fnptr (cc/C)
                                             [(ptr (dyn Allocator)) (ptr i8)]
                                             i64))
                            :owns 0)))

(defn frame [(a (dyn Allocator)) (query Query) (remaining i64)] (-> Frame)
  (Frame
    :key (Key :query query :remaining remaining)
    :rule 0
    :started? false
    :following? false
    :children (ArrayList::new [Query] a)
    :cursor 0))

(defn finish! [V] [(stack (mut (ArrayList Frame)))
                   (memo (mut (HashMap Key (Option V))))
                   (answer (Option V))] (-> void)
  (let [(mut finished)
          (match (pop! (mut stack))
            (Some [f] f)
            (None [] (panic "search frame")))]
    (free! (mut (.children finished)))
    (set! (mut memo) (.key finished) answer)))

;;; Step must be pure over an immutable context for this call. A Follow transfers
;;; its array to the runner; query strings and values remain borrowed until return.
;;; Memo keys include remaining depth: failure at one depth is not global failure.
;;; Completed answers, including misses, are reused. Every child spends one level.
(defn run [C V E] [(a (dyn Allocator))
                   (user (ptr C))
                   (root Query)
                   (remaining i64)
                   (rules i64)
                   (stats (mut Stats))
                   (step (fnptr (cc/C)
                                [(ptr C) (ptr Query) i64]
                                (Result (Decision V) E)))]
  (-> (Result (Option V) (Failure E)))
  (block :done
    (set! (.expanded stats) 0)
    (set! (.cached stats) 0)
    (when (< remaining 0) (break :done (Err (InvalidDepth [E]))))
    (let [(mut stack) (ArrayList::new [Frame] a)
          (mut memo) (HashMap::new [Key (Option V)] a (key-ops))
          (mut returned?) false
          (mut answer) (None [V])]
      (defer (do
               (for [i 0 (len stack)]
                 (free! (mut (.children (elem (mut stack) i)))))
               (free! (mut stack))
               (free! (mut memo))))
      (push! (mut stack) (frame a root remaining))
      (while (> (len stack) 0)
        (let [top (elem (mut stack) (- (len stack) 1))]
          (if returned?
              (match answer
                (Some [_] (finish! (mut stack) (mut memo) answer))
                (None [] (set! returned? false)))
              (cond (not (.started? top))
                      (do
                        (set! (.started? top) true)
                        (match (get memo (.key top))
                          (Some [found]
                                (set! (.cached stats) (+ (.cached stats) 1))
                                (set! answer found)
                                (set! returned? true)
                                (finish! (mut stack) (mut memo) answer))
                          (None []
                                (if (<= (.remaining (.key top)) 0)
                                    (do
                                      (set! answer (None))
                                      (set! returned? true)
                                      (finish! (mut stack) (mut memo) answer))
                                    (set! (.expanded stats)
                                          (+ (.expanded stats) 1))))))
                    (.following? top)
                      (if (< (.cursor top) (len (.children top)))
                          (let [child (get (.children top) (.cursor top))
                                depth (- (.remaining (.key top)) 1)]
                            (set! (.cursor top) (+ (.cursor top) 1))
                            (push! (mut stack) (frame a child depth)))
                          (do
                            (free! (mut (.children top)))
                            (set! (.children top) (ArrayList::new [Query] a))
                            (set! (.following? top) false)
                            (set! (.rule top) (+ (.rule top) 1))))
                    (>= (.rule top) rules)
                      (do
                        (set! answer (None))
                        (set! returned? true)
                        (finish! (mut stack) (mut memo) answer))
                    :else
                      (match (step user
                                   (field (mut (.key top)) query)
                                   (.rule top))
                        (Err [e] (break :done (Err (Callback [E] e))))
                        (Ok [decision]
                            (match decision
                              (Reject []
                                      (set! answer (None))
                                      (set! returned? true)
                                      (finish! (mut stack) (mut memo) answer))
                              (Accept [value]
                                      (set! answer (Some value))
                                      (set! returned? true)
                                      (finish! (mut stack) (mut memo) answer))
                              (Next [] (set! (.rule top) (+ (.rule top) 1)))
                              (Follow [children]
                                      (set! (.children top) children)
                                      (set! (.cursor top) 0)
                                      (set! (.following? top) true)))))))))
      (Ok answer))))
