(module rewrite.main)
(import "coil.reader" :use *)
(import "coil.arraylist" :use *)
(import "coil.str" :use *)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.io" :use [stderr])
(import "coil.source.cli" :use [read-stdin-all write-stdout-all])
(import "rewrite.language" :use [compile-forms])
(defn main [] (-> i64)
  (let [arena (arena-new 16777216)
        a (arena-view arena)
        source (read-stdin-all a)
        compiled
          (match (read-all a source 0)
            (Err [d] (Err [(slice u8) Diag] d))
            (Ok [forms] (compile-forms a forms)))
        result
          (match compiled
            (Err [d]
                 (do
                   (fmt (stderr)
                        "seed error at {}..{}: {}\n"
                        (.lo d)
                        (.hi d)
                        (.msg d))
                   1))
            (Ok [text] (write-stdout-all text)))]
    (arena-release! arena)
    result))
