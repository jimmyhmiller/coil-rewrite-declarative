(module rewrite.main)
(import "rewrite.schema" :as schema)
(import "rewrite.emit" :as emit)
(import "rewrite.judgment" :as judgment)
(import "coil.reader" :use *)
(import "coil.arraylist" :use *)
(import "coil.str" :use *)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.io" :use [stderr])
(import "coil.source.cli" :use [read-stdin-all write-stdout-all])

(defn judgment? [(form (ptr Sexp))] (-> bool)
  (and (sexp-list? form)
       (> (sexp-count form) 0)
       (sexp-sym-is (sexp-nth form 0) "judgment")))

(defn compile-forms [(a (dyn Allocator)) (forms (ptr (ArrayList Sexp)))]
  (-> (Result (slice u8) Diag))
  (block
    :done
      (match (schema/parse-forms a forms)
        (Err [d] (Err d))
        (Ok [s]
            (let [sp (box! a schema/Schema s)
                  (mut output) (StrBuf::new a)]
              (push-str! (mut output) (emit/emit a sp))
              (for [i 0 (len (load forms))]
                (let [form (elem forms i)]
                  (when (judgment? form)
                    (for [j 0 i]
                      (let [previous (elem forms j)]
                        (when (and (judgment? previous)
                                   (>= (sexp-count previous) 2)
                                   (>= (sexp-count form) 2)
                                   (sexp-sym? (sexp-nth form 1))
                                   (sexp-sym-is (sexp-nth previous 1)
                                                (sexp-sym (sexp-nth form 1))))
                          (break
                            :done
                              (Err (schema/problem form "duplicate judgment"))))))
                    (match (judgment/compile-one a sp form)
                      (Err [d] (break :done (Err d)))
                      (Ok [text] (push-str! (mut output) text))))))
              (Ok (str (load output))))))))

(defn main [] (-> i64)
  (let [arena (arena-new 16777216)
        a (arena-view arena)
        source (read-stdin-all a)
        compiled
          (match (read-all a source 0)
            (Err [d] (Err [(slice u8) Diag] d))
            (Ok [forms] (compile-forms a forms)))
        result
          (match compiled
            (Err [d]
                 (do
                   (fmt (stderr)
                        "seed error at {}..{}: {}\n"
                        (.lo d)
                        (.hi d)
                        (.msg d))
                   1))
            (Ok [text] (write-stdout-all text)))]
    (arena-release! arena)
    result))
