(module rewrite.main)
(import "rewrite.schema" :as schema)
(import "rewrite.binding" :as binding)
(import "rewrite.emit" :as emit)
(import "rewrite.index" :as index)
(import "rewrite.resolve" :as resolve)
(import "rewrite.alpha" :as alpha)
(import "rewrite.contextpolicy" :as contextpolicy)
(import "rewrite.equalgen" :as equalgen)
(import "rewrite.readers" :as readers)
(import "rewrite.walk" :as walk)
(import "rewrite.syntax" :as syntax)
(import "rewrite.transform" :as transform)
(import "rewrite.judgment" :as judgment)
(import "rewrite.lower" :as lower)
(import "rewrite.program" :as program)
(import "rewrite.phase" :as phase)
(import "rewrite.protocol" :as protocol)
(import "coil.reader" :use *)
(import "coil.arraylist" :use *)
(import "coil.str" :use *)
(import "coil.alloc" :use *)
(import "coil.result" :use *)
(import "coil.io" :use [stderr])
(import "coil.source.cli" :use [read-stdin-all write-stdout-all])

(defn judgment? [(form (ptr Sexp))] (-> bool)
  (and (sexp-list? form)
       (> (sexp-count form) 0)
       (sexp-sym-is (sexp-nth form 0) "judgment")))

(def compiler-phases
  "(phases\n (input schema Schema)\n (input bindings Bindings)\n (phase program (needs (maps TransformAPI) (surface SurfaceAPI) (readers ReaderAPI) (indexes IndexAPI) (judgments JudgmentAPI) (lowering CIRAPI)) (makes (program ProgramAPI)))\n (phase transform (needs (readers ReaderAPI)) (makes (maps TransformAPI)))\n (phase walk (needs (readers ReaderAPI)) (makes (walk WalkAPI)))\n (phase syntax (needs (readers ReaderAPI)) (makes (surface SurfaceAPI)))\n (phase context-policy (needs (tables Tables)) (makes (contexts ContextAPI)))\n (phase equality (needs (readers ReaderAPI)) (makes (equality EqualityAPI)))\n (phase readers (needs (tables Tables)) (makes (readers ReaderAPI)))\n (phase alpha (needs (resolution ResolutionAPI)) (makes (alpha AlphaAPI)))\n (phase resolution (needs (readers ReaderAPI) (bindings Bindings)) (makes (resolution ResolutionAPI)))\n (phase indexes (needs (tables Tables)) (makes (indexes IndexAPI)))\n (phase judgment (needs (tables Tables) (bindings Bindings)) (makes (judgments JudgmentAPI)))\n (phase lower (needs (tables Tables) (bindings Bindings)) (makes (lowering CIRAPI)))\n (phase tables (needs (schema Schema)) (makes (tables Tables))))")

(defn compile-stage [(a (dyn Allocator))
                     (sp (ptr schema/Schema))
                     (bindings (ptr binding/Bindings))
                     (module-name (slice u8))
                     (forms (ptr (ArrayList Sexp)))
                     (stage (slice u8))]
  (-> (Result (slice u8) Diag))
  (block :done
    (unless (or (= stage "walk")
                (= stage "context-policy")
                (= stage "equality")
                (= stage "tables")
                (= stage "readers")
                (= stage "indexes")
                (= stage "resolution")
                (= stage "alpha")
                (= stage "judgment")
                (= stage "syntax")
                (= stage "transform")
                (= stage "lower")
                (= stage "program"))
      (break
        :done
          (Err (Diag
                 :lo 0
                 :hi 0
                 :source 0
                 :ctxt 0
                 :msg "unknown seed phase implementation"))))
    (let [(mut output) (StrBuf::new a)]
      (cond (= stage "walk")
              (match (walk/emit a forms)
                (Err [d] (break :done (Err d)))
                (Ok [text] (push-str! (mut output) text)))
            (= stage "context-policy")
              (match (contextpolicy/emit a sp forms)
                (Err [d] (break :done (Err d)))
                (Ok [text] (push-str! (mut output) text)))
            (= stage "equality")
              (match (equalgen/emit a sp forms)
                (Err [d] (break :done (Err d)))
                (Ok [text] (push-str! (mut output) text)))
            (= stage "tables")
              (push-str! (mut output) (emit/emit a sp module-name))
            (= stage "transform")
              (match (transform/emit a sp forms)
                (Err [d] (break :done (Err d)))
                (Ok [text] (push-str! (mut output) text)))
            (= stage "readers") (push-str! (mut output) (readers/emit a sp))
            (= stage "alpha")
              (push-str! (mut output) (alpha/emit a sp bindings))
            (= stage "resolution")
              (push-str! (mut output) (resolve/emit a sp bindings))
            (= stage "indexes") (push-str! (mut output) (index/emit a sp))
            :else
              (for [i 0 (len (load forms))]
                (let [form (elem forms i)]
                  (when (and (= stage "syntax")
                             (sexp-list? form)
                             (> (sexp-count form) 0)
                             (sexp-sym-is (sexp-nth form 0) "syntax"))
                    (for [j 0 i]
                      (let [previous (elem forms j)]
                        (when (and (sexp-list? previous)
                                   (>= (sexp-count previous) 2)
                                   (>= (sexp-count form) 2)
                                   (sexp-sym? (sexp-nth form 1))
                                   (sexp-sym-is (sexp-nth previous 0) "syntax")
                                   (sexp-sym-is (sexp-nth previous 1)
                                                (sexp-sym (sexp-nth form 1))))
                          (break
                            :done
                              (Err (schema/problem form
                                                   "duplicate syntax declaration"))))))
                    (match (syntax/compile-one a sp forms form)
                      (Err [d] (break :done (Err d)))
                      (Ok [text] (push-str! (mut output) text))))
                  (when (and (= stage "program")
                             (sexp-list? form)
                             (> (sexp-count form) 0)
                             (sexp-sym-is (sexp-nth form 0) "program"))
                    (for [j 0 i]
                      (let [previous (elem forms j)]
                        (when (and (sexp-list? previous)
                                   (> (sexp-count previous) 0)
                                   (sexp-sym-is (sexp-nth previous 0)
                                                "program"))
                          (break
                            :done
                              (Err (schema/problem form
                                                   "duplicate program declaration"))))))
                    (let [(mut has-judgment) false
                          (mut has-lowering) false]
                      (when (>= (sexp-count form) 2)
                        (for [j 0 (len (load forms))]
                          (let [other (elem forms j)]
                            (when (and (sexp-list? other)
                                       (>= (sexp-count other) 2)
                                       (sexp-sym? (sexp-nth form 1))
                                       (sexp-sym-is (sexp-nth other 1)
                                                    (sexp-sym (sexp-nth form
                                                                        1))))
                              (when (sexp-sym-is (sexp-nth other 0)
                                                 "judgment")
                                (set! has-judgment true))
                              (when (sexp-sym-is (sexp-nth other 0) "lower")
                                (set! has-lowering true))))))
                      (unless (and has-judgment has-lowering)
                        (break
                          :done
                            (Err (schema/problem form
                                                 "program requires judgment and lowering for its expression schema")))))
                    (match (program/compile-one a sp form)
                      (Err [d] (break :done (Err d)))
                      (Ok [text] (push-str! (mut output) text))))
                  (when (and (= stage "lower")
                             (sexp-list? form)
                             (> (sexp-count form) 0)
                             (sexp-sym-is (sexp-nth form 0) "lower"))
                    (for [j 0 i]
                      (let [previous (elem forms j)]
                        (when (and (sexp-list? previous)
                                   (>= (sexp-count previous) 2)
                                   (>= (sexp-count form) 2)
                                   (sexp-sym? (sexp-nth form 1))
                                   (sexp-sym-is (sexp-nth previous 0) "lower")
                                   (sexp-sym-is (sexp-nth previous 1)
                                                (sexp-sym (sexp-nth form 1))))
                          (break
                            :done
                              (Err (schema/problem form "duplicate lowering"))))))
                    (match (lower/compile-one a sp bindings form)
                      (Err [d] (break :done (Err d)))
                      (Ok [text] (push-str! (mut output) text))))
                  (when (and (= stage "judgment") (judgment? form))
                    (for [j 0 i]
                      (let [previous (elem forms j)]
                        (when (and (judgment? previous)
                                   (>= (sexp-count previous) 2)
                                   (>= (sexp-count form) 2)
                                   (sexp-sym? (sexp-nth form 1))
                                   (sexp-sym-is (sexp-nth previous 1)
                                                (sexp-sym (sexp-nth form 1))))
                          (break
                            :done
                              (Err (schema/problem form "duplicate judgment"))))))
                    (match (judgment/compile-one a sp bindings form)
                      (Err [d] (break :done (Err d)))
                      (Ok [text] (push-str! (mut output) text)))))))
      (Ok (str (load output))))))

(defn output-module [(forms (ptr (ArrayList Sexp)))]
  (-> (Result (slice u8) Diag))
  (block
    :done
      (let [(mut name) "rewrite.generated"
            (mut seen) false]
        (for [i 0 (len (load forms))]
          (let [form (elem forms i)]
            (when (and (sexp-list? form)
                       (> (sexp-count form) 0)
                       (sexp-sym-is (sexp-nth form 0) "module"))
              (when seen
                (break
                  :done (Err (schema/problem form "duplicate output module"))))
              (unless (and (= (sexp-count form) 2)
                           (sexp-sym? (sexp-nth form 1)))
                (break
                  :done
                    (Err (schema/problem form
                                         "expected (module qualified.name)"))))
              (set! seen true)
              (set! name (sexp-sym (sexp-nth form 1)))
              (let [(mut segment) 0
                    (mut dots) 0]
                (for byte name
                  (if (= byte 46)
                      (do
                        (when (= segment 0)
                          (break
                            :done
                              (Err (schema/problem form
                                                   "invalid output module name"))))
                        (set! dots (+ dots 1))
                        (set! segment 0))
                      (do
                        (unless (or (and (>= byte 97) (<= byte 122))
                                    (and (>= byte 65) (<= byte 90))
                                    (= byte 95)
                                    (and (> segment 0)
                                         (or (= byte 45)
                                             (and (>= byte 48) (<= byte 57)))))
                          (break
                            :done
                              (Err (schema/problem form
                                                   "invalid output module name"))))
                        (set! segment (+ segment 1)))))
                (unless (and (> dots 0) (> segment 0))
                  (break
                    :done
                      (Err (schema/problem form
                                           "output module needs at least two nonempty segments"))))))))
        (Ok name))))

(defn compile-forms [(a (dyn Allocator)) (forms (ptr (ArrayList Sexp)))]
  (-> (Result (slice u8) Diag))
  (block :done
    (let [(mut protocol-index) (- 0 1)]
      (for [i 0 (len (load forms))]
        (let [form (elem forms i)]
          (when (and (sexp-list? form)
                     (> (sexp-count form) 0)
                     (sexp-sym-is (sexp-nth form 0) "protocol"))
            (when (>= protocol-index 0)
              (break
                :done
                  (Err (schema/problem form "duplicate protocol declaration"))))
            (set! protocol-index i))))
      (when (>= protocol-index 0)
        (for [i 0 (len (load forms))]
          (let [form (elem forms i)]
            (unless (or (= i protocol-index)
                        (and (sexp-list? form)
                             (> (sexp-count form) 0)
                             (sexp-sym-is (sexp-nth form 0) "module")))
              (break
                :done
                  (Err (schema/problem form
                                       "protocol module cannot contain schema declarations"))))))
        (let [module-name
                (match (output-module forms)
                  (Ok [name] name)
                  (Err [d] (break :done (Err d))))]
          (break
            :done (protocol/compile a module-name (elem forms protocol-index))))))
    (let [module-name
            (match (output-module forms)
              (Err [d] (break :done (Err d)))
              (Ok [name] name))
          schema
            (match (schema/parse-forms a forms)
              (Err [d] (break :done (Err d)))
              (Ok [schema] (box! a schema/Schema schema)))
          bindings
            (match (binding/parse a schema forms)
              (Err [d] (break :done (Err d)))
              (Ok [bindings] (box! a binding/Bindings bindings)))
          order
            (match (phase/schedule a compiler-phases 0)
              (Err [d] (break :done (Err d)))
              (Ok [order] order))
          (mut output) (StrBuf::new a)]
      (for [i 0 (len order)]
        (match (compile-stage a
                              schema
                              bindings
                              module-name
                              forms
                              (get order i))
          (Err [d] (break :done (Err d)))
          (Ok [text] (push-str! (mut output) text))))
      (Ok (str (load output))))))

(defn main [] (-> i64)
  (let [arena (arena-new 16777216)
        a (arena-view arena)
        source (read-stdin-all a)
        compiled
          (match (read-all a source 0)
            (Err [d] (Err [(slice u8) Diag] d))
            (Ok [forms] (compile-forms a forms)))
        result
          (match compiled
            (Err [d]
                 (do
                   (fmt (stderr)
                        "seed error at {}..{}: {}\n"
                        (.lo d)
                        (.hi d)
                        (.msg d))
                   1))
            (Ok [text] (write-stdout-all text)))]
    (arena-release! arena)
    result))
