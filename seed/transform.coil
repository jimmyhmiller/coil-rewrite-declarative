;;; Total schema-to-schema maps derive traversal, memoization and provenance.
(module rewrite.transform)
(import "rewrite.schema" :use *)
(import "rewrite.protocol" :use [name?])
(import "rewrite.emit" :use [number!])
(import "rewrite.readers" :use [quoted!])
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.str" :use *)

(defstruct Pass
  [(source i64)
   (target i64)
   (many? bool)
   (occurrences? bool)
   (start i64)
   (form Sexp)])

(defn contains-lexical? [(form (ptr Sexp))] (-> bool)
  (block :found
    (when (or (sexp-list? form) (sexp-vec? form))
      (when (and (sexp-list? form)
                 (> (sexp-count form) 0)
                 (sexp-sym-is (sexp-nth form 0) "lexical"))
        (break :found true))
      (for [i 0 (sexp-count form)]
        (when (contains-lexical? (sexp-nth form i)) (break :found true))))
    false))

(defn node-number [(s (ptr Schema)) (name (slice u8))] (-> i64)
  (block :done
    (for [i 0 (len (.nodes s))]
      (when (= name (.name (elem (field s nodes) i))) (break :done i)))
    (- 0 1)))

(defn function-name! [(b (mut StrBuf)) (source i64) (target i64) (many? bool)]
  (-> void)
  (push-str! (mut b) (if many? "transform-many-" "transform-"))
  (number! (mut b) source)
  (push-str! (mut b) "-")
  (number! (mut b) target))

(defn sequence-function-name! [(b (mut StrBuf))
                               (source i64)
                               (target i64)
                               (many? bool)] (-> void)
  (push-str! (mut b) "sequence-")
  (function-name! (mut b) source target many?))

(defn sequence-wrapper! [(b (mut StrBuf))
                         (source i64)
                         (target i64)
                         (many? bool)
                         (occurrences? bool)
                         (p i64)] (-> void)
  (push-str! (mut b) "(defn sequence-element-")
  (number! (mut b) p)
  (push-str! (mut b) " [(context (ptr TransformState)) (id N")
  (number! (mut b) source)
  (push-str! (mut b) "Id)] (-> (Result i64 TransformError)) (match (")
  (function-name! (mut b) source target many?)
  (push-str! (mut b) " (mut context) id) (Err [e] (Err e)) (Ok [out] (Ok ")
  (if many?
      (push-str! (mut b) "(.index out)")
      (do
        (push-str! (mut b) "(sequence/singleton! (mut (.sequences")
        (number! (mut b) target)
        (push-str! (mut b) " (.target context))) out)")))
  (push-str! (mut b) "))))\n(defn ")
  (sequence-function-name! (mut b) source target many?)
  (push-str! (mut b) " [(state (mut TransformState)) (ids N")
  (number! (mut b) source)
  (push-str! (mut b) "Seq)] (-> (Result N")
  (number! (mut b) target)
  (push-str! (mut b)
             "Seq TransformError)) (block :done (let [input (.source state) store (.target state)] (when (= (transform-primitive/cast i64 input) (transform-primitive/cast i64 store)) (break :done (Err (TransformAliasedStores)))) (match (sequence/map-mode! (.allocator (.source-data store)) (field input sequences")
  (number! (mut b) source)
  (push-str! (mut b) ") (mut (.sequences")
  (number! (mut b) target)
  (push-str! (mut b) " store)) (mut (.seqmemo")
  (number! (mut b) p)
  (push-str! (mut b)
             " state)) (.index ids) ")
  (push-str! (mut b) (if occurrences? "false" "(.sharing? state)"))
  (push-str! (mut b)
             " (transform-primitive/cast (ptr TransformState) state) (transform-primitive/fnptr-of sequence-element-")
  (number! (mut b) p)
  (push-str! (mut b)
             ") (transform-primitive/fnptr-of transform-sequence-error)) (Err [e] (Err e)) (Ok [index] (Ok (N")
  (number! (mut b) target)
  (push-str! (mut b) "Seq :index index)))))))\n"))

(defn term! [(b (mut StrBuf))
             (s (ptr Schema))
             (passes (ptr (ArrayList Pass)))
             (forms (ptr (ArrayList Sexp)))
             (context (ptr (ArrayList Field)))
             (source i64)
             (v (ptr Variant))
             (term (ptr Sexp))
             (expected (slice u8))
             (many? bool)
             (occurrences? bool)
             (rule (ptr Sexp))]
  (-> (Result i64 Diag))
  (block :done
    (when (and (sexp-list? term)
               (> (sexp-count term) 0)
               (sexp-sym-is (sexp-nth term 0) "context"))
      (unless (and (= (sexp-count term) 2)
                   (sexp-sym? (sexp-nth term 1))
                   (not many?))
        (break
          :done (Err (problem term "expected (context name) scalar expression"))))
      (for [c 0 (len (load context))]
        (let [field (get (load context) c)]
          (when (sexp-sym-is (sexp-nth term 1) (.name field))
            (unless (= expected (.type-name field))
              (break :done (Err (problem term "context type mismatch"))))
            (push-str! (mut b) "(.context")
            (number! (mut b) c)
            (push-str! (mut b) " state)")
            (break :done (Ok 0)))))
      (break :done (Err (problem term "unknown transform context field"))))
    (when (and (sexp-list? term)
               (> (sexp-count term) 0)
               (sexp-sym-is (sexp-nth term 0) "concat"))
      (unless (and (= expected "Text") (not many?))
        (break :done (Err (problem term "concat requires Text result"))))
      (push-str! (mut b)
                 "(let [(mut concat-buffer) (StrBuf::new (.allocator (.source-data store)))] (defer (free! (mut concat-buffer))) ")
      (for [i 1 (sexp-count term)]
        (push-str! (mut b) "(push-str! (mut concat-buffer) ")
        (match (term! (mut b)
                      s
                      passes
                      forms
                      context
                      source
                      v
                      (sexp-nth term i)
                      "Text"
                      false
                      occurrences?
                      rule)
          (Err [d] (break :done (Err d)))
          (Ok [_]))
        (push-str! (mut b) ") "))
      (push-str! (mut b) "(store-text! (mut store) (str concat-buffer)))")
      (break :done (Ok 0)))
    (when (and (sexp-list? term)
               (> (sexp-count term) 0)
               (sexp-sym-is (sexp-nth term 0) "classify"))
      (unless (and (>= (sexp-count term) 5) (sexp-sym? (sexp-nth term 1)))
        (break
          :done
            (Err (problem term
                          "expected classify policy text parameter and exhaustive arms"))))
      (let [(mut target) (- 0 1)]
        (for form-value (load forms)
          (let [(mut form) form-value]
            (when (and (sexp-list? (mut form))
                       (>= (sexp-count (mut form)) 3)
                       (sexp-sym-is (sexp-nth (mut form) 0) "text-classifier")
                       (sexp-sym-is (sexp-nth (mut form) 1)
                                    (sexp-sym (sexp-nth term 1))))
              (set! target (node-number s (sexp-sym (sexp-nth (mut form) 2)))))))
        (when (< target 0)
          (break :done (Err (problem term "unknown classifier"))))
        (let [node (elem (field s nodes) target)
              a (.alc (.bytes (load b)))
              (mut seen) (ArrayList::new [bool] a)]
          (defer (free! (mut seen)))
          (for variant (.variants node) (push! (mut seen) false))
          (push-str! (mut b) "(let [classification-value (classify-")
          (push-str! (mut b) (sexp-sym (sexp-nth term 1)))
          (push-str! (mut b) " ")
          (match (term! (mut b)
                        s
                        passes
                        forms
                        context
                        source
                        v
                        (sexp-nth term 2)
                        "Text"
                        false
                        occurrences?
                        rule)
            (Err [d] (break :done (Err d)))
            (Ok [_]))
          (push-str! (mut b) " ")
          (match (term! (mut b)
                        s
                        passes
                        forms
                        context
                        source
                        v
                        (sexp-nth term 3)
                        "Int"
                        false
                        occurrences?
                        rule)
            (Err [d] (break :done (Err d)))
            (Ok [_]))
          (push-str! (mut b) ")] ")
          (when (.sum? node) (push-str! (mut b) "(match classification-value "))
          (for [r 4 (sexp-count term)]
            (let [arm (sexp-nth term r)
                  (mut vi) (- 0 1)]
              (unless (and (sexp-list? arm)
                           (= (sexp-count arm) 3)
                           (sexp-sym? (sexp-nth arm 0))
                           (sexp-vec? (sexp-nth arm 1)))
                (break
                  :done
                    (Err (problem arm
                                  "expected classifier arm (Constructor [bindings] expression)"))))
              (for [i 0 (len (.variants node))]
                (when (sexp-sym-is (sexp-nth arm 0)
                                   (.name (elem (field node variants) i)))
                  (set! vi i)))
              (when (< vi 0)
                (break
                  :done (Err (problem arm "unknown classifier constructor"))))
              (when (get seen vi)
                (break :done (Err (problem arm "duplicate classifier arm"))))
              (set! (mut seen) vi true)
              (let [variant (elem (field node variants) vi)
                    bindings (sexp-nth arm 1)
                    (mut fields) (ArrayList::new [Field] a)]
                (defer (free! (mut fields)))
                (unless (= (sexp-count bindings) (len (.fields variant)))
                  (break :done (Err (problem arm "classifier binding arity"))))
                (for field (.fields v) (push! (mut fields) field))
                (if (.sum? node)
                    (do
                      (push-str! (mut b) "(N")
                      (number! (mut b) target)
                      (push-str! (mut b) "V")
                      (number! (mut b) vi)
                      (push-str! (mut b) " ["))
                    (push-str! (mut b) "(let ["))
                (for [i 0 (len (.fields variant))]
                  (let [binding (sexp-nth bindings i)
                        field (get (.fields variant) i)]
                    (unless (and (sexp-sym? binding) (name? (sexp-sym binding)))
                      (break
                        :done
                          (Err (problem binding
                                        "invalid classifier binding name"))))
                    (for old fields
                      (when (= (.name old) (sexp-sym binding))
                        (break
                          :done
                            (Err (problem binding
                                          "classifier binding shadows existing field")))))
                    (push-str! (mut b) "f")
                    (number! (mut b) (len fields))
                    (push-str! (mut b) " ")
                    (unless (.sum? node)
                      (push-str! (mut b) "(.f")
                      (number! (mut b) i)
                      (push-str! (mut b) " classification-value) "))
                    (push! (mut fields)
                           (Field
                             :name (sexp-sym binding)
                             :type-name (.type-name field)
                             :many? false
                             :key? false
                             :origin (load binding)))))
                (push-str! (mut b) "] ")
                (let [(mut extended)
                        (Variant
                          :name (.name v)
                          :fields fields
                          :origin (.origin v))]
                  (match (term! (mut b)
                                s
                                passes
                                forms
                                context
                                source
                                (mut extended)
                                (sexp-nth arm 2)
                                expected
                                many?
                                occurrences?
                                rule)
                    (Err [d] (break :done (Err d)))
                    (Ok [_])))
                (push-str! (mut b) ") "))))
          (for present seen
            (unless present
              (break
                :done (Err (problem term "classifier arms must be exhaustive")))))
          (when (.sum? node) (push-str! (mut b) ")"))
          (push-str! (mut b) ")")))
      (break :done (Ok 0)))
    (when (and (sexp-list? term)
               (> (sexp-count term) 0)
               (sexp-sym-is (sexp-nth term 0) "lexical"))
      (unless (and (= (sexp-count term) 4) (= expected "Text") (not many?))
        (break
          :done
            (Err (problem term
                          "lexical requires Text, Int, Text arguments and a Text result"))))
      (unless occurrences?
        (break
          :done
            (Err (problem term "lexical requires an occurrence transformation"))))
      (push-str! (mut b) "(let [")
      (for [i 1 4]
        (push-str! (mut b)
                   (cond (= i 1) "lexical-name "
                         (= i 2) "lexical-scope "
                         :else "lexical-module "))
        (match (term! (mut b)
                      s
                      passes
                      forms
                      context
                      source
                      v
                      (sexp-nth term i)
                      (if (= i 2) "Int" "Text")
                      false
                      occurrences?
                      rule)
          (Err [d] (break :done (Err d)))
          (Ok [_]))
        (push-str! (mut b) " "))
      (push-str! (mut b)
                 "(mut lexical-buffer) (StrBuf::new (.allocator (.source-data store)))] (defer (free! (mut lexical-buffer))) (transform-lexical/write! (mut lexical-buffer) lexical-name lexical-scope lexical-module) (store-text! (mut store) (str lexical-buffer)))")
      (break :done (Ok 0)))
    (when many?
      (when (sexp-sym? term)
        (for [f 0 (len (.fields v))]
          (let [field (elem (field v fields) f)]
            (when (and (.many? field) (sexp-sym-is term (.name field)))
              (for [p 0 (len (load passes))]
                (let [pass (elem passes p)]
                  (when (and (not (.many? pass))
                             (= (.type-name field)
                                (.name (elem (field s nodes) (.source pass))))
                             (= expected
                                (.name (elem (field s nodes) (.target pass)))))
                    (when (and (.occurrences? pass) (not occurrences?))
                      (break
                        :done
                          (Err (problem term
                                        "occurrence map requires an occurrence caller"))))
                    (push-str! (mut b) "(match (")
                    (sequence-function-name! (mut b)
                                             (.source pass)
                                             (.target pass)
                                             false)
                    (push-str! (mut b) " (mut state) f")
                    (number! (mut b) f)
                    (push-str! (mut b)
                               ") (Ok [ids] ids) (Err [error] (break :done (Err error))))")
                    (break :done (Ok 0))))))))
        (break
          :done
            (Err (problem term
                          "sequence field needs a matching single-result element map"))))
      (unless (and (sexp-list? term)
                   (> (sexp-count term) 0)
                   (sexp-sym-is (sexp-nth term 0) "items"))
        (break
          :done
            (Err (problem term
                          "sequence result requires (items expression ... (spread field) ...)"))))
      (let [target (node-number s expected)]
        (push-str! (mut b)
                   "(let [(mut parts) (ArrayList::new [i64] (.allocator (.source-data store)))] (defer (free! (mut parts))) ")
        (for [t 1 (sexp-count term)]
          (let [child (sexp-nth term t)]
            (if (and (sexp-list? child)
                     (> (sexp-count child) 0)
                     (sexp-sym-is (sexp-nth child 0) "spread"))
                (do
                  (unless (and (= (sexp-count child) 2)
                               (sexp-sym? (sexp-nth child 1)))
                    (break
                      :done
                        (Err (problem child
                                      "spread requires one source reference field"))))
                  (let [(mut matched) false]
                    (for [f 0 (len (.fields v))]
                      (let [field (elem (field v fields) f)]
                        (when (sexp-sym-is (sexp-nth child 1) (.name field))
                          (for [p 0 (len (load passes))]
                            (let [pass (elem passes p)]
                              (when (and (.many? pass)
                                         (= (.type-name field)
                                            (.name (elem (field s nodes)
                                                         (.source pass))))
                                         (= expected
                                            (.name (elem (field s nodes)
                                                         (.target pass)))))
                                (when (and (.occurrences? pass)
                                           (not occurrences?))
                                  (break
                                    :done
                                      (Err (problem child
                                                    "occurrence map requires an occurrence caller"))))
                                (set! matched true)
                                (push-str! (mut b) "(let [part (match (")
                                (if (.many? field)
                                    (sequence-function-name! (mut b)
                                                             (.source pass)
                                                             (.target pass)
                                                             true)
                                    (function-name! (mut b)
                                                    (.source pass)
                                                    (.target pass)
                                                    true))
                                (push-str! (mut b) " (mut state) f")
                                (number! (mut b) f)
                                (push-str! (mut b)
                                           ") (Ok [ids] ids) (Err [error] (break :done (Err error))))] (push! (mut parts) (.index part))) ")))))))
                    (unless matched
                      (break
                        :done
                          (Err (problem child
                                        "spread field needs a matching sequence map"))))))
                (do
                  (push-str! (mut b)
                             "(push! (mut parts) (sequence/singleton! (mut (.sequences")
                  (number! (mut b) target)
                  (push-str! (mut b) " store)) ")
                  (match (term! (mut b)
                                s
                                passes
                                forms
                                context
                                source
                                v
                                child
                                expected
                                false
                                occurrences?
                                rule)
                    (Err [d] (break :done (Err d)))
                    (Ok [_]))
                  (push-str! (mut b) ")) ")))))
        (push-str! (mut b) "(match (sequence/join! (mut (.sequences")
        (number! (mut b) target)
        (push-str! (mut b) " store)) (mut parts)) (Ok [index] (N")
        (number! (mut b) target)
        (push-str! (mut b)
                   "Seq :index index)) (Err [error] (break :done (Err (TransformSequence error))))))")
        (break :done (Ok 0))))
    (when (and (sexp-list? term)
               (> (sexp-count term) 0)
               (sexp-sym-is (sexp-nth term 0) "first-or"))
      (unless (and (= (sexp-count term) 3)
                   (sexp-sym? (sexp-nth term 1))
                   (not (scalar? expected)))
        (break
          :done
            (Err (problem term
                          "first-or requires a sequence field, fallback and schema result"))))
      (let [(mut matched) false]
        (for [f 0 (len (.fields v))]
          (let [field (elem (field v fields) f)]
            (when (and (.many? field)
                       (sexp-sym-is (sexp-nth term 1) (.name field)))
              (for pass (load passes)
                (when (and (not (.many? pass))
                           (= (.type-name field)
                              (.name (elem (field s nodes) (.source pass))))
                           (= expected
                              (.name (elem (field s nodes) (.target pass)))))
                  (when (and (.occurrences? pass) (not occurrences?))
                    (break
                      :done
                        (Err (problem term
                                      "occurrence map requires an occurrence caller"))))
                  (set! matched true)
                  (push-str! (mut b)
                             "(match (sequence/first! (field input sequences")
                  (number! (mut b) (.source pass))
                  (push-str! (mut b) ") (.index f")
                  (number! (mut b) f)
                  (push-str! (mut b)
                             ")) (Err [error] (break :done (Err (TransformSequence error)))) (Ok [first] (match first (Some [selected] (match (")
                  (function-name! (mut b) (.source pass) (.target pass) false)
                  (push-str! (mut b)
                             " (mut state) selected) (Ok [out] out) (Err [error] (break :done (Err error))))) (None [] ")
                  (match (term! (mut b)
                                s
                                passes
                                forms
                                context
                                source
                                v
                                (sexp-nth term 2)
                                expected
                                false
                                occurrences?
                                rule)
                    (Err [d] (break :done (Err d)))
                    (Ok [_]))
                  (push-str! (mut b) "))))"))))))
        (unless matched
          (break
            :done
              (Err (problem term
                            "first-or field needs a matching single-result element map")))))
      (break :done (Ok 0)))
    (when (sexp-sym? term)
      (for [i 0 (len (.fields v))]
        (let [field (elem (field v fields) i)]
          (when (sexp-sym-is term (.name field))
            (if (and (not (.many? field))
                     (scalar? expected)
                     (= (.type-name field) expected))
                (do
                  (when (= expected "Text")
                    (push-str! (mut b) "(store-text! (mut store) "))
                  (push-str! (mut b) "f")
                  (number! (mut b) i)
                  (when (= expected "Text") (push-str! (mut b) ")"))
                  (break :done (Ok 0)))
                (for [p 0 (len (load passes))]
                  (let [pass (elem passes p)]
                    (when (and (not (.many? field))
                               (not (.many? pass))
                               (= (.type-name field)
                                  (.name (elem (field s nodes) (.source pass))))
                               (= expected
                                  (.name (elem (field s nodes) (.target pass)))))
                      (when (and (.occurrences? pass) (not occurrences?))
                        (break
                          :done
                            (Err (problem term
                                          "occurrence map requires an occurrence caller"))))
                      (push-str! (mut b) "(match (")
                      (function-name! (mut b)
                                      (.source pass)
                                      (.target pass)
                                      false)
                      (push-str! (mut b) " (mut state) f")
                      (number! (mut b) i)
                      (push-str! (mut b)
                                 ") (Ok [id] id) (Err [error] (break :done (Err error))))")
                      (break :done (Ok 0))))))
            (break
              :done
                (Err (problem term
                              "transform field type needs a matching schema map")))))))
    (when (scalar? expected)
      (cond (and (= expected "Int") (sexp-int? term))
              (number! (mut b) (sexp-int term))
            (and (= expected "Text") (sexp-str? term))
              (do
                (push-str! (mut b) "(store-text! (mut store) ")
                (quoted! (mut b) (sexp-str term))
                (push-str! (mut b) ")"))
            (and (= expected "Bool")
                 (or (sexp-sym-is term "true") (sexp-sym-is term "false")))
              (push-str! (mut b) (sexp-sym term))
            :else
              (break
                :done
                  (Err (problem term
                                "transform scalar must be a matching field or literal"))))
      (break :done (Ok 0)))
    (unless (and (sexp-list? term) (> (sexp-count term) 0))
      (break
        :done (Err (problem term "expected target constructor or source field"))))
    (let [target (node-number s expected)
          node (elem (field s nodes) target)
          (mut vi) (- 0 1)]

      (for [i 0 (len (.variants node))]
        (when (sexp-sym-is (sexp-nth term 0)
                           (.name (elem (field node variants) i)))
          (set! vi i)))
      (when (< vi 0)
        (break :done (Err (problem term "unknown target constructor"))))
      (let [variant (elem (field node variants) vi)]
        (unless (= (sexp-count term) (+ 1 (len (.fields variant))))
          (break :done (Err (problem term "wrong target constructor arity"))))
        (push-str! (mut b) "(let [")
        (for [i 0 (len (.fields variant))]
          (push-str! (mut b) "x")
          (number! (mut b) i)
          (push-str! (mut b) " ")
          (match (term! (mut b)
                        s
                        passes
                        forms
                        context
                        source
                        v
                        (sexp-nth term (+ i 1))
                        (.type-name (elem (field variant fields) i))
                        (.many? (elem (field variant fields) i))
                        occurrences?
                        rule)
            (Err [d] (break :done (Err d)))
            (Ok [_]))
          (push-str! (mut b) " "))
        (push-str! (mut b) "out (append-")
        (number! (mut b) target)
        (push-str! (mut b) " (mut (.rows")
        (number! (mut b) target)
        (push-str! (mut b) " store)) (N")
        (number! (mut b) target)
        (if (.sum? node)
            (do (push-str! (mut b) "V") (number! (mut b) vi))
            (push-str! (mut b) "Row"))
        (for [i 0 (len (.fields variant))]
          (unless (.sum? node) (push-str! (mut b) " :f") (number! (mut b) i))
          (push-str! (mut b) " x")
          (number! (mut b) i))
        (push-str! (mut b) "))] (push! (mut (.origins")
        (number! (mut b) target)
        (push-str! (mut b)
                   " store)) origin) (push! (mut (.traces store)) (source/Trace :target-schema ")
        (number! (mut b) target)
        (push-str! (mut b) " :target-node (.index out) :source-schema ")
        (number! (mut b) source)
        (push-str! (mut b) " :source-node (.index id) :rule-lo ")
        (number! (mut b) (.lo rule))
        (push-str! (mut b) " :rule-hi ")
        (number! (mut b) (.hi rule))
        (push-str! (mut b) ")) out)")
        (Ok 0)))))

(defn context-fields [(a (dyn Allocator)) (forms (ptr (ArrayList Sexp)))]
  (-> (Result (ArrayList Field) Diag))
  (block
    :done
      (let [(mut fields) (ArrayList::new [Field] a)
            (mut seen?) false]
        (for form-value (load forms)
          (let [(mut form) form-value]
            (when (and (sexp-list? (mut form))
                       (> (sexp-count (mut form)) 0)
                       (sexp-sym-is (sexp-nth (mut form) 0) "transform-context"))
              (when seen?
                (break
                  :done (Err (problem (mut form) "duplicate transform context"))))
              (set! seen? true)
              (for [i 1 (sexp-count (mut form))]
                (let [field (sexp-nth (mut form) i)]
                  (unless (and (sexp-list? field)
                               (= (sexp-count field) 2)
                               (sexp-sym? (sexp-nth field 0))
                               (sexp-sym? (sexp-nth field 1))
                               (name? (sexp-sym (sexp-nth field 0)))
                               (scalar? (sexp-sym (sexp-nth field 1))))
                    (break
                      :done
                        (Err (problem field
                                      "context requires (name scalar-type)"))))
                  (for old fields
                    (when (= (.name old) (sexp-sym (sexp-nth field 0)))
                      (break
                        :done (Err (problem field "duplicate context field")))))
                  (push! (mut fields)
                         (Field
                           :name (sexp-sym (sexp-nth field 0))
                           :type-name (sexp-sym (sexp-nth field 1))
                           :many? false
                           :key? false
                           :origin (load field))))))))
        (Ok fields))))

(defn emit [(a (dyn Allocator)) (s (ptr Schema)) (forms (ptr (ArrayList Sexp)))]
  (-> (Result (slice u8) Diag))
  (block
    :done
      (let [(mut context)
              (match (context-fields a forms)
                (Ok [v] v)
                (Err [d] (break :done (Err d))))
            (mut passes) (ArrayList::new [Pass] a)
            (mut uses-lexical?) false
            (mut b) (StrBuf::new a)]
        (for [i 0 (len (load forms))]
          (let [form (elem forms i)]
            (when (and (sexp-list? form)
                       (> (sexp-count form) 0)
                       (sexp-sym-is (sexp-nth form 0) "transform"))
              (unless (and (>= (sexp-count form) 4)
                           (sexp-sym? (sexp-nth form 1))
                           (or (sexp-sym? (sexp-nth form 2))
                               (and (sexp-list? (sexp-nth form 2))
                                    (= (sexp-count (sexp-nth form 2)) 2)
                                    (sexp-sym-is (sexp-nth (sexp-nth form 2) 0)
                                                 "many")
                                    (sexp-sym? (sexp-nth (sexp-nth form 2) 1)))))
                (break
                  :done
                    (Err (problem form
                                  "expected (transform Source Target (Constructor expression) ...)"))))
              (let [source (node-number s (sexp-sym (sexp-nth form 1)))
                    many? (sexp-list? (sexp-nth form 2))
                    occurrences? (sexp-kw? (sexp-nth form 3))
                    start (if occurrences? 4 3)
                    target
                      (node-number s
                                   (sexp-sym (if many?
                                                 (sexp-nth (sexp-nth form 2) 1)
                                                 (sexp-nth form 2))))]
                (when occurrences?
                  (unless (and (= (sexp-kw (sexp-nth form 3)) "occurrences")
                               (> (sexp-count form) start))
                    (break
                      :done
                        (Err (problem form
                                      "expected :occurrences followed by transformation rules")))))
                (unless (and (>= source 0) (>= target 0))
                  (break
                    :done (Err (problem form "unknown transformation schema"))))
                (for [p 0 (len passes)]
                  (let [prior (elem (mut passes) p)]
                    (when (and (= (.source prior) source)
                               (= (.target prior) target)
                               (= (.many? prior) many?))
                      (break
                        :done
                          (Err (problem form "duplicate schema transformation"))))))
                (when (contains-lexical? form) (set! uses-lexical? true))
                (push! (mut passes)
                       (Pass
                         :source source
                         :target target
                         :many? many?
                         :occurrences? occurrences?
                         :start start
                         :form (load form)))))))
        (when (= (len passes) 0) (break :done (Ok "")))
        (push-str! (mut b) "(import \"coil.str\" :use [StrBuf])\n")
        (when uses-lexical?
          (push-str! (mut b)
                     "(import \"rewrite.lexical\" :as transform-lexical)\n"))

        (push-str! (mut b)
                   "(import \"coil.primitive\" :as transform-primitive)\n(defsum TransformError (TransformAliasedStores) (TransformSequence [(error sequence/SequenceError)]) (TransformSource [(error source/SourceError)]) (TransformReference [(schema i64) (node i64)]) (TransformCycle [(schema i64) (node i64)]) (TransformOriginMissing [(schema i64) (node i64)]) (TransformSourceChanged [(schema i64)]))\n(defstruct TransformState [(sharing? bool) (source (ptr Store)) (target (ptr Store)) (copied (HashMap i64 bool)) ")
        (for [c 0 (len context)]
          (push-str! (mut b) "(context")
          (number! (mut b) c)
          (push-str! (mut b) " ")
          (push-str! (mut b)
                     (cond (= (.type-name (get context c)) "Int") "i64"
                           (= (.type-name (get context c)) "Bool") "bool"
                           :else "(slice u8)"))
          (push-str! (mut b) ") "))
        (for [p 0 (len passes)]
          (push-str! (mut b) "(memo")
          (number! (mut b) p)
          (push-str! (mut b) " (ArrayList i64)) (seqmemo")
          (number! (mut b) p)
          (push-str! (mut b) " (ArrayList i64)) "))
        (push-str! (mut b)
                   "])\n(defn transform-state-new [(a (dyn Allocator)) (input (ptr Store)) (target (ptr Store)) ")
        (for [c 0 (len context)]
          (push-str! (mut b) "(context")
          (number! (mut b) c)
          (push-str! (mut b) " ")
          (push-str! (mut b)
                     (cond (= (.type-name (get context c)) "Int") "i64"
                           (= (.type-name (get context c)) "Bool") "bool"
                           :else "(slice u8)"))
          (push-str! (mut b) ") "))
        (push-str! (mut b) "] (-> TransformState) (let [")
        (for [p 0 (len passes)]
          (push-str! (mut b) "(mut memo")
          (number! (mut b) p)
          (push-str! (mut b) ") (ArrayList::new [i64] a) (mut seqmemo")
          (number! (mut b) p)
          (push-str! (mut b) ") (ArrayList::new [i64] a) "))
        (push-str! (mut b) "] ")
        (for [p 0 (len passes)]
          (push-str! (mut b) "(for [i 0 (len (.rows")
          (number! (mut b) (.source (elem (mut passes) p)))
          (push-str! (mut b) " input))] (push! (mut memo")
          (number! (mut b) p)
          (push-str! (mut b)
                     ") (- 0 1))) (for [i 0 (len (.segments (.sequences")
          (number! (mut b) (.source (elem (mut passes) p)))
          (push-str! (mut b) " input)))] (push! (mut seqmemo")
          (number! (mut b) p)
          (push-str! (mut b) ") (- 0 1))) "))
        (push-str! (mut b)
                   "(TransformState :sharing? true :source input :target target :copied (HashMap::new-scalar [i64 bool] a) ")
        (for [c 0 (len context)]
          (push-str! (mut b) ":context")
          (number! (mut b) c)
          (push-str! (mut b) " ")
          (when (= (.type-name (get context c)) "Text")
            (push-str! (mut b) "(store-text! (mut target) "))
          (push-str! (mut b) "context")
          (number! (mut b) c)
          (when (= (.type-name (get context c)) "Text") (push-str! (mut b) ")"))
          (push-str! (mut b) " "))
        (for [p 0 (len passes)]
          (push-str! (mut b) ":memo")
          (number! (mut b) p)
          (push-str! (mut b) " memo")
          (number! (mut b) p)
          (push-str! (mut b) " :seqmemo")
          (number! (mut b) p)
          (push-str! (mut b) " seqmemo")
          (number! (mut b) p)
          (push-str! (mut b) " "))
        (push-str! (mut b)
                   ")))\n(defn transform-state-free! [(state (mut TransformState))] (-> void) (free! (mut (.copied state))) ")
        (for [p 0 (len passes)]
          (push-str! (mut b) "(free! (mut (.memo")
          (number! (mut b) p)
          (push-str! (mut b) " state))) (free! (mut (.seqmemo")
          (number! (mut b) p)
          (push-str! (mut b) " state))) "))
        (push-str! (mut b)
                   ")\n(defn transform-sequence-error [(error sequence/SequenceError)] (-> TransformError) (TransformSequence error))\n")
        (for [p 0 (len passes)]
          (let [pass (elem (mut passes) p)
                source (.source pass)
                target (.target pass)
                many? (.many? pass)
                form (field pass form)
                node (elem (field s nodes) source)
                (mut seen) (ArrayList::new [i64] a)]
            (sequence-wrapper! (mut b)
                               source
                               target
                               many?
                               (.occurrences? pass)
                               p)
            (for [i 0 (len (.variants node))] (push! (mut seen) 0))
            (push-str! (mut b) "(defn ")
            (function-name! (mut b) source target many?)
            (push-str! (mut b) " [(state (mut TransformState)) (id N")
            (number! (mut b) source)
            (push-str! (mut b) "Id)] (-> (Result N")
            (number! (mut b) target)
            (push-str! (mut b) (if many? "Seq" "Id"))
            (push-str! (mut b)
                       " TransformError)) (block :done (let [sharing? ")
            (push-str! (mut b)
                       (if (.occurrences? pass) "false" "(.sharing? state)"))
            (push-str! (mut b)
                       " input (.source state) store (.target state) memo (transform-primitive/cast (ptr (ArrayList i64)) (mut (.memo")
            (number! (mut b) p)
            (push-str! (mut b)
                       " state)))] (when (= (transform-primitive/cast i64 input) (transform-primitive/cast i64 store)) (break :done (Err (TransformAliasedStores)))) (unless (= (len (load memo)) (len (.rows")
            (number! (mut b) source)
            (push-str! (mut b)
                       " input))) (break :done (Err (TransformSourceChanged ")
            (number! (mut b) source)
            (push-str! (mut b)
                       ")))) (unless (and (>= (.index id) 0) (< (.index id) (len (load memo)))) (break :done (Err (TransformReference ")
            (number! (mut b) source)
            (push-str! (mut b)
                       " (.index id))))) (unless (< (.index id) (len (.origins")
            (number! (mut b) source)
            (push-str! (mut b)
                       " input))) (break :done (Err (TransformOriginMissing ")
            (number! (mut b) source)
            (push-str! (mut b)
                       " (.index id))))) (let [cached (get (load memo) (.index id)) origin (get (.origins")
            (number! (mut b) source)
            (push-str! (mut b)
                       " input) (.index id))] (match (source/transfer! (mut (.source-data store)) (field input source-data) origin (mut (.copied state))) (Err [error] (break :done (Err (TransformSource error)))) (Ok [_])) (when (and sharing? (>= cached 0)) (break :done (Ok (N")
            (number! (mut b) target)
            (push-str! (mut b) (if many? "Seq" "Id"))
            (push-str! (mut b)
                       " :index cached)))) (when (= cached (- 0 2)) (break :done (Err (TransformCycle ")
            (number! (mut b) source)
            (push-str! (mut b)
                       " (.index id))))) (set! (mut memo) (.index id) (- 0 2)) (defer (when (= (get (load memo) (.index id)) (- 0 2)) (set! (mut memo) (.index id) (- 0 1)))) (let [out ")
            (if (.sum? node)
                (do
                  (push-str! (mut b) "(match (get (.rows")
                  (number! (mut b) source)
                  (push-str! (mut b) " input) (.index id)) "))
                (do
                  (push-str! (mut b) "(let [row (get (.rows")
                  (number! (mut b) source)
                  (push-str! (mut b) " input) (.index id)) ")))
            (for [r (.start pass) (sexp-count form)]
              (let [rule (sexp-nth form r)
                    (mut vi) (- 0 1)]
                (unless (and (sexp-list? rule) (= (sexp-count rule) 2))
                  (break
                    :done
                      (Err (problem rule
                                    "expected (SourceConstructor TargetExpression)"))))
                (for [i 0 (len (.variants node))]
                  (when (sexp-sym-is (sexp-nth rule 0)
                                     (.name (elem (field node variants) i)))
                    (set! vi i)))
                (when (< vi 0)
                  (break
                    :done
                      (Err (problem rule
                                    "unknown transformation source constructor"))))
                (set! (mut seen) vi (+ (get seen vi) 1))
                (let [v (elem (field node variants) vi)]
                  (when (.sum? node)
                    (push-str! (mut b) "(N")
                    (number! (mut b) source)
                    (push-str! (mut b) "V")
                    (number! (mut b) vi)
                    (push-str! (mut b) " ["))
                  (for [i 0 (len (.fields v))]
                    (push-str! (mut b) "f")
                    (number! (mut b) i)
                    (unless (.sum? node)
                      (push-str! (mut b) " (.f")
                      (number! (mut b) i)
                      (push-str! (mut b) " row)"))
                    (push-str! (mut b) " "))
                  (push-str! (mut b) "] ")
                  (match (term! (mut b)
                                s
                                (mut passes)
                                forms
                                (mut context)
                                source
                                v
                                (sexp-nth rule 1)
                                (.name (elem (field s nodes) target))
                                many?
                                (.occurrences? pass)
                                rule)
                    (Err [d] (break :done (Err d)))
                    (Ok [_]))
                  (when (.sum? node) (push-str! (mut b) ") ")))))
            (for [i 0 (len seen)]
              (unless (= (get seen i) 1)
                (break
                  :done
                    (Err (problem form
                                  "each source constructor needs exactly one transformation rule")))))
            (push-str! (mut b)
                       ")] (set! (mut memo) (.index id) (if sharing? (.index out) (- 0 1))) (Ok out))))))\n")))
        (Ok (str (load b))))))
