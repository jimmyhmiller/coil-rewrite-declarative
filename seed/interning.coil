;;; Derive bottom-up canonical row construction from declared schema roots.
(module rewrite.interning)
(import "rewrite.schema" :use *)
(import "rewrite.emit" :use [number!])
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use *)
(import "coil.reader" :use *)
(import "coil.result" :use *)
(import "coil.str" :use [StrBuf])

(defn node-number [(s (ptr Schema)) (name (slice u8))] (-> i64)
  (block :found
    (for [i 0 (len (.nodes s))]
      (when (= (.name (elem (field s nodes) i)) name) (break :found i)))
    -1))

(defn selection [(a (dyn Allocator))
                 (s (ptr Schema))
                 (forms (ptr (ArrayList Sexp)))]
  (-> (Result (ArrayList bool) Diag))
  (block
    :done
      (let [(mut selected) (ArrayList::new [bool] a)
            (mut roots) (ArrayList::new [i64] a)]
        (defer (free! (mut roots)))
        (for node (.nodes s) (push! (mut selected) false))
        (for [i 0 (len (load forms))]
          (let [form (elem forms i)]
            (when (and (sexp-list? form)
                       (> (sexp-count form) 0)
                       (sexp-sym-is (sexp-nth form 0) "intern"))
              (unless (and (= (sexp-count form) 2)
                           (sexp-sym? (sexp-nth form 1)))
                (free! (mut selected))
                (break :done (Err (problem form "expected (intern Schema)"))))
              (let [id (node-number s (sexp-sym (sexp-nth form 1)))]
                (when (< id 0)
                  (free! (mut selected))
                  (break :done (Err (problem form "unknown intern schema"))))
                (for prior roots
                  (when (= prior id)
                    (free! (mut selected))
                    (break :done (Err (problem form "duplicate intern root")))))
                (push! (mut roots) id)
                (set! (mut selected) id true)))))
        (let [(mut changed?) true]
          (loop (unless changed? (break))
            (set! changed? false)
            (for [i 0 (len selected)]
              (when (get selected i)
                (for variant (.variants (elem (field s nodes) i))
                  (for field (.fields variant)
                    (unless (scalar? (.type-name field))
                      (let [child (node-number s (.type-name field))]
                        (unless (get selected child)
                          (set! (mut selected) child true)
                          (set! changed? true))))))))))
        (Ok selected))))

(defn any? [(selected (ptr (ArrayList bool)))] (-> bool)
  (block :found
    (for value (load selected) (when value (break :found true)))
    false))

(defn emit [(a (dyn Allocator))
            (s (ptr Schema))
            (selected (ptr (ArrayList bool)))] (-> (slice u8))
  (let [(mut b) (StrBuf::new a)]
    (when (any? selected)
      (push-str! (mut b)
                 "(import \"coil.str\" :use [StrBuf])\n(defsum InternError (InternUntracked [(schema i64)]) (InternReference [(schema i64) (id i64)]) (InternSequence [(error sequence/SequenceError)]))\n(defn intern-number! [(b (mut StrBuf)) (value i64)] (-> void) (push-i64! (mut b) value) (push-str! (mut b) \";\"))\n(defn intern-text! [(b (mut StrBuf)) (value (slice u8))] (-> void) (intern-number! (mut b) (len value)) (push-str! (mut b) value))\n"))
    (for [n 0 (len (.nodes s))]
      (when (get (load selected) n)
        (let [node (elem (field s nodes) n)]
          (push-str! (mut b) "(defn intern-")
          (number! (mut b) n)
          (push-str! (mut b) "! [(store (mut Store)) (row N")
          (number! (mut b) n)
          (push-str! (mut b) "Row) (origin source/Origin)] (-> (Result N")
          (number! (mut b) n)
          (push-str! (mut b)
                     "Id InternError)) (block :done (let [(mut key) (StrBuf::new (.allocator (.source-data store)))] (defer (free! (mut key))) (intern-number! (mut key) ")
          (number! (mut b) n)
          (push-str! (mut b) ") (unless (= (get (.canonical-counts store) ")
          (number! (mut b) n)
          (push-str! (mut b) ") (len (.rows")
          (number! (mut b) n)
          (push-str! (mut b) " store))) (break :done (Err (InternUntracked ")
          (number! (mut b) n)
          (push-str! (mut b) ")))) ")
          (when (.sum? node) (push-str! (mut b) "(match row "))
          (for [v 0 (len (.variants node))]
            (let [variant (elem (field node variants) v)]
              (if (.sum? node)
                  (do
                    (push-str! (mut b) "(N")
                    (number! (mut b) n)
                    (push-str! (mut b) "V")
                    (number! (mut b) v)
                    (push-str! (mut b) " ["))
                  (push-str! (mut b) "(let ["))
              (for [f 0 (len (.fields variant))]
                (push-str! (mut b) "f")
                (number! (mut b) f)
                (push-str! (mut b) " ")
                (unless (.sum? node)
                  (push-str! (mut b) "(.f")
                  (number! (mut b) f)
                  (push-str! (mut b) " row) ")))
              (push-str! (mut b) "] (intern-number! (mut key) ")
              (number! (mut b) v)
              (push-str! (mut b) ") ")
              (for [f 0 (len (.fields variant))]
                (let [field (elem (field variant fields) f)]
                  (unless (scalar? (.type-name field))
                    (let [child (node-number s (.type-name field))]
                      (push-str! (mut b)
                                 "(unless (= (get (.canonical-counts store) ")
                      (number! (mut b) child)
                      (push-str! (mut b) ") (len (.rows")
                      (number! (mut b) child)
                      (push-str! (mut b)
                                 " store))) (break :done (Err (InternUntracked ")
                      (number! (mut b) child)
                      (push-str! (mut b) ")))) ")))
                  (cond (.many? field)
                          (let [child (node-number s (.type-name field))]
                            (push-str! (mut b)
                                       "(let [(mut items) (ArrayList::new [N")
                            (number! (mut b) child)
                            (push-str! (mut b)
                                       "Id] (.allocator (.source-data store)))] (defer (free! (mut items))) (match (sequence-materialize-")
                            (number! (mut b) child)
                            (push-str! (mut b)
                                       " (.allocator (.source-data store)) store f")
                            (number! (mut b) f)
                            (push-str! (mut b)
                                       " (mut items)) (Err [e] (break :done (Err (InternSequence e)))) (Ok [_])) (intern-number! (mut key) (len items)) (for item items (unless (and (>= (.index item) 0) (< (.index item) (len (.rows")
                            (number! (mut b) child)
                            (push-str! (mut b)
                                       " store)))) (break :done (Err (InternReference ")
                            (number! (mut b) child)
                            (push-str! (mut b)
                                       " (.index item))))) (intern-number! (mut key) (.index item)))) "))
                        (= (.type-name field) "Text")
                          (do
                            (push-str! (mut b) "(intern-text! (mut key) f")
                            (number! (mut b) f)
                            (push-str! (mut b) ") "))
                        (= (.type-name field) "Int")
                          (do
                            (push-str! (mut b) "(intern-number! (mut key) f")
                            (number! (mut b) f)
                            (push-str! (mut b) ") "))
                        (= (.type-name field) "Bool")
                          (do
                            (push-str! (mut b)
                                       "(intern-number! (mut key) (if f")
                            (number! (mut b) f)
                            (push-str! (mut b) " 1 0)) "))
                        :else
                          (let [child (node-number s (.type-name field))]
                            (push-str! (mut b) "(unless (and (>= (.index f")
                            (number! (mut b) f)
                            (push-str! (mut b) ") 0) (< (.index f")
                            (number! (mut b) f)
                            (push-str! (mut b) ") (len (.rows")
                            (number! (mut b) child)
                            (push-str! (mut b)
                                       " store)))) (break :done (Err (InternReference ")
                            (number! (mut b) child)
                            (push-str! (mut b) " (.index f")
                            (number! (mut b) f)
                            (push-str! (mut b)
                                       "))))) (intern-number! (mut key) (.index f")
                            (number! (mut b) f)
                            (push-str! (mut b) ")) ")))))
              (push-str! (mut b)
                         "(match (get (.canonical store) (str key)) (Some [id] (Ok (N")
              (number! (mut b) n)
              (push-str! (mut b)
                         "Id :index id))) (None [] (let [owned (store-text! (mut store) (str key)) out (append-")
              (number! (mut b) n)
              (push-str! (mut b) " (mut (.rows")
              (number! (mut b) n)
              (push-str! (mut b) " store)) (N")
              (number! (mut b) n)
              (if (.sum? node)
                  (do (push-str! (mut b) "V") (number! (mut b) v))
                  (push-str! (mut b) "Row"))
              (for [f 0 (len (.fields variant))]
                (unless (.sum? node)
                  (push-str! (mut b) " :f")
                  (number! (mut b) f))
                (push-str! (mut b) " ")
                (when (= (.type-name (elem (field variant fields) f)) "Text")
                  (push-str! (mut b) "(store-text! (mut store) "))
                (push-str! (mut b) "f")
                (number! (mut b) f)
                (when (= (.type-name (elem (field variant fields) f)) "Text")
                  (push-str! (mut b) ")")))
              (push-str! (mut b) "))] (push! (mut (.origins")
              (number! (mut b) n)
              (push-str! (mut b)
                         " store)) origin) (set! (mut (.canonical-counts store)) ")
              (number! (mut b) n)
              (push-str! (mut b) " (len (.rows")
              (number! (mut b) n)
              (push-str! (mut b)
                         " store))) (set! (mut (.canonical store)) owned (.index out)) (Ok out))))) ")))
          (when (.sum? node) (push-str! (mut b) ")"))
          (push-str! (mut b) ")))\n"))))
    (finish! (mut b))))
