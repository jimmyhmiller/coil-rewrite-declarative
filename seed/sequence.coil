;;; Immutable sequence segments. Joins share children; handles survive table growth.
(module rewrite.sequence)
(import "coil.alloc" :use [Allocator])
(import "coil.arraylist" :use *)
(import "coil.result" :use *)
(import "coil.cc" :as cc)

(defstruct Segment [(join? bool) (start i64) (count i64) (length i64)])

(defstruct Table [T]
  [(values (ArrayList T))
   (edges (ArrayList i64))
   (segments (ArrayList Segment))])

(defsum SequenceError
  (InvalidSequence [(index i64)])
  (SequenceCapacity)
  (SequenceSourceChanged)
  (SequenceCycle [(index i64)])
  (InvalidSequenceRange [(start i64)]))

(defn create [T] [(a (dyn Allocator))] (-> (Table T))
  (Table
    :values (ArrayList::new [T] a)
    :edges (ArrayList::new [i64] a)
    :segments (ArrayList::new [Segment] a)))

(defn release! [T] [(table (mut (Table T)))] (-> void)
  (free! (mut (.values table)))
  (free! (mut (.edges table)))
  (free! (mut (.segments table))))

(defn valid? [T] [(table (ptr (Table T))) (index i64)] (-> bool)
  (and (>= index 0) (< index (len (.segments table)))))

;;; The input list must be distinct from the table's backing values.
(defn append! [T] [(table (mut (Table T))) (items (ptr (ArrayList T)))] (-> i64)
  (let [index (len (.segments table))
        start (len (.values table))
        count (len (load items))]
    (for [i 0 count] (push! (mut (.values table)) (get (load items) i)))
    (push! (mut (.segments table))
           (Segment
             :join? false
             :start start
             :count count
             :length count))
    index))

(defn singleton! [T] [(table (mut (Table T))) (item T)] (-> i64)
  (let [index (len (.segments table))
        start (len (.values table))]
    (push! (mut (.values table)) item)
    (push! (mut (.segments table))
           (Segment
             :join? false
             :start start
             :count 1
             :length 1))
    index))

;;; Edges only point to existing segments, so construction cannot introduce cycles.
;;; Validate every handle and total length before publishing any part of a join.
(defn join-range! [T] [(table (mut (Table T)))
                       (parts (ptr (ArrayList i64)))
                       (from i64)]
  (-> (Result i64 SequenceError))
  (block :done
    (unless (and (>= from 0) (<= from (len (load parts))))
      (break :done (Err (InvalidSequenceRange from))))
    (let [(mut length) 0
          (mut count) 0
          (mut only) 0]
      (for [i from (len (load parts))]
        (let [id (get (load parts) i)]
          (unless (valid? table id) (break :done (Err (InvalidSequence id))))
          (let [n (.length (get (.segments table) id))]
            (when (> n (- 9223372036854775807 length))
              (break :done (Err (SequenceCapacity))))
            (set! length (+ length n))
            (when (> n 0) (set! count (+ count 1)) (set! only id)))))
      (when (= count 1) (break :done (Ok only)))
      (let [index (len (.segments table))
            start (len (.edges table))]
        (for [i from (len (load parts))]
          (let [id (get (load parts) i)]
            (when (> (.length (get (.segments table) id)) 0)
              (push! (mut (.edges table)) id))))
        (push! (mut (.segments table))
               (Segment
                 :join? true
                 :start start
                 :count count
                 :length length))
        (Ok index)))))

(defn join! [T] [(table (mut (Table T))) (parts (ptr (ArrayList i64)))]
  (-> (Result i64 SequenceError))
  (join-range! (mut table) parts 0))

(defn size [T] [(table (ptr (Table T))) (index i64)] (-> (Option i64))
  (if (valid? table index)
      (Some (.length (get (.segments table) index)))
      (None)))

;;; Random access follows the segment path. Materialize once for sequential consumers.
(defn item [T] [(table (ptr (Table T))) (index i64) (position i64)]
  (-> (Option T))
  (block :done
    (unless (valid? table index) (break :done (None)))
    (unless (and (>= position 0)
                 (< position (.length (get (.segments table) index))))
      (break :done (None)))
    (let [(mut current) index
          (mut offset) position]
      (while true
        (let [segment (get (.segments table) current)]
          (unless (.join? segment)
            (break
              :done (Some (get (.values table) (+ (.start segment) offset)))))
          (block :child
            (for [i 0 (.count segment)]
              (let [id (get (.edges table) (+ (.start segment) i))
                    n (.length (get (.segments table) id))]
                (when (< offset n) (set! current id) (break :child 0))
                (set! offset (- offset n))))
            (panic "invalid immutable sequence segment")))))
    (None)))

;;; Inspect only the first selected path, without allocating or visiting the tail.
;;; Invalid handles/ranges and cycles on that path are errors, never empty results.
(defn first! [T] [(table (ptr (Table T))) (index i64)]
  (-> (Result (Option T) SequenceError))
  (block :done
    (let [(mut current) index
          (mut steps) 0]
      (while true
        (unless (valid? table current)
          (break :done (Err (InvalidSequence current))))
        (when (>= steps (len (.segments table)))
          (break :done (Err (SequenceCycle current))))
        (set! steps (+ steps 1))
        (let [segment (get (.segments table) current)
              available
                (if (.join? segment) (len (.edges table)) (len (.values table)))]
          (unless (and (>= (.length segment) 0)
                       (>= (.start segment) 0)
                       (<= (.start segment) available)
                       (>= (.count segment) 0)
                       (<= (.count segment) (- available (.start segment))))
            (break :done (Err (InvalidSequence current))))
          (unless (.join? segment)
            (unless (= (.length segment) (.count segment))
              (break :done (Err (InvalidSequence current))))
            (break
              :done
                (Ok (if (= (.count segment) 0)
                        (None [T])
                        (Some (get (.values table) (.start segment)))))))
          (when (= (.length segment) 0) (break :done (Ok (None [T]))))
          (let [(mut found?) false]
            (for [i 0 (.count segment)]
              (unless found?
                (let [child (get (.edges table) (+ (.start segment) i))]
                  (unless (valid? table child)
                    (break :done (Err (InvalidSequence child))))
                  (let [length (.length (get (.segments table) child))]
                    (when (< length 0)
                      (break :done (Err (InvalidSequence child))))
                    (when (> length 0) (set! current child) (set! found? true))))))
            (unless found? (break :done (Err (InvalidSequence current))))))))
    (Err (InvalidSequence index))))

;;; Explicit traversal avoids host-stack growth on deeply nested joins.
;;; Output must not alias the table's internal values.
(defn materialize! [T] [(a (dyn Allocator))
                        (table (ptr (Table T)))
                        (index i64)
                        (output (mut (ArrayList T)))]
  (-> (Result i64 SequenceError))
  (block :done
    (unless (valid? table index) (break :done (Err (InvalidSequence index))))
    (let [(mut stack) (ArrayList::new [i64] a)]
      (defer (free! (mut stack)))
      (push! (mut stack) index)
      (while (> (len stack) 0)
        (let [id
                (match (pop! (mut stack))
                  (Some [id] id)
                  (None [] (panic "sequence traversal stack")))
              segment (get (.segments table) id)]
          (if (.join? segment)
              (for [i 0 (.count segment)]
                (push! (mut stack)
                       (get (.edges table)
                            (+ (.start segment) (- (- (.count segment) 1) i)))))
              (for [i 0 (.count segment)]
                (push! (mut output)
                       (get (.values table) (+ (.start segment) i)))))))
      (Ok (.length (get (.segments table) index))))))

(defstruct MapFrame [(index i64) (position i64) (start i64)])

;;; Map shared segments once when sharing? is true, or visit every occurrence
;;; otherwise. Both modes use an explicit stack and detect active-segment cycles.
;;; The caller owns a fresh memo initialized to -1 for each immutable input segment.
(defn map-mode! [S T C E] [(a (dyn Allocator))
                           (input (ptr (Table S)))
                           (target (mut (Table T)))
                           (memo (mut (ArrayList i64)))
                           (index i64)
                           (sharing? bool)
                           (context (ptr C))
                           (element (fnptr (cc/C) [(ptr C) S] (Result i64 E)))
                           (failure (fnptr (cc/C) [SequenceError] E))]
  (-> (Result i64 E))
  (block :done
    (unless (= (len (load memo)) (len (.segments input)))
      (break :done (Err (failure (SequenceSourceChanged)))))
    (unless (valid? input index)
      (break :done (Err (failure (InvalidSequence index)))))
    (let [cached (get (load memo) index)]
      (when (and sharing? (>= cached 0)) (break :done (Ok cached)))
      (when (= cached (- 0 2))
        (break :done (Err (failure (SequenceCycle index))))))
    (let [(mut frames) (ArrayList::new [MapFrame] a)
          (mut parts) (ArrayList::new [i64] a)]
      (defer (do
               (for frame frames
                 (when (= (get (load memo) (.index frame)) (- 0 2))
                   (set! (mut memo) (.index frame) (- 0 1))))
               (free! (mut frames))
               (free! (mut parts))))
      (set! (mut memo) index (- 0 2))
      (push! (mut frames)
             (MapFrame
               :index index
               :position 0
               :start 0))
      (while (> (len frames) 0)
        (let [top (- (len frames) 1)
              frame (get frames top)
              segment (get (.segments input) (.index frame))]
          (if (= (.position frame) (.count segment))
              (let [out
                      (match (join-range! (mut target)
                                          (mut parts)
                                          (.start frame))
                        (Ok [out] out)
                        (Err [e] (break :done (Err (failure e)))))]
                (while (> (len parts) (.start frame)) (pop! (mut parts)))
                (set! (mut memo) (.index frame) (if sharing? out (- 0 1)))
                (pop! (mut frames))
                (when (= (len frames) 0) (break :done (Ok out)))
                (push! (mut parts) out))
              (do
                (set! (mut frames)
                      top
                      (MapFrame
                        :index (.index frame)
                        :position (+ (.position frame) 1)
                        :start (.start frame)))
                (if (.join? segment)
                    (let [child
                            (get (.edges input)
                                 (+ (.start segment) (.position frame)))]
                      (unless (valid? input child)
                        (break :done (Err (failure (InvalidSequence child)))))
                      (let [cached (get (load memo) child)]
                        (when (= cached (- 0 2))
                          (break :done (Err (failure (SequenceCycle child)))))
                        (if (and sharing? (>= cached 0))
                            (push! (mut parts) cached)
                            (do
                              (set! (mut memo) child (- 0 2))
                              (push! (mut frames)
                                     (MapFrame
                                       :index child
                                       :position 0
                                       :start (len parts)))))))
                    (match (element context
                                    (get (.values input)
                                         (+ (.start segment) (.position frame))))
                      (Err [e] (break :done (Err e)))
                      (Ok [id] (push! (mut parts) id))))))))
      (panic "sequence map finished without a result"))))

;;; Compact context-free mapping is the default; occurrence-sensitive consumers
;;; use map-mode! with false and a fresh memo for the duration of that traversal.
(defn map! [S T C E] [(a (dyn Allocator))
                      (input (ptr (Table S)))
                      (target (mut (Table T)))
                      (memo (mut (ArrayList i64)))
                      (index i64)
                      (context (ptr C))
                      (element (fnptr (cc/C) [(ptr C) S] (Result i64 E)))
                      (failure (fnptr (cc/C) [SequenceError] E))]
  (-> (Result i64 E))
  (map-mode! a input (mut target) (mut memo) index true context element failure))
