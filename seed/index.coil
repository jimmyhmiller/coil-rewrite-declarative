;;; Scalar keys derive incremental and batch indexes, including common sum keys.
(module rewrite.index)
(import "rewrite.schema" :use *)
(import "rewrite.emit" :use [number! type!])
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.str" :use *)

(defn index-name! [(b (mut StrBuf)) (node i64) (field i64)] (-> void)
  (push-str! (mut b) "index-")
  (number! (mut b) node)
  (push-str! (mut b) "-")
  (number! (mut b) field))

(defn insert-name! [(b (mut StrBuf)) (node i64) (field i64)] (-> void)
  (push-str! (mut b) "insert-")
  (index-name! (mut b) node field))

(defn key! [(b (mut StrBuf))
            (node (ptr Node))
            (n i64)
            (field (ptr Field))
            (f i64)] (-> void)
  (if (not (.sum? node))
      (do
        (push-str! (mut b) "(.f")
        (number! (mut b) f)
        (push-str! (mut b) " row)"))
      (do
        (push-str! (mut b) "(match row ")
        (for [v 0 (len (.variants node))]
          (let [variant (elem (field node variants) v)]
            (push-str! (mut b) "(N")
            (number! (mut b) n)
            (push-str! (mut b) "V")
            (number! (mut b) v)
            (push-str! (mut b) " [")
            (for candidate (.fields variant)
              (push-str! (mut b)
                         (if (= (.name candidate) (.name field)) "key " "_ ")))
            (push-str! (mut b) "] key) ")))
        (push-str! (mut b) ")"))))

(defn map-type! [(b (mut StrBuf)) (s (ptr Schema)) (field (ptr Field)) (n i64)]
  (-> void)
  (push-str! (mut b) "(HashMap ")
  (type! (mut b) s (.type-name field))
  (push-str! (mut b) " N")
  (number! (mut b) n)
  (push-str! (mut b) "Id)"))

(defn emit [(a (dyn Allocator)) (s (ptr Schema))] (-> (slice u8))
  (let [(mut b) (StrBuf::new a)]
    (push-str! (mut b)
               "(import \"coil.hashmap\" :use [HashMap])\n(import \"coil.str\" :as keystr)\n(defsum IndexError (DuplicateKey [(node i64) (field i64) (first i64) (second i64)]) (InvalidIndexReference [(node i64) (index i64)]))\n")
    (for [n 0 (len (.nodes s))]
      (let [node (elem (field s nodes) n)
            variant (elem (field node variants) 0)]
        (for [f 0 (len (.fields variant))]
          (let [field (elem (field variant fields) f)]
            (when (.key? field)
              (push-str! (mut b) "(defn ")
              (insert-name! (mut b) n f)
              (push-str! (mut b) " [(index (mut ")
              (map-type! (mut b) s field n)
              (push-str! (mut b) ")) (rows (ptr (ArrayList N")
              (number! (mut b) n)
              (push-str! (mut b) "Row))) (id N")
              (number! (mut b) n)
              (push-str! (mut b)
                         "Id)] (-> (Result bool IndexError)) (match (lookup-")
              (number! (mut b) n)
              (push-str! (mut b)
                         " rows id) (None [] (Err (InvalidIndexReference ")
              (number! (mut b) n)
              (push-str! (mut b) " (.index id)))) (Some [row] (let [key ")
              (key! (mut b) node n field f)
              (push-str! (mut b)
                         "] (match (get (load index) key) (Some [previous] (Err (DuplicateKey ")
              (number! (mut b) n)
              (push-str! (mut b) " ")
              (number! (mut b) f)
              (push-str! (mut b)
                         " (.index previous) (.index id)))) (None [] (set! (mut index) key id) (Ok true)))))))\n")
              (push-str! (mut b) "(defn new-")
              (index-name! (mut b) n f)
              (push-str! (mut b) " [(a (dyn Allocator))] (-> ")
              (map-type! (mut b) s field n)
              (push-str! (mut b) ") (")
              (push-str! (mut b)
                         (if (= (.type-name field) "Text")
                             "HashMap::new"
                             "HashMap::new-scalar"))
              (push-str! (mut b) " [")
              (type! (mut b) s (.type-name field))
              (push-str! (mut b) " N")
              (number! (mut b) n)
              (push-str! (mut b) "Id] a")
              (when (= (.type-name field) "Text")
                (push-str! (mut b) " (keystr/keyops)"))
              (push-str! (mut b) "))\n")
              (push-str! (mut b) "(defn ")
              (index-name! (mut b) n f)
              (push-str! (mut b)
                         " [(a (dyn Allocator)) (rows (ptr (ArrayList N")
              (number! (mut b) n)
              (push-str! (mut b) "Row))) (ids (ptr (ArrayList N")
              (number! (mut b) n)
              (push-str! (mut b) "Id)))] (-> (Result ")
              (map-type! (mut b) s field n)
              (push-str! (mut b)
                         " IndexError)) (block :done (let [(mut index) (new-")
              (index-name! (mut b) n f)
              (push-str! (mut b) " a)] (for [i 0 (len (load ids))] (match (")
              (insert-name! (mut b) n f)
              (push-str! (mut b)
                         " (mut index) rows (get (load ids) i)) (Ok [_]) (Err [e] (free! (mut index)) (break :done (Err e))))) (Ok index))))\n"))))))
    (str (load b))))
