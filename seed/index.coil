;;; A unique field derives a content-keyed index and duplicate provenance.
(module rewrite.index)
(import "rewrite.schema" :use *)
(import "rewrite.emit" :use [number! type!])
(import "coil.alloc" :use *)
(import "coil.arraylist" :use *)
(import "coil.str" :use *)

(defn index-name! [(b (mut StrBuf)) (node i64) (field i64)] (-> void)
  (push-str! (mut b) "index-")
  (number! (mut b) node)
  (push-str! (mut b) "-")
  (number! (mut b) field))

(defn emit [(a (dyn Allocator)) (s (ptr Schema))] (-> (slice u8))
  (let [(mut b) (StrBuf::new a)]
    (push-str! (mut b)
               "(import \"coil.hashmap\" :use [HashMap])\n(import \"coil.str\" :as keystr)\n(defsum IndexError (DuplicateKey [(node i64) (field i64) (first i64) (second i64)]) (InvalidIndexReference [(node i64) (index i64)]))\n")
    (for [n 0 (len (.nodes s))]
      (let [node (elem (field s nodes) n)]
        (unless (.sum? node)
          (let [variant (elem (field node variants) 0)]
            (for [f 0 (len (.fields variant))]
              (let [field (elem (field variant fields) f)]
                (when (.key? field)
                  (push-str! (mut b) "(defn ")
                  (index-name! (mut b) n f)
                  (push-str! (mut b)
                             " [(a (dyn Allocator)) (rows (ptr (ArrayList N")
                  (number! (mut b) n)
                  (push-str! (mut b) "Row))) (ids (ptr (ArrayList N")
                  (number! (mut b) n)
                  (push-str! (mut b) "Id)))] (-> (Result (HashMap ")
                  (type! (mut b) s (.type-name field))
                  (push-str! (mut b) " N")
                  (number! (mut b) n)
                  (push-str! (mut b)
                             "Id) IndexError)) (block :done (let [(mut index) (")
                  (push-str! (mut b)
                             (if (= (.type-name field) "Text")
                                 "HashMap::new"
                                 "HashMap::new-scalar"))
                  (push-str! (mut b) " [")
                  (type! (mut b) s (.type-name field))
                  (push-str! (mut b) " N")
                  (number! (mut b) n)
                  (push-str! (mut b) "Id] a")
                  (when (= (.type-name field) "Text")
                    (push-str! (mut b) " (keystr/keyops)"))
                  (push-str! (mut b)
                             ")] (for [i 0 (len (load ids))] (let [id (get (load ids) i)] (match (lookup-")
                  (number! (mut b) n)
                  (push-str! (mut b)
                             " rows id) (None [] (free! (mut index)) (break :done (Err (InvalidIndexReference ")
                  (number! (mut b) n)
                  (push-str! (mut b)
                             " (.index id))))) (Some [row] (let [key (.f")
                  (number! (mut b) f)
                  (push-str! (mut b)
                             " row)] (match (get index key) (Some [previous] (free! (mut index)) (break :done (Err (DuplicateKey ")
                  (number! (mut b) n)
                  (push-str! (mut b) " ")
                  (number! (mut b) f)
                  (push-str! (mut b)
                             " (.index previous) (.index id))))) (None [] (set! (mut index) key id)))))))) (Ok index))))\n"))))))))
    (str (load b))))
