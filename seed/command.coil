;;; Standard CLI I/O adapter for the declared unary source-program interface.
(module rewrite.command)

(defn emit [] (-> (slice u8))
  "(import \"coil.fs\" :as command-fs)\n(import \"coil.str\" :as command-text)\n(import \"coil.scratch\" :use [ScratchArena])\n(import \"coil.primitive\" :as command-primitive)\n(import \"coil.cc\" :as command-cc)\n(import \"declarative.rt.jit\" :as command-jit)\n(defn main [(argc i32) (argv (ptr (ptr i8)))] (-> i64)\n  (block :command\n    (unless (= argc 5)\n      (println \"usage: coil-rewrite run <file.coil> <entry> <integer>\")\n      (break :command 2))\n    (unless (= (command-text/from-cstr (load (index argv 1))) \"run\")\n      (println \"expected run command\") (break :command 2))\n    (let [(mut scratch) (zeroed ScratchArena)\n          initialized (init (mut scratch) (malloc-allocator)) a (allocator (mut scratch))\n          path (command-text/from-cstr (load (index argv 2)))\n          entry (command-text/from-cstr (load (index argv 3)))\n          argument (match (command-text/parse-int (command-text/from-cstr (load (index argv 4))))\n                     (Some [v] v) (None [] (println \"invalid integer argument\") (break :command 2)))\n          (mut store) (store-new a)]\n      (defer (close! (mut scratch))) (defer (store-free! (mut store)))\n      (let [text (match (command-fs/read-file a path)\n                   (Ok [v] v) (Err [_] (println \"cannot read {}\" path) (break :command 1)))\n            image (match (compile-source a (mut store) path text 1)\n              (Ok [v] v)\n              (Err [e]\n                (match e\n                  (SourceRead [d] (println \"{}:{}: {}\" path (.lo d) (.msg d)))\n                  (SourceDeclaration [d] (println \"{}:{}: {}\" path (.lo d) (.msg d)))\n                  (SourceChecking [e]\n                    (match e\n                      (DuplicateFunction [name] (println \"duplicate function: {}\" name))\n                      (InvalidBody [name _] (println \"type checking failed in {}\" name))\n                      (WrongReturn [name _] (println \"wrong return type in {}\" name))\n                      (InvalidFunction [_] (println \"invalid function reference\"))))\n                  (SourceDocument [_] (println \"invalid source document\")))\n                (break :command 1)))\n            (mut symbol) -1]\n        (for [i 0 (len (.names image))]\n          (when (= (get (.names image) i) entry) (set! symbol i)))\n        (when (< symbol 0) (println \"entry not found: {}\" entry) (break :command 1))\n        (let [loaded (native/load-image a image)\n              run (command-primitive/cast (fnptr (command-cc/C) [i64] i64) (command-jit/address-of loaded symbol))]\n          (defer (command-jit/unload! loaded))\n          (println \"{}\" (run argument)))))\n    0))\n")
