;;; Borrowed lexical frames ending at an optional immutable global index.
(module rewrite.scope)
(import "coil.hashmap" :use [HashMap])
(import "coil.result" :use *)

(defstruct Scope [V]
  [(present bool)
   (indexed bool)
   (name (slice u8))
   (value V)
   (parent (ptr (Scope V)))
   (globals (ptr (HashMap (slice u8) V)))])

;;; Parent frames and names must outlive this frame. Binding does not mutate them.
(defn scope-bind [V] [(parent (ptr (Scope V))) (name (slice u8)) (value V)]
  (-> (Scope V))
  (Scope [V]
         :present
         true
         :indexed
         false
         :name
         name
         :value
         value
         :parent
         parent
         :globals
         (zeroed (ptr (HashMap (slice u8) V)))))

;;; The index is borrowed, and must remain immutable while this scope is used.
(defn scope-global [V] [(index (ptr (HashMap (slice u8) V)))] (-> (Scope V))
  (Scope [V]
         :present
         false
         :indexed
         true
         :name
         ""
         :value
         (zeroed V)
         :parent
         (zeroed (ptr (Scope V)))
         :globals
         index))

(defn scope-lookup [V] [(scope (ptr (Scope V))) (name (slice u8))]
  (-> (Option V))
  (block
    :found
      (let [(mut cursor) scope]
        (loop (unless (.present cursor) (break))
          (when (= (.name cursor) name) (break :found (Some (.value cursor))))
          (set! cursor (.parent cursor)))
        (if (.indexed cursor) (get (load (.globals cursor)) name) (None)))))
