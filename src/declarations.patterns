(extract function-generics FunctionGenerics GenericParameters Monomorphic
  (list (spellings "defn" "defn*") symbol (optional (keyword "cc") (list symbol)) (optional (keyword "inline") _)
        (capture types (vector ...)) (vector ...) (list "->" _) ...))
(extract ordinary-function FunctionDeclaration Function NoFunction
  (capture declaration (list (spellings "defn" "defn*") (capture name symbol)
        (optional (keyword "cc") (list symbol)) (optional (keyword "inline") _) (optional (vector ...))
        (capture parameters (vector ...)) (list "->" (capture result _)) ...)))
(extract inline-annotation InlineAnnotation Inline NoInline
  (list (spellings "defn" "defn*") symbol (optional (keyword "cc") (list symbol)) (keyword "inline") (capture value _) ...))
(extract typed-parameter ParameterDeclaration Parameter NoParameter
  (list (capture name symbol) (capture type _)))
(extract nullary-call CallExpression Call NoCall
  (list (capture callee symbol)))
(recognize float-literal? floating)
(recognize int-literal? integer)
(recognize true-literal? "true")
(recognize false-literal? "false")
(recognize explicit-call-name? "call")
(recognize explicit-call? (list (matches explicit-call-name?) ...))
(extract application Application Apply NoApplication
  (list (matches explicit-call-name?) (capture operator symbol) ...)
  (list (capture operator symbol) ...))
(recognize identifier? symbol)
(extract conditional Conditional Branches NoConditional
  (list "if" (capture condition _) (capture then _) (capture else _)))
(extract sequence-expression SequenceExpression Sequence NoSequence
  (list "do" ...))
(extract local-bindings LetExpression Bindings NoBindings
  (list (spellings "let" "let*") (capture bindings (vector ...)) _ ...))
(extract mutable-binding MutableBinding CellBinding NoCellBinding
  (list "mut" (capture name symbol)))
(extract local-store LocalStore WriteLocal NoWriteLocal
  (list "set!" (capture name symbol) (capture value _)))
(extract explicit-store ExplicitStore StoreLocal NoStoreLocal
  (list "store!" (capture name symbol) (capture value _)))
(extract explicit-load ExplicitLoad LoadLocal NoLoadLocal
  (list "load" (capture name symbol)))
(extract type-ascription Ascription Ascribed NoAscription
  (list (keyword "") (capture value _) (capture type _)))
(extract numeric-cast NumericCast Convert NoCast
  (list "cast" (capture type _) (capture value _)))
(recognize repetition? (list "loop" _ ...))
(recognize exit-loop? (list "break" ...))
(recognize next-iteration? (list "continue" ...))
(recognize named-block? (list "block*" _ ...))
(extract cleanup-form CleanupForm Guard NoGuard (list "defer*" (capture cleanup _)))
(extract module-header ModuleHeader NamedModule NoModule
  (list "module" (capture name symbol) ...))
(recognize module-form? (list "module" ...))
(extract import-module ModuleImport Imported NoImport
  (list "import" (capture target string) ...))
(recognize export-form? (list "export" ...))
(extract external-function ExternalDeclaration External NoExternal
  (list "extern" (capture name symbol) (capture parameters (vector ...)) (list "->" (capture result _)))
  (list "extern" (capture name symbol) (keyword "cc") (list symbol)
        (capture parameters (vector ...)) (list "->" (capture result _))))
(extract linked-external LinkedExternal LinkedExtern NoLinkedExtern
  (list "extern" (capture name symbol) (keyword "as") (capture link string)
        (capture parameters (vector ...)) (list "->" (capture result _)))
  (list "extern" (capture name symbol) (keyword "as") (capture link string) (keyword "cc") (list symbol)
        (capture parameters (vector ...)) (list "->" (capture result _)))
  (list "extern" (capture name symbol) (keyword "cc") (list symbol) (keyword "as") (capture link string)
        (capture parameters (vector ...)) (list "->" (capture result _))))
(extract constant-declaration ConstantDeclaration Constant NoConstant
  (list (spellings "const" "def") (capture name symbol) (capture initializer _)))
(recognize static-definition? (list "def" ...))
(recognize layout-name? (spellings "sizeof" "alignof"))
(extract layout-query LayoutQuery LayoutOf NoLayoutQuery
  (list (capture query (matches layout-name?)) (capture type _)))
(extract address-layout AddressLayout AddressOf NoAddressLayout
  (list (capture kind (spellings "ptr" "mut" "ref" "slice")) (capture element _)))
(extract array-layout ArrayLayout ArrayOf NoArrayLayout
  (list "array" (capture element _) (capture count integer))
  (list "array" (capture element _) (capture count symbol)))
(extract function-pointer-layout FunctionPointerLayout FunctionPointer NoFunctionPointer
  (list "fnptr" (list (capture convention symbol))
        (capture parameters (vector ...)) (capture result _)))
(extract structure StructDeclaration Struct NoStruct
  (list "defstruct" (capture name symbol) (capture fields (vector ...)))
  (list "defstruct" (capture name symbol) (vector ...) (capture fields (vector ...)))
  (list "defstruct" (capture name symbol) (keyword "layout") _ (capture fields (vector ...))))
(extract nominal-parameters NominalParameters TypeParameters NoTypeParameters
  (list "defstruct" symbol (capture parameters (vector ...)) (vector ...))
  (list "defsum" symbol (capture parameters (vector ...)) ...))
(extract type-application TypeApplication AppliedType NoAppliedType
  (list (capture constructor symbol) ...))
(extract layout-annotation LayoutAnnotation Annotated NoAnnotation
  (list "defstruct" symbol (keyword "layout") (capture expression _) _))
(extract layout-constructor LayoutConstructor Constructor NoConstructor
  (list (capture name symbol) ...))
(recognize offset-name? "offsetof")
(extract field-offset-query FieldOffsetQuery OffsetOf NoOffsetOf
  (list (matches offset-name?) (capture type symbol) (capture field symbol)))
(extract sum-declaration SumDeclaration Sum NoSum
  (list "defsum" (capture name symbol) ...))
(extract variant-name VariantName VariantNamed NoVariantName
  (list (capture name symbol))
  (list (capture name symbol) (vector ...)))
(extract variant-fields VariantFields Payload NoPayload
  (list symbol (capture fields (vector ...))))
(extract declared-convention DeclaredConvention Convention NoConvention
  (list (spellings "defn" "defn*" "extern") symbol (keyword "cc") (list (capture name symbol)) ...)
  (list "extern" symbol (keyword "as") string (keyword "cc") (list (capture name symbol)) ...))

(extract primitive-header PrimitiveHeader Primitive NoPrimitive
  (list "defprimitive" (capture name symbol) ...))

(extract trait-declaration TraitDeclaration Trait NoTrait
  (list "deftrait" (capture name symbol) (capture parameters (vector _ ...)) ...))
(extract trait-method TraitMethod Method NoMethod
  (list (capture name symbol) (optional (keyword "inline") _) (capture parameters (vector ...)) (list "->" (capture result _)) ...))
(extract scalar-implementation ScalarImplementation ScalarImpl NoScalarImpl
  (list "impl" (capture trait symbol) (capture target symbol) ...))
(extract bounded-parameter BoundedParameter Bounded NoBounds
  (list (capture name symbol) symbol ...))
(recognize trait-form? (list "deftrait" ...))
(recognize scalar-impl? (list "impl" symbol symbol ...))
(extract required-traits RequiredTraits Requires NoRequires
  (list "deftrait" symbol (vector ...) (keyword "requires") (capture bases (vector ...)) ...))

(extract inherent-implementation InherentImplementation InherentImpl NoInherentImpl
  (list "impl" (capture target symbol))
  (list "impl" (capture target symbol) (list ...) ...)
  (list "impl" (vector ...) (capture target (list symbol ...)) (list ...) ...))
(extract impl-type-parameters ImplTypeParameters ImplParameters NoImplParameters
  (list "impl" (capture types (vector ...)) (list symbol ...) ...))
