(use "rewrite.declarations")
(use "rewrite.host")
(use "coil.alloc")
(use "coil.text")
(use "coil.fs")
(use "coil.project")
(use "coil.compiler.stdlib_manifest")
(use "coil.path")
(use "coil.source.diagnostic")
(use "coil.io")
(use "coil.slice")

(context WildcardImport [(provider (ptr ModuleScope)) (excluded (coil.hashmap.HashMap (slice u8) bool))])
(value foreign-signature [(form (ptr coil.reader.Sexp))] ExternalDeclaration
  (match (linked-external form)
    (LinkedExtern [name _ parameters result] (External name parameters result))
    (_ (external-function form))))

(value external-symbol [(form (ptr coil.reader.Sexp)) (name (ptr coil.reader.Sexp))] (slice u8)
  (match (linked-external form)
    (LinkedExtern [_ link _ _] (coil.reader.sexp-str link))
    (_ (coil.reader.sexp-sym name))))

(value function-body-start [(form (ptr coil.reader.Sexp)) (parameters (ptr coil.reader.Sexp))] i64
  (block :found
    (for [i 2 (coil.reader.sexp-count form)]
      (when (= (.node-id (coil.reader.sexp-nth form i)) (.node-id parameters))
        (return-from :found (+ i 2))))
    (unreachable "function parameters missing from their declaration")))

(value callable [(form (ptr coil.reader.Sexp))] FunctionDeclaration
  (match (foreign-signature form)
    (External [name parameters result] (Function form name parameters result))
    (_ (ordinary-function form))))

(predicate macro-function? [(form (ptr coil.reader.Sexp))]
  (match (ordinary-function form) (Function [_ _ _ result] (coil.reader.sexp-sym-is result "Code")) (_ false)))

(value type-name [(form (ptr coil.reader.Sexp))] (Option (ptr coil.reader.Sexp))
  (match (structure form)
    (Struct [name _] (Some name))
    (_ (match (sum-declaration form) (Sum [name] (Some name)) (_ (None [(ptr coil.reader.Sexp)]))))))

(value trait-method-start [(form (ptr coil.reader.Sexp))] i64
  (match (required-traits form) (Requires [_] 5) (_ 3)))

(value variant-start [(form (ptr coil.reader.Sexp))] i64
  (match (nominal-parameters form) (TypeParameters [_] 3) (_ 2)))

(value declaration-name [(form (ptr coil.reader.Sexp))] (Option (ptr coil.reader.Sexp))
  (match (constant-declaration form)
    (Constant [name _] (Some name))
    (_ (match (primitive-header form)
         (Primitive [name] (Some name))
         (_ (match (callable form) (Function [_ name _ _] (Some name)) (_ (None [(ptr coil.reader.Sexp)]))))))))

(predicate external? [(form (ptr coil.reader.Sexp))]
  (match (foreign-signature form) (External [_ _ _] true) (_ false)))

(predicate same-foreign-signature? [(left (ptr coil.reader.Sexp)) (right (ptr coil.reader.Sexp))]
  (block :compare
    (match (foreign-signature left)
      (External [lname a r]
        (match (foreign-signature right)
          (External [rname b s]
            (when (or (!= (external-symbol left lname) (external-symbol right rname))
                      (!= (coil.reader.sexp-count a) (coil.reader.sexp-count b))
                      (not (coil.reader.sexp-sym? r))
                      (not (coil.reader.sexp-sym-is s (coil.reader.sexp-sym r))))
              (return-from :compare false))
            (for [i 0 (coil.reader.sexp-count a)]
              (let [param (coil.reader.sexp-nth a i)]
                (unless (and (coil.reader.sexp-sym? param)
                             (coil.reader.sexp-sym-is (coil.reader.sexp-nth b i) (coil.reader.sexp-sym param)))
                  (return-from :compare false))))
            true)
          (_ false)))
      (_ false))))

(domain NameSpace (MethodNames) (TraitNames) (ValueNames) (TypeNames) (VariantNames))

(context ModuleScope
  [(wildcards (coil.arraylist.ArrayList WildcardImport)) (explicit-exports bool) (exports (coil.hashmap.HashMap (slice u8) bool))
   (selected (coil.hashmap.HashMap (slice u8) (ptr ModuleScope)))
   (aliases (coil.hashmap.HashMap (slice u8) (ptr ModuleScope)))
   (namespace (slice u8))
   (method-names (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))
   (method-groups (coil.hashmap.HashMap (slice u8) (ptr (coil.arraylist.ArrayList (ptr coil.reader.Sexp)))))
   (trait-members (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp))) (trait-locals (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))
   (variant-members (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp))) (variant-locals (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))
   (type-members (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp))) (type-locals (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))
   (members (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))
   (locals (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))])
(context VisibilityCheck [(scope (ptr ModuleScope)) (name (ptr coil.reader.Sexp)) (definition? bool)])
(context SourceUnit
  [(scopes (ptr (coil.hashmap.HashMap (slice u8) (ptr ModuleScope))))
   (visibility (coil.arraylist.ArrayList VisibilityCheck))
   (declarations (ptr (coil.arraylist.ArrayList coil.reader.Sexp)))
   (owners (coil.hashmap.HashMap i64 (ptr ModuleScope)))
   (symbols (coil.hashmap.HashMap i64 (slice u8)))
   (variants (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))
   (method-traits (coil.hashmap.HashMap i64 (ptr coil.reader.Sexp)))
   (inherent-methods (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))
   (inherent-names (coil.hashmap.HashMap (slice u8) bool))
   (method-functions (coil.hashmap.HashMap i64 (ptr coil.reader.Sexp)))
   (qualified-methods (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))
   (traits (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))
   (type-globals (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))
   (globals (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))])
(context Lookup [(scope (ptr ModuleScope)) (unit (ptr SourceUnit))])

(value lookup-for [(unit (ptr SourceUnit)) (form (ptr coil.reader.Sexp))] Lookup
  (match (get (.owners unit) (.node-id form))
    (Some [scope] (Lookup :scope scope :unit unit))
    (_ (unreachable "declaration missing from module index"))))

(value symbol-for [(lookup Lookup) (form (ptr coil.reader.Sexp))] (slice u8)
  (match (get (.symbols (.unit lookup)) (.node-id form))
    (Some [symbol] symbol)
    (_ (unreachable "function missing from symbol index"))))

(predicate exported? [(scope (ptr ModuleScope)) (name (slice u8))]
  (or (not (.explicit-exports scope)) (contains? (.exports scope) name)))

(value members-of [(scope (ptr ModuleScope)) (space NameSpace)] (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp))
  (match space (MethodNames [] (.method-names scope)) (TraitNames [] (.trait-members scope)) (TypeNames [] (.type-members scope)) (VariantNames [] (.variant-members scope)) (ValueNames [] (.members scope))))

(derive find-declaration [(lookup Lookup) (site (ptr coil.reader.Sexp))] (Option (ptr coil.reader.Sexp))
  (obtain result (find-name lookup site (ValueNames)) (conclude result)))

(derive find-name [(lookup Lookup) (site (ptr coil.reader.Sexp)) (space NameSpace)] (Option (ptr coil.reader.Sexp))
  (with scope (if (= (.hyg site) 0) (.scope lookup)
                  (match (get (load (.scopes (.unit lookup))) (coil.reader.hmod-name (.hmod site)))
                    (Some [owner] owner) (_ (.scope lookup))))
    (obtain result (find-in-scope (Lookup :unit (.unit lookup) :scope scope) site space) (conclude result))))

(derive find-in-scope [(lookup Lookup) (site (ptr coil.reader.Sexp)) (space NameSpace)] (Option (ptr coil.reader.Sexp))
  (with name (coil.reader.sexp-sym site)
    (each-index i (len name)
      (when (and (> i 0) (= (get name i) (: 47 u8)))
        (cases (get (.aliases (.scope lookup)) (subslice name 0 i))
          ((Some [target])
            (with member (subslice name (+ i 1) (len name))
              (require (or (= (.namespace target) (.namespace (.scope lookup))) (exported? target member))
                       site "qualified name is private to the imported module")
              (conclude (get (members-of target space) member))))
          (_))))
    (cases (get (match space (MethodNames [] (.method-names (.scope lookup))) (TraitNames [] (.trait-locals (.scope lookup))) (TypeNames [] (.type-locals (.scope lookup))) (VariantNames [] (.variant-locals (.scope lookup))) (ValueNames [] (.locals (.scope lookup)))) name)
      ((Some [local]) (conclude (Some local)))
      (_))
    (with (mut candidate) (match (get (.selected (.scope lookup)) name)
                             (Some [provider] (get (members-of provider space) name))
                             (_ (None [(ptr coil.reader.Sexp)])))
      (each-index i (len (.wildcards (.scope lookup)))
        (with wildcard (get (.wildcards (.scope lookup)) i)
          (when (and (not (contains? (.excluded wildcard) name)) (exported? (.provider wildcard) name))
            (cases (get (members-of (.provider wildcard) space) name)
              ((Some [found])
                (cases (load candidate)
                  ((Some [prior]) (require (= (.node-id prior) (.node-id found)) site "ambiguous imported name"))
                  (_ (perform (set! candidate (Some found))))))
              (_)))))
      (cases (load candidate)
        ((Some [found]) (conclude (Some found)))
        (_ (conclude (get (match space (MethodNames [] (.qualified-methods (.unit lookup))) (TraitNames [] (.traits (.unit lookup))) (TypeNames [] (.type-globals (.unit lookup))) (VariantNames [] (.variants (.unit lookup))) (ValueNames [] (.globals (.unit lookup)))) name)))))))

(value new-scope [(allocator (dyn coil.alloc.Allocator)) (name (slice u8))] (ptr ModuleScope)
  (let [scope (box! allocator ModuleScope (ModuleScope :namespace name
    :wildcards (coil.arraylist.ArrayList::new [WildcardImport] allocator) :explicit-exports false
    :exports (coil.hashmap.HashMap::new [(slice u8) bool] allocator (coil.str.keyops-borrowed))
    :selected (coil.hashmap.HashMap::new [(slice u8) (ptr ModuleScope)] allocator (coil.str.keyops-borrowed))
    :aliases (coil.hashmap.HashMap::new [(slice u8) (ptr ModuleScope)] allocator (coil.str.keyops-borrowed))
    :variant-members (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))
    :variant-locals (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))
    :method-names (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))
    :method-groups (coil.hashmap.HashMap::new [(slice u8) (ptr (coil.arraylist.ArrayList (ptr coil.reader.Sexp)))] allocator (coil.str.keyops-borrowed))
    :trait-members (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))
    :trait-locals (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))
    :type-members (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))
    :type-locals (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))
    :members (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))
    :locals (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))))]
    (set! (mut (.aliases scope)) name scope)
    scope))

(judgment bind-import [(unit (mut SourceUnit)) (scope (ptr ModuleScope)) (provider (ptr ModuleScope)) (form (ptr coil.reader.Sexp))]
  (require (= (% (coil.reader.sexp-count form) 2) 0) form "import option requires a value")
  (with (mut alias) (.namespace provider)
    (with (mut selected) (None [(ptr coil.reader.Sexp)])
      (with (mut exclusions) (None [(ptr coil.reader.Sexp)])
        (each-index i (/ (- (coil.reader.sexp-count form) 2) 2)
          (with option (coil.reader.sexp-nth form (+ 2 (* i 2)))
            (with value (coil.reader.sexp-nth form (+ 3 (* i 2)))
              (require (coil.reader.sexp-kw? option) option "expected import option")
              (with key (coil.reader.sexp-kw option)
                (require (or (= key "as") (= key "use") (= key "exclude")) option "unsupported import option")
                (when (= key "as")
                  (require (coil.reader.sexp-sym? value) value "import: :as expects an alias symbol")
                  (perform (set! alias (coil.reader.sexp-sym value))))
                (when (= key "exclude")
                  (require (coil.reader.sexp-vec? value) value "import: :exclude expects [names]")
                  (perform (set! exclusions (Some value))))
                (when (= key "use")
                  (require (or (coil.reader.sexp-vec? value) (coil.reader.sexp-sym-is value "*")) value "import: :use expects * or [names]")
                  (perform (set! selected (Some value))))))))
        (record (.aliases scope) (.namespace provider) provider)
        (record (.aliases scope) (load alias) provider)
        (cases (load selected)
          ((Some [names])
            (when (coil.reader.sexp-sym-is names "*")
              (with (mut excluded) (coil.hashmap.HashMap::new [(slice u8) bool] (.alc (.wildcards scope)) (coil.str.keyops-borrowed))
                (cases (load exclusions)
                  ((Some [items])
                    (each-child item items 0 position
                      (when (coil.reader.sexp-sym? item)
                        (record excluded (coil.reader.sexp-sym item) true))))
                  (_))
                (perform (push! (mut (.wildcards scope)) (WildcardImport :provider provider :excluded excluded))))
              (accept))
            (cases (load exclusions) ((Some [items]) (reject items ":exclude requires :use *")) (_))
            (each-child name names 0 index
              (when (coil.reader.sexp-sym? name)
                (with spelling (coil.reader.sexp-sym name)
                  (cases (get (.selected scope) spelling)
                    ((Some [prior]) (require (= (.namespace prior) (.namespace provider)) name "name imported from two modules"))
                    (_))
                  (perform (push! (mut (.visibility unit)) (VisibilityCheck :scope provider :name name :definition? false)))
                  (record (.selected scope) spelling provider)))))
          (_))))))

(value definition-name [(allocator (dyn coil.alloc.Allocator)) (namespace (slice u8))
                        (entry? bool) (spelling (slice u8))] (slice u8)
  (if (or (= namespace "") (and entry? (= spelling "main"))) spelling
      (let [prefix (coil.text.sconcat allocator namespace ".")]
        (if (coil.str.starts-with spelling prefix) spelling
            (coil.text.sconcat allocator prefix spelling)))))


(value implicit-module-name [(allocator (dyn coil.alloc.Allocator)) (path (slice u8))] (slice u8)
  (let [base (coil.path.basename path)
        end (cond (coil.project.d-ends-with? base ".coil") (- (len base) 5)
                  (coil.project.d-ends-with? base ".scm") (- (len base) 4)
                  :else (len base))
        (mut bytes) (coil.arraylist.ArrayList::new [u8] allocator)]
    (when (and (> end 0) (>= (get base 0) #\0) (<= (get base 0) #\9))
      (push! (mut bytes) (: 95 u8)))
    (for [i 0 end]
      (let [c (get base i)]
        (push! (mut bytes) (if (or (and (>= c #\a) (<= c #\z)) (and (>= c #\A) (<= c #\Z))
                                   (and (>= c #\0) (<= c #\9)) (= c #\-) (= c #\_)) c (: 95 u8)))))
    (if (= end 0) "app" (slice bytes))))

(context SourceFile [(path (slice u8)) (bytes (slice u8))])
(context NativePackage [(root (slice u8)) (manifest (Option (ptr coil.project.Manifest)))
                        (requires (coil.arraylist.ArrayList (slice u8)))])
(context PackageRoot [(member-prefix (slice u8)) (owner (slice u8)) (path (slice u8)) (excludes (slice u8))])
(context Sources [(command (slice u8)) (library (Option (slice u8)))
                  (packages (coil.hashmap.HashMap (slice u8) (ptr NativePackage)))
                  (dependency-roots (coil.arraylist.ArrayList PackageRoot))
                  (mapped-paths (coil.hashmap.HashMap (slice u8) bool))
                  (manifest (Option (ptr coil.project.Manifest))) (indexed bool)
                  (files (coil.arraylist.ArrayList SourceFile))
                  (conflicts (coil.hashmap.HashMap (slice u8) (slice u8)))
                  (mappings (coil.hashmap.HashMap (slice u8) (slice u8)))
                  (providers (coil.hashmap.HashMap (slice u8) (ptr ModuleScope)))
                  (scopes (coil.hashmap.HashMap (slice u8) (ptr ModuleScope)))
                  (root (slice u8))])

(judgment package-mappings [(allocator (dyn coil.alloc.Allocator)) (sources (ptr Sources))
                            (root (slice u8)) (manifest (ptr coil.project.Manifest))]
  (each-index i (len (load (.modules manifest)))
    (with mapping (elem (.modules manifest) i)
      (with path (coil.path.path-join allocator root (.value mapping))
        (when (contains? (.mappings sources) (.key mapping))
          (fail (coil.text.sconcat allocator "duplicate module mapping: " (.key mapping))))
        (record (.mappings sources) (.key mapping) path)
        (cases (coil.project.m-realpath allocator path)
          ((Some [canonical]) (record (.mapped-paths sources) canonical true))
          (_))))))

(predicate package-contains? [(root (slice u8)) (path (slice u8))]
  (and (coil.str.starts-with path root)
       (or (= (len root) (len path)) (= root "/") (= (get path (len root)) (: 47 u8)))))

(judgment dependency-roots [(allocator (dyn coil.alloc.Allocator)) (sources (ptr Sources))
                            (root (slice u8)) (manifest (ptr coil.project.Manifest)) (origin (slice u8))]
  (with excludes (coil.project.m-excludes-env-at allocator manifest root)
    (with roots (coil.project.m-effective-roots allocator manifest root)
      (with before (len (.dependency-roots sources))
        (each-index i (len (load roots))
          (with path (coil.path.path-join allocator root (get (load roots) i))
            (cases (coil.project.m-realpath allocator path)
              ((Some [canonical])
                (when (not (package-contains? root canonical))
                  (fail (coil.text.sconcat3 allocator origin " declares a source root outside the package: " canonical)))
                (perform (push! (mut (.dependency-roots sources)) (PackageRoot :member-prefix "" :owner root :path canonical :excludes excludes))))
              (_))))
        (when (= before (len (.dependency-roots sources)))
          (perform (push! (mut (.dependency-roots sources)) (PackageRoot :member-prefix "" :owner root :path root :excludes excludes))))))))

(value native-package [(allocator (dyn coil.alloc.Allocator)) (root (slice u8))] (ptr NativePackage)
  (box! allocator NativePackage (NativePackage :root root :manifest (None [(ptr coil.project.Manifest)])
    :requires (coil.arraylist.ArrayList::new [(slice u8)] allocator))))

(judgment read-dependencies [(allocator (dyn coil.alloc.Allocator)) (sources (ptr Sources))
                             (owner (ptr NativePackage)) (manifest (ptr coil.project.Manifest))]
  (each-index i (len (load (.deps manifest)))
    (with dep (elem (.deps manifest) i)
      (with origin (coil.text.sconcat3 allocator (coil.path.path-join allocator (.root owner) "Coil.toml") ":"
                     (coil.text.sconcat3 allocator (coil.text.i64->str allocator (.line dep)) ": dependency " (.name dep)))
        (when (= (len (.path dep)) 0) (fail (coil.text.sconcat allocator origin " requires Git dependency resolution")))
        (with path (coil.path.path-join allocator (.root owner) (.path dep))
          (cases (coil.project.m-realpath allocator path)
            ((Some [base])
              (perform (push! (mut (.requires owner)) base))
              (when (not (contains? (.packages sources) base))
                (with nested (native-package allocator base)
                  (record (.packages sources) base nested)
                  (with file (coil.path.path-join allocator base "Coil.toml")
                    (cases (coil.fs.read-file allocator file)
                      ((Ok [bytes])
                        (with package (coil.project.parse-manifest allocator bytes)
                          (when (> (len (.project-path package)) 0)
                            (fail (coil.text.sconcat allocator "dependency is a project pointer: " file)))
                          (perform (set! (.manifest nested) (Some package)))
                          (prove (package-mappings allocator sources base package))
                          (prove (dependency-roots allocator sources base package origin))
                          (prove (read-dependencies allocator sources nested package))))
                      (_
                        (when (not (coil.project.dir? (coil.str.to-cstr allocator base)))
                          (fail (coil.text.sconcat allocator "dependency is not a directory: " base)))
                        (perform (push! (mut (.dependency-roots sources)) (PackageRoot :member-prefix "" :owner base :path base :excludes "")))))))))
            (_ (fail (coil.text.sconcat3 allocator origin " path does not exist: " path)))))))))

(value workspace-directories [(a (dyn coil.alloc.Allocator)) (manifest (ptr coil.project.Manifest))]
       (ptr (coil.arraylist.ArrayList (slice u8)))
  (let [directories (box! a (coil.arraylist.ArrayList (slice u8)) (coil.arraylist.ArrayList::new [(slice u8)] a))
        lines (coil.project.m-lines a (coil.project.m-workspace-packages a manifest))]
    (for [i 0 (len (load lines))]
      (let [line (get (load lines) i) separator (coil.project.m-index line (: 61 u8))]
        (when (>= separator 0) (push! directories (subslice line (+ separator 1) (len line))))))
    directories))

(judgment workspace-packages [(allocator (dyn coil.alloc.Allocator)) (sources (ptr Sources))
                              (manifest (ptr coil.project.Manifest))]
  (with dirs (workspace-directories allocator manifest)
    (each-index i (len (load dirs))
      (with base (get (load dirs) i)
        (with file (coil.path.path-join allocator base "Coil.toml")
          (with package (coil.project.parse-manifest allocator (coil.project.m-read-text allocator (coil.str.to-cstr allocator file)))
            (when (not (contains? (.packages sources) base))
              (with owner (native-package allocator base)
                (record (.packages sources) base owner)
                (perform (set! (.manifest owner) (Some package)))
                (prove (package-mappings allocator sources base package))
                (prove (read-dependencies allocator sources owner package))))
            (with prefix (coil.text.sconcat3 allocator (.ws-name manifest) "." (.name package))
              (perform (push! (mut (.dependency-roots sources))
                        (PackageRoot :member-prefix prefix :owner base :path base
                                     :excludes (coil.project.m-excludes-env-at allocator package base)))))))))))

(derive source-catalog [(allocator (dyn coil.alloc.Allocator)) (command (slice u8)) (path (slice u8)) (bytes (slice u8))] (ptr Sources)
  (with sources (box! allocator Sources (Sources :command command :library (None [(slice u8)])
        :packages (coil.hashmap.HashMap::new [(slice u8) (ptr NativePackage)] allocator (coil.str.keyops-borrowed))
        :mapped-paths (coil.hashmap.HashMap::new [(slice u8) bool] allocator (coil.str.keyops-borrowed))
        :dependency-roots (coil.arraylist.ArrayList::new [PackageRoot] allocator)
        :manifest (None [(ptr coil.project.Manifest)]) :indexed false
        :files (coil.arraylist.ArrayList::new [SourceFile] allocator)
        :conflicts (coil.hashmap.HashMap::new [(slice u8) (slice u8)] allocator (coil.str.keyops-borrowed))
        :mappings (coil.hashmap.HashMap::new [(slice u8) (slice u8)] allocator (coil.str.keyops-borrowed))
        :providers (coil.hashmap.HashMap::new [(slice u8) (ptr ModuleScope)] allocator (coil.str.keyops-borrowed))
        :scopes (coil.hashmap.HashMap::new [(slice u8) (ptr ModuleScope)] allocator (coil.str.keyops-borrowed))
        :root ""))
    (perform (push! (mut (.files sources)) (SourceFile :path path :bytes bytes)))
    (record (.scopes sources) "" (new-scope allocator ""))
    (cases (coil.fs.read-file allocator "Coil.toml")
      ((Ok [text])
        (with manifest (coil.project.parse-manifest allocator text)
          (perform (set! (.manifest sources) (Some manifest)))
          (with root (coil.path.cwd-slice allocator)
            (with owner (native-package allocator root)
              (record (.packages sources) root owner)
              (prove (package-mappings allocator sources root manifest))
              (prove (read-dependencies allocator sources owner manifest))
              (when (coil.project.m-workspace? manifest) (prove (workspace-packages allocator sources manifest)))))))
      (_))
    (conclude sources)))

(value report-problem [(sources (ptr Sources)) (problem coil.reader.Diag)] i64
  (let [index (.source problem)
        file (get (.files sources) (if (and (>= index 0) (< index (len (.files sources)))) index 0))]
    (coil.source.diagnostic.report (coil.io.stderr) (.path file) (.bytes file) problem)
    1))

(judgment check-member-name [(allocator (dyn coil.alloc.Allocator)) (sources (ptr Sources))
                             (site (ptr coil.reader.Sexp)) (path (slice u8)) (name (slice u8))]
  (each-index i (len (.dependency-roots sources))
    (with root (get (.dependency-roots sources) i)
      (when (and (> (len (.member-prefix root)) 0) (package-contains? (.path root) path))
        (with prefix (coil.text.sconcat allocator (.member-prefix root) ".")
          (require (and (coil.str.starts-with name prefix) (> (len name) (len prefix))) site
                   (coil.text.sconcat3 allocator path " must declare a module below " (.member-prefix root))))))))

(judgment index-path [(allocator (dyn coil.alloc.Allocator)) (sources (ptr Sources))
                      (site (ptr coil.reader.Sexp)) (path (slice u8))]
  (cases (coil.fs.read-file allocator path)
    ((Ok [bytes])
      (cases (coil.project.namespace-declared-module bytes)
        ((Some [header])
          (with name (coil.text.sconcat allocator header "")
            (prove (check-member-name allocator sources site path name))
            (cases (get (.mappings sources) name)
              ((Some [prior])
                (when (!= path prior)
                  (with paths (match (get (.conflicts sources) name) (Some [listed] listed) (_ prior))
                    (record (.conflicts sources) name (coil.text.sconcat3 allocator paths ", " path)))))
              (_ (record (.mappings sources) name path)))))
        (_))
      (perform (coil.alloc.free [u8] allocator bytes)))
    (_ (reject site (coil.text.sconcat allocator "cannot read package source " path)))))

(judgment index-source-root [(allocator (dyn coil.alloc.Allocator)) (sources (ptr Sources))
                             (site (ptr coil.reader.Sexp)) (root PackageRoot)]
  (with paths (box! allocator (coil.arraylist.ArrayList (slice u8))
                (coil.arraylist.ArrayList::new [(slice u8)] allocator))
    (perform (if (coil.project.dir? (coil.str.to-cstr allocator (.path root)))
                 (coil.project.m-source-walk! allocator (.path root) (.excludes root) paths)
                 (do (push! paths (.path root)) 0)))
    (each-index i (len (load paths))
      (with path (get (load paths) i)
        (when (not (or (contains? (.mapped-paths sources) path) (coil.project.m-excluded? (.excludes root) path)))
          (prove (index-path allocator sources site path)))))))

(judgment index-package [(allocator (dyn coil.alloc.Allocator)) (sources (ptr Sources)) (site (ptr coil.reader.Sexp))]
  (when (.indexed sources) (accept))
  (perform (set! (.indexed sources) true))
  (cases (.manifest sources)
    ((Some [manifest])
      (with base (coil.path.cwd-slice allocator)
        (with paths (coil.project.project-source-paths allocator manifest)
          (each-index i (len (load paths))
            (with path (coil.path.path-join allocator base (get (load paths) i))
              (when (not (contains? (.mapped-paths sources) path))
                (prove (index-path allocator sources site path)))))))
      (each-index i (len (.dependency-roots sources))
        (with root (get (.dependency-roots sources) i)
          (when (= (len (.member-prefix root)) 0) (prove (index-source-root allocator sources site root))))))
    (_
      (with entry (get (.files sources) 0)
        (with directory (coil.path.dirname (.path entry))
          (cases (coil.project.m-realpath allocator (if (= directory "") "/" directory))
            ((Some [root])
              (prove (index-source-root allocator sources site (PackageRoot :member-prefix "" :owner "" :path root :excludes ""))))
            (_ (reject site "cannot resolve entry source directory"))))))))

(predicate namespace-import? [(name (slice u8))]
  (and (< (coil.project.m-index name (: 47 u8)) 0)
       (not (coil.project.d-ends-with? name ".coil"))))

(value library-near [(a (dyn coil.alloc.Allocator)) (command (slice u8))] (Option (slice u8))
  (block :search
    (let [bin (coil.path.dirname command)
          installed (coil.path.path-join a (coil.path.dirname bin) "lib/coil/stdlib")]
      (when (and (= (coil.path.basename bin) "bin") (coil.project.dir? (coil.str.to-cstr a installed)))
        (return-from :search (Some installed)))
      (let [(mut dir) bin]
        (while (> (len (load dir)) 1)
          (let [lib (coil.path.path-join a (load dir) "src/stdlib")]
            (when (and (coil.project.dir? (coil.str.to-cstr a lib))
                       (coil.project.dir? (coil.str.to-cstr a (coil.path.path-join a (load dir) "src/compiler"))))
              (return-from :search (Some lib))))
          (set! dir (coil.path.dirname (load dir))))))
    (None [(slice u8)])))

(derive provider-path [(allocator (dyn coil.alloc.Allocator)) (sources (ptr Sources))
                       (site (ptr coil.reader.Sexp)) (name (slice u8))] (slice u8)
  (with relative (coil.compiler.stdlib_manifest.stdlib-file-for-namespace name)
    (with profile (match (.manifest sources) (Some [m] (.language-stdlib-profile m)) (_ "full"))
      (when (and (!= relative "") (!= profile "none"))
        (require (or (!= profile "hermetic") (coil.compiler.stdlib_manifest.stdlib-hermetic-namespace? name))
                 site "namespace is unavailable under the hermetic standard library profile")
        (cases (.library sources)
          ((Some [dir]) (conclude (coil.path.path-join allocator dir relative)))
          (_))
        (with own (coil.path.resolve-command-path allocator (.command sources))
          (with library (match (library-near allocator own)
                          (Some [dir] (Some dir))
                          (_ (library-near allocator (coil.path.resolve-command-path allocator
                                                      (coil.path.path-in-search-path allocator "coil")))))
            (perform (set! (.library sources) library))
            (cases library
              ((Some [dir]) (conclude (coil.path.path-join allocator dir relative)))
              (_ (reject site "cannot locate the Coil standard-library source directory"))))))))
  (when (not (contains? (.mappings sources) name)) (prove (index-package allocator sources site)))
  (cases (get (.conflicts sources) name)
    ((Some [paths])
      (reject site (coil.text.sconcat3 allocator "namespace '" name
                       (coil.text.sconcat allocator "' is declared by multiple source files: " paths))))
    (_))
  (cases (get (.mappings sources) name)
    ((Some [path]) (conclude path))
    (_ (reject site "cannot resolve imported module"))))

(derive load-provider [(allocator (dyn coil.alloc.Allocator)) (sources (ptr Sources)) (unit (mut SourceUnit))
                       (site (ptr coil.reader.Sexp)) (name (slice u8))] (ptr ModuleScope)
  (cases (get (.scopes sources) name)
    ((Some [scope]) (conclude scope))
    (_))
  (obtain path (provider-path allocator sources site name)
      (cases (get (.providers sources) path)
        ((Some [scope]) (conclude scope))
        (_))
      (cases (coil.fs.read-file allocator path)
        ((Ok [bytes])
          (with id (len (.files sources))
            (perform (push! (mut (.files sources)) (SourceFile :path path :bytes bytes)))
            (obtain parsed (coil.reader.read-all allocator bytes id)
              (cases (coil.reader.declared-module parsed)
                ((Some [declared])
                  (with scope (match (get (.scopes sources) declared)
                                (Some [existing] existing) (_ (new-scope allocator declared)))
                    (record (.scopes sources) declared scope)
                    (record (.providers sources) path scope)
                    (prove (index-source allocator sources (mut unit) parsed false))
                    (conclude scope)))
                (_ (reject site "imported file has no module declaration"))))))
        (_ (reject site (coil.text.sconcat allocator "cannot read module file " path))))))

(judgment index-source [(allocator (dyn coil.alloc.Allocator)) (sources (ptr Sources)) (unit (mut SourceUnit))
                        (forms (ptr (coil.arraylist.ArrayList coil.reader.Sexp))) (entry? bool)]
  (with (mut namespace) (: "" (slice u8))
    (each-form form forms
      (cases (module-header form)
        ((NamedModule [name])
          (perform (set! namespace (coil.reader.sexp-sym name)))
          (when (match (.manifest sources) (Some [m] (coil.project.m-workspace? m)) (_ false))
            (cases (coil.project.m-realpath allocator (.path (get (.files sources) (.source form))))
              ((Some [path]) (prove (check-member-name allocator sources form path (load namespace))))
              (_)))
          (when (not (contains? (.scopes sources) (load namespace)))
            (record (.scopes sources) (load namespace) (new-scope allocator (load namespace))))
          (when (and entry? (= (len (.root sources)) 0))
            (perform (set! (.root sources) (load namespace)))))
        (_
          (require (not (module-form? form)) form "module: expected (module NAME)")
          (with scope (match (get (.scopes sources) (load namespace)) (Some [value] value) (_ (unreachable "declaration missing from module index")))
            (cases (import-module form)
              ((Imported [target])
                (require (namespace-import? (coil.reader.sexp-str target)) form
                         "import paths are not supported; import the target's declared namespace")
                (obtain provider (load-provider allocator sources (mut unit) form (coil.reader.sexp-str target))
                  (prove (bind-import (mut unit) scope provider form))))
              (_
                (when (export-form? form)
                  (perform (set! (.explicit-exports scope) true))
                  (each-child item form 1 position
                    (require (coil.reader.sexp-sym? item) item "export: names must be symbols")
                    (record (.exports scope) (coil.reader.sexp-sym item) true)
                    (perform (push! (mut (.visibility unit)) (VisibilityCheck :scope scope :name item :definition? true)))))
                (when (not (export-form? form)) (perform (push! (.declarations unit) (load form))))))
            (record (.owners unit) (.node-id form) scope)
            (cases (trait-declaration form)
              ((Trait [name parameters])
                (with spelling (coil.reader.sexp-sym name)
                  (with canonical (definition-name allocator (load namespace) false spelling)
                    (require (not (contains? (.traits unit) canonical)) name "duplicate trait declaration")
                    (record (.symbols unit) (.node-id form) canonical)
                    (record (.traits unit) canonical form)
                    (record (.trait-locals scope) spelling form)
                    (record (.trait-members scope) (if (= (load namespace) "") spelling (subslice canonical (+ (len (load namespace)) 1) (len canonical))) form)))
                (each-child method form (trait-method-start form) i
                  (cases (trait-method method)
                    ((Method [member _ _])
                      (with key (coil.reader.sexp-sym member)
                        (with group (match (get (.method-groups scope) key)
                                      (Some [existing] existing)
                                      (_ (box! allocator (coil.arraylist.ArrayList (ptr coil.reader.Sexp))
                                               (coil.arraylist.ArrayList::new [(ptr coil.reader.Sexp)] allocator))))
                          (record (.method-traits unit) (.node-id method) form)
                          (record (.method-names scope) key method)
                          (record (.qualified-methods unit) (definition-name allocator (load namespace) false key) method)
                          (record (.method-groups scope) key group)
                          (record (.owners unit) (.node-id method) scope)
                          (perform (push! group method)))))
                    (_ (reject method "expected a trait method signature")))))
              (_))
            (cases (type-name form)
              ((Some [name])
                (with spelling (coil.reader.sexp-sym name)
                  (with canonical (definition-name allocator (load namespace) false spelling)
                    (require (not (contains? (.type-globals unit) canonical)) name "duplicate type declaration")
                    (record (.type-globals unit) canonical form)
                    (record (.symbols unit) (.node-id form) canonical)
                    (record (.type-locals scope) spelling form)
                    (with member (if (= (load namespace) "") spelling (subslice canonical (+ (len (load namespace)) 1) (len canonical)))
                      (record (.type-members scope) member form)))))
              (_))
            (cases (sum-declaration form)
              ((Sum [_])
                (each-child variant form (variant-start form) i
                  (cases (variant-name variant)
                    ((VariantNamed [name])
                      (with canonical (definition-name allocator (load namespace) false (coil.reader.sexp-sym name))
                        (require (not (contains? (.variants unit) canonical)) name "duplicate sum variant")
                        (record (.variants unit) canonical variant)
                        (record (.symbols unit) (.node-id variant) canonical)
                        (record (.variant-locals scope) (coil.reader.sexp-sym name) variant)
                        (with member (if (= (load namespace) "") canonical (subslice canonical (+ (len (load namespace)) 1) (len canonical)))
                          (record (.variant-members scope) member variant))))
                    (_ (reject variant "invalid sum variant")))))
              (_))
            (cases (declaration-name form)
              ((Some [name])
                (with spelling (coil.reader.sexp-sym name)
                  (with canonical (definition-name allocator (load namespace) (and entry? (= (load namespace) (.root sources))
                                           (match (ordinary-function form) (Function [_ _ _ _] true) (_ false))) spelling)
                    (cases (get (.globals unit) canonical)
                      ((Some [prior])
                        (require (and (external? prior) (external? form)) form "duplicate declaration")
                        (require (same-foreign-signature? prior form) form "extern declared with conflicting signatures"))
                      (_))
                    (record (.globals unit) canonical form)
                    (when (static-definition? form)
                      (with qualified (if (= (load namespace) "")
                                        (definition-name allocator (implicit-module-name allocator (.path (get (.files sources) (.source form)))) false spelling)
                                        canonical)
                        (record (.symbols unit) (.node-id form) (coil.text.sconcat allocator "coil_def." qualified))))
                    (when (match (callable form) (Function [_ _ _ _] true) (_ false))
                      (record (.symbols unit) (.node-id form) (if (external? form) (external-symbol form name) canonical)))
                    (record (.locals scope) spelling form)
                    (when (and (!= (load namespace) "") (!= canonical "main"))
                      (with member (subslice canonical (+ (len (load namespace)) 1) (len canonical))
                        (record (.members scope) member form))))))
              (_))))))))

(predicate implementation-form? [(form (ptr coil.reader.Sexp))]
  (or (scalar-impl? form) (match (inherent-implementation form) (InherentImpl [_] true) (_ false))))

(value parameter-name [(parameter (ptr coil.reader.Sexp))] (ptr coil.reader.Sexp)
  (match (bounded-parameter parameter) (Bounded [name] name) (_ parameter)))

(value word-name [(name (slice u8))] (slice u8)
  (cond (= name "isize") (rewrite.host.signed-word-type)
        (= name "usize") (rewrite.host.unsigned-word-type) :else name))

(derive owner-name [(lookup Lookup) (name (ptr coil.reader.Sexp))] (slice u8)
  (obtain resolved (find-name lookup name (TypeNames))
    (cases resolved
      ((Some [form]) (conclude (symbol-for lookup form)))
      (_ (conclude (word-name (coil.reader.sexp-sym name)))))))

(value inherent-key [(allocator (dyn coil.alloc.Allocator)) (owner (slice u8)) (member (slice u8))] (slice u8)
  (coil.text.sconcat3 allocator owner "::" member))

(value method-function [(allocator (dyn coil.alloc.Allocator)) (method (ptr coil.reader.Sexp))
                        (parameters (Option (ptr coil.reader.Sexp)))] (ptr coil.reader.Sexp)
  (let [(mut items) (coil.arraylist.ArrayList::new [coil.reader.Sexp] allocator)
        (mut pending) parameters]
    (push! (mut items) (coil.reader.mk-sexp-src (coil.reader.KSym "defn") method))
    (for [i 0 (coil.reader.sexp-count method)]
      (let [item (coil.reader.sexp-nth method i)]
        (when (coil.reader.sexp-vec? item)
          (match (load pending)
            (Some [types] (do (push! (mut items) (load types)) (set! pending (None [(ptr coil.reader.Sexp)]))))
            (_ 0)))
        (push! (mut items) (load item))))
    (box! allocator coil.reader.Sexp (coil.reader.mk-sexp-src (coil.reader.KList (coil.reader.box-items allocator items)) method))))

(judgment index-method-list [(allocator (dyn coil.alloc.Allocator)) (unit (mut SourceUnit)) (declaration (ptr coil.reader.Sexp))
                             (start i64) (prefix (slice u8)) (inherent bool) (parameters (Option (ptr coil.reader.Sexp)))
                             (added (mut (coil.arraylist.ArrayList coil.reader.Sexp)))]
  (with lookup (lookup-for unit declaration)
    (each-child method declaration start i
      (with function (method-function allocator method parameters)
        (cases (ordinary-function function)
          ((Function [_ name _ _])
            (with spelling (coil.reader.sexp-sym name)
              (with key (inherent-key allocator prefix spelling)
                (record (.method-functions unit) (.node-id method) function)
                (record (.owners unit) (.node-id function) (.scope lookup))
                (when inherent
                  (when (match parameters (None [] true) (_ false))
                    (require (match (function-generics function) (Monomorphic [] true) (_ false)) method
                             "inherent type parameters belong on the impl declaration"))
                  (require (not (contains? (.inherent-methods unit) key)) name "duplicate inherent method for type")
                  (record (.inherent-methods unit) key function)
                  (record (.inherent-names unit) spelling true))
                (record (.symbols unit) (.node-id function) (if inherent key
                          (coil.text.sconcat3 allocator key "::" (coil.text.i64->str allocator i))))
                (perform (push! (mut added) (load function))))))
          (_ (reject method "invalid implementation method")))))))

(judgment index-method-bodies [(allocator (dyn coil.alloc.Allocator)) (unit (mut SourceUnit))]
  (with (mut added) (coil.arraylist.ArrayList::new [coil.reader.Sexp] allocator)
    (each-form declaration (.declarations unit)
      (with lookup (lookup-for unit declaration)
        (cases (scalar-implementation declaration)
          ((ScalarImpl [trait target])
            (obtain resolved (find-name lookup trait (TraitNames))
              (cases resolved
                ((Some [owner])
                  (with prefix (inherent-key allocator (symbol-for lookup owner) (coil.reader.sexp-sym target))
                    (prove (index-method-list allocator (mut unit) declaration 3 prefix false (None [(ptr coil.reader.Sexp)]) (mut added)))))
                (_ (reject trait "unknown trait")))))
          (_))
        (cases (inherent-implementation declaration)
          ((InherentImpl [target])
            (cases (impl-type-parameters declaration)
              ((ImplParameters [types])
                (require (= (coil.reader.sexp-count target) (+ 1 (coil.reader.sexp-count types))) target "unsupported inherent type pattern")
                (each-child param types 0 i
                  (require (and (coil.reader.sexp-sym? (parameter-name param)) (coil.reader.sexp-sym-is (coil.reader.sexp-nth target (+ i 1)) (coil.reader.sexp-sym (parameter-name param))))
                           target "unsupported specialized inherent type pattern"))
                (obtain owner (owner-name lookup (coil.reader.sexp-nth target 0))
                  (prove (index-method-list allocator (mut unit) declaration 3 owner true (Some types) (mut added)))))
              (_ (obtain owner (owner-name lookup target)
                   (prove (index-method-list allocator (mut unit) declaration 2 owner true (None [(ptr coil.reader.Sexp)]) (mut added)))))))
          (_))))
    (perform (for function added (push! (.declarations unit) function)))))

(derive read-unit [(allocator (dyn coil.alloc.Allocator)) (sources (ptr Sources))
                   (forms (ptr (coil.arraylist.ArrayList coil.reader.Sexp)))] (ptr SourceUnit)
  (when (and (> (len (load forms)) 0)
             (match (.manifest sources) (Some [m] (coil.project.m-workspace? m)) (_ false)))
    (prove (index-package allocator sources (elem forms 0))))
  (with (mut unit) (SourceUnit :scopes (field sources scopes)
    :visibility (coil.arraylist.ArrayList::new [VisibilityCheck] allocator)
    :declarations (box! allocator (coil.arraylist.ArrayList coil.reader.Sexp) (coil.arraylist.ArrayList::new [coil.reader.Sexp] allocator))
    :owners (coil.hashmap.HashMap::new-scalar [i64 (ptr ModuleScope)] allocator)
    :symbols (coil.hashmap.HashMap::new-scalar [i64 (slice u8)] allocator)
    :variants (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))
    :inherent-methods (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))
    :inherent-names (coil.hashmap.HashMap::new [(slice u8) bool] allocator (coil.str.keyops-borrowed))
    :method-functions (coil.hashmap.HashMap::new-scalar [i64 (ptr coil.reader.Sexp)] allocator)
    :method-traits (coil.hashmap.HashMap::new-scalar [i64 (ptr coil.reader.Sexp)] allocator)
    :qualified-methods (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))
    :traits (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))
    :type-globals (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))
    :globals (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed)))
    (prove (index-source allocator sources (mut unit) forms true))
    (each-index i (len (.visibility unit))
      (with check (get (.visibility unit) i)
        (with name (coil.reader.sexp-sym (.name check))
          (when (.definition? check)
            (require (or (contains? (.trait-locals (.scope check)) name) (contains? (.method-groups (.scope check)) name) (contains? (.locals (.scope check)) name) (contains? (.type-locals (.scope check)) name)
                         (contains? (.variants unit) (definition-name allocator (.namespace (.scope check)) false name))) (.name check) "export names an undefined declaration"))
          (when (not (.definition? check))
            (require (exported? (.scope check) name) (.name check) "import names a private declaration")))))
    (prove (index-method-bodies allocator (mut unit)))
    (conclude (box! allocator SourceUnit unit))))
