(use "rewrite.declarations")
(use "coil.alloc")
(use "coil.text")
(use "coil.slice")

(context SourceUnit [(namespace (slice u8)) (declarations (ptr (coil.arraylist.ArrayList coil.reader.Sexp)))])

(derive read-unit [(allocator (dyn coil.alloc.Allocator))
                   (forms (ptr (coil.arraylist.ArrayList coil.reader.Sexp)))] SourceUnit
  (with declarations (box! allocator (coil.arraylist.ArrayList coil.reader.Sexp)
                       (coil.arraylist.ArrayList::new [coil.reader.Sexp] allocator))
    (with (mut namespace) (: "" (slice u8))
      (each-form form forms
        (cases (module-header form)
          ((NamedModule [name])
            (require (and (= (len (load declarations)) 0)
                          (= (len (load namespace)) 0)) form "multiple declaration scopes are not implemented")
            (perform (set! namespace (coil.reader.sexp-sym name))))
          (_ (require (not (module-form? form)) form "module: expected (module NAME)")
             (perform (push! declarations (load form))))))
      (conclude (SourceUnit :namespace (load namespace) :declarations declarations)))))

(derive definition-name [(allocator (dyn coil.alloc.Allocator)) (namespace (slice u8)) (spelling (slice u8))] (slice u8)
  (when (or (= namespace "") (= spelling "main")) (conclude spelling))
  (with prefix (coil.text.sconcat allocator namespace ".")
    (when (coil.str.starts-with spelling prefix) (conclude spelling))
    (conclude (coil.text.sconcat allocator prefix spelling))))

(derive unit-signatures [(allocator (dyn coil.alloc.Allocator)) (unit SourceUnit)
                         (local (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))]
  (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp))
  (with (mut names) local
    (when (> (len (.namespace unit)) 0)
      (each-form form (.declarations unit)
        (cases (ordinary-function form)
          ((Function [_ name _ _])
            (with spelling (coil.reader.sexp-sym name)
              (when (!= spelling "main")
                (obtain canonical (definition-name allocator (.namespace unit) spelling)
                  (when (!= canonical spelling)
                    (require (not (contains? names canonical)) form "duplicate qualified declaration")
                    (record names canonical form))
                  (with member (subslice canonical (+ (len (.namespace unit)) 1) (len canonical))
                    (with alias (coil.text.sconcat3 allocator (.namespace unit) "/" member)
                      (require (not (contains? names alias)) form "duplicate qualified declaration")
                      (record names alias form)))))))
          (_))))
    (conclude names)))
