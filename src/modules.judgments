(use "rewrite.declarations")
(use "coil.alloc")
(use "coil.text")
(use "coil.slice")

(context WildcardImport [(provider (ptr ModuleScope)) (excluded (coil.hashmap.HashMap (slice u8) bool))])
(context ModuleScope
  [(wildcards (coil.arraylist.ArrayList WildcardImport)) (explicit-exports bool) (exports (coil.hashmap.HashMap (slice u8) bool))
   (selected (coil.hashmap.HashMap (slice u8) (ptr ModuleScope)))
   (aliases (coil.hashmap.HashMap (slice u8) (ptr ModuleScope)))
   (namespace (slice u8))
   (members (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))
   (locals (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))])
(context VisibilityCheck [(scope (ptr ModuleScope)) (name (ptr coil.reader.Sexp)) (definition? bool)])
(context SourceUnit
  [(visibility (coil.arraylist.ArrayList VisibilityCheck))
   (declarations (ptr (coil.arraylist.ArrayList coil.reader.Sexp)))
   (owners (coil.hashmap.HashMap i64 (ptr ModuleScope)))
   (symbols (coil.hashmap.HashMap i64 (slice u8)))
   (globals (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))])
(context Lookup [(scope (ptr ModuleScope)) (unit (ptr SourceUnit))])

(value lookup-for [(unit (ptr SourceUnit)) (form (ptr coil.reader.Sexp))] Lookup
  (match (get (.owners unit) (.node-id form))
    (Some [scope] (Lookup :scope scope :unit unit))
    (_ (unreachable "declaration missing from module index"))))

(value symbol-for [(lookup Lookup) (form (ptr coil.reader.Sexp))] (slice u8)
  (match (get (.symbols (.unit lookup)) (.node-id form))
    (Some [symbol] symbol)
    (_ (unreachable "function missing from symbol index"))))

(predicate exported? [(scope (ptr ModuleScope)) (name (slice u8))]
  (or (not (.explicit-exports scope)) (contains? (.exports scope) name)))

(derive find-function [(lookup Lookup) (site (ptr coil.reader.Sexp))] (Option (ptr coil.reader.Sexp))
  (with name (coil.reader.sexp-sym site)
    (each-index i (len name)
      (when (and (> i 0) (= (get name i) (: 47 u8)))
        (cases (get (.aliases (.scope lookup)) (subslice name 0 i))
          ((Some [target])
            (with member (subslice name (+ i 1) (len name))
              (require (or (= (.namespace target) (.namespace (.scope lookup))) (exported? target member))
                       site "qualified name is private to the imported module")
              (conclude (get (.members target) member))))
          (_))))
    (cases (get (.locals (.scope lookup)) name)
      ((Some [local]) (conclude (Some local)))
      (_))
    (with (mut candidate) (match (get (.selected (.scope lookup)) name)
                             (Some [provider] (get (.members provider) name))
                             (_ (None [(ptr coil.reader.Sexp)])))
      (each-index i (len (.wildcards (.scope lookup)))
        (with wildcard (get (.wildcards (.scope lookup)) i)
          (when (and (not (contains? (.excluded wildcard) name)) (exported? (.provider wildcard) name))
            (cases (get (.members (.provider wildcard)) name)
              ((Some [found])
                (cases (load candidate)
                  ((Some [prior]) (require (= (.node-id prior) (.node-id found)) site "ambiguous imported name"))
                  (_ (perform (set! candidate (Some found))))))
              (_)))))
      (cases (load candidate)
        ((Some [found]) (conclude (Some found)))
        (_ (conclude (get (.globals (.unit lookup)) name)))))))

(value new-scope [(allocator (dyn coil.alloc.Allocator)) (name (slice u8))] (ptr ModuleScope)
  (let [scope (box! allocator ModuleScope (ModuleScope :namespace name
    :wildcards (coil.arraylist.ArrayList::new [WildcardImport] allocator) :explicit-exports false
    :exports (coil.hashmap.HashMap::new [(slice u8) bool] allocator (coil.str.keyops-borrowed))
    :selected (coil.hashmap.HashMap::new [(slice u8) (ptr ModuleScope)] allocator (coil.str.keyops-borrowed))
    :aliases (coil.hashmap.HashMap::new [(slice u8) (ptr ModuleScope)] allocator (coil.str.keyops-borrowed))
    :members (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))
    :locals (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))))]
    (set! (mut (.aliases scope)) name scope)
    scope))

(judgment bind-import [(unit (mut SourceUnit)) (scope (ptr ModuleScope)) (provider (ptr ModuleScope)) (form (ptr coil.reader.Sexp))]
  (require (= (% (coil.reader.sexp-count form) 2) 0) form "import option requires a value")
  (with (mut alias) (.namespace provider)
    (with (mut selected) (None [(ptr coil.reader.Sexp)])
      (with (mut exclusions) (None [(ptr coil.reader.Sexp)])
        (each-index i (/ (- (coil.reader.sexp-count form) 2) 2)
          (with option (coil.reader.sexp-nth form (+ 2 (* i 2)))
            (with value (coil.reader.sexp-nth form (+ 3 (* i 2)))
              (require (coil.reader.sexp-kw? option) option "expected import option")
              (with key (coil.reader.sexp-kw option)
                (require (or (= key "as") (= key "use") (= key "exclude")) option "unsupported import option")
                (when (= key "as")
                  (require (coil.reader.sexp-sym? value) value "import: :as expects an alias symbol")
                  (perform (set! alias (coil.reader.sexp-sym value))))
                (when (= key "exclude")
                  (require (coil.reader.sexp-vec? value) value "import: :exclude expects [names]")
                  (perform (set! exclusions (Some value))))
                (when (= key "use")
                  (require (or (coil.reader.sexp-vec? value) (coil.reader.sexp-sym-is value "*")) value "import: :use expects * or [names]")
                  (perform (set! selected (Some value))))))))
        (record (.aliases scope) (.namespace provider) provider)
        (record (.aliases scope) (load alias) provider)
        (cases (load selected)
          ((Some [names])
            (when (coil.reader.sexp-sym-is names "*")
              (with (mut excluded) (coil.hashmap.HashMap::new [(slice u8) bool] (.alc (.wildcards scope)) (coil.str.keyops-borrowed))
                (cases (load exclusions)
                  ((Some [items])
                    (each-child item items 0 position
                      (when (coil.reader.sexp-sym? item)
                        (record excluded (coil.reader.sexp-sym item) true))))
                  (_))
                (perform (push! (mut (.wildcards scope)) (WildcardImport :provider provider :excluded excluded))))
              (accept))
            (cases (load exclusions) ((Some [items]) (reject items ":exclude requires :use *")) (_))
            (each-child name names 0 index
              (when (coil.reader.sexp-sym? name)
                (with spelling (coil.reader.sexp-sym name)
                  (cases (get (.selected scope) spelling)
                    ((Some [prior]) (require (= (.namespace prior) (.namespace provider)) name "name imported from two modules"))
                    (_))
                  (perform (push! (mut (.visibility unit)) (VisibilityCheck :scope provider :name name :definition? false)))
                  (record (.selected scope) spelling provider)))))
          (_))))))

(value definition-name [(allocator (dyn coil.alloc.Allocator)) (namespace (slice u8))
                        (entry? bool) (spelling (slice u8))] (slice u8)
  (if (or (= namespace "") (and entry? (= spelling "main"))) spelling
      (let [prefix (coil.text.sconcat allocator namespace ".")]
        (if (coil.str.starts-with spelling prefix) spelling
            (coil.text.sconcat allocator prefix spelling)))))

(derive read-unit [(allocator (dyn coil.alloc.Allocator))
                   (forms (ptr (coil.arraylist.ArrayList coil.reader.Sexp)))] (ptr SourceUnit)
  (with (mut unit) (SourceUnit
    :visibility (coil.arraylist.ArrayList::new [VisibilityCheck] allocator)
    :declarations (box! allocator (coil.arraylist.ArrayList coil.reader.Sexp) (coil.arraylist.ArrayList::new [coil.reader.Sexp] allocator))
    :owners (coil.hashmap.HashMap::new-scalar [i64 (ptr ModuleScope)] allocator)
    :symbols (coil.hashmap.HashMap::new-scalar [i64 (slice u8)] allocator)
    :globals (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed)))
    (with (mut scopes) (coil.hashmap.HashMap::new [(slice u8) (ptr ModuleScope)] allocator (coil.str.keyops-borrowed))
      (record scopes "" (new-scope allocator ""))
      (with (mut namespace) (: "" (slice u8))
        (with (mut root) (: "" (slice u8))
          (each-form form forms
            (cases (module-header form)
              ((NamedModule [name])
                (perform (set! namespace (coil.reader.sexp-sym name)))
                (when (not (contains? scopes (load namespace)))
                  (record scopes (load namespace) (new-scope allocator (load namespace))))
                (when (= (len (load root)) 0)
                  (perform (set! root (load namespace)))))
              (_
                (require (not (module-form? form)) form "module: expected (module NAME)")
                (with scope (match (get scopes (load namespace)) (Some [value] value) (_ (unreachable "declaration missing from module index")))
                  (cases (import-module form)
                    ((Imported [target])
                      (cases (get scopes (coil.reader.sexp-str target))
                        ((Some [provider])
                          (prove (bind-import (mut unit) scope provider form)))
                        (_ (reject target "cannot resolve imported module"))))
                    (_
                      (when (export-form? form)
                        (perform (set! (.explicit-exports scope) true))
                        (each-child item form 1 position
                          (require (coil.reader.sexp-sym? item) item "export: names must be symbols")
                          (record (.exports scope) (coil.reader.sexp-sym item) true)
                          (perform (push! (mut (.visibility unit)) (VisibilityCheck :scope scope :name item :definition? true)))))
                      (when (not (export-form? form)) (perform (push! (.declarations unit) (load form))))))
                  (record (.owners unit) (.node-id form) scope)
                  (cases (ordinary-function form)
                    ((Function [_ name _ _])
                      (with spelling (coil.reader.sexp-sym name)
                        (with canonical (definition-name allocator (load namespace) (= (load namespace) (load root)) spelling)
                          (require (not (contains? (.globals unit) canonical)) form "duplicate function declaration")
                          (record (.globals unit) canonical form)
                          (record (.symbols unit) (.node-id form) canonical)
                          (record (.locals scope) spelling form)
                          (when (and (!= (load namespace) "") (!= canonical "main"))
                            (with member (subslice canonical (+ (len (load namespace)) 1) (len canonical))
                              (record (.members scope) member form))))))
                    (_)))))))
        (each-index i (len (.visibility unit))
          (with check (get (.visibility unit) i)
            (with name (coil.reader.sexp-sym (.name check))
              (when (.definition? check)
                (require (contains? (.locals (.scope check)) name) (.name check) "export names an undefined declaration"))
              (when (not (.definition? check))
                (require (exported? (.scope check) name) (.name check) "import names a private declaration")))))
        (conclude (box! allocator SourceUnit unit))))))
