(use "coil.alloc" alloc)
(use "coil.arraylist" al)
(use "coil.hashmap" hm)
(use "coil.reader" rd)
(use "coil.str" str)
(use "coil.fs" fs)
(use "declarative.rt.image" image)
(use "declarative.rt.graph" graph)
(use "declarative.backend.nodes" ir)
(use "rewrite.nodes" nodes)
(use "rewrite.check" checker)
(use "rewrite.modules" modules)
(use "rewrite.operators" ops)
(use "rewrite.declarations" syntax)
(use "rewrite.host" host)

(context LoopEdges
  [(backs (al/ArrayList i32)) (exits (al/ArrayList i32)) (values (al/ArrayList i32))])

(context Frame
  [(loops (hm/HashMap i64 (ptr LoopEdges))) (a (dyn Allocator)) (g graph/Graph) (control i32)
   (checked checker/Checked)
   (locals (hm/HashMap i64 i32))])

(translate machine-type [(type (slice u8)) (at (ptr Sexp))] (Result i32 Diag)
  (where (= type "i64") (yield (Ok ir/T-I64)))
  (where (= type "u64") (yield (Ok ir/T-U64)))
  (where (= type "i32") (yield (Ok ir/T-I32)))
  (where (= type "u32") (yield (Ok ir/T-U32)))
  (where (= type "i16") (yield (Ok ir/T-I16)))
  (where (= type "u16") (yield (Ok ir/T-U16)))
  (where (= type "i8") (yield (Ok ir/T-I8)))
  (where (= type "u8") (yield (Ok ir/T-U8)))
  (where (= type "never") (yield (Ok ir/T-CTRL)))
  (where (= type "void") (yield (Ok ir/T-CTRL)))
  (where (= type "bool") (yield (Ok ir/T-BOOL)))
  (otherwise (yield (Err (mk-diag-src (.source at) (.lo at) (.hi at)
                                      "type has no native representation yet")))))

(translate convert-integer [(g (mut graph/Graph)) (value i32) (source i32) (target i32)] i32
  (where (= source target) (yield value))
  (where (= (ir/type-bits source) (ir/type-bits target)) (yield (ir/bitcast! (mut g) target value)))
  (where (> (ir/type-bits source) (ir/type-bits target)) (yield (ir/trunc! (mut g) target value)))
  (where (ir/type-signed? source) (yield (ir/sext! (mut g) target value)))
  (otherwise (yield (ir/zext! (mut g) target value))))

(translate merge-controls [(g (mut graph/Graph)) (edges (al/ArrayList i32))] i32
  (where (= (len edges) 0) (yield (: -1 i32)))
  (where (= (len edges) 1) (yield (get edges 0)))
  (otherwise (yield (nodes/join-controls (mut g) (slice edges)))))

(translate lower-parameter [(f (mut Frame)) (position i64) (param (ptr Sexp))] (Result i32 Diag)
  (on (typed-parameter param) (Parameter [name type])
    (need rep (machine-type (sexp-sym type) type))
    (bind value (nodes/parameter (mut (.g f)) rep (cast u64 position)))
    (perform (set! (mut (.locals f)) (.node-id name) value))
    (yield (Ok rep)))
  (otherwise (yield (Err (mk-diag (.lo param) (.hi param) "invalid native parameter")))))

(translate lower-expression
  [(f (mut Frame)) (im (mut image/Image))
   (signatures modules/Lookup) (expr (ptr Sexp))] (Result i32 Diag)
  (where (< (.control f) 0) (yield (Ok (: -1 i32))))
  (where (contains? (.guards (.checked f)) (.node-id expr)) (yield (Ok (.control f))))
  (on (get (.expanded (.checked f)) (.node-id expr)) (Some [expanded])
    (yield (lower-expression (mut f) (mut im) signatures expanded)))
  (on (get (.types (.checked f)) (.node-id expr)) (Some [type])
    (need rep (machine-type type expr))
    (yield (lower-value (mut f) (mut im) signatures expr rep)))
  (otherwise (yield (Err (mk-diag (.lo expr) (.hi expr) "missing checked expression type")))))

(translate jump-edges [(f Frame) (expr (ptr Sexp))] (Result (ptr LoopEdges) Diag)
  (on (get (.targets (.checked f)) (.node-id expr)) (Some [id])
    (choose
      (on (get (.loops f) id) (Some [edges]) (yield (Ok edges)))
      (otherwise (yield (Err (mk-diag (.lo expr) (.hi expr) "missing native jump target"))))))
  (otherwise (yield (Err (mk-diag (.lo expr) (.hi expr) "jump target was not resolved")))))

(translate lower-value
  [(f (mut Frame)) (im (mut image/Image))
   (signatures modules/Lookup)
   (expr (ptr Sexp)) (expected i32)] (Result i32 Diag)
  (where (int-literal? expr)
    (yield (Ok (nodes/literal (mut (.g f)) expected (cast u64 (sexp-int expr))))))
  (where (true-literal? expr) (yield (Ok (nodes/literal (mut (.g f)) ir/T-BOOL 1))))
  (where (false-literal? expr) (yield (Ok (nodes/literal (mut (.g f)) ir/T-BOOL 0))))
  (where (identifier? expr)
    (yield (read-binding (mut f) expr expected)))
  (on (explicit-load expr) (LoadLocal [name])
    (yield (read-binding (mut f) name expected)))
  (on (local-store expr) (WriteLocal [name value])
    (yield (write-binding (mut f) (mut im) signatures name value)))
  (on (explicit-store expr) (StoreLocal [name value])
    (yield (write-binding (mut f) (mut im) signatures name value)))
  (on (type-ascription expr) (Ascribed [value _])
    (yield (lower-expression (mut f) (mut im) signatures value)))
  (on (numeric-cast expr) (Convert [_ value])
    (need operand (lower-expression (mut f) (mut im) signatures value) (< (.control f) 0))
    (yield (Ok (convert-integer (mut (.g f)) operand (graph/ty (.g f) operand) expected))))
  (on (local-bindings expr) (Bindings [pairs])
    (walk-pairs name init pairs
      (need value (lower-expression (mut f) (mut im) signatures init) (< (.control f) 0))
      (choose
        (on (mutable-binding name) (CellBinding [symbol])
          (bind bits (ir/type-bits (graph/ty (.g f) value)))
          (bind address (nodes/stack-storage (mut (.g f)) (cast u64 (/ (+ bits 7) 8))))
          (perform (set! (mut (.locals f)) (.node-id symbol) address))
          (perform (save-scalar (mut f) address value))
          (yield 0))
        (otherwise
          (perform (set! (mut (.locals f)) (.node-id name) value))
          (yield 0))))
    (yield (lower-sequence (mut f) (mut im) signatures expr 2)))
  (on (sequence-expression expr) (Sequence [])
    (yield (lower-sequence (mut f) (mut im) signatures expr 1)))
  (where (or (repetition? expr) (named-block? expr))
    (bind incoming (.control f))
    (bind header (nodes/loop-header (mut (.g f)) incoming))
    (bind edges (box! (.a f) LoopEdges (LoopEdges :backs (al/ArrayList::new [i32] (.a f))
                         :exits (al/ArrayList::new [i32] (.a f)) :values (al/ArrayList::new [i32] (.a f)))))
    (perform (set! (mut (.loops f)) (.node-id expr) edges))
    (perform (set! (.control f) header))
    (need normal (lower-sequence (mut f) (mut im) signatures expr
                            (if (sexp-kw? (sexp-nth expr 1)) 2 1)))
    (perform (when (>= (.control f) 0)
               (if (named-block? expr)
                   (do (push! (mut (.exits edges)) (nodes/jump-edge (mut (.g f)) (.control f)))
                       (push! (mut (.values edges)) normal))
                   (push! (mut (.backs edges)) (.control f)))))
    (bind back (merge-controls (mut (.g f)) (.backs edges)))
    (perform (if (< back 0)
                 (do (graph/replace-uses! (mut (.g f)) header incoming) (graph/drop! (mut (.g f)) header))
                 (graph/set-input! (mut (.g f)) header 1 back)))
    (bind join (merge-controls (mut (.g f)) (.exits edges)))
    (perform (set! (.control f) join))
    (choose
      (where (or (< join 0) (= expected ir/T-CTRL)) (yield (Ok join)))
      (where (= (len (.values edges)) 1) (yield (Ok (get (.values edges) 0))))
      (otherwise (yield (Ok (nodes/join-values (mut (.g f)) expected join (slice (.values edges))))))))
  (where (exit-loop? expr)
    (need edges (jump-edges f expr))
    (bind first-value (if (checker/labelled-jump? expr) 2 1))
    (need value (if (> (sexp-count expr) first-value)
                    (lower-expression (mut f) (mut im) signatures (sexp-nth expr first-value))
                    (Ok (nodes/literal (mut (.g f)) ir/T-I64 0))))
    (need _ (run-cleanups (mut f) (mut im) signatures expr))
    (perform (when (>= (.control f) 0)
               (push! (mut (.exits edges)) (nodes/jump-edge (mut (.g f)) (.control f)))
               (push! (mut (.values edges)) value)))
    (perform (set! (.control f) -1))
    (yield (Ok (: -1 i32))))
  (where (next-iteration? expr)
    (need edges (jump-edges f expr))
    (need _ (run-cleanups (mut f) (mut im) signatures expr))
    (perform (when (>= (.control f) 0) (push! (mut (.backs edges)) (nodes/jump-edge (mut (.g f)) (.control f)))))
    (perform (set! (.control f) -1))
    (yield (Ok (: -1 i32))))
  (on (conditional expr) (Branches [condition then else])
    (need predicate (lower-expression (mut f) (mut im) signatures condition) (< (.control f) 0))
    (bind type (graph/ty (.g f) predicate))
    (bind truth (if (= type ir/T-BOOL) predicate (nodes/nonzero (mut (.g f)) type predicate)))
    (bind split (nodes/branch (mut (.g f)) (.control f) truth))
    (perform (set! (.control f) (nodes/taken (mut (.g f)) split)))
    (need left (lower-expression (mut f) (mut im) signatures then))
    (bind left-end (.control f))
    (perform (set! (.control f) (nodes/untaken (mut (.g f)) split)))
    (need right (lower-expression (mut f) (mut im) signatures else))
    (choose
      (where (< left-end 0) (yield (Ok right)))
      (where (< (.control f) 0)
        (perform (set! (.control f) left-end))
        (yield (Ok left)))
      (otherwise
        (bind join (nodes/merge-paths (mut (.g f)) left-end (.control f)))
        (perform (set! (.control f) join))
        (yield (Ok (if (= expected ir/T-CTRL) join
                       (nodes/merge-values (mut (.g f)) expected join left right)))))))
  (on (get (.operators (.checked f)) (.node-id expr)) (Some [op])
    (need left (lower-expression (mut f) (mut im) signatures (sexp-nth expr 1)) (< (.control f) 0))
    (bind type (graph/ty (.g f) left))
    (bind (mut result) left)
    (walk position arg expr 2
      (need right (lower-expression (mut f) (mut im) signatures arg) (< (.control f) 0))
      (perform (set! result (ops/emit-operator op (mut (.g f)) type (load result) right)))
      (yield 0))
    (yield (Ok (if (= (sexp-count expr) 2)
                   (ops/emit-operator op (mut (.g f)) type left left)
                   (load result)))))
  (on (application expr) (Apply [operator])
    (choose
      (on (get (.callees (.checked f)) (.node-id expr)) (Some [function])
        (choose
          (on (ordinary-function function) (Function [_ name parameters result])
            (bind (mut args) (al/ArrayList::new [i32] (.a f)))
            (walk position arg expr 1
              (need value (lower-expression (mut f) (mut im) signatures arg) (< (.control f) 0))
              (perform (push! (mut args) value))
              (yield 0))
            (bind canonical (modules/symbol-for signatures function))
            (bind symbol (image/symbol! (mut im) canonical))
            (bind call-node (nodes/invoke (mut (.g f)) (.control f) (cast u64 symbol) (slice args)))
            (perform (set! (.control f) call-node))
            (yield (Ok (if (= expected ir/T-CTRL) call-node
                           (nodes/call-result (mut (.g f)) expected call-node)))))
          (otherwise (yield (Err (mk-diag (.lo expr) (.hi expr) "invalid native callee"))))))
      (otherwise (yield (Err (mk-diag (.lo expr) (.hi expr) "unknown native callee"))))))
  (otherwise (yield (Err (mk-diag (.lo expr) (.hi expr) "unsupported native expression")))))

(translate read-binding [(f (mut Frame)) (expr (ptr Sexp)) (type i32)] (Result i32 Diag)
  (on (get (.references (.checked f)) (.node-id expr)) (Some [binding])
    (choose
      (on (get (.locals f) binding) (Some [value])
        (choose
          (where (contains? (.cells (.checked f)) binding)
            (bind stored-type (if (= type ir/T-BOOL) ir/T-U8 type))
            (bind loaded (nodes/load-scalar (mut (.g f)) (.control f) value stored-type))
            (perform (set! (.control f) loaded))
            (yield (Ok (if (= type ir/T-BOOL) (nodes/nonzero (mut (.g f)) stored-type loaded) loaded))))
          (otherwise (yield (Ok value)))))
      (otherwise (yield (Err (mk-diag (.lo expr) (.hi expr) "binding has no native value"))))))
  (otherwise (yield (Err (mk-diag (.lo expr) (.hi expr) "unresolved native local")))))

(translate save-scalar [(f (mut Frame)) (address i32) (value i32)] i32
  (otherwise
    (bind stored (if (= (graph/ty (.g f) value) ir/T-BOOL) (nodes/bool-byte (mut (.g f)) value) value))
    (bind write (nodes/store-scalar (mut (.g f)) (.control f) address stored))
    (perform (set! (.control f) write))
    (yield write)))

(translate write-binding
  [(f (mut Frame)) (im (mut image/Image)) (signatures modules/Lookup)
   (name (ptr Sexp)) (expr (ptr Sexp))] (Result i32 Diag)
  (on (get (.references (.checked f)) (.node-id name)) (Some [binding])
    (choose
      (on (get (.locals f) binding) (Some [address])
        (need value (lower-expression (mut f) (mut im) signatures expr) (< (.control f) 0))
        (perform (save-scalar (mut f) address value))
        (yield (Ok (nodes/literal (mut (.g f)) ir/T-I64 0))))
      (otherwise (yield (Err (mk-diag (.lo name) (.hi name) "missing native cell"))))))
  (otherwise (yield (Err (mk-diag (.lo name) (.hi name) "unresolved native cell")))))

(translate run-cleanups
  [(f (mut Frame)) (im (mut image/Image)) (signatures modules/Lookup)
   (site (ptr Sexp))] (Result i32 Diag)
  (on (get (.on-exit (.checked f)) (.node-id site)) (Some [actions])
    (each-element cleanup actions
      (need done (lower-expression (mut f) (mut im) signatures cleanup) (< (.control f) 0))
      (yield 0))
    (yield (Ok (.control f))))
  (otherwise (yield (Ok (.control f)))))

(translate lower-sequence
  [(f (mut Frame)) (im (mut image/Image))
   (signatures modules/Lookup)
   (expr (ptr Sexp)) (start i64)] (Result i32 Diag)
  (otherwise
    (bind (mut last-value) (.control f))
    (walk position item expr start
      (need value (lower-expression (mut f) (mut im) signatures item) (< (.control f) 0))
      (perform (set! last-value value))
      (yield 0))
    (need done (run-cleanups (mut f) (mut im) signatures expr) (< (.control f) 0))
    (yield (Ok (load last-value)))))

(translate lower-function
  [(a (dyn Allocator)) (im (mut image/Image))
   (signatures modules/Lookup) (checked checker/Checked) (form (ptr Sexp))] (Result i64 Diag)
  (on (ordinary-function form) (Function [_ name parameters result])
    (need rep (machine-type (sexp-sym result) result))
    (bind (mut f) (Frame :loops (hm/HashMap::new-scalar [i64 (ptr LoopEdges)] a) :a a :checked checked :g (graph/create a) :control 0
                         :locals (hm/HashMap::new-scalar [i64 i32] a)))
    (perform (set! (.control f) (nodes/start (mut (.g f)))))
    (walk position param parameters 0
      (need _ (lower-parameter (mut f) position param))
      (yield 0))
    (need value (lower-sequence (mut f) (mut im) signatures form 4))
    (perform (when (and (>= (.control f) 0) (!= rep ir/T-CTRL))
               (nodes/finish (mut (.g f)) (.control f) value)))
    (perform (when (and (>= (.control f) 0) (= rep ir/T-CTRL)) (nodes/finish-void (mut (.g f)) (.control f))))
    (bind canonical (modules/symbol-for signatures form))
    (choose
      (on (host/append-graph! a (mut im) (image/symbol! (mut im) canonical) (.g f))
          (Err [message]) (yield (Err (mk-diag (.lo form) (.hi form) message))))
      (otherwise (yield (Ok 0)))))
  (otherwise (yield (Err (mk-diag (.lo form) (.hi form) "unsupported native declaration")))))

(translate emit-object
  [(a (dyn Allocator))
   (checked checker/Checked) (unit (ptr modules/SourceUnit)) (output (slice u8))] (Result i64 Diag)
  (otherwise
    (bind (mut im) (image/create a))
    (visit form (.declarations unit)
      (need _ (lower-function a (mut im) (modules/lookup-for unit form) checked form))
      (yield 0))
    (bind bytes (host/object-bytes a im))
    (choose
      (on (fs/write-file a output (slice bytes)) (Ok [_]) (yield (Ok 0)))
      (otherwise (yield (Err (mk-diag -1 -1 "cannot write object file")))))))
