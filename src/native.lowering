(use "coil.alloc" alloc)
(use "coil.arraylist" al)
(use "coil.hashmap" hm)
(use "coil.reader" rd)
(use "coil.str" str)
(use "coil.text" text)
(use "coil.fs" fs)
(use "declarative.rt.image" image)
(use "declarative.rt.graph" graph)
(use "declarative.backend.nodes" ir)
(use "rewrite.nodes" nodes)
(use "rewrite.check" checker)
(use "rewrite.modules" modules)
(use "rewrite.operators" ops)
(use "rewrite.declarations" syntax)
(use "rewrite.host" host)

(context LoopEdges
  [(backs (al/ArrayList i32)) (exits (al/ArrayList i32)) (values (al/ArrayList i32))])

(context Instance
  [(definition (ptr Sexp)) (symbol (slice u8)) (types (hm/HashMap (slice u8) (slice u8)))])
(context Instances
  [(empty-types (hm/HashMap (slice u8) (slice u8))) (costs (hm/HashMap i64 i64))
   (pending (al/ArrayList Instance)) (symbols (hm/HashMap (slice u8) Instance)) (scheduled (hm/HashMap (slice u8) bool)) (used (hm/HashMap (slice u8) bool))])

(translate concrete [(types (hm/HashMap (slice u8) (slice u8))) (name (slice u8))] (slice u8)
  (on (get types name) (Some [actual]) (yield actual))
  (otherwise (yield name)))

(context Frame
  [(loops (hm/HashMap i64 (ptr LoopEdges))) (a (dyn Allocator)) (g graph/Graph) (control i32)
   (inline-stack (al/ArrayList i64)) (inline-budget i64)
   (instances (ptr Instances)) (instance Instance) (checked checker/Checked)
   (locals (hm/HashMap i64 i32))])

(translate machine-type [(type (slice u8)) (at (ptr Sexp))] (Result i32 Diag)
  (where (= type "f32") (yield (Ok ir/T-F32)))
  (where (= type "f64") (yield (Ok ir/T-F64)))
  (where (= type "i64") (yield (Ok ir/T-I64)))
  (where (= type "u64") (yield (Ok ir/T-U64)))
  (where (= type "i32") (yield (Ok ir/T-I32)))
  (where (= type "u32") (yield (Ok ir/T-U32)))
  (where (= type "i16") (yield (Ok ir/T-I16)))
  (where (= type "u16") (yield (Ok ir/T-U16)))
  (where (= type "i8") (yield (Ok ir/T-I8)))
  (where (= type "u8") (yield (Ok ir/T-U8)))
  (where (= type "never") (yield (Ok ir/T-CTRL)))
  (where (= type "void") (yield (Ok ir/T-CTRL)))
  (where (= type "bool") (yield (Ok ir/T-BOOL)))
  (otherwise (yield (Err (mk-diag-src (.source at) (.lo at) (.hi at)
                                      "type has no native representation yet")))))

(translate float-literal-bits [(bits i64) (type i32)] u64
  (where (= type ir/T-F32)
    (yield (let [(mut wide) bits
                 (mut narrow) (cast f32 (load (cast (ptr f64) (mut wide))))]
             (cast u64 (load (cast (ptr u32) (mut narrow)))))))
  (otherwise (yield (cast u64 bits))))

(translate convert-number [(g (mut graph/Graph)) (value i32) (source i32) (target i32)] i32
  (where (= source target) (yield value))
  (where (and (ir/type-float? source) (ir/type-float? target))
    (yield (if (= target ir/T-F32) (ir/ftrunc! (mut g) target value) (ir/fext! (mut g) target value))))
  (where (and (ir/type-float? source) (< (ir/type-bits target) 32))
    (bind wide (cast i32 (if (ir/type-signed? target) ir/T-I32 ir/T-U32)))
    (bind converted (convert-number (mut g) value source wide))
    (yield (ir/trunc! (mut g) target converted)))
  (where (and (ir/type-float? target) (< (ir/type-bits source) 32))
    (bind wide (cast i32 (if (ir/type-signed? source) ir/T-I32 ir/T-U32)))
    (bind extended (convert-number (mut g) value source wide))
    (yield (convert-number (mut g) extended wide target)))
  (where (ir/type-float? source)
    (yield (if (ir/type-signed? target) (ir/ftosi! (mut g) target value) (ir/ftoui! (mut g) target value))))
  (where (ir/type-float? target)
    (yield (if (ir/type-signed? source) (ir/sitof! (mut g) target value) (ir/uitof! (mut g) target value))))
  (where (= (ir/type-bits source) (ir/type-bits target)) (yield (ir/bitcast! (mut g) target value)))
  (where (> (ir/type-bits source) (ir/type-bits target)) (yield (ir/trunc! (mut g) target value)))
  (where (ir/type-signed? source) (yield (ir/sext! (mut g) target value)))
  (otherwise (yield (ir/zext! (mut g) target value))))

(translate merge-controls [(g (mut graph/Graph)) (edges (al/ArrayList i32))] i32
  (where (= (len edges) 0) (yield (: -1 i32)))
  (where (= (len edges) 1) (yield (get edges 0)))
  (otherwise (yield (nodes/join-controls (mut g) (slice edges)))))

(translate lower-parameter [(f (mut Frame)) (position i64) (param (ptr Sexp))] (Result i32 Diag)
  (on (typed-parameter param) (Parameter [name type])
    (need rep (machine-type (concrete (.types (.instance f)) (checker/scalar-type type)) type))
    (bind value (nodes/parameter (mut (.g f)) rep (cast u64 position)))
    (perform (set! (mut (.locals f)) (.node-id name) value))
    (yield (Ok rep)))
  (otherwise (yield (Err (mk-diag-src (.source param) (.lo param) (.hi param) "invalid native parameter")))))

(translate lower-expression
  [(f (mut Frame)) (im (mut image/Image))
   (signatures modules/Lookup) (expr (ptr Sexp))] (Result i32 Diag)
  (where (< (.control f) 0) (yield (Ok (: -1 i32))))
  (where (contains? (.guards (.checked f)) (.node-id expr)) (yield (Ok (.control f))))
  (on (get (.expanded (.checked f)) (.node-id expr)) (Some [expanded])
    (yield (lower-expression (mut f) (mut im) signatures expanded)))
  (on (get (.types (.checked f)) (.node-id expr)) (Some [type])
    (need rep (machine-type (concrete (.types (.instance f)) type) expr))
    (yield (lower-value (mut f) (mut im) signatures expr rep)))
  (otherwise (yield (Err (mk-diag-src (.source expr) (.lo expr) (.hi expr) "missing checked expression type")))))

(translate jump-edges [(f Frame) (expr (ptr Sexp))] (Result (ptr LoopEdges) Diag)
  (on (get (.targets (.checked f)) (.node-id expr)) (Some [id])
    (choose
      (on (get (.loops f) id) (Some [edges]) (yield (Ok edges)))
      (otherwise (yield (Err (mk-diag-src (.source expr) (.lo expr) (.hi expr) "missing native jump target"))))))
  (otherwise (yield (Err (mk-diag-src (.source expr) (.lo expr) (.hi expr) "jump target was not resolved")))))

(translate lower-value
  [(f (mut Frame)) (im (mut image/Image))
   (signatures modules/Lookup)
   (expr (ptr Sexp)) (expected i32)] (Result i32 Diag)
  (on (.kind expr) (KFloat [bits])
    (yield (Ok (nodes/literal (mut (.g f)) expected (float-literal-bits bits expected)))))
  (where (int-literal? expr)
    (yield (Ok (nodes/literal (mut (.g f)) expected (cast u64 (sexp-int expr))))))
  (where (true-literal? expr) (yield (Ok (nodes/literal (mut (.g f)) ir/T-BOOL 1))))
  (where (false-literal? expr) (yield (Ok (nodes/literal (mut (.g f)) ir/T-BOOL 0))))
  (on (get (.statics (.checked f)) (.node-id expr)) (Some [form])
    (bind symbol (image/symbol! (mut im) (modules/symbol-for signatures form)))
    (bind address (ir/symbol! (mut (.g f)) (cast u64 symbol)))
    (yield (Ok (load-scalar-at (mut f) address expected))))
  (on (get (.layout-parameters (.checked f)) (.node-id expr)) (Some [parameter])
    (bind bytes (checker/scalar-bytes (concrete (.types (.instance f)) parameter)))
    (yield (Ok (nodes/literal (mut (.g f)) expected (cast u64 bytes)))))
  (on (get (.constants (.checked f)) (.node-id expr)) (Some [constant])
    (yield (lower-value (mut f) (mut im) signatures (.literal constant) expected)))
  (where (identifier? expr)
    (yield (read-binding (mut f) expr expected)))
  (on (explicit-load expr) (LoadLocal [name])
    (yield (read-binding (mut f) name expected)))
  (on (local-store expr) (WriteLocal [name value])
    (yield (write-binding (mut f) (mut im) signatures name value)))
  (on (explicit-store expr) (StoreLocal [name value])
    (yield (write-binding (mut f) (mut im) signatures name value)))
  (on (type-ascription expr) (Ascribed [value _])
    (yield (lower-expression (mut f) (mut im) signatures value)))
  (on (numeric-cast expr) (Convert [_ value])
    (need operand (lower-expression (mut f) (mut im) signatures value) (< (.control f) 0))
    (yield (Ok (convert-number (mut (.g f)) operand (graph/ty (.g f) operand) expected))))
  (on (local-bindings expr) (Bindings [pairs])
    (walk-pairs name init pairs
      (need value (lower-expression (mut f) (mut im) signatures init) (< (.control f) 0))
      (choose
        (on (mutable-binding name) (CellBinding [symbol])
          (bind bits (ir/type-bits (graph/ty (.g f) value)))
          (bind address (nodes/stack-storage (mut (.g f)) (cast u64 (/ (+ bits 7) 8))))
          (perform (set! (mut (.locals f)) (.node-id symbol) address))
          (perform (save-scalar (mut f) address value))
          (yield 0))
        (otherwise
          (perform (set! (mut (.locals f)) (.node-id name) value))
          (yield 0))))
    (yield (lower-sequence (mut f) (mut im) signatures expr 2)))
  (on (sequence-expression expr) (Sequence [])
    (yield (lower-sequence (mut f) (mut im) signatures expr 1)))
  (where (or (repetition? expr) (named-block? expr))
    (bind incoming (.control f))
    (bind header (nodes/loop-header (mut (.g f)) incoming))
    (bind edges (box! (.a f) LoopEdges (LoopEdges :backs (al/ArrayList::new [i32] (.a f))
                         :exits (al/ArrayList::new [i32] (.a f)) :values (al/ArrayList::new [i32] (.a f)))))
    (perform (set! (mut (.loops f)) (.node-id expr) edges))
    (perform (set! (.control f) header))
    (need normal (lower-sequence (mut f) (mut im) signatures expr
                            (if (sexp-kw? (sexp-nth expr 1)) 2 1)))
    (perform (when (>= (.control f) 0)
               (if (named-block? expr)
                   (do (push! (mut (.exits edges)) (nodes/jump-edge (mut (.g f)) (.control f)))
                       (push! (mut (.values edges)) normal))
                   (push! (mut (.backs edges)) (.control f)))))
    (bind back (merge-controls (mut (.g f)) (.backs edges)))
    (perform (if (< back 0)
                 (do (graph/replace-uses! (mut (.g f)) header incoming) (graph/drop! (mut (.g f)) header))
                 (graph/set-input! (mut (.g f)) header 1 back)))
    (bind join (merge-controls (mut (.g f)) (.exits edges)))
    (perform (set! (.control f) join))
    (choose
      (where (or (< join 0) (= expected ir/T-CTRL)) (yield (Ok join)))
      (where (= (len (.values edges)) 1) (yield (Ok (get (.values edges) 0))))
      (otherwise (yield (Ok (nodes/join-values (mut (.g f)) expected join (slice (.values edges))))))))
  (where (exit-loop? expr)
    (need edges (jump-edges f expr))
    (bind first-value (if (checker/labelled-jump? expr) 2 1))
    (need value (if (> (sexp-count expr) first-value)
                    (lower-expression (mut f) (mut im) signatures (sexp-nth expr first-value))
                    (Ok (nodes/literal (mut (.g f)) ir/T-I64 0))))
    (need _ (run-cleanups (mut f) (mut im) signatures expr))
    (perform (when (>= (.control f) 0)
               (push! (mut (.exits edges)) (nodes/jump-edge (mut (.g f)) (.control f)))
               (push! (mut (.values edges)) value)))
    (perform (set! (.control f) -1))
    (yield (Ok (: -1 i32))))
  (where (next-iteration? expr)
    (need edges (jump-edges f expr))
    (need _ (run-cleanups (mut f) (mut im) signatures expr))
    (perform (when (>= (.control f) 0) (push! (mut (.backs edges)) (nodes/jump-edge (mut (.g f)) (.control f)))))
    (perform (set! (.control f) -1))
    (yield (Ok (: -1 i32))))
  (on (conditional expr) (Branches [condition then else])
    (need predicate (lower-expression (mut f) (mut im) signatures condition) (< (.control f) 0))
    (bind type (graph/ty (.g f) predicate))
    (bind truth (if (= type ir/T-BOOL) predicate (nodes/nonzero (mut (.g f)) type predicate)))
    (bind split (nodes/branch (mut (.g f)) (.control f) truth))
    (perform (set! (.control f) (nodes/taken (mut (.g f)) split)))
    (need left (lower-expression (mut f) (mut im) signatures then))
    (bind left-end (.control f))
    (perform (set! (.control f) (nodes/untaken (mut (.g f)) split)))
    (need right (lower-expression (mut f) (mut im) signatures else))
    (choose
      (where (< left-end 0) (yield (Ok right)))
      (where (< (.control f) 0)
        (perform (set! (.control f) left-end))
        (yield (Ok left)))
      (otherwise
        (bind join (nodes/merge-paths (mut (.g f)) left-end (.control f)))
        (perform (set! (.control f) join))
        (yield (Ok (if (= expected ir/T-CTRL) join
                       (nodes/merge-values (mut (.g f)) expected join left right)))))))
  (on (get (.operators (.checked f)) (.node-id expr)) (Some [op])
    (bind start (checker/argument-start expr))
    (need left (lower-expression (mut f) (mut im) signatures (sexp-nth expr start)) (< (.control f) 0))
    (bind type (graph/ty (.g f) left))
    (bind (mut result) left)
    (walk position arg expr (+ start 1)
      (need right (lower-expression (mut f) (mut im) signatures arg) (< (.control f) 0))
      (perform (set! result (ops/emit-operator op (mut (.g f)) type (load result) right)))
      (yield 0))
    (yield (Ok (if (= (sexp-count expr) (+ start 1))
                   (ops/emit-operator op (mut (.g f)) type left left)
                   (load result)))))
  (on (application expr) (Apply [operator])
    (choose
      (on (selected-function (mut f) signatures expr) (Some [function])
        (choose
          (on (modules/callable function) (Function [_ name parameters result])
            (bind (mut args) (al/ArrayList::new [i32] (.a f)))
            (walk position arg expr (checker/call-start expr)
              (need value (lower-expression (mut f) (mut im) signatures arg) (< (.control f) 0))
              (perform (push! (mut args) value))
              (yield 0))
            (need callee (call-instance (mut f) signatures function expr))
            (yield (lower-call (mut f) (mut im) signatures callee parameters (slice args) expected)))
          (otherwise (yield (Err (mk-diag-src (.source expr) (.lo expr) (.hi expr) "invalid native callee"))))))
      (otherwise (yield (Err (mk-diag-src (.source expr) (.lo expr) (.hi expr) "unknown native callee"))))))
  (otherwise (yield (Err (mk-diag-src (.source expr) (.lo expr) (.hi expr) "unsupported native expression")))))

(translate read-binding [(f (mut Frame)) (expr (ptr Sexp)) (type i32)] (Result i32 Diag)
  (on (get (.references (.checked f)) (.node-id expr)) (Some [binding])
    (choose
      (on (get (.locals f) binding) (Some [value])
        (choose
          (where (contains? (.cells (.checked f)) binding)
            (yield (Ok (load-scalar-at (mut f) value type))))
          (otherwise (yield (Ok value)))))
      (otherwise (yield (Err (mk-diag-src (.source expr) (.lo expr) (.hi expr) "binding has no native value"))))))
  (otherwise (yield (Err (mk-diag-src (.source expr) (.lo expr) (.hi expr) "unresolved native local")))))

(translate load-scalar-at [(f (mut Frame)) (address i32) (type i32)] i32
  (otherwise
    (bind stored-type (if (= type ir/T-BOOL) ir/T-U8 type))
    (bind loaded (nodes/load-scalar (mut (.g f)) (.control f) address stored-type))
    (perform (set! (.control f) loaded))
    (yield (if (= type ir/T-BOOL) (nodes/nonzero (mut (.g f)) stored-type loaded) loaded))))

(translate save-scalar [(f (mut Frame)) (address i32) (value i32)] i32
  (otherwise
    (bind stored (if (= (graph/ty (.g f) value) ir/T-BOOL) (nodes/bool-byte (mut (.g f)) value) value))
    (bind write (nodes/store-scalar (mut (.g f)) (.control f) address stored))
    (perform (set! (.control f) write))
    (yield write)))

(translate write-binding
  [(f (mut Frame)) (im (mut image/Image)) (signatures modules/Lookup)
   (name (ptr Sexp)) (expr (ptr Sexp))] (Result i32 Diag)
  (on (get (.references (.checked f)) (.node-id name)) (Some [binding])
    (choose
      (on (get (.locals f) binding) (Some [address])
        (need value (lower-expression (mut f) (mut im) signatures expr) (< (.control f) 0))
        (perform (save-scalar (mut f) address value))
        (yield (Ok (nodes/literal (mut (.g f)) ir/T-I64 0))))
      (otherwise (yield (Err (mk-diag-src (.source name) (.lo name) (.hi name) "missing native cell"))))))
  (otherwise (yield (Err (mk-diag-src (.source name) (.lo name) (.hi name) "unresolved native cell")))))

(translate run-cleanups
  [(f (mut Frame)) (im (mut image/Image)) (signatures modules/Lookup)
   (site (ptr Sexp))] (Result i32 Diag)
  (on (get (.on-exit (.checked f)) (.node-id site)) (Some [actions])
    (each-element cleanup actions
      (need done (lower-expression (mut f) (mut im) signatures cleanup) (< (.control f) 0))
      (yield 0))
    (yield (Ok (.control f))))
  (otherwise (yield (Ok (.control f)))))

(translate lower-sequence
  [(f (mut Frame)) (im (mut image/Image))
   (signatures modules/Lookup)
   (expr (ptr Sexp)) (start i64)] (Result i32 Diag)
  (otherwise
    (bind (mut last-value) (.control f))
    (walk position item expr start
      (need value (lower-expression (mut f) (mut im) signatures item) (< (.control f) 0))
      (perform (set! last-value value))
      (yield 0))
    (need done (run-cleanups (mut f) (mut im) signatures expr) (< (.control f) 0))
    (yield (Ok (load last-value)))))

(translate selected-function [(f (mut Frame)) (lookup modules/Lookup) (expr (ptr Sexp))] (Option (ptr Sexp))
  (on (get (.dispatches (.checked f)) (.node-id expr)) (Some [dispatch])
    (bind actual (concrete (.types (.instance f)) (.target dispatch)))
    (yield (get (.method-bodies (.checked f)) (checker/method-key lookup (.trait dispatch) actual (.member dispatch) (.a f)))))
  (otherwise (yield (get (.callees (.checked f)) (.node-id expr)))))

(translate call-instance [(f (mut Frame)) (lookup modules/Lookup) (function (ptr Sexp)) (expr (ptr Sexp))]
  (Result Instance Diag)
  (on (function-generics function) (GenericParameters [params])
    (choose
      (on (get (.type-arguments (.checked f)) (.node-id expr)) (Some [arguments])
        (bind (mut types) (hm/HashMap::new [(slice u8) (slice u8)] (.a f) (str/keyops-borrowed)))
        (bind (mut suffix) (: "" (slice u8)))
        (walk i param params 0
          (bind actual (concrete (.types (.instance f)) (get arguments i)))
          (perform (set! (mut types) (sexp-sym (modules/parameter-name param)) actual))
          (perform (set! suffix (text/sconcat3 (.a f) (load suffix) "." actual)))
          (yield 0))
        (bind key (text/sconcat3 (.a f) (load suffix) ":" (modules/symbol-for lookup function)))
        (choose
          (on (get (.symbols (.instances f)) key) (Some [existing]) (yield (Ok existing)))
          (otherwise
            (bind (mut symbol) (text/sconcat (.a f) "coil.generic" key))
            (perform (while (contains? (.used (.instances f)) (load symbol))
                       (set! symbol (text/sconcat (.a f) (load symbol) "."))))
            (perform (set! (mut (.used (.instances f))) (load symbol) true))
            (bind callee (Instance :definition function :symbol (load symbol) :types (load types)))
            (perform (set! (mut (.symbols (.instances f))) key callee))
            (yield (Ok callee)))))
      (otherwise (yield (Err (mk-diag-src (.source expr) (.lo expr) (.hi expr) "missing inferred type arguments"))))))
  (otherwise (yield (Ok (Instance :definition function :symbol (modules/symbol-for lookup function)
                                 :types (.empty-types (.instances f)))))))

(translate inline-cost [(expr (ptr Sexp))] i64
  (otherwise
    (bind (mut cost) 1)
    (walk i child expr 0
      (perform (set! cost (+ (load cost) (inline-cost child))))
      (yield 0))
    (yield (load cost))))

(translate definition-cost [(instances (ptr Instances)) (form (ptr Sexp))] i64
  (on (get (.costs instances) (.node-id form)) (Some [cost]) (yield cost))
  (otherwise
    (bind cost (inline-cost form))
    (perform (set! (mut (.costs instances)) (.node-id form) cost))
    (yield cost)))

(translate lower-call [(f (mut Frame)) (im (mut image/Image)) (lookup modules/Lookup)
                       (callee Instance) (parameters (ptr Sexp)) (args (slice i32)) (expected i32)] (Result i32 Diag)
  (otherwise
    (bind form (.definition callee))
    (bind id (.node-id form))
    (bind policy (match (get (.inline-policies (.checked f)) id) (Some [value] value) (_ "Never")))
    (bind active (block :found
                   (for item (.inline-stack f) (when (= item id) (return-from :found true)))
                   false))
    (bind cost (if (or (= policy "Never") active (>= (len (.inline-stack f)) 16)) 0 (definition-cost (.instances f) form)))
    (choose
      (where (and (> cost 0) (<= cost (.inline-budget f)) (or (= policy "Always") (<= cost 32)))
        (perform (set! (.inline-budget f) (- (.inline-budget f) cost)))
        (bind previous (.instance f))
        (perform (set! (.instance f) callee))
        (perform (push! (mut (.inline-stack f)) id))
        (walk i param parameters 0
          (bind name (sexp-nth param 0))
          (perform (set! (mut (.locals f)) (.node-id name) (get args i)))
          (yield 0))
        (need value (lower-sequence (mut f) (mut im) (modules/lookup-for (.unit lookup) form)
                                    form (modules/function-body-start form parameters)))
        (perform (pop! (mut (.inline-stack f))))
        (perform (set! (.instance f) previous))
        (yield (Ok value)))
      (otherwise
        (perform (when (and (match (function-generics form) (GenericParameters [_] true) (_ false))
                            (not (contains? (.scheduled (.instances f)) (.symbol callee))))
                   (set! (mut (.scheduled (.instances f))) (.symbol callee) true)
                   (push! (mut (.pending (.instances f))) callee)))
        (bind symbol (image/symbol! (mut im) (.symbol callee)))
        (bind call-node (nodes/invoke (mut (.g f)) (.control f) (cast u64 symbol) args))
        (perform (set! (.control f) call-node))
        (yield (Ok (if (= expected ir/T-CTRL) call-node (nodes/call-result (mut (.g f)) expected call-node))))))))

(translate lower-function
  [(a (dyn Allocator)) (im (mut image/Image))
   (signatures modules/Lookup) (checked checker/Checked) (instances (ptr Instances)) (instance Instance) (form (ptr Sexp))] (Result i64 Diag)
  (where (or (trait-form? form) (modules/implementation-form? form)) (yield (Ok 0)))
  (on (primitive-header form) (Primitive [_]) (yield (Ok 0)))
  (on (modules/type-name form) (Some [_]) (yield (Ok 0)))
  (where (static-definition? form)
    (choose
      (on (get (.constants checked) (.node-id form)) (Some [value])
        (need rep (machine-type (.type value) form))
        (bind literal (.literal value))
        (bind bits (match (.kind literal)
                     (KFloat [raw] (float-literal-bits raw rep))
                     (KInt [raw] (cast u64 raw))
                     (_ (if (true-literal? literal) (: 1 u64) (: 0 u64)))))
        (bind size (cast i64 (/ (+ (ir/type-bits rep) 7) 8)))
        (bind (mut bytes) (al/ArrayList::new [u8] a))
        (perform (for [i 0 size] (push! (mut bytes) (cast u8 (>> bits (cast u64 (* i 8)))))))
        (bind symbol (image/symbol! (mut im) (modules/symbol-for signatures form)))
        (perform (image/add-data! (mut im) symbol (slice bytes) size))
        (yield (Ok 0)))
      (otherwise (yield (Err (mk-diag-src (.source form) (.lo form) (.hi form) "missing static initializer"))))))
  (on (constant-declaration form) (Constant [_ _]) (yield (Ok 0)))
  (where (modules/external? form) (yield (Ok 0)))
  (on (ordinary-function form) (Function [_ name parameters result])
    (need rep (machine-type (concrete (.types instance) (checker/scalar-type result)) result))
    (bind (mut f) (Frame :inline-stack (al/ArrayList::new [i64] a) :inline-budget 16384 :instances instances :instance instance :loops (hm/HashMap::new-scalar [i64 (ptr LoopEdges)] a) :a a :checked checked :g (graph/create a) :control 0
                         :locals (hm/HashMap::new-scalar [i64 i32] a)))
    (perform (push! (mut (.inline-stack f)) (.node-id form)))
    (perform (set! (.control f) (nodes/start (mut (.g f)))))
    (walk position param parameters 0
      (need _ (lower-parameter (mut f) position param))
      (yield 0))
    (need value (lower-sequence (mut f) (mut im) signatures form (modules/function-body-start form parameters)))
    (perform (when (and (>= (.control f) 0) (!= rep ir/T-CTRL))
               (nodes/finish (mut (.g f)) (.control f) value)))
    (perform (when (and (>= (.control f) 0) (= rep ir/T-CTRL)) (nodes/finish-void (mut (.g f)) (.control f))))
    (bind canonical (if (= (.symbol instance) "") (modules/symbol-for signatures form) (.symbol instance)))
    (choose
      (on (host/append-graph! a (mut im) (image/symbol! (mut im) canonical) (.g f))
          (Err [message]) (yield (Err (mk-diag-src (.source form) (.lo form) (.hi form) message))))
      (otherwise (yield (Ok 0)))))
  (otherwise (yield (Err (mk-diag-src (.source form) (.lo form) (.hi form) "unsupported native declaration")))))

(translate emit-object
  [(a (dyn Allocator))
   (checked checker/Checked) (unit (ptr modules/SourceUnit)) (output (slice u8))] (Result i64 Diag)
  (otherwise
    (bind (mut im) (image/create a))
    (bind empty (hm/HashMap::new [(slice u8) (slice u8)] a (str/keyops-borrowed)))
    (bind instances (box! a Instances (Instances :empty-types empty :costs (hm/HashMap::new-scalar [i64 i64] a)
                                        :pending (al/ArrayList::new [Instance] a)
                                        :scheduled (hm/HashMap::new [(slice u8) bool] a (str/keyops-borrowed))
                                        :symbols (hm/HashMap::new [(slice u8) Instance] a (str/keyops-borrowed))
                                        :used (hm/HashMap::new [(slice u8) bool] a (str/keyops-borrowed)))))
    (visit form (.declarations unit)
      (choose
        (on (get (.symbols unit) (.node-id form)) (Some [symbol])
          (perform (set! (mut (.used instances)) symbol true))
          (yield 0))
        (otherwise (yield 0))))
    (visit form (.declarations unit)
      (choose
        (on (function-generics form) (GenericParameters [_]) (yield 0))
        (otherwise
          (need _ (lower-function a (mut im) (modules/lookup-for unit form) checked instances
                                   (Instance :definition form :symbol "" :types empty) form))
          (yield 0))))
    (drain instance (.pending instances)
      (bind form (.definition instance))
      (need _ (lower-function a (mut im) (modules/lookup-for unit form) checked instances instance form))
      (yield 0))
    (bind bytes (host/object-bytes a im))
    (choose
      (on (fs/write-file a output (slice bytes)) (Ok [_]) (yield (Ok 0)))
      (otherwise (yield (Err (mk-diag -1 -1 "cannot write object file")))))))
