(use "coil.alloc")
(use "rewrite.command-tools")
(use "rewrite.modules")
(use "coil.project")
(use "coil.path")
(use "coil.fs")
(use "coil.text")
(use "coil.source.cli")

(value child-status [(result (Result i64 coil.reader.Diag))] i64
  (match result (Ok [status] status) (Err [problem] (do (ps (coil.io.stderr) (.msg problem)) (ps (coil.io.stderr) "\n") 1))))

(value member-status [(a (dyn coil.alloc.Allocator)) (self (slice u8)) (command (slice u8))
                      (dir (slice u8)) (m (ptr coil.project.Manifest)) (output (Option (slice u8)))] i64
  (block :status
    (let [entry (coil.path.path-join a dir (.entry m))]
      (when (= command "check")
        (when (> (len (.entry m)) 0) (return-from :status (child-status (execute a self ["check" entry]))))
        (let [roots (coil.project.m-effective-roots a m dir)
              excludes (coil.project.m-excludes-env-at a m dir)
              paths (box! a (coil.arraylist.ArrayList (slice u8)) (coil.arraylist.ArrayList::new [(slice u8)] a))]
          (for [i 0 (len (load roots))]
            (let [path (coil.path.path-join a dir (get (load roots) i))
                  cpath (coil.str.to-cstr a path)]
              (cond (coil.project.dir? cpath) (coil.project.m-source-walk! a path excludes paths)
                    (= (coil.fs.access cpath 0) (: 0 i32)) (do (push! paths path) 0)
                    :else 0)))
          (for [i 0 (len (load paths))]
            (when (!= (child-status (execute a self ["check" (get (load paths) i)])) 0) (return-from :status 1)))
          (return-from :status 0)))
      (when (= command "run") (return-from :status (child-status (execute a self ["run" entry]))))
      (let [destination (match output
                    (Some [path] path)
                    (_ (let [build (coil.path.path-join a dir "build") debug (coil.path.path-join a build "debug")]
                         (for path [build debug]
                           (let [name (coil.str.to-cstr a path)]
                             (unless (or (coil.project.dir? name) (= (coil.fs.make-dir name 493) (: 0 i32)))
                               (ps (coil.io.stderr) (coil.text.sconcat3 a "cannot create directory " path "\n"))
                               (return-from :status 1))))
                         (coil.path.path-join a debug (.name m)))))]
        (child-status (execute a self ["build" entry "-o" destination]))))))

(value workspace-command [(a (dyn coil.alloc.Allocator)) (self (slice u8)) (command (slice u8))
                          (output (Option (slice u8)))] (Option i64)
  (block :route
    (unless (and (or (= command "build") (= command "check") (= command "run"))
                 (or (= command "build") (match output (None [] true) (_ false))))
      (return-from :route (None [i64])))
    (let [manifest (match (coil.fs.read-file a "Coil.toml")
                     (Ok [bytes] (coil.project.parse-manifest a bytes)) (_ (return-from :route (None [i64]))))]
      (unless (coil.project.m-workspace? manifest) (return-from :route (None [i64])))
      (let [dirs (workspace-directories a manifest)
            compiler (coil.path.resolve-command-path a self)
            (mut total) 0 (mut failures) 0]
        (for [i 0 (len (load dirs))]
          (let [dir (get (load dirs) i)]
            (when (> (len dir) 0)
              (let [file (coil.path.path-join a dir "Coil.toml")
                    m (coil.project.parse-manifest a (coil.project.m-read-text a (coil.str.to-cstr a file)))]
                (if (and (!= command "check") (= (len (.entry m)) 0))
                    (ps (coil.io.stderr) (coil.text.sconcat3 a "-- " dir " (library: no entry)\n"))
                    (do (ps (coil.io.stderr) (coil.text.sconcat3 a "== " command (coil.text.sconcat3 a " " dir "\n")))
                        (set! total (+ total 1))
                        (when (!= (member-status a compiler command dir m output) 0) (set! failures (+ failures 1)))
                        0))))))
        (ps (coil.io.stderr) (coil.text.sconcat3 a "workspace " command ": "))
        (ps (coil.io.stderr) (coil.text.sconcat3 a (coil.text.i64->str a (- total failures)) "/" (coil.text.i64->str a total)))
        (ps (coil.io.stderr) " members ok\n")
        (Some (load failures))))))
