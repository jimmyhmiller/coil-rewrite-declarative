(use "rewrite.command-tools")
(use "rewrite.modules")
(use "coil.project")
(use "coil.path")
(use "coil.text")

(judgment collect-objects [(allocator (dyn coil.alloc.Allocator)) (root (slice u8))
                     (manifest (ptr coil.project.Manifest))
                     (objects (mut (coil.arraylist.ArrayList (slice u8))))]
  (each-index i (len (load (.sources manifest)))
    (with source (coil.path.path-join allocator root (get (load (.sources manifest)) i))
      (obtain object (temporary "foreign.o")
        (with (mut args) (coil.arraylist.ArrayList::new [(slice u8)] allocator)
          (each-index j (len (load (.include-dirs manifest)))
            (perform (push! (mut args) "-I"))
            (perform (push! (mut args) (coil.path.path-join allocator root (get (load (.include-dirs manifest)) j)))))
          (each-index j (len (load (.ccflags manifest)))
            (perform (push! (mut args) (get (load (.ccflags manifest)) j))))
          (perform (push! (mut args) "-c"))
          (perform (push! (mut args) source))
          (perform (push! (mut args) "-o"))
          (perform (push! (mut args) object))
          (prove (run-tool allocator "cc" (slice args)))
          (perform (push! (mut objects) object))))))
  (each-index i (len (load (.objects manifest)))
    (perform (push! (mut objects) (coil.path.path-join allocator root (get (load (.objects manifest)) i))))))

(judgment append-link-inputs [(allocator (dyn coil.alloc.Allocator)) (root (slice u8))
                              (manifest (ptr coil.project.Manifest))
                              (args (mut (coil.arraylist.ArrayList (slice u8))))]
  (each-index i (len (load (.search-paths manifest)))
    (perform (push! (mut args) (coil.text.sconcat allocator "-L"
             (coil.path.path-join allocator root (get (load (.search-paths manifest)) i))))))
  (each-index i (len (load (.frameworks manifest)))
    (perform (push! (mut args) "-framework"))
    (perform (push! (mut args) (get (load (.frameworks manifest)) i))))
  (each-index i (len (load (.libs manifest)))
    (perform (push! (mut args) (coil.text.sconcat allocator "-l" (get (load (.libs manifest)) i)))))
  (each-index i (len (load (.flags manifest)))
    (perform (push! (mut args) (get (load (.flags manifest)) i)))))

(judgment include-package [(catalog (ptr Sources)) (root (slice u8))
                           (selected (mut (coil.hashmap.HashMap (slice u8) bool)))
                           (packages (mut (coil.arraylist.ArrayList (ptr NativePackage))))]
  (when (contains? selected root) (accept))
  (record selected root true)
  (cases (get (.packages catalog) root)
    ((Some [package])
      (each-index i (len (.requires package))
        (prove (include-package catalog (get (.requires package) (- (len (.requires package)) i 1)) (mut selected) (mut packages))))
      (perform (push! (mut packages) package)))
    (_ (fail "unknown dependency package during linking"))))

(judgment link-executable [(allocator (dyn coil.alloc.Allocator)) (catalog (ptr Sources))
                           (object (slice u8)) (output (slice u8))]
  (with (mut args) (coil.arraylist.ArrayList::new [(slice u8)] allocator)
    (perform (push! (mut args) object))
    (cases (.manifest catalog)
      ((Some [manifest])
        (with root (coil.path.cwd-slice allocator)
          (with (mut selected) (coil.hashmap.HashMap::new [(slice u8) bool] allocator (coil.str.keyops-borrowed))
            (record selected root true)
            (with (mut packages) (coil.arraylist.ArrayList::new [(ptr NativePackage)] allocator)
              (each-index i (len (.files catalog))
                (cases (coil.project.m-realpath allocator (.path (get (.files catalog) i)))
                  ((Some [path])
                    (each-index j (len (.dependency-roots catalog))
                      (with dependency (get (.dependency-roots catalog) j)
                        (when (package-contains? (.path dependency) path)
                          (prove (include-package catalog (.owner dependency) (mut selected) (mut packages)))))))
                  (_)))
              (prove (collect-objects allocator root manifest (mut args)))
              (each-index i (len packages)
                (with package (get packages (- (len packages) i 1))
                  (cases (.manifest package)
                    ((Some [m]) (prove (collect-objects allocator (.root package) m (mut args))))
                    (_))))
              (prove (append-link-inputs allocator root manifest (mut args)))
              (each-index i (len packages)
                (with package (get packages (- (len packages) i 1))
                  (cases (.manifest package)
                    ((Some [m]) (prove (append-link-inputs allocator (.root package) m (mut args))))
                    (_))))))))
      (_))
    (perform (push! (mut args) "-o"))
    (perform (push! (mut args) output))
    (prove (run-tool allocator "cc" (slice args)))))
