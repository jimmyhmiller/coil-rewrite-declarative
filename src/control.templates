("while" 1 rest (loop (if (arg 1) (do (tail 2)) (break))))
("when" 1 rest (if (arg 1) (do (tail 2)) 0))
("unless" 1 rest (if (arg 1) 0 (do (tail 2))))
("block" 1 rest (block* (arg 1) (tail 2)))
("scope" 1 rest (block* (arg 1) (tail 2)))
("return-from" 2 exact (break (arg 1) (arg 2)))
("defer" 0 rest (defer* (tail 1)))
("cond" 0 pairs-right (if-keyword "else" (value) (if (item) (value) (rest))) 0)
("|>" 1 fold-left ((stage-head "expected a function at the start of the threading stage") (accumulator) (splice-stage 1)))
("|>>" 1 fold-left ((splice-stage 0) (accumulator)))
