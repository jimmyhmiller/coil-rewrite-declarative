(use "coil.slice")
(use "coil.result")
(use "coil.alloc")
(use "rewrite.modules")
(use "rewrite.host")
(use "coil.project")
(use "rewrite.declarations")

(use "coil.amap")
(use "rewrite.operators")
(use "rewrite.control")
(use "rewrite.logic")

(domain Expectation (Infer) (Discard) (Expect [(type (slice u8))]))

(context LoopScope [(cleanup-depth i64) (unlabelled bool) (id i64) (label (slice u8)) (expected Expectation) (result (Option (slice u8)))])
(context ConstantValue [(layout-dependent bool) (contextual bool) (reads-storage bool) (literal (ptr coil.reader.Sexp)) (type (slice u8))])
(context Dispatch [(trait (ptr coil.reader.Sexp)) (member (slice u8)) (target (slice u8))])
(context Checked
  [(allocator (dyn coil.alloc.Allocator))
   (nominal-state (coil.hashmap.HashMap i64 bool))
   (dispatches (coil.hashmap.HashMap i64 Dispatch))
   (method-bodies (coil.hashmap.HashMap (slice u8) (ptr coil.reader.Sexp)))
   (implementations (coil.hashmap.HashMap (slice u8) bool))
   (parameters (Option (ptr coil.reader.Sexp)))
   (layout-parameters (coil.hashmap.HashMap i64 (slice u8)))
   (payload-sizes (coil.hashmap.HashMap i64 i64))
   (field-offsets (coil.hashmap.HashMap i64 i64))
   (layouts (coil.hashmap.HashMap i64 Layout)) (layout-started (coil.hashmap.HashMap i64 bool))
   (statics (coil.hashmap.HashMap i64 (ptr coil.reader.Sexp)))
   (constants (coil.hashmap.HashMap i64 ConstantValue))
   (evaluating (coil.hashmap.HashMap i64 bool))
   (type-arguments (coil.hashmap.HashMap i64 (coil.arraylist.ArrayList (slice u8))))
   (inline-policies (coil.hashmap.HashMap i64 (slice u8)))
   (callees (coil.hashmap.HashMap i64 (ptr coil.reader.Sexp)))
   (active-cleanups (coil.arraylist.ArrayList (ptr coil.reader.Sexp)))
   (barrier i64)
   (guards (coil.hashmap.HashMap i64 bool))
   (on-exit (coil.hashmap.HashMap i64 (coil.arraylist.ArrayList (ptr coil.reader.Sexp))))
   (targets (coil.hashmap.HashMap i64 i64)) (loops (coil.arraylist.ArrayList LoopScope))
   (expanded (coil.hashmap.HashMap i64 (ptr coil.reader.Sexp)))
   (types (coil.hashmap.HashMap i64 (slice u8)))
   (references (coil.hashmap.HashMap i64 i64))
   (cells (coil.hashmap.HashMap i64 bool))
   (operators (coil.hashmap.HashMap i64 rewrite.operators.Operator))])



(intervals integer-result?
  ("i8" -128 127) ("u8" 0 255)
  ("i16" -32768 32767) ("u16" 0 65535)
  ("i32" -2147483648 2147483647) ("u32" 0 4294967295)
  ("i64") ("u64") ("i128") ("u128"))

(value scalar-type [(type (ptr coil.reader.Sexp))] (slice u8)
  (cond (coil.reader.sexp-sym-is type "isize") (rewrite.host.signed-word-type)
        (coil.reader.sexp-sym-is type "usize") (rewrite.host.unsigned-word-type)
        :else (coil.reader.sexp-sym type)))

(predicate float-type? [(type (slice u8))]
  (or (= type "f32") (= type "f64")))

(predicate numeric-type? [(type (slice u8))]
  (or (float-type? type) (integer-result? type 0)))

(value argument-start [(expr (ptr coil.reader.Sexp))] i64
  (if (explicit-call? expr) 2 1))

(value call-start [(expr (ptr coil.reader.Sexp))] i64
  (let [start (argument-start expr)]
    (if (and (> (coil.reader.sexp-count expr) start) (coil.reader.sexp-vec? (coil.reader.sexp-nth expr start)))
        (+ start 1) start)))

(value function-parameters [(form (ptr coil.reader.Sexp))] (Option (ptr coil.reader.Sexp))
  (match (function-generics form) (GenericParameters [params] (Some params)) (_ (None [(ptr coil.reader.Sexp)]))))

(judgment check-signature-type [(form (ptr coil.reader.Sexp)) (type (ptr coil.reader.Sexp))]
  (when (and (coil.reader.sexp-sym? type) (parameter-type? (function-parameters form) (coil.reader.sexp-sym type))) (accept))
  (prove (check-type type)))

(predicate contextual-number? [(expr (ptr coil.reader.Sexp))]
  (cond (or (int-literal? expr) (float-literal? expr)) true
        (match (sequence-expression expr) (Sequence [] true) (_ false))
        (and (> (coil.reader.sexp-count expr) 1)
             (contextual-number? (coil.reader.sexp-nth expr (- (coil.reader.sexp-count expr) 1))))
        (match (local-bindings expr) (Bindings [_] true) (_ false))
        (contextual-number? (coil.reader.sexp-nth expr (- (coil.reader.sexp-count expr) 1)))
        :else (match (conditional expr)
                (Branches [_ yes no] (and (contextual-number? yes) (contextual-number? no)))
                (_ false))))

(judgment check-type [(type (ptr coil.reader.Sexp))]
  (require (and (coil.reader.sexp-sym? type)
               (or (integer-result? (scalar-type type) 0)
                   (float-type? (scalar-type type)) (coil.reader.sexp-sym-is type "bool")))
           type "unsupported type"))

(context Layout [(size i64) (alignment i64)])

(value integer-width [(name (slice u8))] i64
  (block :width
    (when (or (< (len name) 2) (not (or (= (get name 0) #\i) (= (get name 0) #\u))))
      (return-from :width 0))
    (let [(mut width) 0]
      (for [i 1 (len name)]
        (let [digit (- (cast i64 (get name i)) 48)]
          (when (or (< digit 0) (> digit 9)) (return-from :width 0))
          (set! width (+ (* width 10) digit))
          (when (> width 65535) (return-from :width 0))))
      (load width))))

(value scalar-bytes [(type (slice u8))] i64
  (let [bits (integer-width type)]
    (cond (= type "bool") 1
          (= type "f32") 4
          (= type "f64") 8
          (= bits 0) 0
          (<= bits 8) 1
          (<= bits 16) 2
          (<= bits 32) 4
          (<= bits 64) 8
          (<= bits 128) 16
          :else 0)))

(predicate builtin-type-name? [(name (ptr coil.reader.Sexp))]
  (let [type (scalar-type name)]
    (or (> (integer-width type) 0) (float-type? type) (= type "bool") (= type "void")
        (= type "never") (= type "externref") (= type "Code") (= type "CodeBuilder"))))

(derive array-length [(lookup rewrite.modules.Lookup) (checked (mut Checked)) (count (ptr coil.reader.Sexp))] i64
  (when (int-literal? count) (conclude (coil.reader.sexp-int count)))
  (obtain value (evaluate-constant lookup (mut checked) count)
    (require (and (int-literal? (.literal value)) (not (.reads-storage value)) (not (.layout-dependent value)))
             count "array length must name a layout-independent integer constant")
    (conclude (coil.reader.sexp-int (.literal value)))))

(derive aligned-size [(size i64) (alignment i64) (site (ptr coil.reader.Sexp))] i64
  (with padding (% (- alignment (% size alignment)) alignment)
    (require (<= size (- 9223372036854775807 padding)) site "struct alignment overflows")
    (conclude (+ size padding))))

(context StructPolicy [(packed bool) (alignment i64)])

(derive struct-policy [(lookup rewrite.modules.Lookup) (form (ptr coil.reader.Sexp))] StructPolicy
  (cases (layout-annotation form)
    ((Annotated [expression])
      (cases (layout-constructor expression)
        ((Constructor [name])
          (obtain resolved (rewrite.modules.find-name lookup name (rewrite.modules.VariantNames))
            (with canonical (match resolved (Some [variant] (rewrite.modules.symbol-for lookup variant))
                                           (_ (coil.reader.sexp-sym name)))
              (with arity (- (coil.reader.sexp-count expression) 1)
                (when (and (= arity 0) (or (= canonical "coil.layout.C") (= canonical "coil.layout.Packed")))
                  (conclude (StructPolicy :packed (= canonical "coil.layout.Packed") :alignment 1)))
                (when (and (= arity 1) (= canonical "coil.layout.Align"))
                  (with argument (coil.reader.sexp-nth expression 1)
                    (require (int-literal? argument) argument "alignment must be a power-of-two integer literal")
                    (with bytes (coil.reader.sexp-int argument)
                      (require (and (> bytes 0) (= (& bytes (- bytes 1)) 0)) argument "alignment must be a positive power of two")
                      (conclude (StructPolicy :packed false :alignment bytes)))))))))
        (_))
      (reject expression "unsupported struct layout constructor"))
    (_ (conclude (StructPolicy :packed false :alignment 1)))))

(derive nominal-layout [(unit (ptr rewrite.modules.SourceUnit)) (checked (mut Checked))
                       (form (ptr coil.reader.Sexp))] Layout
  (cases (get (.layouts checked) (.node-id form)) ((Some [layout]) (conclude layout)) (_))
  (require (not (contains? (.layout-started checked) (.node-id form))) form "type contains itself by value")
  (record (.layout-started checked) (.node-id form) true)
  (cases (structure form)
    ((Struct [name fields])
      (require (not (builtin-type-name? name)) name "struct name is a built-in type")
      (obtain policy (struct-policy (rewrite.modules.lookup-for unit form) form)
        (with (mut end) 0
          (with (mut alignment) (.alignment policy)
            (distinct names (.allocator checked)
              (each-child field fields 0 i
                (cases (typed-parameter field)
                  ((Parameter [name type])
                    (insert-unique names name field "duplicate struct field")
                    (obtain layout (type-layout (rewrite.modules.lookup-for unit form) (mut checked) type)
                      (with field-alignment (if (.packed policy) 1 (.alignment layout))
                        (obtain offset (aligned-size (load end) field-alignment field)
                          (require (<= (.size layout) (- 9223372036854775807 offset)) field "struct size overflows")
                          (record (.field-offsets checked) (.node-id name) offset)
                          (perform (set! end (+ offset (.size layout))))
                          (when (> field-alignment (load alignment)) (perform (set! alignment field-alignment)))))))
                  (_ (reject field "expected a named struct field")))))
            (obtain size (aligned-size (load end) (load alignment) form)
              (with layout (Layout :size size :alignment (load alignment))
                (record (.layouts checked) (.node-id form) layout)
                (conclude layout)))))))
    (_ (cases (sum-declaration form)
         ((Sum [name])
           (require (not (builtin-type-name? name)) name "sum name is a built-in type")
           (with (mut largest) 0
             (each-child variant form (rewrite.modules.variant-start form) i
               (cases (variant-fields variant)
                 ((Payload [fields])
                   (obtain bytes (payload-fields-size (rewrite.modules.lookup-for unit form) (mut checked) fields)
                     (when (> bytes (load largest)) (perform (set! largest bytes)))))
                 (_)))
             (with word (scalar-bytes (rewrite.host.unsigned-word-type))
               (obtain payload (aligned-size (load largest) word form)
                 (require (<= payload (- 9223372036854775807 word)) form "sum size overflows")
                 (with layout (Layout :size (+ word payload) :alignment word)
                   (record (.layouts checked) (.node-id form) layout)
                   (conclude layout))))))
         (_ (reject form "expected a type declaration"))))))

(derive payload-size [(lookup rewrite.modules.Lookup) (checked (mut Checked))
                      (type (ptr coil.reader.Sexp)) (layout Layout)] i64
  (when (coil.reader.sexp-sym? type)
    (when (= (scalar-bytes (scalar-type type)) 0)
      (obtain resolved (rewrite.modules.find-name lookup type (rewrite.modules.TypeNames))
        (cases resolved
          ((Some [form])
            (cases (structure form)
              ((Struct [_ fields])
                (cases (get (.payload-sizes checked) (.node-id form))
                  ((Some [cached]) (conclude cached)) (_))
                (obtain size (payload-fields-size (rewrite.modules.lookup-for (.unit lookup) form) (mut checked) fields)
                  (record (.payload-sizes checked) (.node-id form) size)
                  (conclude size)))
              (_)))
          (_)))))
  (cases (array-layout type)
    ((ArrayOf [element count])
      (obtain n (array-length lookup (mut checked) count)
        (obtain inner (type-layout lookup (mut checked) element)
          (obtain bytes (payload-size lookup (mut checked) element inner)
            (require (or (= bytes 0) (<= n (/ 9223372036854775807 bytes))) count "payload array size overflows")
            (conclude (* n bytes))))))
    (_ (conclude (.size layout)))))

;; A variant reserves a whole eight-byte slot for each field, and enough space
;; for natural padding when a field requires greater alignment. Nested structs
;; contribute their payload footprint recursively.
(derive payload-fields-size [(lookup rewrite.modules.Lookup) (checked (mut Checked))
                             (fields (ptr coil.reader.Sexp))] i64
  (with (mut rounded) 0
    (with (mut end) 0
      (with (mut alignment) 1
        (each-child field fields 0 i
          (cases (typed-parameter field)
            ((Parameter [_ type])
              (obtain layout (type-layout lookup (mut checked) type)
                (obtain bytes (payload-size lookup (mut checked) type layout)
                  (obtain slot (aligned-size bytes 8 field)
                    (require (<= slot (- 9223372036854775807 (load rounded))) field "sum payload size overflows")
                    (perform (set! rounded (+ (load rounded) slot))))
                  (obtain offset (aligned-size (load end) (.alignment layout) field)
                    (require (<= bytes (- 9223372036854775807 offset)) field "sum payload size overflows")
                    (perform (set! end (+ offset bytes))))
                  (when (> (.alignment layout) (load alignment)) (perform (set! alignment (.alignment layout)))))))
            (_ (reject field "expected a named variant field"))))
        (obtain natural (aligned-size (load end) (load alignment) fields)
          (conclude (if (> natural (load rounded)) natural (load rounded))))))))

(derive type-layout [(lookup rewrite.modules.Lookup) (checked (mut Checked)) (type (ptr coil.reader.Sexp))] Layout
  (obtain result (inspect-type lookup (mut checked) type true)
    (cases result ((Some [layout]) (conclude layout)) (_ (reject type "type has no native layout")))))

(value parameter-name [(parameter (ptr coil.reader.Sexp))] (ptr coil.reader.Sexp)
  (match (bounded-parameter parameter) (Bounded [name] name) (_ parameter)))

(predicate parameter-type? [(parameters (Option (ptr coil.reader.Sexp))) (name (slice u8))]
  (match parameters
    (Some [items]
      (block :found
        (for [i 0 (coil.reader.sexp-count items)]
          (when (coil.reader.sexp-sym-is (parameter-name (coil.reader.sexp-nth items i)) name) (return-from :found true)))
        false))
    (_ false)))

(derive inspect-type [(lookup rewrite.modules.Lookup) (checked (mut Checked))
                      (type (ptr coil.reader.Sexp)) (measure? bool)] (Option Layout)
  (when (coil.reader.sexp-sym? type)
    (with name (scalar-type type)
      (when (and (not measure?) (or (parameter-type? (.parameters checked) name) (> (integer-width name) 0) (= name "Code") (= name "CodeBuilder"))) (conclude (None [Layout])))
      (with bytes (scalar-bytes name)
        (when (> bytes 0) (conclude (if measure? (Some (Layout :size bytes :alignment bytes)) (None [Layout])))))
      (require (not (builtin-type-name? type)) type "type has no supported native layout")
      (obtain resolved (rewrite.modules.find-name lookup type (rewrite.modules.TypeNames))
        (cases resolved
          ((Some [form])
            (cases (nominal-parameters form)
              ((TypeParameters [params]) (require (= (coil.reader.sexp-count params) 0) type "generic type requires arguments"))
              (_))
            (when (not measure?) (conclude (None [Layout])))
            (obtain layout (nominal-layout (.unit lookup) (mut checked) form) (conclude (Some layout))))
          (_ (reject type "unknown type"))))))
  (cases (address-layout type)
    ((AddressOf [kind element])
      (prove (inspect-type lookup (mut checked) element false))
      (when (not measure?) (conclude (None [Layout])))
      (with word (scalar-bytes (rewrite.host.unsigned-word-type))
        (conclude (Some (Layout :alignment word :size (if (coil.reader.sexp-sym-is kind "slice") (* word 2) word))))))
    (_))
  (cases (function-pointer-layout type)
    ((FunctionPointer [convention parameters result])
      (prove (native-convention lookup convention))
      (each-child param parameters 0 i (prove (inspect-type lookup (mut checked) param false)))
      (when (not (or (coil.reader.sexp-sym-is result "void") (coil.reader.sexp-sym-is result "never")))
        (prove (inspect-type lookup (mut checked) result false)))
      (when (not measure?) (conclude (None [Layout])))
      (with word (scalar-bytes (rewrite.host.unsigned-word-type))
        (conclude (Some (Layout :size word :alignment word)))))
    (_))
  (cases (array-layout type)
    ((ArrayOf [element count])
      (obtain n (array-length lookup (mut checked) count)
        (require (>= n 0) count "array length cannot be negative")
        (obtain result (inspect-type lookup (mut checked) element measure?)
          (cases result
            ((Some [item])
              (require (or (= (.size item) 0) (<= n (/ 9223372036854775807 (.size item)))) count "array size overflows")
              (conclude (Some (Layout :size (* n (.size item)) :alignment (.alignment item)))))
            (_ (conclude (None [Layout])))))))
    (_))
  (cases (type-application type)
    ((AppliedType [head])
      (obtain resolved (rewrite.modules.find-name lookup head (rewrite.modules.TypeNames))
        (cases resolved
          ((Some [definition])
            (cases (nominal-parameters definition)
              ((TypeParameters [params])
                (require (= (coil.reader.sexp-count params) (- (coil.reader.sexp-count type) 1)) type "incorrect type argument count")
                (each-child argument type 1 i (prove (inspect-type lookup (mut checked) argument false)))
                (when (not measure?) (conclude (None [Layout])))
                (reject type "generic type layout has not been specialized"))
              (_)))
          (_))))
    (_))
  (reject type "type has no known layout"))

(value layout-integer [(allocator (dyn coil.alloc.Allocator)) (n i64) (expr (ptr coil.reader.Sexp))] ConstantValue
  (ConstantValue :type "i64" :layout-dependent true :contextual false :reads-storage false
                 :literal (box! allocator coil.reader.Sexp (coil.reader.mk-sexp-src (coil.reader.KInt n) expr))))

(derive layout-value [(lookup rewrite.modules.Lookup) (checked (mut Checked))
                      (expr (ptr coil.reader.Sexp))] (Option ConstantValue)
  (cases (layout-query expr)
    ((LayoutOf [query type])
      (obtain layout (type-layout lookup (mut checked) type)
        (with n (if (coil.reader.sexp-sym-is query "sizeof") (.size layout) (.alignment layout))
          (conclude (Some (layout-integer (.allocator checked) n expr))))))
    (_))
  (cases (field-offset-query expr)
    ((OffsetOf [type field])
      (obtain resolved (rewrite.modules.find-name lookup type (rewrite.modules.TypeNames))
        (cases resolved
          ((Some [form])
            (prove (nominal-layout (.unit lookup) (mut checked) form))
            (cases (structure form)
              ((Struct [_ fields])
                (each-child item fields 0 i
                  (cases (typed-parameter item)
                    ((Parameter [name _])
                      (when (coil.reader.sexp-sym-is name (coil.reader.sexp-sym field))
                        (cases (get (.field-offsets checked) (.node-id name))
                          ((Some [offset]) (conclude (Some (layout-integer (.allocator checked) offset expr))))
                          (_ (reject field "field layout is unavailable")))))
                    (_))))
              (_))
            (reject field "unknown struct field"))
          (_ (reject type "unknown struct type")))))
    (_ (conclude (None [ConstantValue])))))

(derive constant-type [(value ConstantValue) (expected Expectation) (site (ptr coil.reader.Sexp))] (slice u8)
  (with actual (.type value)
    (with wanted (match expected (Expect [t] t) (_ actual))
      (when (= wanted actual) (conclude actual))
      (require (.contextual value) site "value differs from expected type")
      (when (and (= actual "i64") (int-literal? (.literal value)))
        (require (integer-result? wanted (coil.reader.sexp-int (.literal value))) site "constant does not fit expected type")
        (conclude wanted))
      (when (and (= actual "f64") (float-type? wanted)) (conclude wanted))
      (reject site "constant differs from expected type"))))

(value literal-constant [(expr (ptr coil.reader.Sexp)) (type (slice u8))] ConstantValue
  (ConstantValue :literal expr :type type :layout-dependent false :contextual true :reads-storage false))

(derive evaluate-constant [(lookup rewrite.modules.Lookup) (checked (mut Checked))
                           (expr (ptr coil.reader.Sexp))] ConstantValue
  (obtain result (layout-value lookup (mut checked) expr)
    (cases result ((Some [value]) (conclude value)) (_)))
  (when (int-literal? expr) (conclude (literal-constant expr "i64")))
  (when (float-literal? expr) (conclude (literal-constant expr "f64")))
  (when (or (true-literal? expr) (false-literal? expr)) (conclude (literal-constant expr "bool")))
  (when (identifier? expr)
    (obtain resolution (rewrite.modules.find-declaration lookup expr)
      (cases resolution
        ((Some [found])
          (obtain value (constant-value (.unit lookup) (mut checked) found) (conclude value)))
        (_ (reject expr "unbound constant")))))
  (cases (type-ascription expr)
    ((Ascribed [inner type])
      (prove (check-type type))
      (obtain value (evaluate-constant lookup (mut checked) inner)
        (obtain t (constant-type value (Expect (scalar-type type)) inner)
          (conclude (ConstantValue :layout-dependent (.layout-dependent value) :contextual (.contextual value)
                                  :reads-storage (.reads-storage value) :literal (.literal value) :type t)))))
    (_))
  (cases (conditional expr)
    ((Branches [condition yes no])
      (obtain test (evaluate-constant lookup (mut checked) condition)
        (require (or (= (.type test) "bool") (integer-result? (.type test) 0)) condition
                 "constant condition requires a boolean or integer")
        (obtain left (evaluate-constant lookup (mut checked) yes)
          (obtain right (evaluate-constant lookup (mut checked) no)
            (with joined (if (or (= (.type left) "i64") (= (.type left) "f64")) (.type right) (.type left))
              (prove (constant-type left (Expect joined) yes))
              (prove (constant-type right (Expect joined) no))
              (with taken (if (int-literal? (.literal test)) (!= (coil.reader.sexp-int (.literal test)) 0)
                              (true-literal? (.literal test)))
                (conclude (ConstantValue :layout-dependent (or (.layout-dependent test) (.layout-dependent left) (.layout-dependent right))
                                        :contextual (and (.contextual left) (.contextual right))
                                        :reads-storage (or (.reads-storage test) (.reads-storage left) (.reads-storage right))
                                        :type joined :literal (if taken (.literal left) (.literal right))))))))))
    (_))
  (reject expr "unsupported constant initializer"))

(derive constant-value [(unit (ptr rewrite.modules.SourceUnit)) (checked (mut Checked))
                        (form (ptr coil.reader.Sexp))] ConstantValue
  (cases (get (.constants checked) (.node-id form))
    ((Some [value]) (conclude value))
    (_))
  (cases (constant-declaration form)
    ((Constant [_ init])
      (require (not (contains? (.evaluating checked) (.node-id form))) init "cyclic constant initializer")
      (record (.evaluating checked) (.node-id form) true)
      (obtain value (evaluate-constant (rewrite.modules.lookup-for unit form) (mut checked) init)
        (when (static-definition? form)
          (require (not (.reads-storage value)) init "static initializer cannot read another static definition")
          (with stored (ConstantValue :layout-dependent (.layout-dependent value) :contextual false :literal (.literal value) :type (.type value) :reads-storage true)
            (record (.constants checked) (.node-id form) stored)
            (conclude stored)))
        (record (.constants checked) (.node-id form) value)
        (conclude value)))
    (_ (reject form "expected a constant declaration"))))

(derive synthesize
  [(signatures rewrite.modules.Lookup)
   (checked (mut Checked))
   (locals (coil.amap.AMap (slice u8) i64)) (expr (ptr coil.reader.Sexp))
   (expected Expectation)] (slice u8)
  (cases (layout-query expr)
    ((LayoutOf [_ type])
      (when (and (coil.reader.sexp-sym? type) (parameter-type? (.parameters checked) (coil.reader.sexp-sym type)))
        (record (.layout-parameters checked) (.node-id expr) (coil.reader.sexp-sym type))
        (conclude "i64")))
    (_))
  (obtain result (layout-value signatures (mut checked) expr)
    (cases result
      ((Some [value]) (record (.constants checked) (.node-id expr) value) (conclude (.type value)))
      (_)))
  (when (float-literal? expr)
    (with type (match expected (Expect [t] t) (_ "f64"))
      (require (float-type? type) expr "floating literal requires a floating-point type")
      (conclude type)))
  (when (int-literal? expr)
    (with type (match expected (Expect [t] t) (_ "i64"))
      (require (integer-result? type (coil.reader.sexp-int expr))
               expr "integer literal does not fit expected type")
      (conclude type)))
  (when (or (true-literal? expr) (false-literal? expr)) (conclude "bool"))
  (when (identifier? expr)
    (cases (get locals (coil.reader.sexp-sym expr))
      ((Some [binding])
        (record (.references checked) (.node-id expr) binding)
        (cases (get (.types checked) binding)
          ((Some [t]) (conclude t))
          (_ (reject expr "binding has no checked type"))))
      (_ (obtain resolution (rewrite.modules.find-declaration signatures expr)
           (cases resolution
             ((Some [found])
               (obtain value (constant-value (.unit signatures) (mut checked) found)
                 (when (static-definition? found) (record (.statics checked) (.node-id expr) found))
                 (record (.constants checked) (.node-id expr) value)
                 (obtain t (constant-type value expected expr) (conclude t))))
             (_ (reject expr "unbound identifier")))))))
  (cases (type-ascription expr)
    ((Ascribed [value type])
      (prove (check-type type))
      (obtain t (check-expression signatures (mut checked) locals value (Expect (scalar-type type)))
        (conclude t)))
    (_))
  (cases (numeric-cast expr)
    ((Convert [type value])
      (prove (check-type type))
      (obtain source (check-expression signatures (mut checked) locals value (Infer))
        (require (and (numeric-type? source) (numeric-type? (scalar-type type)))
                 expr "cast requires numeric operands")
        (conclude (scalar-type type))))
    (_))
  (cases (local-bindings expr)
    ((Bindings [pairs])
      (require (= (% (coil.reader.sexp-count pairs) 2) 0) pairs "let needs binding/value pairs")
      (with (mut inner) (coil.amap.amap-edit locals (.alc locals))
        (each-pair name init pairs
          (obtain t (check-expression signatures (mut checked) inner init (Infer))
            (require (!= t "void") init "cannot bind a void value")
            (cases (mutable-binding name)
              ((CellBinding [symbol])
                (record (.cells checked) (.node-id symbol) true)
                (record (.types checked) (.node-id symbol) t)
                (record inner (coil.reader.sexp-sym symbol) (.node-id symbol)))
              (_
                (require (identifier? name) name "expected a binding name")
                (record (.types checked) (.node-id name) t)
                (when (not (coil.reader.sexp-sym-is name "_"))
                  (record inner (coil.reader.sexp-sym name) (.node-id name)))))))
        (obtain result (check-body signatures (mut checked) inner expr 2 expected)
          (conclude result))))
    (_))
  (cases (explicit-load expr)
    ((LoadLocal [name])
      (obtain t (check-cell signatures (mut checked) locals name) (conclude t)))
    (_))
  (cases (local-store expr)
    ((WriteLocal [name value])
      (prove (check-write signatures (mut checked) locals name value))
      (conclude "i64"))
    (_))
  (cases (explicit-store expr)
    ((StoreLocal [name value])
      (prove (check-write signatures (mut checked) locals name value))
      (conclude "i64"))
    (_))
  (when (or (repetition? expr) (named-block? expr))
    (with index (len (.loops checked))
      (with labelled (coil.reader.sexp-kw? (coil.reader.sexp-nth expr 1))
        (require (or (not (named-block? expr)) labelled) expr "block requires a label")
        (require (or (named-block? expr) (> (coil.reader.sexp-count expr) (if labelled 2 1))) expr "loop requires a body")
        (perform (push! (mut (.loops checked))
                   (LoopScope :cleanup-depth (len (.active-cleanups checked)) :unlabelled (not (named-block? expr)) :id (.node-id expr)
                              :label (if labelled (coil.reader.sexp-kw (coil.reader.sexp-nth expr 1)) "")
                              :expected expected :result (None [(slice u8)]))))
        (obtain normal (check-body signatures (mut checked) locals expr (if labelled 2 1)
                                   (if (named-block? expr) expected (Discard)))
          (when (and (named-block? expr) (!= normal "never"))
            (with joined (match expected (Discard [] "void") (_ normal))
              (cases (.result (get (.loops checked) index))
                ((Some [t]) (require (= t joined) expr "block exits have different types"))
                (_))
              (perform (set! (.result (elem (field checked loops) index)) (Some joined)))))))
      (with scope (get (.loops checked) index)
        (perform (pop! (mut (.loops checked))))
        (cases (.result scope)
          ((Some [t]) (conclude t))
          (_ (conclude "never"))))))
  (when (next-iteration? expr)
    (obtain scope (jump-scope (mut checked) expr)
      (require (= (coil.reader.sexp-count expr) (if (labelled-jump? expr) 2 1))
               expr "continue accepts only a label")
      (conclude "never")))
  (when (exit-loop? expr)
    (obtain index (jump-scope (mut checked) expr)
      (with scope (get (.loops checked) index)
        (with first-value (if (labelled-jump? expr) 2 1)
          (require (<= (coil.reader.sexp-count expr) (+ first-value 1)) expr "break accepts one value")
        (with target (match (.expected scope)
                       (Infer [] (match (.result scope) (Some [t] (Expect t)) (_ (Infer))))
                       (_ (.expected scope)))
          (when (> (coil.reader.sexp-count expr) first-value)
            (obtain t (check-expression signatures (mut checked) locals (coil.reader.sexp-nth expr first-value) target)
              (when (!= t "never")
                (perform (set! (.result (elem (field checked loops) index))
                               (Some (match target (Discard [] "void") (_ t))))))
              (conclude "never")))
          (require (match target (Expect [t] (= t "i64")) (_ true)) expr "break value differs from expected type")
          (perform (set! (.result (elem (field checked loops) index))
                         (Some (match target (Discard [] "void") (_ "i64")))))
          (conclude "never"))))))
  (cases (sequence-expression expr)
    ((Sequence [])
      (when (= (coil.reader.sexp-count expr) 1) (conclude "void"))
      (obtain result (check-body signatures (mut checked) locals expr 1 expected)
        (conclude result)))
    (_))
  (cases (conditional expr)
    ((Branches [condition then else])
      (obtain predicate (check-expression signatures (mut checked) locals condition (Infer))
        (require (or (= predicate "bool") (integer-result? predicate 0))
                 condition "if condition must be a bool or integer"))
      (when (match expected (Discard [] true) (_ false))
        (prove (check-expression signatures (mut checked) locals then (Discard)))
        (prove (check-expression signatures (mut checked) locals else (Discard)))
        (conclude "void"))
      (when (and (match expected (Infer [] true) (_ false)) (contextual-number? then))
        (obtain branch (check-expression signatures (mut checked) locals else (Infer))
          (when (= branch "never")
            (obtain other (check-expression signatures (mut checked) locals then expected) (conclude other)))
          (prove (check-expression signatures (mut checked) locals then (Expect branch)))
          (conclude branch)))
      (obtain branch (check-expression signatures (mut checked) locals then expected)
        (when (= branch "never")
          (obtain other (check-expression signatures (mut checked) locals else expected) (conclude other)))
        (prove (check-expression signatures (mut checked) locals else (Expect branch)))
        (conclude branch)))
    (_))
  (cases (application expr)
    ((Apply [operator])
      (when (explicit-call? expr)
        (require (and (> (coil.reader.sexp-count expr) 1) (coil.reader.sexp-sym? (coil.reader.sexp-nth expr 1))) expr "call requires a function name"))
      (when (not (explicit-call? expr))
        (obtain expansion (rewrite.logic.expand-call (.alc locals) expr (coil.reader.sexp-sym operator))
          (cases expansion
            ((Some [expanded])
              (record (.expanded checked) (.node-id expr) expanded)
              (obtain t (check-expression signatures (mut checked) locals expanded expected) (conclude t)))
            (_))))
      (require (not (contains? locals (coil.reader.sexp-sym operator))) operator "local value is not callable")
      (obtain qualified (qualified-method signatures operator)
        (cases qualified
          ((Some [method]) (obtain t (method-call signatures (mut checked) locals expr method) (conclude t)))
          (_)))
      (obtain resolution (rewrite.modules.find-declaration signatures operator)
        (cases resolution
          ((None [])
            (obtain representative (rewrite.modules.find-name signatures operator (rewrite.modules.MethodNames))
              (cases representative
                ((Some [method])
                  (with owner (rewrite.modules.lookup-for (.unit signatures) method)
                    (with group (match (get (.method-groups (.scope owner)) (coil.reader.sexp-sym (coil.reader.sexp-nth method 0))) (Some [g] g) (_ (unreachable "method group missing")))
                      (require (= (len (load group)) 1) operator "ambiguous trait method; qualify the call with the trait name")
                      (obtain t (method-call signatures (mut checked) locals expr method) (conclude t)))))
                (_)))
            (when (not (explicit-call? expr))
              (obtain expansion (rewrite.control.expand-call (.alc locals) expr (coil.reader.sexp-sym operator))
                (cases expansion
                  ((Some [expanded])
                    (record (.expanded checked) (.node-id expr) expanded)
                    (obtain t (check-expression signatures (mut checked) locals expanded expected)
                      (conclude t)))
                  (_))))
            (cases (rewrite.operators.find-operator (coil.reader.sexp-sym operator) (- (coil.reader.sexp-count expr) (argument-start expr)))
              ((Some [op])
                (record (.operators checked) (.node-id expr) op)
                (obtain t (check-operator signatures (mut checked) locals expr op) (conclude t)))
              (_ (reject expr "call to undefined function"))))
          ((Some [found])
            (cases (primitive-header found)
              ((Primitive [_])
                (with tag (coil.reader.sexp-nth found (- (coil.reader.sexp-count found) 1))
                  (require (coil.reader.sexp-kw? tag) found "expected a primitive opcode")
                  (with opcode (coil.reader.sexp-kw tag)
                    (require (= (- (coil.reader.sexp-count expr) (argument-start expr)) 2) expr "binary primitive expects two operands")
                    (cases (rewrite.operators.primitive-operator opcode)
                      ((Some [op])
                        (record (.operators checked) (.node-id expr) op)
                        (obtain t (check-operator signatures (mut checked) locals expr op)
                          (with left (coil.reader.sexp-nth expr (argument-start expr))
                            (require (match (get (.types checked) (.node-id left)) (Some [operand] (numeric-type? operand)) (_ false))
                                     left "primitive requires numeric operands"))
                          (conclude t)))
                      (_ (reject expr "unsupported primitive opcode"))))))
              (_))
            (record (.callees checked) (.node-id expr) found)
            (cases (rewrite.modules.callable found)
              ((Function [_ _ parameters result])
                (cases (function-generics found)
                  ((GenericParameters [types])
                    (obtain t (generic-call signatures (rewrite.modules.lookup-for (.unit signatures) found) (mut checked) locals expr types parameters result expected) (conclude t)))
                  (_))
                (require (= (coil.reader.sexp-count parameters) (- (coil.reader.sexp-count expr) (argument-start expr)))
                         expr "wrong number of arguments")
                (each-child arg expr (argument-start expr) i
                  (with parameter (coil.reader.sexp-nth parameters (- i (argument-start expr)))
                    (with type (match (typed-parameter parameter) (Parameter [_ t] t) (_ parameter))
                      (prove (check-expression signatures (mut checked) locals arg (Expect (scalar-type type)))))))
                (conclude (scalar-type result)))
              (_ (reject found "invalid function signature")))))))
    (_ (reject expr "unsupported expression"))))

(derive qualified-method [(lookup rewrite.modules.Lookup) (operator (ptr coil.reader.Sexp))] (Option (ptr coil.reader.Sexp))
  (with name (coil.reader.sexp-sym operator)
    (each-index i (- (len name) 1)
      (when (and (= (get name i) #\:) (= (get name (+ i 1)) #\:))
        (with (mut owner) (coil.reader.mk-sexp-src (coil.reader.KSym (subslice name 0 i)) operator)
          (obtain resolved (rewrite.modules.find-name lookup (mut owner) (rewrite.modules.TraitNames))
            (cases resolved
              ((Some [trait])
                (each-child method trait (rewrite.modules.trait-method-start trait) j
                  (when (coil.reader.sexp-sym-is (coil.reader.sexp-nth method 0) (subslice name (+ i 2) (len name)))
                    (conclude (Some method))))
                (reject operator "trait does not declare this method"))
              (_ (conclude (None [(ptr coil.reader.Sexp)])))))))))
  (conclude (None [(ptr coil.reader.Sexp)])))

(derive method-call [(lookup rewrite.modules.Lookup) (checked (mut Checked)) (locals (coil.amap.AMap (slice u8) i64))
                     (expr (ptr coil.reader.Sexp)) (method (ptr coil.reader.Sexp))] (slice u8)
  (with trait (match (get (.method-traits (.unit lookup)) (.node-id method))
                (Some [t] t) (_ (unreachable "trait method without owner")))
    (with self (coil.reader.sexp-sym (coil.reader.sexp-nth (coil.reader.sexp-nth trait 2) 0))
      (cases (trait-method method)
        ((Method [name params result])
          (with start (argument-start expr)
            (require (= (coil.reader.sexp-count params) (- (coil.reader.sexp-count expr) start)) expr "wrong method argument count")
            (each-child receiver params 0 index
              (when (coil.reader.sexp-sym-is (coil.reader.sexp-nth receiver 1) self)
                (with argument (coil.reader.sexp-nth expr (+ start index))
                  (obtain actual (check-expression lookup (mut checked) locals argument (Infer))
                    (obtain valid (implements-trait lookup (mut checked) actual trait)
                      (require valid argument "receiver type does not implement the trait"))
                    (each-child param params 0 j
                      (when (!= j index)
                        (obtain wanted (self-type (coil.reader.sexp-nth param 1) self actual)
                          (prove (check-expression lookup (mut checked) locals (coil.reader.sexp-nth expr (+ start j)) (Expect wanted))))))
                    (record (.dispatches checked) (.node-id expr) (Dispatch :trait trait :member (coil.reader.sexp-sym name) :target actual))
                    (obtain t (self-type result self actual) (conclude t))))))
            (reject expr "unsupported compound method receiver")))
        (_ (reject method "invalid trait method"))))))

(derive generic-call [(lookup rewrite.modules.Lookup) (definition rewrite.modules.Lookup) (checked (mut Checked)) (locals (coil.amap.AMap (slice u8) i64))
                      (expr (ptr coil.reader.Sexp)) (types (ptr coil.reader.Sexp)) (params (ptr coil.reader.Sexp))
                      (result (ptr coil.reader.Sexp)) (expected Expectation)] (slice u8)
  (with start (call-start expr)
    (require (= (- (coil.reader.sexp-count expr) start) (coil.reader.sexp-count params)) expr "wrong number of arguments")
    (with (mut bindings) (coil.hashmap.HashMap::new [(slice u8) (slice u8)] (.allocator checked) (coil.str.keyops-borrowed))
      (when (!= start (argument-start expr))
        (with supplied (coil.reader.sexp-nth expr (argument-start expr))
          (require (= (coil.reader.sexp-count supplied) (coil.reader.sexp-count types)) supplied "wrong number of type arguments")
          (each-child t supplied 0 i
            (require (coil.reader.sexp-sym? t) t "expected a scalar type argument")
            (when (not (parameter-type? (.parameters checked) (coil.reader.sexp-sym t))) (prove (check-type t)))
            (record bindings (coil.reader.sexp-sym (parameter-name (coil.reader.sexp-nth types i))) (scalar-type t)))))
      (when (and (= start (argument-start expr)) (coil.reader.sexp-sym? result)
                 (parameter-type? (Some types) (scalar-type result)))
        (cases expected ((Expect [wanted]) (record bindings (scalar-type result) wanted)) (_)))
      (each-index pass 2
        (each-child param params 0 i
          (cases (typed-parameter param)
            ((Parameter [_ t])
              (require (coil.reader.sexp-sym? t) t "unsupported generic parameter type")
              (with key (scalar-type t)
                (with arg (coil.reader.sexp-nth expr (+ start i))
                  (when (= pass (if (or (int-literal? arg) (float-literal? arg)) 1 0))
                    (cases (get bindings key)
                      ((Some [known]) (prove (check-expression lookup (mut checked) locals arg (Expect known))))
                      (_ (when (parameter-type? (Some types) key)
                           (obtain actual (check-expression lookup (mut checked) locals arg (Infer))
                             (record bindings key actual)))
                         (when (not (parameter-type? (Some types) key))
                           (prove (check-expression lookup (mut checked) locals arg (Expect key))))))))))
            (_ (reject param "invalid generic parameter")))))
      (with (mut arguments) (coil.arraylist.ArrayList::new [(slice u8)] (.allocator checked))
        (each-child t types 0 i
          (cases (get bindings (coil.reader.sexp-sym (parameter-name t)))
            ((Some [actual])
              (each-child bound t 1 j
                (obtain trait (resolve-trait definition bound)
                  (obtain valid (implements-trait lookup (mut checked) actual trait)
                    (require valid expr "type argument does not implement the required trait"))))
              (perform (push! (mut arguments) actual)))
            (_ (reject expr "cannot infer type argument"))))
        (record (.type-arguments checked) (.node-id expr) (load arguments)))
      (require (coil.reader.sexp-sym? result) result "unsupported generic result type")
      (conclude (match (get bindings (scalar-type result)) (Some [actual] actual) (_ (scalar-type result)))))))

(predicate labelled-jump? [(expr (ptr coil.reader.Sexp))]
  (and (> (coil.reader.sexp-count expr) 1) (coil.reader.sexp-kw? (coil.reader.sexp-nth expr 1))))

(derive jump-scope [(checked (mut Checked)) (expr (ptr coil.reader.Sexp))] i64
  (with count (len (.loops checked))
    (each-index offset (- count (.barrier checked))
      (with i (- (- count 1) offset)
        (with scope (get (.loops checked) i)
          (when (if (labelled-jump? expr)
                    (= (.label scope) (coil.reader.sexp-kw (coil.reader.sexp-nth expr 1)))
                    (.unlabelled scope))
            (record (.targets checked) (.node-id expr) (.id scope))
            (prove (schedule-exit (mut checked) expr (.cleanup-depth scope)))
            (conclude i)))))
    (reject expr "no enclosing loop matches this jump")))

(derive check-operator
  [(signatures rewrite.modules.Lookup)
   (checked (mut Checked)) (locals (coil.amap.AMap (slice u8) i64))
   (expr (ptr coil.reader.Sexp)) (op rewrite.operators.Operator)] (slice u8)
  (with start (argument-start expr)
    (with left (coil.reader.sexp-nth expr start)
      (with seed (if (and (> (coil.reader.sexp-count expr) (+ start 1)) (contextual-number? left))
                     (+ start 1) start)
        (obtain t (check-expression signatures (mut checked) locals (coil.reader.sexp-nth expr seed) (Infer))
          (when (and (!= seed start) (= t "never"))
            (obtain receiver (check-expression signatures (mut checked) locals left (Infer))
              (require (rewrite.operators.accepts? op (float-type? receiver) (integer-result? receiver 0)
                         (= (get receiver 0) #\i) (= receiver "bool")) expr "operator does not accept this operand type")
              (each-child operand expr (+ start 2) position
                (prove (check-expression signatures (mut checked) locals operand (Expect receiver))))
              (conclude (if (rewrite.operators.boolean-result? op) "bool" receiver))))
          (require (rewrite.operators.accepts? op (float-type? t) (integer-result? t 0)
                     (= (get t 0) #\i) (= t "bool")) expr "operator does not accept this operand type")
          (each-child operand expr start position
            (when (!= position seed)
              (prove (check-expression signatures (mut checked) locals operand (Expect t)))))
          (conclude (if (rewrite.operators.boolean-result? op) "bool" t)))))))

(derive check-cell
  [(signatures rewrite.modules.Lookup)
   (checked (mut Checked)) (locals (coil.amap.AMap (slice u8) i64))
   (name (ptr coil.reader.Sexp))] (slice u8)
  (obtain t (check-expression signatures (mut checked) locals name (Infer))
    (cases (get (.references checked) (.node-id name))
      ((Some [binding])
        (require (contains? (.cells checked) binding) name "expected a mutable binding")
        (conclude t))
      (_ (reject name "expected a mutable binding")))))

(judgment check-write
  [(signatures rewrite.modules.Lookup)
   (checked (mut Checked)) (locals (coil.amap.AMap (slice u8) i64))
   (name (ptr coil.reader.Sexp)) (value (ptr coil.reader.Sexp))]
  (obtain t (check-cell signatures (mut checked) locals name)
    (prove (check-expression signatures (mut checked) locals value (Expect t)))))

(judgment schedule-exit [(checked (mut Checked)) (site (ptr coil.reader.Sexp)) (depth i64)]
  (with count (len (.active-cleanups checked))
    (when (> count depth)
      (with (mut actions) (coil.arraylist.ArrayList::new [(ptr coil.reader.Sexp)] (.alc (.active-cleanups checked)))
        (each-index offset (- count depth)
          (perform (push! (mut actions) (get (.active-cleanups checked) (- (- count 1) offset)))))
        (record (.on-exit checked) (.node-id site) actions)))))

(derive check-body-item
  [(signatures rewrite.modules.Lookup)
   (checked (mut Checked)) (locals (coil.amap.AMap (slice u8) i64))
   (item (ptr coil.reader.Sexp)) (last? bool) (expected Expectation)] (slice u8)
  (cases (cleanup-form item)
    ((Guard [cleanup])
      (require (not last?) item "defer must have a following body form")
      (with outer (.barrier checked)
        (perform (set! (.barrier checked) (len (.loops checked))))
        (prove (check-expression signatures (mut checked) locals cleanup (Discard)))
        (perform (set! (.barrier checked) outer)))
      (record (.guards checked) (.node-id item) true)
      (perform (push! (mut (.active-cleanups checked)) cleanup))
      (conclude "void"))
    (_))
  (cases (application item)
    ((Apply [head])
      (with name (coil.reader.sexp-sym head)
        (when (not (or (contains? locals name) (match (rewrite.modules.find-declaration signatures head) (Ok [result] (match result (Some [_] true) (_ false))) (Err [_] true))))
          (obtain expansion (rewrite.control.expand-call (.alc locals) item name)
            (cases expansion
              ((Some [expanded])
                (record (.expanded checked) (.node-id item) expanded)
                (obtain t (check-body-item signatures (mut checked) locals expanded last? expected)
                  (record (.types checked) (.node-id item) t)
                  (conclude t)))
              (_))))))
    (_))
  (obtain t (check-expression signatures (mut checked) locals item expected) (conclude t)))

(derive check-body
  [(signatures rewrite.modules.Lookup)
   (checked (mut Checked)) (locals (coil.amap.AMap (slice u8) i64))
   (expr (ptr coil.reader.Sexp)) (start i64) (expected Expectation)] (slice u8)
  (with depth (len (.active-cleanups checked))
    (with (mut result) (: "void" (slice u8))
      (each-child item expr start index
        (with last? (= (+ index 1) (coil.reader.sexp-count expr))
          (obtain t (check-body-item signatures (mut checked) locals item last? (if last? expected (Discard)))
            (perform (set! result t)))))
      (prove (schedule-exit (mut checked) expr depth))
      (each-index i (- (len (.active-cleanups checked)) depth)
        (perform (pop! (mut (.active-cleanups checked)))))
      (conclude (load result)))))

(derive check-expression
  [(signatures rewrite.modules.Lookup)
   (checked (mut Checked))
   (locals (coil.amap.AMap (slice u8) i64)) (expr (ptr coil.reader.Sexp))
   (expected Expectation)] (slice u8)
  (obtain actual (synthesize signatures (mut checked) locals expr expected)
    (require (or (= actual "never") (match expected (Expect [t] (= t actual)) (_ true))) expr "expression differs from expected type")
    (record (.types checked) (.node-id expr) actual)
    (conclude actual)))

(derive inline-policy [(lookup rewrite.modules.Lookup) (value (ptr coil.reader.Sexp))] (slice u8)
  (cases (nullary-call value)
    ((Call [name])
      (obtain resolved (rewrite.modules.find-name lookup name (rewrite.modules.VariantNames))
        (with canonical (match resolved (Some [variant] (rewrite.modules.symbol-for lookup variant)) (_ (coil.reader.sexp-sym name)))
          (when (or (= canonical "coil.core.Always") (and (= canonical "Always") (none? resolved))) (conclude "Always"))
          (when (or (= canonical "coil.core.Hint") (and (= canonical "Hint") (none? resolved))) (conclude "Hint"))
          (when (or (= canonical "coil.core.Never") (and (= canonical "Never") (none? resolved))) (conclude "Never")))))
    (_))
  (reject value "expected a coil.core.InlinePolicy constructor"))

(predicate native-convention-name? [(name (slice u8))]
  (or (= name "coil.cc.C") (= name "coil.cc.Fast") (= name "coil.cc.Cold")
      (= name "coil.cc.Tail") (= name "coil.cc.SwiftTail")))

(derive native-convention [(lookup rewrite.modules.Lookup) (name (ptr coil.reader.Sexp))] (slice u8)
  (when (native-convention-name? (coil.reader.sexp-sym name)) (conclude (coil.reader.sexp-sym name)))
  (obtain resolved (rewrite.modules.find-name lookup name (rewrite.modules.VariantNames))
    (cases resolved
      ((Some [variant])
        (with canonical (rewrite.modules.symbol-for lookup variant)
          (when (native-convention-name? canonical) (conclude canonical))))
      (_)))
  (reject name "expected a native calling convention constructor from coil.cc"))

(derive resolve-trait [(lookup rewrite.modules.Lookup) (name (ptr coil.reader.Sexp))] (ptr coil.reader.Sexp)
  (require (coil.reader.sexp-sym? name) name "expected a trait name")
  (obtain resolved (rewrite.modules.find-name lookup name (rewrite.modules.TraitNames))
    (cases resolved ((Some [trait]) (conclude trait)) (_ (reject name "unknown trait")))))

(predicate mentions-type? [(type (ptr coil.reader.Sexp)) (name (slice u8))]
  (block :found
    (when (coil.reader.sexp-sym-is type name) (return-from :found true))
    (for [i 0 (coil.reader.sexp-count type)]
      (when (mentions-type? (coil.reader.sexp-nth type i) name) (return-from :found true)))
    false))

(judgment check-trait [(lookup rewrite.modules.Lookup) (form (ptr coil.reader.Sexp))]
  (cases (trait-declaration form)
    ((Trait [_ types])
      (each-child t types 0 i (require (coil.reader.sexp-sym? t) t "expected a trait type parameter"))
      (cases (required-traits form)
        ((Requires [bases]) (each-child base bases 0 i (prove (resolve-trait lookup base))))
        (_))
      (each-child method form (rewrite.modules.trait-method-start form) i
        (cases (trait-method method)
          ((Method [_ params _])
            (with (mut receiver) false
              (each-child param params 0 j
                (cases (typed-parameter param)
                  ((Parameter [_ type])
                    (when (mentions-type? type (coil.reader.sexp-sym (coil.reader.sexp-nth types 0)))
                      (perform (set! receiver true))))
                  (_ (reject param "expected a typed method parameter"))))
              (require (load receiver) method "trait method needs a Self parameter")))
          (_ (reject method "invalid trait method signature")))))
    (_ (reject form "expected a trait name and nonempty type parameter vector"))))

(value implementation-key [(lookup rewrite.modules.Lookup) (trait (ptr coil.reader.Sexp)) (actual (slice u8))
                           (allocator (dyn coil.alloc.Allocator))] (slice u8)
  (coil.text.sconcat3 allocator actual ":" (rewrite.modules.symbol-for lookup trait)))

(value method-key [(lookup rewrite.modules.Lookup) (trait (ptr coil.reader.Sexp)) (target (slice u8))
                   (name (slice u8)) (a (dyn coil.alloc.Allocator))] (slice u8)
  (coil.text.sconcat3 a (implementation-key lookup trait target a) "::" name))

(derive self-type [(type (ptr coil.reader.Sexp)) (self (slice u8)) (target (slice u8))] (slice u8)
  (require (coil.reader.sexp-sym? type) type "unsupported compound trait method type")
  (conclude (if (coil.reader.sexp-sym-is type self) target (scalar-type type))))

(judgment register-method [(lookup rewrite.modules.Lookup) (checked (mut Checked)) (trait (ptr coil.reader.Sexp))
                           (target (slice u8)) (function (ptr coil.reader.Sexp))]
  (cases (ordinary-function function)
    ((Function [_ name params result])
      (with member (coil.reader.sexp-sym name)
        (with key (method-key lookup trait target member (.allocator checked))
          (each-child method trait (rewrite.modules.trait-method-start trait) i
            (cases (trait-method method)
              ((Method [declared spec ret])
                (when (coil.reader.sexp-sym-is declared member)
                  (with self (coil.reader.sexp-sym (coil.reader.sexp-nth (coil.reader.sexp-nth trait 2) 0))
                    (require (= (coil.reader.sexp-count params) (coil.reader.sexp-count spec)) name "method parameter count differs from trait")
                    (obtain wanted (self-type ret self target)
                      (require (and (coil.reader.sexp-sym? result) (= wanted (scalar-type result))) result "method result differs from trait"))
                    (each-child param params 0 j
                      (with expected (coil.reader.sexp-nth (coil.reader.sexp-nth spec j) 1)
                        (obtain wanted (self-type expected self target)
                          (cases (typed-parameter param)
                            ((Parameter [_ ty]) (require (and (coil.reader.sexp-sym? ty) (= wanted (scalar-type ty))) param "method parameter differs from trait"))
                            (_ (reject param "invalid method parameter"))))))
                    (record (.method-bodies checked) key function)
                    (accept))))
              (_)))
          (accept))))
    (_ (reject function "invalid implementation method"))))

(judgment register-implementation [(lookup rewrite.modules.Lookup) (checked (mut Checked)) (form (ptr coil.reader.Sexp))]
  (cases (scalar-implementation form)
    ((ScalarImpl [name target])
      (obtain trait (resolve-trait lookup name)
        (each-child method form 3 i
          (cases (get (.method-functions (.unit lookup)) (.node-id method))
            ((Some [fn]) (prove (register-method lookup (mut checked) trait (scalar-type target) fn)))
            (_ (reject method "missing implementation function"))))
        (each-child method trait (rewrite.modules.trait-method-start trait) i
          (with member (coil.reader.sexp-sym (coil.reader.sexp-nth method 0))
            (require (contains? (.method-bodies checked) (method-key lookup trait (scalar-type target) member (.allocator checked)))
                     form "implementation is missing trait methods")))
        (prove (check-type target))
        (with key (implementation-key lookup trait (scalar-type target) (.allocator checked))
          (require (not (contains? (.implementations checked) key)) form "duplicate trait implementation")
          (record (.implementations checked) key true))))
    (_)))

(judgment check-implementation-bases [(lookup rewrite.modules.Lookup) (checked (mut Checked)) (form (ptr coil.reader.Sexp))]
  (cases (scalar-implementation form)
    ((ScalarImpl [name target])
      (obtain trait (resolve-trait lookup name)
        (cases (required-traits trait)
          ((Requires [bases])
            (each-child base bases 0 i
              (obtain parent (resolve-trait (rewrite.modules.lookup-for (.unit lookup) trait) base)
                (require (contains? (.implementations checked) (implementation-key lookup parent (scalar-type target) (.allocator checked)))
                         form "missing implementation of a required supertrait"))))
          (_))))
    (_)))

(derive trait-implies [(unit (ptr rewrite.modules.SourceUnit)) (trait (ptr coil.reader.Sexp)) (required (ptr coil.reader.Sexp))
                       (seen (mut (coil.hashmap.HashMap i64 bool)))] bool
  (when (= (.node-id trait) (.node-id required)) (conclude true))
  (when (contains? (load seen) (.node-id trait)) (conclude false))
  (perform (set! (mut seen) (.node-id trait) true))
  (cases (required-traits trait)
    ((Requires [bases])
      (each-child base bases 0 i
        (obtain parent (resolve-trait (rewrite.modules.lookup-for unit trait) base)
          (obtain inherited (trait-implies unit parent required (mut seen))
            (when inherited (conclude true))))))
    (_))
  (conclude false))

(derive implements-trait [(caller rewrite.modules.Lookup) (checked (mut Checked)) (actual (slice u8)) (trait (ptr coil.reader.Sexp))] bool
  (when (contains? (.implementations checked) (implementation-key caller trait actual (.allocator checked))) (conclude true))
  (cases (.parameters checked)
    ((Some [parameters])
      (each-child param parameters 0 i
        (when (coil.reader.sexp-sym-is (parameter-name param) actual)
          (each-child inherited param 1 j
            (obtain available (resolve-trait caller inherited)
              (with (mut seen) (coil.hashmap.HashMap::new-scalar [i64 bool] (.allocator checked))
                (obtain inherited (trait-implies (.unit caller) available trait (mut seen))
                  (when inherited (conclude true)))))))))
    (_))
  (conclude false))

(judgment check-signatures
  [(allocator (dyn coil.alloc.Allocator))
   (unit (ptr rewrite.modules.SourceUnit))]
  (each-form form (.declarations unit)
    (when (trait-form? form) (prove (check-trait (rewrite.modules.lookup-for unit form) form)))
    (cases (primitive-header form)
      ((Primitive [_])
        (require (and (>= (coil.reader.sexp-count form) 3)
                      (coil.reader.sexp-kw? (coil.reader.sexp-nth form (- (coil.reader.sexp-count form) 1)))) form "expected a primitive opcode"))
      (_))
    (cases (declared-convention form)
      ((Convention [name])
        (obtain convention (native-convention (rewrite.modules.lookup-for unit form) name)
          (require (= convention "coil.cc.C") name "only the C calling convention is supported for native functions")))
      (_))
    (cases (ordinary-function form)
      ((Function [_ name parameters result])
        (cases (function-generics form)
          ((GenericParameters [types])
            (each-child t types 0 i
              (require (coil.reader.sexp-sym? (parameter-name t)) t "expected a type parameter name")
              (each-child bound t 1 j (prove (resolve-trait (rewrite.modules.lookup-for unit form) bound)))))
          (_))
        (require (not (or (explicit-call-name? name) (layout-name? name) (offset-name? name))) name "cannot define a function named for a built-in form")
        (when (not (coil.reader.sexp-sym-is result "void")) (prove (check-signature-type form result)))
        (distinct names allocator
          (each-child parameter parameters 0 position
            (cases (typed-parameter parameter)
              ((Parameter [name type])
                (insert-unique names name form "duplicate parameter name")
                (prove (check-signature-type form type)))
              (_ (reject parameter "invalid parameter"))))))
      (_ (cases (rewrite.modules.foreign-signature form)
           ((External [name parameters result])
             (with link (rewrite.modules.external-symbol form name)
               (require (and (> (len link) 0) (< (coil.project.m-index link (: 0 u8)) 0)) form
                        "linker symbol must be nonempty and contain no NUL byte"))
             (when (not (coil.reader.sexp-sym-is result "void")) (prove (check-type result)))
             (each-child parameter parameters 0 position (prove (check-type parameter))))
           (_ (require (or (trait-form? form) (scalar-impl? form) (match (primitive-header form) (Primitive [_] true) (_ false)) (match (rewrite.modules.type-name form) (Some [_] true) (_ false)) (match (constant-declaration form) (Constant [_ _] true) (_ false))) form "unsupported declaration")))))))

(judgment check-contains [(lookup rewrite.modules.Lookup) (checked (mut Checked)) (type (ptr coil.reader.Sexp))]
  (cases (array-layout type)
    ((ArrayOf [element _]) (prove (check-contains lookup (mut checked) element)))
    (_))
  (when (and (coil.reader.sexp-sym? type) (not (builtin-type-name? type))
             (not (parameter-type? (.parameters checked) (coil.reader.sexp-sym type))))
    (obtain resolved (rewrite.modules.find-name lookup type (rewrite.modules.TypeNames))
      (cases resolved
        ((Some [definition]) (prove (check-nominal (.unit lookup) (mut checked) definition)))
        (_)))))

(judgment check-field-types [(lookup rewrite.modules.Lookup) (checked (mut Checked)) (fields (ptr coil.reader.Sexp))]
  (distinct names (.allocator checked)
    (each-child field fields 0 i
      (cases (typed-parameter field)
        ((Parameter [name type])
          (insert-unique names name field "duplicate field")
          (prove (inspect-type lookup (mut checked) type false))
          (prove (check-contains lookup (mut checked) type)))
        (_ (reject field "expected a named field"))))))

(judgment check-nominal [(unit (ptr rewrite.modules.SourceUnit)) (checked (mut Checked)) (form (ptr coil.reader.Sexp))]
  (cases (get (.nominal-state checked) (.node-id form))
    ((Some [done]) (require done form "type contains itself by value") (accept))
    (_))
  (record (.nominal-state checked) (.node-id form) false)
  (with previous (.parameters checked)
    (perform (set! (.parameters checked) (None [(ptr coil.reader.Sexp)])))
    (cases (nominal-parameters form)
      ((TypeParameters [parameters])
        (each-child param parameters 0 i
          (require (coil.reader.sexp-sym? param) param "expected a type parameter name"))
        (perform (set! (.parameters checked) (Some parameters))))
      (_))
    (with lookup (rewrite.modules.lookup-for unit form)
      (cases (rewrite.modules.type-name form)
        ((Some [name]) (require (not (builtin-type-name? name)) name "type name is a built-in type"))
        (_))
      (cases (structure form)
        ((Struct [_ fields])
          (prove (struct-policy lookup form))
          (prove (check-field-types lookup (mut checked) fields)))
        (_ (each-child variant form (rewrite.modules.variant-start form) i
             (cases (variant-fields variant)
               ((Payload [fields]) (prove (check-field-types lookup (mut checked) fields)))
               (_))))))
    (perform (set! (.parameters checked) previous)))
  (record (.nominal-state checked) (.node-id form) true))

(derive check-functions
  [(allocator (dyn coil.alloc.Allocator))
   (unit (ptr rewrite.modules.SourceUnit))] Checked
  (with (mut checked) (Checked :dispatches (coil.hashmap.HashMap::new-scalar [i64 Dispatch] allocator)
                               :method-bodies (coil.hashmap.HashMap::new [(slice u8) (ptr coil.reader.Sexp)] allocator (coil.str.keyops-borrowed))
                               :implementations (coil.hashmap.HashMap::new [(slice u8) bool] allocator (coil.str.keyops-borrowed))
                               :nominal-state (coil.hashmap.HashMap::new-scalar [i64 bool] allocator) :parameters (None [(ptr coil.reader.Sexp)]) :layout-parameters (coil.hashmap.HashMap::new-scalar [i64 (slice u8)] allocator)
                               :payload-sizes (coil.hashmap.HashMap::new-scalar [i64 i64] allocator)
                               :field-offsets (coil.hashmap.HashMap::new-scalar [i64 i64] allocator)
                               :layouts (coil.hashmap.HashMap::new-scalar [i64 Layout] allocator)
                               :layout-started (coil.hashmap.HashMap::new-scalar [i64 bool] allocator)
                               :allocator allocator :statics (coil.hashmap.HashMap::new-scalar [i64 (ptr coil.reader.Sexp)] allocator)
                               :constants (coil.hashmap.HashMap::new-scalar [i64 ConstantValue] allocator)
                               :evaluating (coil.hashmap.HashMap::new-scalar [i64 bool] allocator)
                               :type-arguments (coil.hashmap.HashMap::new-scalar [i64 (coil.arraylist.ArrayList (slice u8))] allocator)
                               :inline-policies (coil.hashmap.HashMap::new-scalar [i64 (slice u8)] allocator)
                               :callees (coil.hashmap.HashMap::new-scalar [i64 (ptr coil.reader.Sexp)] allocator) :active-cleanups (coil.arraylist.ArrayList::new [(ptr coil.reader.Sexp)] allocator)
                               :barrier 0 :guards (coil.hashmap.HashMap::new-scalar [i64 bool] allocator)
                               :on-exit (coil.hashmap.HashMap::new-scalar [i64 (coil.arraylist.ArrayList (ptr coil.reader.Sexp))] allocator)
                               :targets (coil.hashmap.HashMap::new-scalar [i64 i64] allocator)
                               :loops (coil.arraylist.ArrayList::new [LoopScope] allocator)
                               :expanded (coil.hashmap.HashMap::new-scalar [i64 (ptr coil.reader.Sexp)] allocator)
                               :types (coil.hashmap.HashMap::new-scalar [i64 (slice u8)] allocator)
                               :references (coil.hashmap.HashMap::new-scalar [i64 i64] allocator)
                               :cells (coil.hashmap.HashMap::new-scalar [i64 bool] allocator)
                               :operators (coil.hashmap.HashMap::new-scalar [i64 rewrite.operators.Operator] allocator))
    (each-form form (.declarations unit)
      (when (scalar-impl? form) (prove (register-implementation (rewrite.modules.lookup-for unit form) (mut checked) form))))
    (each-form form (.declarations unit)
      (when (scalar-impl? form) (prove (check-implementation-bases (rewrite.modules.lookup-for unit form) (mut checked) form)))
      (cases (ordinary-function form)
        ((Function [_ _ parameters result])
          (cases (inline-annotation form)
            ((Inline [value])
              (obtain policy (inline-policy (rewrite.modules.lookup-for unit form) value)
                (record (.inline-policies checked) (.node-id form) policy)))
            (_))
          (perform (set! (.parameters checked) (function-parameters form)))
          (require (or (> (coil.reader.sexp-count form) (rewrite.modules.function-body-start form parameters)) (coil.reader.sexp-sym-is result "void"))
                   form "empty function body requires a void result")
          (with (mut locals) (coil.amap.amap-new [(slice u8) i64] (coil.str.keyops-borrowed) allocator)
            (each-child param parameters 0 index
              (cases (typed-parameter param)
                ((Parameter [name type])
                  (record (.types checked) (.node-id name) (scalar-type type))
                  (record locals (coil.reader.sexp-sym name) (.node-id name)))
                (_ (reject param "invalid parameter"))))
            (prove (check-body (rewrite.modules.lookup-for unit form) (mut checked) locals form (rewrite.modules.function-body-start form parameters)
                     (if (coil.reader.sexp-sym-is result "void") (Discard)
                         (Expect (scalar-type result))))
            (perform (set! (.parameters checked) (None [(ptr coil.reader.Sexp)]))))))
        (_ (cases (rewrite.modules.type-name form) ((Some [_]) (prove (check-nominal unit (mut checked) form)))
             (_ (when (not (or (trait-form? form) (scalar-impl? form) (rewrite.modules.external? form) (match (primitive-header form) (Primitive [_] true) (_ false)))) (prove (constant-value unit (mut checked) form))))))))
    (conclude checked)))
