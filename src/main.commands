(use "coil.project" :as project)
(use "coil.fs" :as fs)
(use "coil.text" :as text)
(use "rewrite.workspace")
(use "rewrite.native")
(use "rewrite.link")
(use "rewrite.modules")
(use "rewrite.check")
(use "rewrite.command-tools")
(usage "usage: rewrite check|run [file.coil]\n       rewrite build [file.coil] [-o <output>]\n       rewrite emit-obj <file.coil> -o <output>\n")

(input-path package-entry allocator
  (let [manifest (project/parse-manifest allocator
                   (coil.source.cli.read-source allocator (coil.str.to-cstr allocator "Coil.toml") 1))
        entry (.entry manifest)]
    (cond
      (= (len entry) 0) "src/main.coil"
      :else
        (let [path (coil.str.to-cstr allocator entry)]
          (when (or (!= (fs/access path 0) (: 0 i32)) (project/dir? path))
            (project/m-error allocator (text/sconcat3 allocator "Coil.toml: [package] entry '" entry "' is not a file")))
          entry))))

(pipeline check-source
  (phase sources source-catalog allocator (coil.str.from-cstr (load (index argv 0))) path source-bytes)
  (on-error problem (report-problem sources problem))
  (read-forms parsed)
  (phase unit read-unit allocator sources parsed)
  (phase valid check-signatures allocator unit)
  (phase checked check-functions allocator unit))

(pipeline compile-object
  (phase temporary-object temporary "unit.o")
  (phase emitted emit-object allocator checked unit temporary-object))

(route (or (= argc 2) (and (= argc 4) (= (coil.str.from-cstr (load (index argv 2))) "-o")))
  (workspace-command allocator (coil.str.from-cstr (load (index argv 0)))
    (coil.str.from-cstr (load (index argv 1)))
    (if (= argc 4) (Some (coil.str.from-cstr (load (index argv 3)))) (None [(slice u8)]))))

(source-command "check" path
  (default-input (package-entry allocator))
  (include check-source)
  (exit 0))

(source-command "emit-obj" path
  (output "-o" destination)
  (include check-source)
  (phase object staged-output destination)
  (phase emitted emit-object allocator checked unit object)
  (phase published publish allocator object destination)
  (exit 0))

(source-command "build" path
  (default-input (package-entry allocator))
  (optional-output "-o" requested)
  (include check-source)
  (phase destination source-output allocator sources path (= argc 2) requested)
  (include compile-object)
  (phase executable staged-output destination)
  (phase linked link-executable allocator sources temporary-object executable)
  (phase published publish allocator executable destination)
  (exit 0))

(source-command "run" path
  (default-input (package-entry allocator))
  (include check-source)
  (include compile-object)
  (phase executable temporary "program")
  (phase linked link-executable allocator sources temporary-object executable)
  (phase status execute allocator executable [])
  (exit status))
