(module rewrite.admissionprotocol)
(protocol
  (start classify)
  (finish complete)
  (state classify (on Registration reuse) (on Ordinary declare))
  (state reuse (on Unchanged declare) (on Changed register))
  (state register (on Done complete))
  (state declare (on Done collect))
  (state collect (on Done publish))
  (state publish (on Done complete)))
