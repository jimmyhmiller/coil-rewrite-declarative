(module rewrite.corecompiler)
(sum Expr (Integer (value Int)) (Boolean (value Bool))
  (Add (left Expr) (right Expr)) (Choose (condition Expr) (yes Expr) (no Expr))
  (Variable (name Text)) (Let (name Text) (value Expr) (body Expr)) (Call (callee Expr) (argument Expr)) (AddressOf (function Expr)))
(bindings Expr (Variable (reference name)) (Let (scope body name)))
(judgment Expr (Integer Int) (Boolean Bool)
  (Add Int (left Int) (right Int))
  (Choose ?result (condition Bool) (yes ?result) (no ?result))
  (Variable (lookup)) (Let ?body (value ?value) (body ?body (with ?value)))
  (Call ?result (callee (in [value function] (Fn ?argument ?result))) (argument ?argument))
  (AddressOf (Fn ?argument ?result) (function (in [function] (Fn ?argument ?result)))))
(lower Expr (Integer (const value)) (Boolean (bool value))
  (Add (add left right)) (Choose (if condition yes no))
  (Variable (name)) (Let (let value body)) (Call (call callee argument)) (AddressOf (identity function)))

(node Function (name Text :key) (parameter Text) (body Expr))
(syntax Expr
  (Integer (int value))
  (Boolean (bool value))
  (Variable (symbol name))
  (Add (list "+" (ref left) (ref right)))
  (Choose (list "if" (ref condition) (ref yes) (ref no)))
  (Let (list "let" (vector (symbol name) (ref value)) (ref body)))
  (AddressOf (list "fnptr-of" (ref function)))
  (Call (list (ref callee) (ref argument))))
(syntax Function
  (Function (list "defn" (symbol name) (vector (list (symbol parameter) "i64")) (list "->" "i64") (ref body))))

(program Expr Function name parameter body Int Int)
(source-program Function (command))
