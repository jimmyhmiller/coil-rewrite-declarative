(module rewrite.corecompiler)
(sum Expr (Integer (value Int)) (Boolean (value Bool))
  (Add (left Expr) (right Expr))
  (Subtract (left Expr) (right Expr))
  (Multiply (left Expr) (right Expr))
  (Equal (left Expr) (right Expr))
  (NotEqual (left Expr) (right Expr))
  (Less (left Expr) (right Expr))
  (LessEqual (left Expr) (right Expr))
  (Greater (left Expr) (right Expr))
  (GreaterEqual (left Expr) (right Expr))
  (Choose (condition Expr) (yes Expr) (no Expr))
  (Variable (name Text)) (Let (name Text) (value Expr) (body Expr)) (Call (callee Expr) (arguments (many Expr))) (AddressOf (function Expr)))
(bindings Expr (Variable (reference name)) (Let (scope body name)))
(judgment Expr (Integer Int) (Boolean Bool)
  (Add Int (left Int) (right Int))
  (Subtract Int (left Int) (right Int))
  (Multiply Int (left Int) (right Int))
  (Equal Bool (left Int) (right Int))
  (NotEqual Bool (left Int) (right Int))
  (Less Bool (left Int) (right Int))
  (LessEqual Bool (left Int) (right Int))
  (Greater Bool (left Int) (right Int))
  (GreaterEqual Bool (left Int) (right Int))

  (Choose ?result (condition Bool) (yes ?result) (no ?result))
  (Variable (lookup)) (Let ?body (value ?value) (body ?body (with ?value)))
  (Call (apply callee arguments [value function]))
  (AddressOf ?signature (function (in [function] ?signature))))
(lower Expr (Integer (const value)) (Boolean (bool value))
  (Add (add left right))
  (Subtract (sub left right))
  (Multiply (mul left right))
  (Equal (eq left right))
  (NotEqual (ne left right))
  (Less (slt left right))
  (LessEqual (sle left right))
  (Greater (sgt left right))
  (GreaterEqual (sge left right))
  (Choose (if condition yes no))
  (Variable (name)) (Let (let value body)) (Call (call callee (spread arguments))) (AddressOf (identity function)))

(node Parameter (name Text))
(syntax Parameter (Parameter (list (symbol name) "i64")))
(node Function (name Text :key) (parameters (many Parameter)) (body Expr))
(syntax Expr
  (Integer (int value))
  (Boolean (bool value))
  (Variable (symbol name))
  (Add (list "+" (ref left) (ref right)))
  (Subtract (list "-" (ref left) (ref right)))
  (Multiply (list "*" (ref left) (ref right)))
  (Equal (list "=" (ref left) (ref right)))
  (NotEqual (list "!=" (ref left) (ref right)))
  (Less (list "<" (ref left) (ref right)))
  (LessEqual (list "<=" (ref left) (ref right)))
  (Greater (list ">" (ref left) (ref right)))
  (GreaterEqual (list ">=" (ref left) (ref right)))

  (Choose (list "if" (ref condition) (ref yes) (ref no)))
  (Let (list "let" (vector (symbol name) (ref value)) (ref body)))
  (AddressOf (list "fnptr-of" (ref function)))
  (Call (list (ref callee) (rest arguments))))
(syntax Function
  (Function (list "defn" (symbol name) (vector (rest parameters)) (list "->" "i64") (ref body))))

(program Expr Function name (each parameters name) body Int Int)
(source-program Function (command))
