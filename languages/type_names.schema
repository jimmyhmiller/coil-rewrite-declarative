(module rewrite.typenameforms)
(sum Atom
  (Integer (bits Int) (signed Bool)) (Float (bits Int))
  (Boolean) (Void) (Never) (ExternRef) (Code) (CodeBuilder)
  (Pack) (Nominal))
; The parameter is the target's machine-word width, not the host's width.
; A failed numeric match falls through to nominal, as parse-type does.
(text-classifier type-name Atom
  (suffix "..." (Pack))
  (exact "Code" (Code))
  (exact "CodeBuilder" (CodeBuilder))
  (exact "f32" (Float 32))
  (exact "f64" (Float 64))
  (exact "bool" (Boolean))
  (exact "void" (Void))
  (exact "never" (Never))
  (exact "externref" (ExternRef))
  (exact "usize" (Integer $parameter false))
  (exact "isize" (Integer $parameter true))
  (decimal "i" 1 65535 (Integer $number true))
  (decimal "u" 1 65535 (Integer $number false))
  (default (Nominal)))
