(module rewrite.typesyntax)
; Written forms retain raw spelling, scope and definition module.
; Canonical elaboration decides when a lexical identity is required.
(sum Constant
  (Integer (value Int))
  (Keyword (value Text))
  (Boolean (value Bool))
  (Reference (name Text) (scope Int) (module Text)))
(syntax Constant :expect "expected integer, keyword, boolean or constant name"
  (Integer (int value))
  (Keyword (keyword value))
  (Boolean (bool value))
  (Reference (identifier name scope module)))

(sum Length (Fixed (value Int)) (Parameter (name Text) (scope Int) (module Text)))
(syntax Length :expect "expected non-negative integer or length parameter"
  (Fixed (int value :min 0))
  (Parameter (identifier name scope module)))

(sum Convention (Named (name Text) (scope Int) (module Text)) (Value (name Text) (scope Int) (module Text)))
(syntax Convention :expect "expected convention name or (convention value)"
  (Named (identifier name scope module))
  (Value (list (identifier name scope module))))

(sum WrittenType
  (Integer (value Int))
  (Keyword (value Text))
  (Boolean (value Bool))
  (Name (name Text) (scope Int) (module Text))
  (Constant (value Constant))
  (Mask (width Width))
  (Mutable (element WrittenType))
  (Reference (element WrittenType))
  (Pointer (elements (many WrittenType)))
  (Array (element WrittenType) (length Length))
  (Slice (element WrittenType))
  (Vector (element WrittenType) (width Width))
  (Struct (name Text) (scope Int) (module Text))
  (Dynamic (name Text) (scope Int) (module Text))
  (Function (convention Convention) (parameters (many WrittenType)) (result WrittenType))
  (Application (name Text) (scope Int) (module Text) (arguments (many WrittenType))))
(syntax WrittenType :expect "expected type"
  (Integer (int value))
  (Keyword (keyword value))
  (Boolean (bool value))
  (Name (identifier name scope module))
  (Constant (list "const" (ref value)))
  (Mask (list "mask" (ref width) (skip-rest)))
  (Mutable (list "mut" (ref element) (skip-rest)))
  (Reference (list "ref" (ref element) (skip-rest)))
  (Pointer (list "ptr" (rest elements :limit 1)))
  (Array (list "array" (ref element) (ref length) (skip-rest)))
  (Slice (list "slice" (ref element) (skip-rest)))
  (Vector (list "vec" (ref element) (ref width) (skip-rest)))
  (Struct (list "struct" (identifier name scope module) (skip-rest)))
  (Dynamic (list "dyn" (identifier name scope module) (skip-rest)))
  (Function (list "fnptr" (ref convention) (vector (rest parameters)) (ref result) (skip-rest)))
  (Application (list (identifier name scope module) (rest arguments))))

(sum Width (Fixed (value Int)) (Parameter (name Text) (scope Int) (module Text)))
(syntax Width :expect "expected positive integer or width parameter"
  (Fixed (int value :min 1))
  (Parameter (identifier name scope module)))

; Structural elaboration. Bare type names remain explicit classification work;
; this representation is not yet interned or resolved against declarations.
(node Identifier (spelling Text) (scope Int) (module Text))
(sum TypeConstant
  (Integer (value Int)) (Keyword (value Text)) (Boolean (value Bool))
  (Reference (name Identifier)))
(sum TypeExtent (Fixed (value Int)) (Parameter (name Identifier)))
(sum TypeConvention (Named (name Identifier)) (Value (name Identifier)))
(sum Type
  (Integer (bits Int) (signed Bool))
  (Float (bits Int))
  (Boolean) (Void) (Never) (Code) (CodeBuilder) (ExternRef)
  (UnclassifiedName (name Identifier))
  (Nominal (name Text))
  (Dynamic (name Text))
  (Pointer (element Type))
  (Reference (mutable Bool) (element Type))
  (Array (element Type) (length TypeExtent))
  (Slice (element Type))
  (Vector (element Type) (width TypeExtent))
  (Function (convention TypeConvention) (parameters (many Type)) (result Type))
  (Application (name Identifier) (arguments (many Type)))
  (Constant (value TypeConstant)))

(transform Constant TypeConstant
  (Integer (Integer value))
  (Keyword (Keyword value))
  (Boolean (Boolean value))
  (Reference (Reference (Identifier name scope module))))
(transform Length TypeExtent
  (Fixed (Fixed value))
  (Parameter (Parameter (Identifier name scope module))))
(transform Width TypeExtent
  (Fixed (Fixed value))
  (Parameter (Parameter (Identifier name scope module))))
(transform Convention TypeConvention
  (Named (Named (Identifier name scope module)))
  (Value (Value (Identifier name scope module))))
(transform WrittenType Type
  (Integer (Constant (Integer value)))
  (Keyword (Constant (Keyword value)))
  (Boolean (Constant (Boolean value)))
  (Name (UnclassifiedName (Identifier name scope module)))
  (Constant (Constant value))
  (Mask (Vector (Boolean) width))
  (Mutable (Reference true element))
  (Reference (Reference false element))
  (Pointer (Pointer (first-or elements (Integer 64 true))))
  (Array (Array element length))
  (Slice (Slice element))
  (Vector (Vector element width))
  (Struct (Nominal name))
  (Dynamic (Dynamic name))
  (Function (Function convention parameters result))
  (Application (Application (Identifier name scope module) arguments)))
(equality Type)
