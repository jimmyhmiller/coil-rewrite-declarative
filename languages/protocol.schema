(module rewrite.protocolforms)
(sum Edge
  (Goto (event Text :key) (target Text))
  (Spend (event Text :key) (target Text) (budget Text))
  (Within (event Text :key) (target Text) (budget Text) (ceiling Int)))
(sum Clause
  (Budget (name Text :key) (limit Int))
  (Start (name Text :key))
  (Finish (name Text :key))
  (State (name Text :key) (edges (many Edge))))
(node Protocol (clauses (many Clause)))
(syntax Edge
  (Goto (list "on" (symbol event) (symbol target)))
  (Spend (list "spend" (symbol event) (symbol budget) (symbol target)))
  (Within (list "spend-within" (symbol event) (symbol budget) (int ceiling) (symbol target))))
(syntax Clause
  (Budget (list "budget" (symbol name) (int limit)))
  (Start (list "start" (symbol name)))
  (Finish (list "finish" (symbol name)))
  (State (list "state" (symbol name) (rest edges))))
(syntax Protocol
  (Protocol (list "protocol" (rest clauses))))
