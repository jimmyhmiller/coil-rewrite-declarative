(phases
 (input schema Schema)
 (input bindings Bindings)
 (phase program (needs (maps TransformAPI) (surface SurfaceAPI) (readers ReaderAPI) (indexes IndexAPI) (judgments JudgmentAPI) (lowering CIRAPI)) (makes (program ProgramAPI)))
 (phase transform (needs (readers ReaderAPI) (classification ClassificationAPI)) (makes (maps TransformAPI)))
 (phase selection (needs (tables Tables)) (makes (selection SelectionAPI)))
 (phase refer (needs (readers ReaderAPI)) (makes (refers ReferAPI)))
 (phase pairs (needs (readers ReaderAPI)) (makes (pairs PairAPI)))
 (phase classification (needs (tables Tables)) (makes (classification ClassificationAPI)))
 (phase walk (needs (readers ReaderAPI)) (makes (walk WalkAPI)))
 (phase syntax (needs (readers ReaderAPI)) (makes (surface SurfaceAPI)))
 (phase context-policy (needs (tables Tables)) (makes (contexts ContextAPI)))
 (phase equality (needs (readers ReaderAPI)) (makes (equality EqualityAPI)))
 (phase readers (needs (tables Tables)) (makes (readers ReaderAPI)))
 (phase alpha (needs (resolution ResolutionAPI)) (makes (alpha AlphaAPI)))
 (phase resolution (needs (readers ReaderAPI) (bindings Bindings)) (makes (resolution ResolutionAPI)))
 (phase indexes (needs (tables Tables)) (makes (indexes IndexAPI)))
 (phase judgment (needs (tables Tables) (bindings Bindings)) (makes (judgments JudgmentAPI)))
 (phase lower (needs (tables Tables) (bindings Bindings)) (makes (lowering CIRAPI)))
 (phase tables (needs (schema Schema)) (makes (tables Tables))))
