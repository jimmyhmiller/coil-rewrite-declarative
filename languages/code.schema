(module rewrite.codeforms)
(sum Syntax
  (Integer (value Int))
  (Float (bits Int))
  (Symbol (text Text))
  (Keyword (text Text))
  (String (text Text))
  (CString (text Text))
  (List (items (many Syntax)))
  (Vector (items (many Syntax))))
(node Context (scope Int) (module Text) (context Int))
(syntax Syntax
  (Integer (int value))
  (Float (float-bits bits))
  (Symbol (symbol text))
  (Keyword (keyword text))
  (String (text text))
  (CString (cstring text))
  (List (list (rest items)))
  (Vector (vector (rest items))))
(transform Syntax Syntax
  (Integer (Integer value))
  (Float (Float bits))
  (Symbol (Symbol text))
  (Keyword (Keyword text))
  (String (String text))
  (CString (CString text))
  (List (List items))
  (Vector (Vector items)))
