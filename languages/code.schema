(module rewrite.codeforms)
(sum Syntax
  (Integer (value Int))
  (Float (bits Int))
  (Symbol (text Text))
  (Keyword (text Text))
  (String (text Text))
  (CString (text Text))
  (List (items (many Syntax)))
  (Vector (items (many Syntax))))
(node Context (scope Int) (module Text) (context Int)
  (origin Int) (flags Int) (identity Int))
(syntax Syntax
  (Integer (int value))
  (Float (float-bits bits))
  (Symbol (symbol text))
  (Keyword (keyword text))
  (String (text text))
  (CString (cstring text))
  (List (list (rest items)))
  (Vector (vector (rest items))))
(transform Syntax Syntax
  (Integer (Integer value))
  (Float (Float bits))
  (Symbol (Symbol text))
  (Keyword (Keyword text))
  (String (String text))
  (CString (CString text))
  (List (List items))
  (Vector (Vector items)))

(equality Syntax)

; Ordered whole-form roots share one comparison memo across all roots.
(node FormSequence (forms (many Syntax)))
(equality FormSequence)

(context-policy stage-datum Syntax Context
  (Symbol (scope 0) (module "") (origin 5) (identity fresh))
  (List (identity fresh))
  (Vector (identity fresh)))

(node StageDeclaration (marker Text) (body (many Syntax)))
(syntax StageDeclaration
  :expect "stage: expected (stage MARKER FORM...), with a symbol marker"
  (StageDeclaration (list "stage" (symbol marker) (rest body))))

(sum StageEntry (SymbolEntry (name Text)) (StringEntry (name Text)))
(syntax StageEntry (SymbolEntry (symbol name)) (StringEntry (text name)))
(node StageRequest (marker Text) (entry StageEntry) (arguments (many Syntax)))
(syntax StageRequest
  (StageRequest (list (symbol marker) (ref entry) (rest arguments))))
(walk stage-requests
  (opaque-list "quote")
  (prefix "defn" 4 (keyword 2 "cc" 6))
  (prefix "defn*" 4 (keyword 2 "cc" 6))
  (prefix "declare" 4 (keyword 2 "cc" 6)))

; Only bundle containers are transparent; ordinary forms are complete leaves.
(walk produced-forms
  (default keep)
  (prefix-list "do" 1))

(equivalence source-reuse Context scope module)
(equivalence revision-reuse Context scope module origin flags)

; Keep the selected syntax occurrence and its hygiene, not just its spelling.
(pair-selection derive-arms (start 2) (key keyword) (value symbol) (choose last))
