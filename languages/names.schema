(module rewrite.nameforms)
(node Name (text Text))
(node Rename (exported Text) (local Text))
(node Refer (all Bool) (selected (many Name)) (excluded (many Name)) (renames (many Rename)))
(refer-policy imports Refer
  (selection all selected text)
  (exclude excluded text)
  (rename renames exported local))

; One immutable namespace snapshot; names here are already canonical spellings.
(node Declaration (name Text :key))
(node Alias (name Text :key) (target Text))
(node ExportModule (name Text :key) (restricted Bool) (exports (many Name)) (edges (many Reexport)))
(node Reexport (target Text) (refer Refer))
(node Namespace (declarations (many Declaration)) (aliases (many Alias)) (modules (many ExportModule)))

(node Candidate (owner Text) (exported Text) (target Text))
(selection macro-use Candidate first)
(selection unique-use Candidate (agree-any owner target))
(node Imports (uses (many Reexport)))

(node ImportAlias (name Text) (target Text))
(node ModuleImports (name Text :key) (aliases (many ImportAlias)) (uses Imports) (core Refer))
(node Provider (name Text) (owner Text) (root Bool))
(node Routing (modules (many ModuleImports)) (providers (many Provider)) (declared (many Name)) (toolchain (many Name)) (prelude Text))
