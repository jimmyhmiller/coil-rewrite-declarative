(module rewrite.schemaforms)
(node Attribute (name Text))
(sum FieldType (Named (name Text)) (Repeated (name Text)))
(node FieldForm (name Text :key) (type FieldType) (attributes (many Attribute)))
(node VariantForm (name Text :key) (fields (many FieldForm)))
(sum Declaration
  (Record (name Text :key) (fields (many FieldForm)))
  (Sum (name Text :key) (variants (many VariantForm))))
(syntax Attribute :expect "expected field attribute keyword" (Attribute (keyword name)))
(syntax FieldType :expect "expected field type"
  (Named (symbol name))
  (Repeated (list "many" (symbol name))))
(syntax FieldForm :expect "expected field declaration"
  (FieldForm (list (symbol name) (ref type) (rest attributes))))
(syntax VariantForm :expect "expected named variant"
  (VariantForm (list (symbol name) (rest fields))))
(syntax Declaration :expect "expected node or sum declaration"
  (Record (list "node" (symbol name) (rest fields)))
  (Sum (list "sum" (symbol name) (rest variants))))
